{
  "openapi": "3.1.0",
  "info": {
    "title": "DarkLion Agent Work API",
    "version": "1.0.0",
    "description": "Machine-readable API schema for DarkLion staff-scoped agent endpoints and the 62-tool supported-business MCP surface."
  },
  "x-darklion-mcp": {
    "endpoint": "https://darklion.ai/mcp",
    "tool_count": 62,
    "oauth_scopes": ["darklion:read", "darklion:write", "darklion:communicate"],
    "business_domain_catalog": "docs/mcp-business-domain-catalog.json",
    "excluded_classes": ["authentication internals", "webhooks and callbacks", "UI helpers", "connection administration", "broad third-party synchronization", "AI generation", "QBO posting", "bulk mutations", "irreversible deletes"]
  },
  "servers": [
    { "url": "https://darklion.ai" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "DarkLion API key: Authorization: Bearer <dlk_api_key>"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "source": { "type": "string", "enum": ["transactions", "bookkeeper_uncoded"] },
          "source_id": { "type": "string" },
          "transaction_id": { "type": "string" },
          "qb_id": { "type": "string" },
          "company_id": { "type": "integer" },
          "realm_id": { "type": "string" },
          "company_name": { "type": "string" },
          "date": { "type": "string" },
          "vendor": { "type": "string" },
          "vendor_name": { "type": "string" },
          "amount": { "type": ["number", "null"] },
          "description": { "type": "string" },
          "original_account": { "type": "string" },
          "coded_account": { "type": "string" },
          "coded_by": { "type": "string" },
          "coded_at": { "type": ["string", "null"], "format": "date-time" },
          "doc_number": { "type": "string" },
          "memo": { "type": "string" },
          "qbo_txn_type": { "type": "string" },
          "ai_category": { "type": "string" },
          "ai_confidence": { "type": ["number", "null"] },
          "ai_memo": { "type": "string" },
          "txn_type": { "type": "string" },
          "status": { "type": "string" },
          "run_id": { "type": ["integer", "null"] }
        }
      },
      "TransactionSearchResponse": {
        "type": "object",
        "properties": {
          "company": { "type": "object" },
          "query": { "type": "object" },
          "count": { "type": "integer" },
          "total_count": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        }
      },
      "TransactionBackfillResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "company": { "type": "object" },
          "start_date": { "type": "string", "format": "date" },
          "months": { "type": "integer" },
          "types": { "type": "array", "items": { "type": "string" } },
          "fetched": { "type": "integer" },
          "inserted": { "type": "integer" },
          "updated": { "type": "integer" },
          "errors": { "type": "array", "items": { "type": "object" } },
          "by_type": { "type": "object" }
        }
      },
      "ActivityEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "event_type": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "event_date": { "type": "string", "format": "date" },
          "person_id": { "type": ["integer", "null"] },
          "company_id": { "type": ["integer", "null"] },
          "relationship_id": { "type": ["integer", "null"] },
          "tax_year": { "type": "string" },
          "entity_type": { "type": "string" },
          "entity_id": { "type": ["integer", "null"] },
          "source_table": { "type": "string" },
          "source_id": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "ActivityLogResponse": {
        "type": "object",
        "properties": {
          "date": { "type": ["string", "null"], "format": "date" },
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/ActivityEvent" } },
          "message_summaries": {
            "type": "object",
            "properties": {
              "generated_at": { "type": ["string", "null"], "format": "date-time" },
              "client_threads": { "type": "array", "items": { "type": "object" } },
              "team_chats": { "type": "array", "items": { "type": "object" } }
            }
          },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RevenueForecastResponse": {
        "type": "object",
        "properties": {
          "generated_at": { "type": "string", "format": "date-time" },
          "year": { "type": "integer" },
          "totals": {
            "type": "object",
            "properties": {
              "annual": { "type": "number" },
              "collected": { "type": "number" },
              "pastDue": { "type": "number" },
              "upcoming": { "type": "number" }
            },
            "required": ["annual", "collected", "pastDue", "upcoming"]
          },
          "monthly_totals": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                "collected": { "type": "number" },
                "past_due": { "type": "number" },
                "upcoming": { "type": "number" },
                "projected": { "type": "number" }
              },
              "required": ["month", "collected", "past_due", "upcoming", "projected"]
            }
          },
          "customers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "custId": { "type": "string" },
                "email": { "type": "string" },
                "name": { "type": "string" },
                "account": { "type": "string" },
                "source": { "type": "string", "enum": ["stripe", "aum"] },
                "billing_day": { "type": ["integer", "null"] },
                "monthlyAmount": { "type": "number" },
                "annual": { "type": "number" },
                "collected": { "type": "number" },
                "pastDue": { "type": "number" },
                "upcoming": { "type": "number" },
                "months": {
                  "type": "array",
                  "minItems": 12,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "properties": {
                      "status": { "type": "string" },
                      "amount": { "type": "number" }
                    },
                    "required": ["status", "amount"]
                  }
                },
                "subscriptions": { "type": "array", "items": { "type": "object" } }
              }
            }
          },
          "assumptions": {
            "type": "object",
            "properties": {
              "sources": { "type": "array", "items": { "type": "string" } },
              "annual_definition": { "type": "string" },
              "projected_definition": { "type": "string" },
              "baseline_assumption": { "type": "string" },
              "excludes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "required": ["generated_at", "year", "totals", "monthly_totals", "customers", "assumptions"]
      },
      "AgentWorkStatusResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "firm_id": { "type": "integer" },
          "staff_user_id": { "type": "integer" },
          "agent_connection_id": { "type": ["integer", "null"] },
          "agent_name": { "type": "string" },
          "capabilities": {
            "type": "object",
            "properties": {
              "agent_work": { "type": "boolean" },
              "inbox_read": { "type": "boolean" },
              "inbox_drafts": { "type": "boolean" },
              "team_chat_read": { "type": "boolean" },
              "team_chat_send": { "type": "boolean" },
              "documents_read": { "type": "boolean" },
              "activity_log_read": { "type": "boolean" },
              "transactions_read": { "type": "boolean" },
              "transactions_write": { "type": "boolean" },
              "revenue_read": { "type": "boolean" },
              "general_api": { "type": "boolean" },
              "summaries_read": { "type": "boolean" }
            },
            "additionalProperties": { "type": "boolean" }
          },
          "resources": {
            "type": "object",
            "properties": {
              "summaries": {
                "type": "object",
                "properties": {
                  "calendar_read": { "type": "boolean" },
                  "detail_read": { "type": "boolean" },
                  "detail_marks_viewed": { "type": "boolean" }
                }
              },
              "revenue_forecast": {
                "type": "object",
                "properties": {
                  "read": { "type": "boolean" },
                  "live_sources": { "type": "boolean" }
                }
              }
            }
          }
        },
        "required": ["ok", "firm_id", "staff_user_id", "agent_name", "capabilities", "resources"]
      }
    }
  },
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/api/agent-work/status": {
      "get": {
        "operationId": "getAgentWorkStatus",
        "summary": "Validate Agent Work API key and capabilities",
        "description": "Returns effective capabilities for API-token agents. summaries_read covers side-effect-free Conversation Summaries calendar/detail access.",
        "responses": {
          "200": { "description": "Status response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentWorkStatusResponse" } } } },
          "401": { "description": "Missing/invalid auth", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/agent-work/activity-log": {
      "get": {
        "operationId": "getAgentWorkActivityLog",
        "summary": "Read firm-wide daily activity log for agents",
        "description": "Requires activity_log_read capability. Returns append-only workflow events plus cached daily message summaries when include_summaries is true.",
        "x-required-capability": "activity_log_read",
        "parameters": [
          { "name": "date", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Eastern business date. Defaults to today when since/until are omitted." },
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "until", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "event_type", "in": "query", "schema": { "type": "array", "items": { "type": "string" } }, "style": "form", "explode": true },
          { "name": "include_summaries", "in": "query", "schema": { "type": "boolean", "default": true } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 500 } }
        ],
        "responses": {
          "200": { "description": "Activity log response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityLogResponse" } } } },
          "403": { "description": "Capability disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/agent-work/revenue-forecast": {
      "get": {
        "operationId": "getAgentWorkRevenueForecast",
        "summary": "Read the live recurring-revenue forecast",
        "description": "Requires revenue_read capability. Returns the same Stripe and AUM figures used by the Revenue Forecast page, plus forecast-friendly monthly totals.",
        "x-required-capability": "revenue_read",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Forecast year. Defaults to the current year and may be up to ten years in the future."
          }
        ],
        "responses": {
          "200": { "description": "Revenue forecast response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevenueForecastResponse" } } } },
          "400": { "description": "Invalid year", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Capability disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/agent-work/companies/{companyId}/transactions/search": {
      "get": {
        "operationId": "searchAgentWorkTransactionsByCompany",
        "summary": "Search company transaction history",
        "description": "Requires transactions_read capability. Amount filters use absolute amount.",
        "parameters": [
          { "name": "companyId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "vendor", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "General text search, e.g. check 1023" },
          { "name": "amount", "in": "query", "schema": { "type": "number" } },
          { "name": "amount_near", "in": "query", "schema": { "type": "number" } },
          { "name": "tolerance", "in": "query", "schema": { "type": "number" } },
          { "name": "amount_min", "in": "query", "schema": { "type": "number" } },
          { "name": "amount_max", "in": "query", "schema": { "type": "number" } },
          { "name": "date_from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "date_to", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "source", "in": "query", "schema": { "type": "string", "enum": ["transactions", "bookkeeper_uncoded"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 25, "maximum": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionSearchResponse" } } } }
        }
      }
    },
    "/api/agent-work/transactions/search": {
      "post": {
        "operationId": "searchAgentWorkTransactions",
        "summary": "Structured transaction search",
        "description": "Requires transactions_read capability. Pass company_id or realm_id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_id": { "type": "integer" },
                  "realm_id": { "type": "string" },
                  "vendor": { "type": "string" },
                  "q": { "type": "string" },
                  "amount": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "object", "properties": { "exact": { "type": "number" }, "near": { "type": "number" }, "min": { "type": "number" }, "max": { "type": "number" }, "tolerance": { "type": "number" } } }
                    ]
                  },
                  "date_range": { "type": "object", "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } },
                  "limit": { "type": "integer", "default": 25, "maximum": 100 },
                  "offset": { "type": "integer", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionSearchResponse" } } } }
        }
      }
    },
    "/api/agent-work/companies/{companyId}/transactions/backfill": {
      "post": {
        "operationId": "backfillAgentWorkTransactionsByCompany",
        "summary": "Backfill company transaction history from QBO",
        "description": "Requires transactions_write capability. Safe to rerun; upserts by realm_id and qb_id.",
        "parameters": [ { "name": "companyId", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "months": { "type": "integer", "default": 24, "maximum": 84 },
                  "types": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Backfill result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionBackfillResponse" } } } }
        }
      }
    },
    "/api/agent-work/transactions/backfill": {
      "post": {
        "operationId": "backfillAgentWorkTransactions",
        "summary": "Structured transaction backfill",
        "description": "Requires transactions_write capability. Pass company_id or realm_id.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_id": { "type": "integer" },
                  "realm_id": { "type": "string" },
                  "months": { "type": "integer", "default": 24, "maximum": 84 },
                  "types": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Backfill result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionBackfillResponse" } } } }
        }
      }
    },
    "/api/agent-work/companies": {
      "get": {
        "operationId": "listAgentWorkCompanies",
        "summary": "List companies visible to the scoped staff identity",
        "x-required-capability": "transactions_read",
        "responses": {
          "200": {
            "description": "Visible companies",
            "content": { "application/json": { "schema": { "type": "object", "required": ["companies"], "properties": { "companies": { "type": "array", "items": { "type": "object", "required": ["id", "realm_id", "company_name"], "properties": { "id": { "type": "integer" }, "realm_id": { "type": "string" }, "company_name": { "type": "string" }, "entity_type": { "type": ["string", "null"] }, "status": { "type": ["string", "null"] } } } } } } } }
          }
        }
      }
    },
    "/api/agent-work/crm/search": {
      "get": {
        "operationId": "searchAgentWorkCrm",
        "summary": "Search firm relationships, people, and companies",
        "description": "Requires crm_read capability. Searches relationship names and linked people, spouses, emails, and active companies within the authorized firm.",
        "x-required-capability": "crm_read",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 25, "default": 10 }, "description": "Maximum results per entity type." }
        ],
        "responses": {
          "200": {
            "description": "Firm-scoped CRM matches",
            "content": { "application/json": { "schema": { "type": "object", "required": ["relationships", "companies", "people"], "properties": { "relationships": { "type": "array", "items": { "type": "object" } }, "companies": { "type": "array", "items": { "type": "object" } }, "people": { "type": "array", "items": { "type": "object" } } } } } }
          },
          "400": { "description": "Missing or invalid query", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Capability disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/agent-work/inbox/summary": {
      "get": {
        "operationId": "getAgentWorkInboxSummary",
        "summary": "Read visible Inbox counts",
        "x-required-capability": "inbox_read",
        "responses": { "200": { "description": "Inbox summary" } }
      }
    },
    "/api/agent-work/inbox/threads": {
      "get": {
        "operationId": "listAgentWorkInboxThreads",
        "summary": "List visible Inbox threads without marking them read",
        "x-required-capability": "inbox_read",
        "parameters": [
          { "name": "unread", "in": "query", "schema": { "type": "boolean" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Visible Inbox threads" } }
      }
    },
    "/api/agent-work/inbox/threads/{threadId}": {
      "get": {
        "operationId": "getAgentWorkInboxThread",
        "summary": "Read one visible Inbox thread without marking it read",
        "x-required-capability": "inbox_read",
        "parameters": [ { "name": "threadId", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "Inbox thread, messages, and pending drafts" }, "404": { "description": "Thread not found" } }
      }
    },
    "/api/agent-work/inbox/threads/{threadId}/draft": {
      "post": {
        "operationId": "createAgentWorkInboxDraft",
        "summary": "Create a pending client-reply draft for staff review",
        "x-required-capability": "inbox_drafts",
        "parameters": [ { "name": "threadId", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["draft_body"], "properties": { "draft_body": { "type": "string", "minLength": 1 }, "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "notes": { "type": ["string", "null"] } } } } } },
        "responses": { "201": { "description": "Draft created; nothing was sent" } }
      }
    },
    "/api/agent-work/team-chat/summary": {
      "get": {
        "operationId": "getAgentWorkTeamChatSummary",
        "summary": "Read Team Chat unread counts",
        "x-required-capability": "team_chat_read",
        "responses": { "200": { "description": "Team Chat summary" } }
      }
    },
    "/api/agent-work/team-chat/conversations": {
      "get": {
        "operationId": "listAgentWorkTeamConversations",
        "summary": "List visible Team Chat conversations without changing read state",
        "x-required-capability": "team_chat_read",
        "parameters": [
          { "name": "unread", "in": "query", "schema": { "type": "boolean" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Visible Team Chat conversations" } }
      }
    },
    "/api/agent-work/team-chat/conversations/{conversationId}/messages": {
      "get": {
        "operationId": "getAgentWorkTeamConversationMessages",
        "summary": "Read messages from one visible Team Chat conversation",
        "x-required-capability": "team_chat_read",
        "parameters": [
          { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Team Chat messages" }, "404": { "description": "Conversation not found" } }
      }
    },
    "/api/agent-work/team-chat/conversations/{conversationId}/reply": {
      "post": {
        "operationId": "replyToAgentWorkTeamConversation",
        "summary": "Send an internal Team Chat reply",
        "x-required-capability": "team_chat_send",
        "parameters": [ { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["body", "client_nonce"], "properties": { "body": { "type": "string", "minLength": 1 }, "client_nonce": { "type": "string", "minLength": 8, "maxLength": 200 } } } } } },
        "responses": { "201": { "description": "Reply created or idempotently replayed" } }
      }
    }
  }
}
