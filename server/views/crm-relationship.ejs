        return `<div class="ov2-work-row">
          <span style="font-size:0.85rem;">${a.icon || '•'}</span>
          <span style="flex:1;font-size:0.82rem;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${esc(a.title || '')}">${esc(a.title || '')}${a.entity_name ? ' · ' + esc(a.entity_name) : ''}</span>
