  async function loadOvBilling() {
    const el = document.getElementById('ov-billing-content');
    if (!el) return;
    try {
      const res = await apiFetch(`/api/billing/${relId}/summary`);
      if (!res.ok) throw new Error('billing failed');
      const data = await res.json();
      const statusMrr = document.getElementById('ov2-status-mrr');
      const statusSub = document.getElementById('ov2-status-billing-sub');
      if (!data.configured || !data.accounts || !data.total_mrr) {
        el.innerHTML = `<div style="color:var(--muted);font-size:0.78rem;">Not configured — <a href="#" onclick="switchTab('billing',document.querySelectorAll('.tab-item')[4]);return false;" style="color:var(--gold);">Set up →</a></div>`;
        if (statusSub) statusSub.textContent = 'Not configured';
        return;
      }
      if (statusMrr) statusMrr.innerHTML = `$${Number(data.total_mrr).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}<span>/mo</span>`;
      if (statusSub) statusSub.textContent = data.has_past_due ? 'Stripe · Past due' : 'Stripe active · no past due';
      const pastDue = data.has_past_due ? `<span style="margin-left:0.4rem;padding:0.08rem 0.4rem;border-radius:20px;font-size:0.65rem;font-weight:700;background:rgba(237,137,54,0.15);color:#ed8936;">⚠️ Past Due</span>` : '';
      let html = `<div style="margin-bottom:0.65rem;">
        <div style="font-size:1.25rem;font-weight:800;color:var(--gold);">$${data.total_mrr.toFixed(2)}<span style="font-size:0.72rem;font-weight:500;color:var(--muted);">/mo MRR</span>${pastDue}</div>
      </div>`;
      data.accounts.forEach(acc => {
        if (!acc.customers || !acc.customers.length) return;
        acc.customers.filter(c => c.subscriptions && c.subscriptions.length).forEach(cust => {
          cust.subscriptions.forEach(sub => {
            const dot = ({active:'#3ecf8e',past_due:'#ed8936',canceled:'#f56565'})[sub.status]||'#8fa3b8';
            html += `<div style="display:flex;align-items:center;justify-content:space-between;padding:0.25rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
              <div style="display:flex;align-items:center;gap:0.4rem;min-width:0;">
                <div style="width:7px;height:7px;border-radius:50%;background:${dot};flex-shrink:0;"></div>
                <span style="font-size:0.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(cust.name)}</span>
              </div>
              <span style="font-size:0.78rem;font-weight:700;flex-shrink:0;margin-left:0.5rem;">$${sub.total_monthly.toFixed(0)}/mo</span>
            </div>`;
          });
        });
      });
      el.innerHTML = html;
    } catch(e) {
      if (document.getElementById('ov-billing-content')) {
        document.getElementById('ov-billing-content').innerHTML = `<div style="color:var(--muted);font-size:0.78rem;">Could not load billing.</div>`;
      }
    }
  }



    function timeAgo(dateStr) {
    const d = new Date(dateStr);
    const diff = Math.floor((Date.now() - d) / 1000);
    if (diff < 60) return 'just now';
    if (diff < 3600) return Math.floor(diff/60) + 'm ago';
    if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
    if (diff < 604800) return Math.floor(diff/86400) + 'd ago';
    return d.toLocaleDateString('en-US', { month:'short', day:'numeric' });
  }

  // ── Team panel ────────────────────────────────────────────────────
  let _allStaff = [];
  let _assignedTeam = [];

  async function loadTeamPanel() {
    try {
      // Fetch all staff + assigned team in parallel
      const [staffRes, teamRes] = await Promise.all([
        fetch('/firms/team', { headers: { 'Authorization': 'Bearer ' + token } }),
        apiFetch(`/api/relationships/${relId}/team`),
      ]);
      _allStaff = staffRes.ok ? await staffRes.json() : [];
      _assignedTeam = teamRes.ok ? await teamRes.json() : [];
      renderTeamPanel();
    } catch(e) {
      const el = document.getElementById('team-members-list');
      if (el) el.innerHTML = '<div style="color:var(--muted);font-size:0.78rem;">Failed to load team.</div>';
    }
  }

  function renderTeamPanel() {
    const listEl = document.getElementById('team-members-list');
    const addRow = document.getElementById('team-add-row');
    const addSelect = document.getElementById('team-add-select');
    if (!listEl) return;

    const assignedIds = new Set(_assignedTeam.map(m => m.id));

    // Render 2-per-row card grid
    if (!_assignedTeam.length) {
      listEl.innerHTML = `<div style="color:var(--muted);font-size:0.78rem;margin-bottom:0.3rem;">No team assigned yet.</div>`;
    } else {
      listEl.innerHTML = `<div class="team-grid">` + _assignedTeam.map(m => {
        const initials = m.name ? m.name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2) : '?';
        const title = m.credentials ? esc(m.credentials) : (m.role === 'owner' ? 'Owner' : m.role === 'admin' ? 'Admin' : 'Staff');
        const pendingClass = m.pending ? ' pending' : '';
        return `<div class="team-card${pendingClass}" id="tm-${m.id}">
          <button class="team-card-remove" onclick="removeTeamMember(${m.id})" title="Remove">✕</button>
          <div class="team-card-avatar" id="tca-${m.id}">${initials}</div>
          <div class="team-card-name">${esc(m.name||m.email)}</div>
          <div class="team-card-title">${title}${m.pending ? ' · Pending' : ''}</div>
        </div>`;
      }).join('') + `</div>`;
      // Async-load signed avatar URLs
      _assignedTeam.forEach(m => {
        if (!m.avatar_url) return; // no avatar key, keep initials
        apiFetch(`/firms/team/${m.id}/avatar`).then(r => r.json()).then(d => {
          if (!d.url) return;
          const el = document.getElementById(`tca-${m.id}`);
          if (!el) return;
          const img = document.createElement('img');
          img.src = d.url;
          img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';
          img.onerror = () => img.remove();
          img.onload = () => { el.textContent = ''; el.appendChild(img); };
        }).catch(() => {});
      });
    }

    // Populate dropdown — include pending staff
    if (addSelect) {
      const unassigned = _allStaff.filter(s => !assignedIds.has(s.id));
      addSelect.innerHTML = `<option value="">Select member…</option>` +
        unassigned.map(s => {
          const label = (s.display_name||s.name||s.email) + (s.pending ? ' (pending)' : '');
          return `<option value="${s.id}">${esc(label)}</option>`;
        }).join('');
      // Only auto-hide if no unassigned remain and row is not already visible
      if (!unassigned.length && addRow && addRow.style.display !== 'flex') {
        addRow.style.display = 'none';
      }
    }
  }

  async function addTeamMember() {
    const sel = document.getElementById('team-add-select');
    const userId = sel ? parseInt(sel.value) : 0;
    if (!userId) return;
    try {
      const res = await apiFetch(`/api/relationships/${relId}/team`, {
        method: 'POST',
        body: JSON.stringify({ firm_user_id: userId }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      await loadTeamPanel();
    } catch(e) {
      toast('Failed to add: ' + e.message, 'error');
    }
  }

  async function removeTeamMember(userId) {
    try {
      const res = await apiFetch(`/api/relationships/${relId}/team/${userId}`, { method: 'DELETE' });
      if (!res.ok) throw new Error('Failed');
      _assignedTeam = _assignedTeam.filter(m => m.id !== userId);
      renderTeamPanel();
    } catch(e) {
      toast('Failed to remove', 'error');
    }
  }

  // ── Engagement tab ────────────────────────────────────────────────
  let engDocs = [];
  // ── Engagement tab ──────────────────────────────────────────────
  let engLetters = [];

  async function loadEngagement() {
    const el = document.getElementById('engagement-list');
    if (el.dataset.loaded) return;
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading…</div></div>';
    try {
      const res = await apiFetch(`/api/engagement/${relId}`);
      engLetters = res.ok ? await res.json() : [];
      renderEngagementList();
      el.dataset.loaded = '1';
      updateEngagementSummary();
    } catch(e) {
      el.innerHTML = '<div style="color:var(--muted);padding:1rem;">Failed to load engagement letters.</div>';
    }
  }

  async function updateEngagementSummary() {
    // Contracted MRR from active engagement letters
    const active = engLetters.filter(l => l.status === 'active' && l.extracted_data && l.extracted_data.total_monthly);
    const contractedMRR = active.reduce((s, l) => s + Number(l.extracted_data.total_monthly), 0);
    const countEl = document.getElementById('eng-active-count');
    const contractedEl = document.getElementById('eng-contracted-mrr');
    if (countEl) countEl.textContent = engLetters.filter(l => l.status === 'active').length;
    if (contractedEl) contractedEl.textContent = contractedMRR > 0 ? `$${contractedMRR.toFixed(0)}/mo` : '—';

    // Billed MRR + status from Stripe
    try {
      const res = await apiFetch(`/api/billing/${relId}/summary`);
      if (!res.ok) return;
      const data = await res.json();
      const billedEl = document.getElementById('eng-billed-mrr');
      const statusEl = document.getElementById('eng-stripe-status');
      if (!data.configured || !data.total_mrr) {
        if (billedEl) billedEl.textContent = 'Not configured';
        if (statusEl) { statusEl.textContent = '—'; }
        return;
      }
      if (billedEl) { billedEl.textContent = `$${data.total_mrr.toFixed(0)}/mo`; billedEl.style.color = '#3ecf8e'; }
      if (statusEl) {
        if (data.has_past_due) {
          statusEl.innerHTML = '<span style="color:#ed8936;">⚠️ Past Due</span>';
        } else {
          statusEl.innerHTML = '<span style="color:#3ecf8e;">✓ Current</span>';
        }
      }
    } catch(e) { /* billing not configured */ }
  }

  function renderEngagementList() {
    const el = document.getElementById('engagement-list');
    if (!engLetters.length) {
      el.innerHTML = `<div class="placeholder-section">
        <div class="ph-icon">📄</div>
        <div class="ph-title">No Engagement Letters</div>
        <div class="ph-desc">Upload a signed engagement letter to get started.</div>
      </div>`;
      return;
    }
    const active = engLetters.filter(l => l.status === 'active');
    const retired = engLetters.filter(l => l.status === 'retired');
    let html = '';

    if (active.length) {
      html += `<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.85rem;">`;
      active.forEach(l => { html += renderEngLetterCard(l, false); });
      html += `</div>`;
    }
    if (retired.length) {
      html += `<div style="font-size:0.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin:1.25rem 0 0.6rem;padding-top:0.75rem;border-top:1px solid var(--border);">Retired (${retired.length})</div>`;
      html += `<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.85rem;">`;
      retired.forEach(l => { html += renderEngLetterCard(l, true); });
      html += `</div>`;
    }
    el.innerHTML = html;
  }

  function renderEngLetterCard(l, isRetired) {
    const d = l.extracted_data;
    const isExtracting = !d && !isRetired;
    const servicePills = d && d.services ? [
      d.services.tax ? `<span style="padding:0.1rem 0.45rem;border-radius:20px;font-size:0.65rem;font-weight:700;background:rgba(99,179,237,0.15);color:#63b3ed;border:1px solid rgba(99,179,237,0.25);">Tax</span>` : '',
      d.services.bookkeeping ? `<span style="padding:0.1rem 0.45rem;border-radius:20px;font-size:0.65rem;font-weight:700;background:rgba(62,207,142,0.12);color:#3ecf8e;border:1px solid rgba(62,207,142,0.25);">Bookkeeping</span>` : '',
      d.services.financial_planning ? `<span style="padding:0.1rem 0.45rem;border-radius:20px;font-size:0.65rem;font-weight:700;background:rgba(201,168,76,0.15);color:var(--gold);border:1px solid rgba(201,168,76,0.25);">Financial Planning</span>` : '',
    ].filter(Boolean).join(' ') : '';

    const retiredBadge = isRetired ? `<span style="padding:0.1rem 0.5rem;border-radius:20px;font-size:0.65rem;font-weight:700;background:rgba(143,163,184,0.12);color:var(--muted);border:1px solid rgba(143,163,184,0.2);">Retired ${l.retired_at ? fmtDate(l.retired_at) : ''}</span>` : '';

    let feeHtml = '';
    if (d && d.monthly_line_items && d.monthly_line_items.length) {
      feeHtml = `<div style="margin-top:0.75rem;">
        <div style="font-size:0.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.4rem;">Fee Schedule</div>
        <table style="width:100%;border-collapse:collapse;">`;
      d.monthly_line_items.forEach(item => {
        feeHtml += `<tr><td style="font-size:0.82rem;padding:0.2rem 0;">${esc(item.description)}</td><td style="font-size:0.82rem;text-align:right;padding:0.2rem 0;font-variant-numeric:tabular-nums;">$${Number(item.amount).toFixed(2)}/mo</td></tr>`;
      });
      if (d.total_monthly) {
        feeHtml += `<tr style="border-top:1px solid var(--border);"><td style="font-size:0.85rem;font-weight:700;padding:0.3rem 0;">Total Monthly</td><td style="font-size:0.85rem;font-weight:700;text-align:right;color:var(--gold);padding:0.3rem 0;">$${Number(d.total_monthly).toFixed(2)}/mo</td></tr>`;
      }
      if (d.one_time_fees && d.one_time_fees.length) {
        feeHtml += `<tr><td colspan="2" style="padding-top:0.4rem;font-size:0.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;">One-Time Fees</td></tr>`;
        d.one_time_fees.forEach(item => {
          feeHtml += `<tr><td style="font-size:0.82rem;padding:0.15rem 0;">${esc(item.description)}</td><td style="font-size:0.82rem;text-align:right;padding:0.15rem 0;">$${Number(item.amount).toFixed(2)}</td></tr>`;
        });
      }
      feeHtml += `</table></div>`;
    }

    const summaryHtml = d && d.ai_summary ? `<div style="font-size:0.8rem;color:var(--muted);margin-top:0.6rem;line-height:1.5;border-left:2px solid var(--border);padding-left:0.6rem;">${esc(d.ai_summary)}</div>` : '';

    const extractingHtml = isExtracting ? `<div style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem;display:flex;align-items:center;gap:0.5rem;"><div class="loading-spinner" style="width:14px;height:14px;border-width:2px;"></div> Extracting data with AI…</div>` : '';

    const termHtml = d && d.term_end_date ? `<span style="font-size:0.72rem;color:var(--muted);">Term ends ${fmtDate(d.term_end_date)}</span>` : '';

    const actions = isRetired
      ? `<button class="btn btn-ghost btn-xs" onclick="engReactivate(${l.id})">Reactivate</button>`
      : `<button class="btn btn-outline btn-xs" onclick="engDownload(${l.id}, this)">⬇ View</button>
         <button class="btn btn-ghost btn-xs" onclick="engReExtract(${l.id})" title="Re-run AI extraction">🔄</button>
         <button class="btn btn-ghost btn-xs" style="color:var(--muted);" onclick="engRetire(${l.id})">Retire</button>`;

    const cardOpacity = isRetired ? 'opacity:0.65;' : '';
    const goldBorder = !isRetired ? 'border-color:rgba(201,168,76,0.3);' : '';

    return `<div style="background:var(--card);border:1px solid var(--border);${goldBorder}${cardOpacity}border-radius:10px;padding:1rem 1.1rem;margin-bottom:0.85rem;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.75rem;margin-bottom:0.35rem;">
        <div style="min-width:0;">
          <div style="font-weight:700;font-size:0.92rem;margin-bottom:0.25rem;">${esc(l.display_name || 'Engagement Letter')}</div>
          <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">${servicePills}${retiredBadge}${termHtml}</div>
        </div>
        <div style="display:flex;gap:0.4rem;flex-shrink:0;">${actions}</div>
      </div>
      ${feeHtml}${summaryHtml}${extractingHtml}
    </div>`;
  }

  async function engDownload(id, btn) {
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/engagement/${relId}/${id}/url`);
      const data = await res.json();
      if (data.url) window.open(data.url, '_blank');
    } catch(e) { toast('Failed to get link', 'error'); }
    if (btn) { btn.disabled = false; btn.textContent = '⬇ View'; }
  }

  async function engRetire(id) {
    if (!await window.dlConfirm('Retire this engagement letter? It will remain in history but marked inactive.', { title:'Retire Letter', confirmLabel:'Retire', icon:'📁' })) return;
    try {
      const res = await apiFetch(`/api/engagement/${relId}/${id}/retire`, { method: 'POST' });
      if (!res.ok) throw new Error((await res.json()).error);
      toast('Engagement letter retired');
      const el = document.getElementById('engagement-list');
      delete el.dataset.loaded;
      await loadEngagement();
    } catch(e) { toast(e.message, 'error'); }
  }

  async function engReExtract(id) {
    toast('Re-extracting with AI…');
    try {
      const res = await apiFetch(`/api/engagement/${relId}/${id}/re-extract`, { method: 'POST' });
      if (!res.ok) throw new Error((await res.json()).error);
      const listEl = document.getElementById('engagement-list');
      delete listEl.dataset.loaded;
      await loadEngagement();
      if (id) pollExtraction(id);
    } catch(e) { toast(e.message, 'error'); }
  }

  async function engReactivate(id) {
    try {
      const res = await apiFetch(`/api/engagement/${relId}/${id}/reactivate`, { method: 'POST' });
      if (!res.ok) throw new Error((await res.json()).error);
      toast('Engagement letter reactivated');
      const el = document.getElementById('engagement-list');
      delete el.dataset.loaded;
      await loadEngagement();
    } catch(e) { toast(e.message, 'error'); }
  }

  // Poll for extraction completion after upload
  function pollExtraction(letterId, maxAttempts = 12) {
    let attempts = 0;
    const interval = setInterval(async () => {
      attempts++;
      try {
        const res = await apiFetch(`/api/engagement/${relId}/${letterId}/extracted`);
        const data = await res.json();
        if (data.extracted_at) {
          clearInterval(interval);
          // Refresh the list
          const listEl = document.getElementById('engagement-list');
          delete listEl.dataset.loaded;
          await loadEngagement();
          toast('AI extraction complete');
        }
        if (attempts >= maxAttempts) clearInterval(interval);
      } catch(e) { clearInterval(interval); }
    }, 5000);
  }

  // ── Engagement upload modal ──────────────────────────────────────
  let _engFile = null;
  function openEngagementUpload() {
    _engFile = null;
    document.getElementById('eng-selected-name').textContent = '';
    document.getElementById('eng-submit').disabled = true;
    document.getElementById('eng-error').style.display = 'none';
    document.getElementById('eng-msg').style.display = 'none';
    document.getElementById('engagement-upload-modal').classList.remove('hidden');
  }
  function closeEngagementModal() {
    document.getElementById('engagement-upload-modal').classList.add('hidden');
  }

  (function() {
    const fileDrop = document.getElementById('eng-file-drop');
    const fileInput = document.getElementById('eng-file-input');
    const submitBtn = document.getElementById('eng-submit');

    function setEngFile(f) {
      _engFile = f;
      document.getElementById('eng-selected-name').textContent = f.name;
      submitBtn.disabled = false;
    }

    fileDrop.addEventListener('click', () => fileInput.click());
    fileDrop.addEventListener('dragover', e => { e.preventDefault(); fileDrop.classList.add('drag-over'); });
    fileDrop.addEventListener('dragleave', () => fileDrop.classList.remove('drag-over'));
    fileDrop.addEventListener('drop', e => {
      e.preventDefault(); fileDrop.classList.remove('drag-over');
      if (e.dataTransfer.files[0]) setEngFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', () => { if (fileInput.files[0]) setEngFile(fileInput.files[0]); });
    document.getElementById('engagement-upload-modal').addEventListener('click', e => {
      if (e.target === document.getElementById('engagement-upload-modal')) closeEngagementModal();
    });
  })();

  async function submitEngagementUpload() {
    if (!_engFile) return;
    const submitBtn = document.getElementById('eng-submit');
    const errEl = document.getElementById('eng-error');
    const msgEl = document.getElementById('eng-msg');
    submitBtn.disabled = true; submitBtn.textContent = 'Uploading…';
    errEl.style.display = 'none'; msgEl.style.display = 'none';
    try {
      const fd = new FormData();
      fd.append('file', _engFile);
      const res = await fetch(`/api/engagement/${relId}/upload`, {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token },
        body: fd,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      submitBtn.textContent = '✓ Uploaded';
      // Reload list immediately (shows "extracting" state)
      const listEl = document.getElementById('engagement-list');
      delete listEl.dataset.loaded;
      await loadEngagement();
      // Poll for extraction
      if (data.id) pollExtraction(data.id);
      setTimeout(() => { closeEngagementModal(); toast('Uploaded — AI extraction in progress…'); }, 700);
    } catch(e) {
      errEl.textContent = e.message; errEl.style.display = '';
      submitBtn.disabled = false; submitBtn.textContent = 'Upload';
    }
  }

  // ── Workflow tab ──────────────────────────────────────────────────
  async function loadWorkflow() {
    const el = document.getElementById('workflow-content');
    if (el.dataset.loaded) return;
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading pipelines…</div></div>';

    if (!relData) { el.innerHTML = '<div style="color:var(--muted);padding:1rem;">Relationship not loaded.</div>'; return; }

    const people = relData.people || [];
    const companies = relData.companies || [];

    try {
      // Fetch jobs for all entities in parallel
      const allFetches = [
        ...people.map(p => apiFetch(`/api/pipelines/entity-jobs?entity_type=person&entity_id=${p.id}`)
          .then(r => r.json())
          .then(jobs => ({ entityName: formatPersonDisplayName(p) || 'Person', entityType: 'person', jobs }))
          .catch(() => null)),
        ...companies.map(c => apiFetch(`/api/pipelines/entity-jobs?entity_type=company&entity_id=${c.id}`)
          .then(r => r.json())
          .then(jobs => ({ entityName: c.company_name || c.name || 'Company', entityType: 'company', jobs }))
          .catch(() => null)),
      ];

      const results = (await Promise.all(allFetches)).filter(Boolean);
      const withJobs = results.filter(r => r.jobs && r.jobs.length > 0);

      if (!withJobs.length) {
        el.innerHTML = `<div class="placeholder-section">
          <div class="ph-icon">📋</div>
          <div class="ph-title">No Active Pipelines</div>
          <div class="ph-desc">None of the people or companies in this relationship have active pipeline jobs.</div>
        </div>`;
        el.dataset.loaded = '1';
        return;
      }

      let html = '';
      withJobs.forEach(({ entityName, entityType, jobs }) => {
        html += `<div class="workflow-entity-group">
          <div class="workflow-entity-label">${entityType === 'person' ? '👤' : '🏢'} ${esc(entityName)}</div>
          <div class="workflow-jobs-grid">`;
        jobs.forEach(j => {
          const stageColor = j.stage_color || 'var(--gold)';
          const yearBadge = j.tax_year ? `<span style="font-size:0.7rem;background:rgba(255,255,255,0.06);border-radius:4px;padding:0.1rem 0.4rem;margin-left:0.35rem;color:var(--muted);">${j.tax_year}</span>` : '';
          const statusColor = j.job_status === 'blocked' ? '#f56565' : (['waiting_client','missing_info'].includes(j.job_status)) ? '#ed8936' : '#3ecf8e';
          const statusLabel = { active:'Active', waiting_client:'Waiting on Client', missing_info:'Missing Info', blocked:'Blocked', under_extension:'Under Extension', on_hold:'On Hold' }[j.job_status] || 'Active';
          html += `<div class="workflow-job-row">
            <div style="font-weight:700;font-size:0.87rem;">${esc(j.pipeline_name)}${yearBadge}</div>
            <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
              <div>
                <div style="font-size:0.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.1rem;">Stage</div>
                <div style="font-weight:700;color:${stageColor};font-size:0.82rem;">${esc(j.stage_name)}</div>
              </div>
              <div>
                <div style="font-size:0.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.1rem;">Status</div>
                <div style="font-weight:600;font-size:0.8rem;color:${statusColor};">${statusLabel}</div>
              </div>
              ${j.assigned_name ? `<div><div style="font-size:0.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.1rem;">Assigned</div><div style="font-size:0.8rem;">${esc(j.assigned_name)}</div></div>` : ''}
            </div>
          </div>`;
        });
        html += `</div></div>`;
      });

      el.innerHTML = html;
      el.dataset.loaded = '1';
    } catch(e) {
      el.innerHTML = `<div style="color:var(--muted);padding:1rem;">Failed to load workflow data: ${esc(e.message)}</div>`;
    }

    // Load pipeline history
    loadPipelineHistory();
  }

  async function loadPipelineHistory() {
    const loading = document.getElementById('pipeline-history-loading');
    const list = document.getElementById('pipeline-history-list');
    if (!loading || !list) return;
    loading.style.display = ''; list.style.display = 'none';
    try {
      const res = await apiFetch(`/api/pipelines/completions?relationship_id=${relId}`);
      const data = await res.json();
      loading.style.display = 'none'; list.style.display = '';
      const completions = data.completions || [];
      const activeJobs = data.active_jobs || [];
      if (!completions.length && !activeJobs.length) {
        list.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;">No pipeline history yet.</div>';
        return;
      }
      const rows = [];
      completions.forEach(c => {
        const yr = c.tax_year ? ` ${c.tax_year}` : '';
        const date = new Date(c.completed_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
        rows.push(`<div style="display:flex;align-items:center;gap:0.75rem;padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
          <span style="font-size:1rem;">✅</span>
          <span style="flex:1;font-size:0.88rem;font-weight:600;">${esc(c.pipeline_name)}${yr}</span>
          <span style="font-size:0.78rem;color:var(--muted);">completed ${date}</span>
        </div>`);
      });
      activeJobs.forEach(j => {
        const yr = j.tax_year ? ` ${j.tax_year}` : '';
        const stage = j.current_stage_name ? ` → ${j.current_stage_name}` : '';
        rows.push(`<div style="display:flex;align-items:center;gap:0.75rem;padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
          <span style="font-size:1rem;">🔄</span>
          <span style="flex:1;font-size:0.88rem;font-weight:600;">${esc(j.pipeline_name)}${yr}</span>
          <span style="font-size:0.78rem;color:var(--muted);">in progress${esc(stage)}</span>
        </div>`);
      });
      list.innerHTML = rows.join('') || '<div style="color:var(--muted);font-size:0.85rem;">No pipeline history yet.</div>';
    } catch(e) { loading.textContent = 'Failed to load pipeline history.'; }
  }

  // ── Notes ─────────────────────────────────────────────────────────
  async function autoSaveNotes(val, force) {
    try {
      await apiFetch(`/api/relationships/${relId}`, { method: 'PUT', body: JSON.stringify({ notes: val }) });
      if (relData) relData.notes = val;
      const ind = document.getElementById('notes-saved');
      if (ind) { ind.textContent = '✓ Saved'; setTimeout(() => { ind.textContent = ''; }, 2000); }
      if (force) toast('Notes saved');
    } catch(e) { toast('Failed to save notes', 'error'); }
  }

  // ── Billing tab ───────────────────────────────────────────────────
  // ── Billing tab ──────────────────────────────────────────────────
  let billingConfig = null;

  async function renderBilling() {
    const el = document.getElementById('billing-content');
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading billing config…</div></div>';

    // Load config
    try {
      const res = await apiFetch(`/api/billing/${relId}/config`);
      billingConfig = res.ok ? await res.json() : { billing_accounts: [], billing_emails: [] };
    } catch(e) { billingConfig = { billing_accounts: [], billing_emails: [] }; }

    renderBillingConfig(el);

    // If configured, load live Stripe data
    if ((billingConfig.billing_accounts.length && billingConfig.billing_emails.length) || billingConfig.aum_billing_enabled) {
      loadBillingSummary(el);
    }
  }

  function renderBillingConfig(el) {
    const cfg = billingConfig || {};
    const accounts = cfg.billing_accounts || [];
    const emails = cfg.billing_emails || [];
    const aumPeople = cfg.aum_people || [];
    const aum = cfg.aum_summary || {};
    const money = n => '$' + Number(n || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
    let aumLines = Array.isArray(cfg.aum_lines) ? cfg.aum_lines.slice() : [];
    if (!aumLines.length && cfg.aum_billing_enabled) {
      aumLines = [{
        person_id: cfg.aum_person_id || '',
        label: '',
        enabled: true,
        annual_rate: cfg.aum_annual_rate ?? '',
        min_monthly_fee: cfg.aum_min_monthly_fee ?? '',
        override_monthly_fee: cfg.aum_override_monthly_fee ?? '',
      }];
    }
    const personOptionsFor = selectedId => ['<option value="">Select Blueleaf household…</option>'].concat(aumPeople.map(p => {
      const name = [p.first_name, p.last_name].filter(Boolean).join(' ') || p.email || ('Person ' + p.id);
      const disabled = !p.blueleaf_household_id ? ' disabled' : '';
      const selected = String(selectedId || '') === String(p.id) ? ' selected' : '';
      const suffix = p.blueleaf_household_id ? ' — BL ' + p.blueleaf_household_id : ' — no Blueleaf';
      return `<option value="${p.id}"${selected}${disabled}>${esc(name + suffix)}</option>`;
    })).join('');
    const aumLineRows = aumLines.map((line, i) => `<div class="aum-line-row" data-idx="${i}" style="border:1px solid var(--border);border-radius:8px;padding:0.65rem;margin-bottom:0.6rem;background:rgba(255,255,255,0.025);">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.5rem;">
        <label style="display:flex;align-items:center;gap:0.45rem;font-size:0.78rem;color:var(--muted);cursor:pointer;"><input type="checkbox" class="aum-line-enabled" ${line.enabled === false ? '' : 'checked'} onchange="saveBillingConfig()"> Active</label>
        <button class="btn btn-ghost btn-xs" onclick="removeAumLine(${i})" style="color:var(--muted);">Remove</button>
      </div>
      <div style="display:grid;grid-template-columns:minmax(220px,1.4fr) minmax(140px,1fr) minmax(90px,0.55fr) minmax(120px,0.65fr);gap:0.45rem;">
        <select class="form-control aum-line-person" onchange="saveBillingConfig()">${personOptionsFor(line.person_id)}</select>
        <input class="form-control aum-line-label" value="${esc(line.label || '')}" placeholder="Label / family" onblur="saveBillingConfig()">
        <input type="number" step="0.01" min="0" max="10" class="form-control aum-line-rate" value="${line.annual_rate ?? ''}" placeholder="Rate %" onblur="saveBillingConfig()">
        <input type="number" step="0.01" min="0" class="form-control aum-line-override" value="${line.override_monthly_fee ?? ''}" placeholder="Override/mo" onblur="saveBillingConfig()">
      </div>
    </div>`).join('');

    let html = `<div style="display:grid;grid-template-columns:minmax(260px,320px) minmax(520px,1fr);gap:1rem;align-items:flex-start;margin-bottom:1.5rem;">
      <div class="card" style="min-width:280px;flex:0 0 auto;">
        <div class="card-title">Stripe Configuration</div>
        <div style="margin-bottom:0.75rem;">
          <div style="font-size:0.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Accounts</div>
          ${(cfg.available_accounts||[]).map(a=>`<label style="display:flex;gap:.5rem;margin-bottom:.35rem;"><input type="checkbox" class="billing-account" value="${esc(a.name)}" ${accounts.includes(a.name)?'checked':''} onchange="saveBillingConfig()">${esc(a.label)}</label>`).join('') || '<a href="/workspace-setup">Connect your Stripe account</a>'}
        </div>
        <div style="margin-bottom:0.75rem;">
          <div style="font-size:0.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Lookup Emails</div>
          <div id="billing-emails-list">`;
    emails.forEach((e, i) => {
      html += `<div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.3rem;">
        <span style="flex:1;font-size:0.84rem;">${esc(e)}</span>
        <button class="btn btn-ghost btn-xs" onclick="removeBillingEmail(${i})" style="color:var(--muted);">✕</button>
      </div>`;
    });
    html += `</div>
          <div style="display:flex;gap:0.4rem;margin-top:0.5rem;">
            <input type="email" class="form-control" id="billing-email-input" placeholder="Add email…" style="flex:1;">
            <button class="btn btn-outline btn-sm" onclick="addBillingEmail()">Add</button>
          </div>
        </div>

      </div>
      <div class="card" style="min-width:0;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;margin-bottom:0.75rem;">
          <div class="card-title" style="margin:0;">IAS / AUM Billing</div>
          <button class="btn btn-outline btn-xs" onclick="addAumLine()">+ Add household</button>
        </div>
        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.84rem;margin-bottom:0.75rem;cursor:pointer;">
          <input type="checkbox" id="aum-enabled" ${cfg.aum_billing_enabled || aumLines.length ? 'checked' : ''} onchange="saveBillingConfig()">
          Bill from Blueleaf AUM
        </label>
        <div id="aum-lines-list">${aumLineRows || '<div style="font-size:0.82rem;color:var(--muted);padding:0.5rem 0;">No IAS/AUM billing households yet. Add one to calculate monthly billing from Blueleaf.</div>'}</div>
        ${aum.enabled ? (aum.configured ? `<div style="font-size:0.8rem;line-height:1.5;color:var(--muted);border-top:1px solid var(--border);padding-top:0.65rem;">
          <div><strong style="color:var(--text);">${money(aum.monthly_fee)}/mo total</strong> from ${money(aum.billable_aum)} billable AUM across ${esc(aum.line_count || 0)} household(s)</div>
        </div>` : `<div style="font-size:0.8rem;color:#ed8936;border-top:1px solid var(--border);padding-top:0.65rem;">${esc(aum.reason || 'IAS billing needs at least one configured Blueleaf household line.')}</div>`) : ''}
      </div>
      <div id="billing-summary" style="grid-column:1 / -1;min-width:0;">
        <div style="display:flex;justify-content:flex-end;margin-bottom:0.5rem;">
          <button class="btn btn-ghost btn-xs" onclick="loadBillingSummary(document.getElementById('billing-content'))">↻ Refresh</button>
        </div>`;

    if (!accounts.length || !emails.length) {
      html += `<div class="placeholder-section"><div class="ph-icon">💳</div>
        <div class="ph-title">Not Configured</div>
        <div class="ph-desc">Select at least one Stripe account and add a lookup email to see billing data.</div>
      </div>`;
    } else {
      html += `<div class="loading-state"><div class="loading-spinner"></div><div>Fetching from Stripe…</div></div>`;
    }

    html += `</div></div>`;
    el.innerHTML = html;

    // Wire Enter key on email input
    const inp = document.getElementById('billing-email-input');
    if (inp) inp.addEventListener('keydown', e => { if (e.key === 'Enter') addBillingEmail(); });
  }

  function addBillingEmail() {
    const inp = document.getElementById('billing-email-input');
    const val = inp.value.trim();
    if (!val || !val.includes('@')) { toast('Enter a valid email', 'error'); return; }
    if (!billingConfig.billing_emails) billingConfig.billing_emails = [];
    if (billingConfig.billing_emails.includes(val)) { toast('Already added', 'error'); return; }
    billingConfig.billing_emails.push(val);
    inp.value = '';
    saveBillingConfig();
  }

  function removeBillingEmail(idx) {
    billingConfig.billing_emails.splice(idx, 1);
    saveBillingConfig();
  }


  function addAumLine() {
    if (!billingConfig.aum_lines) billingConfig.aum_lines = [];
    billingConfig.aum_lines.push({ enabled:true, person_id:'', label:'', annual_rate:'1.00', min_monthly_fee:null, override_monthly_fee:null });
    billingConfig.aum_billing_enabled = true;
    renderBillingConfig(document.getElementById('billing-content'));
  }

  function removeAumLine(idx) {
    if (!billingConfig.aum_lines) billingConfig.aum_lines = [];
    billingConfig.aum_lines.splice(idx, 1);
    renderBillingConfig(document.getElementById('billing-content'));
    saveBillingConfig();
  }

  async function saveBillingConfig() {
    const accounts=Array.from(document.querySelectorAll('.billing-account:checked')).map(el=>el.value);
    billingConfig.billing_accounts = accounts;
    billingConfig.aum_billing_enabled = !!document.getElementById('aum-enabled')?.checked;
    const aumLines = Array.from(document.querySelectorAll('.aum-line-row')).map(row => ({
      enabled: !!row.querySelector('.aum-line-enabled')?.checked,
      person_id: row.querySelector('.aum-line-person')?.value || null,
      label: row.querySelector('.aum-line-label')?.value || '',
      annual_rate: row.querySelector('.aum-line-rate')?.value || null,
      min_monthly_fee: null,
      override_monthly_fee: row.querySelector('.aum-line-override')?.value || null,
    }));
    billingConfig.aum_lines = aumLines;
    try {
      const res = await apiFetch(`/api/billing/${relId}/config`, {
        method: 'PUT',
        body: JSON.stringify({
          billing_accounts: accounts,
          billing_emails: billingConfig.billing_emails || [],
          aum_billing_enabled: billingConfig.aum_billing_enabled,
          aum_lines: billingConfig.aum_lines || [],
        }),
      });
      if (!res.ok) throw new Error((await res.json()).error);
      billingConfig = await res.json();
      // Re-render config panel and fetch Stripe data if configured
      renderBillingConfig(document.getElementById('billing-content'));
      if ((billingConfig.billing_accounts.length && billingConfig.billing_emails.length) || billingConfig.aum_billing_enabled) {
        loadBillingSummary(document.getElementById('billing-content'));
      }
    } catch(e) { toast(e.message, 'error'); }
  }

  async function loadBillingSummary(containerEl) {
    // billing-summary div is injected by renderBillingConfig — wait a tick for DOM
    await new Promise(r => setTimeout(r, 50));
    const summaryEl = document.getElementById('billing-summary');
    if (!summaryEl) {
      console.warn('[billing] billing-summary not in DOM');
      return;
    }
    summaryEl.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Fetching from Stripe…</div></div>';
    try {
      const res = await apiFetch(`/api/billing/${relId}/summary`);
      const raw = await res.json();
      if (!res.ok) throw new Error(raw.error || 'Stripe request failed');
      if (!raw.configured) {
        summaryEl.innerHTML = '<div style="color:var(--muted);font-size:0.84rem;padding:0.5rem 0;">No Stripe data found for these emails.</div>';
        return;
      }
      renderBillingSummary(summaryEl, raw);
    } catch(e) {
      console.error('[billing] loadBillingSummary error:', e);
      summaryEl.innerHTML = `<div style="color:#f56565;font-size:0.84rem;padding:0.5rem 0;">⚠️ ${esc(e.message)}</div>`;
    }
  }

  function renderBillingSummary(el, data) {
    const statusColor = { active:'#3ecf8e', past_due:'#ed8936', canceled:'#f56565', trialing:'#63b3ed', unpaid:'#f56565', incomplete:'#8fa3b8' };
    const statusLabel = { active:'Active', past_due:'Past Due', canceled:'Canceled', trialing:'Trial', unpaid:'Unpaid', incomplete:'Incomplete' };

    let html = '';

    const aum = data.aum_summary || {};
    // MRR header
    if (data.total_mrr > 0) {
      const pastDueBadge = data.has_past_due ? `<span style="margin-left:0.75rem;padding:0.15rem 0.6rem;border-radius:20px;font-size:0.72rem;font-weight:700;background:rgba(237,137,54,0.15);color:#ed8936;border:1px solid rgba(237,137,54,0.3);">⚠️ Past Due</span>` : '';
      html += `<div style="background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.2);border-radius:10px;padding:0.85rem 1.1rem;margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;max-width:320px;">
        <div>
          <div style="font-size:0.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.1rem;">Total MRR</div>
          <div style="font-size:1.5rem;font-weight:800;color:var(--gold);">$${data.total_mrr.toFixed(2)}<span style="font-size:0.75rem;font-weight:500;color:var(--muted);">/mo</span></div>
        </div>
        <div>${pastDueBadge}</div>
      </div>`;
    }

    if (aum.enabled) {
      if (aum.configured) {
        const lineCards = (aum.lines || []).filter(l => l.configured).map(line => `<div class="card" style="margin-bottom:0;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:0.6rem;">
            <div>
              <div style="font-weight:800;font-size:0.9rem;">${esc(line.label || line.person_name || 'Blueleaf household')}</div>
              <div style="font-size:0.72rem;color:var(--muted);">Snapshot ${line.snapshot_date ? fmtDate(line.snapshot_date) : '—'} · ${line.included_account_count || 0} included account(s)</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:1rem;font-weight:900;color:var(--gold);">$${Number(line.monthly_fee || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}<span style="font-size:0.65rem;font-weight:500;color:var(--muted);">/mo</span></div>
              <div style="font-size:0.72rem;color:var(--muted);">${Number(line.annual_rate || 0).toFixed(2)}% annually</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;font-size:0.76rem;">
            <div><div style="color:var(--muted);">Billable AUM</div><strong>$${Number(line.billable_aum || 0).toLocaleString()}</strong></div>
            <div><div style="color:var(--muted);">Annual Fee</div><strong>$${Number(line.annual_fee || 0).toLocaleString()}</strong></div>
            <div><div style="color:var(--muted);">Hidden</div><strong>${line.hidden_account_count || 0}</strong></div>
          </div>
        </div>`).join('');
        html += `<div style="margin-bottom:0.6rem;font-size:0.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;">IAS / AUM Billing</div>
          <div style="background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.2);border-radius:10px;padding:0.85rem 1.1rem;margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;max-width:320px;">
            <div><div style="font-size:0.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;">IAS / AUM Total</div><div style="font-size:1.35rem;font-weight:900;color:var(--gold);">$${Number(aum.monthly_fee || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}<span style="font-size:0.72rem;font-weight:500;color:var(--muted);">/mo</span></div></div>
            <div style="font-size:0.8rem;color:var(--muted);text-align:right;">$${Number(aum.billable_aum || 0).toLocaleString()} billable AUM<br>${aum.line_count || 0} household(s)</div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,320px));gap:0.85rem;margin-bottom:1rem;justify-content:start;">${lineCards}</div>`;
      } else {
        html += `<div style="color:#ed8936;font-size:0.84rem;margin-bottom:1rem;">⚠️ IAS / AUM billing: ${esc(aum.reason || 'Not configured')}</div>`;
      }
    }

    data.accounts.forEach(account => {
      if (account.error) {
        html += `<div style="color:#f56565;font-size:0.84rem;margin-bottom:0.75rem;">⚠️ ${esc(account.label)}: ${esc(account.error)}</div>`;
        return;
      }
      // Filter out customers with no subscriptions and no invoices
      const validCustomers = (account.customers || []).filter(c => !c.error && (c.subscriptions?.length || c.invoices?.length));
      if (!validCustomers.length) return; // skip entire account section if nothing to show

      html += `<div style="margin-bottom:0.6rem;font-size:0.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;">${esc(account.label)}</div>`;
      html += `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:0.85rem;margin-bottom:1rem;">`;

      validCustomers.forEach(cust => {
        html += `<div class="card" style="margin-bottom:0;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.65rem;gap:0.5rem;">
            <div style="min-width:0;">
              <div style="font-weight:700;font-size:0.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(cust.name)}</div>
              <div style="font-size:0.72rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(cust.email)}</div>
            </div>
            ${cust.total_monthly > 0 ? `<div style="font-size:1rem;font-weight:800;color:var(--gold);flex-shrink:0;">$${cust.total_monthly.toFixed(0)}<span style="font-size:0.65rem;font-weight:500;color:var(--muted);">/mo</span></div>` : ''}
          </div>`;

        if (cust.subscriptions.length) {
          cust.subscriptions.forEach(sub => {
            const dot = statusColor[sub.status] || '#8fa3b8';
            const lbl = statusLabel[sub.status] || sub.status;
            const nextDate = sub.current_period_end ? new Date(sub.current_period_end * 1000).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '';
            html += `<div style="background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:7px;padding:0.5rem 0.7rem;margin-bottom:0.4rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.3rem;">
                <div style="display:flex;align-items:center;gap:0.4rem;">
                  <div style="width:7px;height:7px;border-radius:50%;background:${dot};flex-shrink:0;"></div>
                  <span style="font-size:0.75rem;font-weight:700;color:${dot};">${lbl}</span>
                </div>
                ${nextDate ? `<span style="font-size:0.68rem;color:var(--muted);">↻ ${nextDate}</span>` : ''}
              </div>`;
            sub.items.forEach(item => {
              html += `<div style="display:flex;justify-content:space-between;font-size:0.78rem;padding:0.1rem 0;">
                <span style="color:var(--muted);">${esc(item.description)}</span>
                <span style="font-variant-numeric:tabular-nums;">$${item.amount.toFixed(2)}/${item.interval}</span>
              </div>`;
            });
            html += `</div>`;
          });
        }

        if (cust.invoices.length) {
          html += `<div style="font-size:0.65rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin:0.4rem 0 0.25rem;">Invoices</div>`;
          html += `<table style="width:100%;border-collapse:collapse;">`;
          cust.invoices.forEach(inv => {
            const invDate = new Date(inv.created * 1000).toLocaleDateString('en-US',{month:'short',day:'numeric'});
            const paidBadge = inv.paid
              ? `<span style="font-size:0.62rem;font-weight:700;color:#3ecf8e;">✓</span>`
              : `<span style="font-size:0.62rem;font-weight:700;color:#ed8936;">!</span>`;
            html += `<tr style="border-top:1px solid rgba(255,255,255,0.04);">
              <td style="font-size:0.75rem;padding:0.2rem 0;color:var(--muted);">${invDate}</td>
              <td style="font-size:0.75rem;padding:0.2rem 0;text-align:right;font-variant-numeric:tabular-nums;">$${inv.amount_due.toFixed(2)}</td>
              <td style="padding:0.2rem 0 0.2rem 0.4rem;text-align:right;">${paidBadge}</td>
            </tr>`;
          });
          html += `</table>`;
        }

        html += `</div>`;
      });

      html += `</div>`;
    });

    el.innerHTML = html;
  }

  // ── Edit Modal ────────────────────────────────────────────────────
  function openEditModal() {
    if (!relData) return;
    document.getElementById('ef-name').value = relData.name || '';
    document.getElementById('ef-tier').value = relData.service_tier || '';
    document.getElementById('ef-billing').value = relData.billing_status || 'active';
    document.getElementById('edit-error').style.display = 'none';
    document.getElementById('edit-modal').classList.remove('hidden');
  }
  function closeModal() { document.getElementById('edit-modal').classList.add('hidden'); }
  document.getElementById('edit-modal').addEventListener('click', e => {
    if (e.target === document.getElementById('edit-modal')) closeModal();
  });

  async function submitEdit() {
    const name = document.getElementById('ef-name').value.trim();
    if (!name) {
      const errEl = document.getElementById('edit-error');
      errEl.textContent = 'Name is required.'; errEl.style.display = '';
      return;
    }
    const body = {
      name,
      service_tier: document.getElementById('ef-tier').value || null,
      billing_status: document.getElementById('ef-billing').value || null,
    };
    const btn = document.getElementById('ef-submit');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await apiFetch(`/api/relationships/${relId}`, { method: 'PUT', body: JSON.stringify(body) });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      const updated = await res.json();
      relData = { ...relData, ...updated };
      btn.textContent = '✓ Saved';
      setTimeout(() => { closeModal(); window.location.reload(); }, 600);
      // Re-render billing if active
      if (document.getElementById('tab-billing').classList.contains('active')) renderBilling();
    } catch(e) {
      const errEl = document.getElementById('edit-error');
      errEl.textContent = e.message; errEl.style.display = '';
      btn.disabled = false; btn.textContent = 'Save Changes';
    }
  }

  // ── Boot ──────────────────────────────────────────────────────────
  loadRelationship();
</script>

<%- include('partials/shell-close') %>
