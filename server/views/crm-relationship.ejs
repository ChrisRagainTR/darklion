    } else if (!snap.active_engagements || !snap.active_engagements.length) {
      engHtml = `<div style="color:var(--muted);font-size:0.78rem;">No active engagement letters.</div>`;
    } else {
      const seen = new Set();
      snap.active_engagements.filter(l => { if (seen.has(l.id)) return false; seen.add(l.id); return true; }).forEach(l => {
        const d = l.extracted_data;
        const svcPills = d && d.services ? [
          d.services.tax ? `<span class="badge badge-blue" style="font-size:0.62rem;">Tax</span>` : '',
          d.services.bookkeeping ? `<span class="badge badge-green" style="font-size:0.62rem;">Books</span>` : '',
          d.services.financial_planning ? `<span class="badge badge-gold" style="font-size:0.62rem;">FP</span>` : '',
        ].filter(Boolean).join(' ') : '<span style="font-size:0.72rem;color:var(--muted);">Extracting…</span>';
        const price = d && d.total_monthly
          ? `<div class="ov2-mrr" style="font-size:0.95rem;margin-top:0.25rem;">$${Number(d.total_monthly).toFixed(0)}<span>/mo</span></div>`
          : '';
        engHtml += `<div class="ov2-eng-card">
          <div style="font-size:0.82rem;font-weight:700;margin-bottom:0.25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(l.display_name || 'Engagement')}</div>
          <div style="display:flex;gap:0.25rem;flex-wrap:wrap;">${svcPills}</div>
          ${price}
        </div>`;
      });
    }

    document.getElementById('overview-dashboard').innerHTML = `
      <div class="ov-page">
        ${statusStrip}
        <div class="ov2-body">
          <div class="ov2-stack">
            <div class="ov-panel">
              <div class="ov-panel-title">
                <span>People</span>
                <span style="display:flex;align-items:center;gap:0.45rem;">
                  <span class="ov2-count-pill">${people.length}</span>
                  <a href="/crm/people?add=1" class="btn btn-ghost btn-xs">+ Add</a>
                </span>
              </div>
              <div class="ov2-note">Each person is a container — tax, organizer, pipeline, and portal live on the person page. Overview shows membership and light status only.</div>
              <div class="ov2-container-list">${peopleRows}</div>
            </div>
            <div class="ov-panel">
              <div class="ov-panel-title">
                <span>Companies</span>
                <span style="display:flex;align-items:center;gap:0.45rem;">
                  <span class="ov2-count-pill">${companies.length}</span>
                  <a href="/crm/companies?add=1" class="btn btn-ghost btn-xs">+ Add</a>
                </span>
              </div>
              <div class="ov2-note">Each company is a container — QBO, bookkeeping, business tax, and pipelines live on the company page.</div>
              <div class="ov2-container-list">${companyRows}</div>
            </div>
            <div class="ov-panel">
              <div class="ov-panel-title">
                <span>Recent household activity</span>
                <a href="#" onclick="switchTab('workflow', document.querySelectorAll('.tab-item')[2]);return false;" class="btn btn-ghost btn-xs">Workflow →</a>
              </div>
              <div class="ov2-note">Light feed only. Active pipeline cards stay on person/company pages and the Workflow tab.</div>
              ${activityBody}
            </div>
          </div>
          <aside class="ov2-rail">
            <div class="ov-panel" id="ov-billing-panel">
              <div class="ov-panel-title">
                <span>Billing</span>
                <a href="#" onclick="switchTab('billing', document.querySelectorAll('.tab-item')[4]);return false;" class="btn btn-ghost btn-xs">View →</a>
              </div>
              <div id="ov-billing-content"><div style="color:var(--muted);font-size:0.78rem;">${snap ? 'Loading billing…' : 'Loading…'}</div></div>
            </div>
            <div class="ov-panel">
              <div class="ov-panel-title">
                <span>Active engagement</span>
                <a href="#" onclick="switchTab('engagement', document.querySelectorAll('.tab-item')[1]);return false;" class="btn btn-ghost btn-xs">View all →</a>
              </div>
              ${engHtml}
            </div>
            <div class="ov-panel" id="team-panel">
              <div class="ov-panel-title">
                <span>Account team</span>
                <button class="btn btn-ghost btn-xs" onclick="document.getElementById('team-add-row').style.display='flex';document.getElementById('team-add-select').focus()">+ Team</button>
              </div>
              <div id="team-members-list"><div style="color:var(--muted);font-size:0.78rem;">Loading…</div></div>
              <div class="team-add-row" id="team-add-row" style="display:none;">
                <select class="team-add-select" id="team-add-select"><option value="">Select member…</option></select>
                <button class="team-add-btn" onclick="addTeamMember()">Add</button>
              </div>
