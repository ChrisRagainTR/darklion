<%- include('partials/shell-globals') %>

<script>
  const relId = location.pathname.split('/').pop();
  const token = (window.DLAuth ? window.DLAuth.token() : localStorage.getItem('dl_token'));
  if (!token) window.location.href = '/login';

  let relData = null;

  // ── Helpers ──────────────────────────────────────────────────────
  function tierBadge(tier) {
    const labels = { standard:'Standard', legacy_blueprint:'Legacy Blueprint', tax_only:'Tax Only', full_service:'Full Service' };
    const cls = { standard:'badge-muted', legacy_blueprint:'badge-gold', tax_only:'badge-blue', full_service:'badge-green' };
    if (!tier) return '';
    return `<span class="badge ${cls[tier]||'badge-muted'}">${labels[tier]||esc(tier)}</span>`;
  }
  function billingBadge(status) {
    const cls = { active:'badge-green', past_due:'badge-orange', cancelled:'badge-red', inactive:'badge-muted' };
    const lbl = { active:'Active', past_due:'Past Due', cancelled:'Cancelled', inactive:'Inactive' };
    if (!status) return '';
    return `<span class="badge ${cls[status]||'badge-muted'}">${lbl[status]||esc(status)}</span>`;
  }
  function filingLabel(s) {
    return { single:'Single', mfj:'MFJ', mfs:'MFS', hoh:'HOH', qw:'QW', married_joint:'MFJ', married_separate:'MFS', head_household:'HOH', widow:'QW' }[s] || (s||'');
  }
  function fmtPhone(p) {
    if (!p) return '';
    const d = p.replace(/\D/g,'');
    if (d.length === 10) return `(${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}`;
    if (d.length === 11 && d[0]==='1') return `(${d.slice(1,4)}) ${d.slice(4,7)}-${d.slice(7)}`;
    return p;
  }

  function fmtDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  // ── Tab switching ─────────────────────────────────────────────────
  function switchTab(name, el) {
    document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    if (el) el.classList.add('active');
    document.getElementById('tab-' + name).classList.add('active');
    if (name === 'notes' && relData) document.getElementById('notes-ta').value = relData.notes || '';
    if (name === 'engagement') loadEngagement();
    if (name === 'workflow') loadWorkflow();
    if (name === 'billing') renderBilling();
  }

  // ── Load relationship ─────────────────────────────────────────────
  async function loadRelationship() {
    try {
      const res = await apiFetch(`/api/relationships/${relId}`);
      if (!res.ok) { document.getElementById('entity-name').textContent = 'Not Found'; return; }
      relData = await res.json();
      renderHeader(relData);
      renderOverview(relData);
    } catch(e) {
      document.getElementById('entity-name').textContent = 'Error loading';
      console.error(e);
    }
  }

  // ── Header ────────────────────────────────────────────────────────
  function renderHeader(r, snap) {
    document.title = `${r.name || 'Relationship'} — DarkLion CRM`;
    document.getElementById('entity-name').textContent = r.name || 'Unnamed Relationship';
    if (window.addRecentClient) window.addRecentClient({ _type:'relationship', id: r.id, _label: r.name || 'Unnamed Relationship', _sub: 'Relationship' });
    let html = '';
    // Service pills from active engagement letter
    const activeLetter = snap && snap.active_engagements && snap.active_engagements[0];
    const svcs = activeLetter && activeLetter.extracted_data && activeLetter.extracted_data.services;
    if (svcs) {
      if (svcs.tax) html += `<span class="badge" style="background:rgba(99,179,237,0.18);color:#63b3ed;border:1px solid rgba(99,179,237,0.35);">Tax</span> `;
      if (svcs.bookkeeping) html += `<span class="badge" style="background:rgba(167,139,250,0.18);color:#a78bfa;border:1px solid rgba(167,139,250,0.35);">Bookkeeping</span> `;
      if (svcs.financial_planning) html += `<span class="badge" style="background:rgba(251,191,36,0.15);color:#fbbf24;border:1px solid rgba(251,191,36,0.3);">Financial Planning</span> `;
    } else {
      if (r.service_tier) html += tierBadge(r.service_tier) + ' ';
    }
    // MRR from Stripe billing sync (not engagement letter amount)
    const stripeMrr = r && r.mrr != null ? Number(r.mrr) : 0;
    if (Number.isFinite(stripeMrr) && stripeMrr > 0) {
      html += `<span class="badge" style="background:rgba(16,185,129,0.15);color:#10b981;border:1px solid rgba(16,185,129,0.35);">$${stripeMrr.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0})}/mo</span> `;
    }
    if (r.billing_status) {
      const bc = {active:'rgba(62,207,142,0.15)',past_due:'rgba(237,137,54,0.15)',cancelled:'rgba(245,101,101,0.15)',inactive:'rgba(143,163,184,0.12)'};
      const bt = {active:'#3ecf8e',past_due:'#ed8936',cancelled:'#f56565',inactive:'var(--muted)'};
      const bl = {active:'Active',past_due:'Past Due',cancelled:'Cancelled',inactive:'Inactive'};
      const s = r.billing_status;
      html += `<span class="badge" style="background:${bc[s]||bc.inactive};color:${bt[s]||bt.inactive};border:1px solid ${bt[s]||bt.inactive}40;">${bl[s]||s}</span> `;
    }
    if (r.created_at) html += `<span class="badge" style="background:rgba(148,163,184,0.1);color:var(--muted);border:1px solid rgba(148,163,184,0.2);">Since ${fmtDate(r.created_at)}</span>`;
    document.getElementById('entity-badges').innerHTML = html;
  }

  // ── Overview ──────────────────────────────────────────────────────
  function renderOverview(r) {
    renderDashboard(r, null);
    loadSnapshot(r);
  }

  async function loadSnapshot(r) {
    try {
      const res = await apiFetch(`/api/relationships/${relId}/snapshot`);
      if (!res.ok) throw new Error('snapshot failed');
      const snap = await res.json();
      renderHeader(r, snap);
      renderDashboard(r, snap);
    } catch(e) {
      renderDashboard(r, { tax_deliveries: [], threads: [], activity: [], error: true });
    }
  }

  function renderDashboard(r, snap) {
    const people = r.people || [];
    const companies = r.companies || [];
    const entityTypeLabels = { llc:'LLC', s_corp:'S-Corp', c_corp:'C-Corp', partnership:'Partnership', sole_prop:'Sole Prop', trust:'Trust', nonprofit:'Non-Profit', other:'Other' };

    const portalActive = people.filter(p => p.portal_enabled).length;
    const qboConnected = companies.filter(co => {
      if (typeof co.qbo_connected === 'boolean') return co.qbo_connected;
      const rid = co.realm_id || '';
      return rid && !String(rid).startsWith('import-') && !String(rid).startsWith('unconnected-');
    }).length;

    // Engagement rollup (relationship-level)
    let engCount = 0;
    let engSvcBits = [];
    if (snap && snap.active_engagements && snap.active_engagements.length) {
      const seen = new Set();
      const uniq = snap.active_engagements.filter(l => { if (seen.has(l.id)) return false; seen.add(l.id); return true; });
      engCount = uniq.length;
      const svc = { tax: false, bookkeeping: false, financial_planning: false };
      uniq.forEach(l => {
        const d = l.extracted_data;
        if (d && d.services) {
          if (d.services.tax) svc.tax = true;
          if (d.services.bookkeeping) svc.bookkeeping = true;
          if (d.services.financial_planning) svc.financial_planning = true;
        }
      });
      if (svc.tax) engSvcBits.push('Tax');
      if (svc.bookkeeping) engSvcBits.push('Books');
      if (svc.financial_planning) engSvcBits.push('FP');
    }

    // Stripe MRR from relationship when available; billing panel refines
    const stripeMrr = r && r.mrr != null ? Number(r.mrr) : null;
    const mrrDisplay = (Number.isFinite(stripeMrr) && stripeMrr > 0)
      ? `$${stripeMrr.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`
      : '—';

    // ── Status strip (relationship-level only — no pipeline next step) ──
    const statusStrip = `
      <section class="ov2-status">
        <div class="ov2-status-cell">
          <div class="ov2-status-label">Billing</div>
          <div class="ov2-status-value"><span class="ov2-mrr" id="ov2-status-mrr">${mrrDisplay}<span>${mrrDisplay === '—' ? '' : '/mo'}</span></span></div>
          <div class="ov2-status-sub" id="ov2-status-billing-sub">${snap ? 'Loading Stripe…' : 'Loading…'}</div>
        </div>
        <div class="ov2-status-cell">
          <div class="ov2-status-label">Engagement</div>
          <div class="ov2-status-value">${
            !snap ? '…'
            : engCount
              ? `<span class="badge badge-green">${engCount} active</span>`
              : `<span style="color:var(--muted);font-weight:600;">None active</span>`
          }</div>
          <div class="ov2-status-sub">${engSvcBits.length ? esc(engSvcBits.join(' · ')) : (snap ? 'No LOE on file' : 'Loading…')}</div>
        </div>
        <div class="ov2-status-cell">
          <div class="ov2-status-label">People</div>
          <div class="ov2-status-value">${people.length}</div>
          <div class="ov2-status-sub">${portalActive} portal active</div>
        </div>
        <div class="ov2-status-cell">
          <div class="ov2-status-label">Companies</div>
          <div class="ov2-status-value">${companies.length}</div>
          <div class="ov2-status-sub">${qboConnected} QBO connected</div>
        </div>
        <div class="ov2-status-actions">
          <button class="btn btn-gold btn-sm" onclick="switchTab('billing', document.querySelectorAll('.tab-item')[4])">View billing</button>
          <button class="btn btn-outline btn-sm" onclick="switchTab('engagement', document.querySelectorAll('.tab-item')[1])">Engagement</button>
        </div>
      </section>`;

    // ── People container ──
    let peopleRows = '';
    if (!people.length) {
      peopleRows = `<div style="color:var(--muted);font-size:0.82rem;padding:0.25rem 0;">No people yet. <a href="/crm/people?add=1" style="color:var(--gold);">+ Add</a></div>`;
    } else {
      people.forEach(p => {
        const initials = ((p.first_name||'').charAt(0)+(p.last_name||'').charAt(0)).toUpperCase() || '?';
        const chips = [];
        if (p.portal_enabled) chips.push(`<span class="badge badge-green" style="font-size:0.62rem;">Portal</span>`);
        else if (p.portal_invite_token) chips.push(`<span class="badge badge-orange" style="font-size:0.62rem;">Invite sent</span>`);
        if (p.filing_status) chips.push(`<span class="badge badge-blue" style="font-size:0.62rem;">${esc(filingLabel(p.filing_status))}</span>`);
        const metaBits = [p.email, fmtPhone(p.phone) || p.phone].filter(Boolean).map(esc);
        peopleRows += `<a class="ov2-member-row" href="/crm/person/${p.id}">
          <div class="ov2-av">${initials}</div>
          <div style="min-width:0;">
            <div class="ov2-member-name">${esc(formatPersonDisplayName(p))}</div>
            <div class="ov2-member-meta">${metaBits.join(' · ') || '—'}</div>
          </div>
          <div class="ov2-chip-row">${chips.join('') || '<span class="badge badge-muted" style="font-size:0.62rem;">Person</span>'}</div>
        </a>`;
      });
    }

    // ── Companies container ──
    let companyRows = '';
    if (!companies.length) {
      companyRows = `<div style="color:var(--muted);font-size:0.82rem;padding:0.25rem 0;">No companies yet. <a href="/crm/companies?add=1" style="color:var(--gold);">+ Add</a></div>`;
    } else {
      companies.forEach(co => {
        const name = co.company_name || co.name || 'Unknown';
        const initial = name.charAt(0).toUpperCase();
        const entityLabel = co.entity_type ? (entityTypeLabels[co.entity_type] || co.entity_type) : '';
        const rid = co.realm_id || '';
        const isImport = String(rid).startsWith('import-') || String(rid).startsWith('unconnected-');
        let qboChip = '';
        if (co.qbo_connected) qboChip = `<span class="badge badge-green" style="font-size:0.62rem;">QBO</span>`;
        else if (rid && !isImport) qboChip = `<span class="badge" style="font-size:0.62rem;background:rgba(229,62,62,0.12);color:var(--red);border:1px solid rgba(229,62,62,0.28);">Reconnect</span>`;
        else qboChip = `<span class="badge badge-muted" style="font-size:0.62rem;">No QBO</span>`;
        const entityChip = co.entity_type
          ? `<span class="badge badge-blue" style="font-size:0.62rem;">${esc(entityTypeLabels[co.entity_type] || co.entity_type)}</span>`
          : '';
        const svc = co.bookkeeping_service
          ? ({ bank_feed:'Bank Feed', accrual:'Accrual', client_prepared:'Client prepared', none:'None' })[co.bookkeeping_service] || co.bookkeeping_service
          : '';
        companyRows += `<a class="ov2-member-row" href="/crm/company/${co.id}">
          <div class="ov2-av sq">${esc(initial)}</div>
          <div style="min-width:0;">
            <div class="ov2-member-name">${esc(name)}</div>
            <div class="ov2-member-meta">${[entityLabel, svc].filter(Boolean).map(esc).join(' · ') || 'Company'}</div>
          </div>
          <div class="ov2-chip-row">${entityChip}${qboChip}</div>
        </a>`;
      });
    }

    // ── Light household activity (not pipeline hero) ──
    let activityBody = '';
    if (!snap) {
      activityBody = `<div style="color:var(--muted);font-size:0.78rem;">Loading…</div>`;
