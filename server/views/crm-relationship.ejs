      // Fall back to recent threads if no activity feed
      if (snap.threads && snap.threads.length) {
        activityBody = snap.threads.slice(0, 5).map(t => {
          const when = t.last_message_at ? timeAgo(t.last_message_at) : '';
          return `<div class="ov2-work-row">
