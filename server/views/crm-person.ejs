          ${organizerProfileFormRow('Phone','org-prof-spouse-phone',s.phone)}
          ${organizerProfileFormRow('Occupation','org-prof-spouse-occupation',s.occupation)}
        </div>
      </div>
    </div>
    <div style="border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem;margin-top:1rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;"><div style="color:var(--gold);font-weight:700;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.05em;">Dependents</div><button class="btn btn-outline btn-sm" onclick="addAdvisorDependentRow()">+ Add Dependent</button></div>
      <div id="advisor-dependent-rows">${deps.map(renderAdvisorDependentRow).join('')}</div>
    </div>
    <div id="org-profile-save-msg" style="font-size:0.8rem;color:var(--muted);margin-top:0.75rem;"></div>`;
  }

  function renderAdvisorDependentRow(dep = {}) {
    const rowId = `dep-${Date.now()}-${Math.random().toString(36).slice(2,7)}`;
    return `<div class="advisor-dependent-row" data-row-id="${rowId}" data-dependent-id="${Number.isSafeInteger(Number(dep.id)) && Number(dep.id) > 0 ? Number(dep.id) : ''}" style="display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr auto;gap:0.6rem;align-items:end;margin-bottom:0.65rem;">
      ${organizerProfileFormRow('Full Name','',dep.full_name || dep.name || '').replace('id=""', 'data-field="full_name"')}
      ${organizerProfileFormRow('Relationship','',dep.relationship || '').replace('id=""', 'data-field="relationship"')}
      ${organizerProfileFormRow('DOB','',dep.date_of_birth || dep.dob || '').replace('id=""', 'data-field="date_of_birth"')}
      ${organizerProfileFormRow('School / Childcare','',dep.school_childcare || dep.school || '').replace('id=""', 'data-field="school_childcare"')}
      <button class="btn btn-outline btn-sm" style="margin-bottom:0.05rem;" onclick="removeAdvisorDependentRow(this)">Remove</button>
    </div>`;
  }

  function addAdvisorDependentRow() {
    const rows = document.getElementById('advisor-dependent-rows');
    if (rows) rows.insertAdjacentHTML('beforeend', renderAdvisorDependentRow({}));
  }

  function removeAdvisorDependentRow(button) {
    const row = button.closest('.advisor-dependent-row');
    if (!row) return;
    if (row.dataset.dependentId) advisorDeletedDependentIds.add(Number(row.dataset.dependentId));
    row.remove();
  }

  function advisorProfileVal(id) { return document.getElementById(id)?.value?.trim() || ''; }

  function collectAdvisorOrganizerProfile() {
    const dependents = Array.from(document.querySelectorAll('.advisor-dependent-row')).map(row => ({
      ...(row.dataset.dependentId ? { id: Number(row.dataset.dependentId) } : {}),
      full_name: row.querySelector('[data-field="full_name"]')?.value?.trim() || '',
      relationship: row.querySelector('[data-field="relationship"]')?.value?.trim() || '',
      date_of_birth: row.querySelector('[data-field="date_of_birth"]')?.value?.trim() || '',
      school_childcare: row.querySelector('[data-field="school_childcare"]')?.value?.trim() || '',
    })).filter(d => d.full_name);
    return {
      taxpayer: {
        first_name: advisorProfileVal('org-prof-first'), last_name: advisorProfileVal('org-prof-last'), email: advisorProfileVal('org-prof-email'), phone: advisorProfileVal('org-prof-phone'), occupation: advisorProfileVal('org-prof-occupation'), filing_status: advisorProfileVal('org-prof-filing'), address_line1: advisorProfileVal('org-prof-address1'), address_line2: advisorProfileVal('org-prof-address2'), city: advisorProfileVal('org-prof-city'), state: advisorProfileVal('org-prof-state'), zip: advisorProfileVal('org-prof-zip')
      },
      spouse: {
        first_name: advisorProfileVal('org-prof-spouse-first'), last_name: advisorProfileVal('org-prof-spouse-last'), email: advisorProfileVal('org-prof-spouse-email'), phone: advisorProfileVal('org-prof-spouse-phone'), occupation: advisorProfileVal('org-prof-spouse-occupation')
      },
      dependents,
      deletedDependentIds: Array.from(advisorDeletedDependentIds),
    };
  }

  async function saveOrganizerProfileFromAdvisor() {
    const btn = document.getElementById('org-profile-save-btn');
    const msg = document.getElementById('org-profile-save-msg');
    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
    try {
      const res = await apiFetch(`/api/organizers/${personId}/profile`, { method: 'PUT', body: JSON.stringify({ profile: collectAdvisorOrganizerProfile(), expected_revision: window.organizerProfile?.profile_revision }) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save profile');
      window.organizerProfile = data.profile;
      if (msg) { msg.style.color = 'var(--green)'; msg.textContent = '✓ Saved'; }
      loadOrganizersTab();
    } catch(e) {
      if (msg) { msg.style.color = 'var(--red)'; msg.textContent = 'Failed to save: ' + e.message; }
      if (btn) { btn.disabled = false; btn.textContent = 'Save Profile'; }
    }
  }

  function renderOrgCard(org) {
    const statusColors = { pending:'var(--muted)', in_progress:'var(--gold)', submitted:'var(--green)', reviewed:'var(--green)', closed:'var(--muted)', reopened:'#f5a623' };
    const statusLabels = { pending:'Not Started', in_progress:'In Progress', submitted:'Submitted', reviewed:'Reviewed', closed:'Closed', reopened:'Reopened' };
    const color = statusColors[org.status] || 'var(--muted)';
    const label = statusLabels[org.status] || org.status;
    const submittedDate = org.submitted_at ? new Date(org.submitted_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : null;
    const closedDate = org.closed_at ? new Date(org.closed_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : null;

    let actionBtns = `<label style="cursor:pointer;" title="Re-upload Drake organizer"><input type="file" accept=".pdf" style="display:none;" onchange="uploadOrganizerFile(this,${personId},'${esc(org.tax_year)}')"><span class="btn btn-outline btn-sm" style="font-size:0.72rem;">↻ Re-parse</span></label>`;
    if (['closed','reviewed','reopened'].includes(org.status)) {
      actionBtns += `<button class="btn btn-outline btn-sm" onclick="reopenOrganizer('${esc(org.tax_year)}')">🔄 Request More Docs</button>`;
    }

    // Item list — reuse existing renderAdvisorOrganizer logic but inline here
    const items = org.items || [];
    const actionable = items.filter(i => !i.sentinel_provides);
    const uploaded = actionable.filter(i => i.status === 'uploaded').length;
    const nty = actionable.filter(i => i.status === 'not_this_year').length;
    const pending = actionable.filter(i => i.status === 'pending').length;
    const sentinel = items.filter(i => i.sentinel_provides).length;
    const total = actionable.length;
    const pct = total ? Math.round(((uploaded + nty) / total) * 100) : 0;
    const isSubmitted = ['submitted','reviewed','closed'].includes(org.status);

    const FULL_SECTION_LABELS = {
      'w2':'W-2','1099-r':'1099-R','1099-div':'1099-DIV','1099-int':'1099-INT',
      'k1':'K-1','schedule-c':'Sch C','1098':'1098','childcare':'Childcare',
      '1099-nec':'1099-NEC','1099-misc':'1099-MISC','1099-g':'1099-G','other':'Other'
    };
    const leftSecs = ['w2','1099-r','1099-div','1099-int','1099-nec','1099-misc','1099-g'];
    const rightSecs = ['k1','schedule-c','1098','childcare','questionnaire','other'];
    const bySection = {};
    for (const item of items) { if (!bySection[item.section]) bySection[item.section] = []; bySection[item.section].push(item); }

    function buildSectionHtml(sec) {
      const secItems = bySection[sec]; if (!secItems) return '';
      const rows = secItems.map(item => {
        const icon = item.sentinel_provides ? '🏢' : item.status === 'uploaded' ? '✓' : item.status === 'not_this_year' ? '–' : '○';
        const icolor = item.sentinel_provides ? 'var(--gold)' : item.status === 'uploaded' ? 'var(--green)' : item.status === 'not_this_year' ? 'var(--muted)' : 'rgba(255,255,255,0.2)';
        const badge = item.sentinel_provides ? `<span style="font-size:0.65rem;color:var(--gold);background:rgba(201,168,76,0.1);padding:0.1rem 0.45rem;border-radius:3px;border:1px solid rgba(201,168,76,0.25);">Firm</span>`
          : item.status === 'uploaded' ? `<span style="font-size:0.65rem;color:var(--green);">Uploaded</span>`
          : item.status === 'not_this_year' ? `<span style="font-size:0.65rem;color:var(--muted);">Not This Year</span>`
          : `<span style="font-size:0.65rem;color:rgba(255,255,255,0.25);">Pending</span>`;
        const acct = item.account_number ? ` <span style="color:var(--muted);font-size:0.72rem;">(···${item.account_number.replace(/\*/g,'').slice(-4)})</span>` : '';
        const sentinelBtn = `<button onclick="toggleAdvItemSentinel(${item.id},'${esc(org.tax_year)}',${item.sentinel_provides ? 'false' : 'true'})" title="${item.sentinel_provides ? 'Mark as client-provided instead' : 'Mark as provided by the firm'}" style="background:${item.sentinel_provides ? 'rgba(201,168,76,0.14)' : 'none'};border:1px solid ${item.sentinel_provides ? 'rgba(201,168,76,0.35)' : 'rgba(255,255,255,0.12)'};cursor:pointer;color:${item.sentinel_provides ? 'var(--gold)' : 'var(--muted)'};font-size:0.68rem;font-weight:700;padding:0.13rem 0.38rem;border-radius:4px;flex-shrink:0;">Firm</button>`;
        const uploadBtn = `<label title="Upload this item from the office" style="border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:0.13rem 0.38rem;color:var(--muted);font-size:0.68rem;font-weight:700;cursor:pointer;flex-shrink:0;"><input type="file" accept=".pdf,image/jpeg,image/png,image/heic,image/heif" style="display:none;" onchange="uploadAdvItemFile(this,${item.id},'${esc(org.tax_year)}')">${item.status === 'uploaded' ? 'Replace' : 'Upload'}</label>`;
        return `<div id="adv-item-${item.id}" style="display:flex;align-items:center;gap:0.4rem;padding:0.35rem 0.4rem;border-radius:6px;min-width:0;" onmouseenter="this.style.background='rgba(255,255,255,0.03)'" onmouseleave="this.style.background=''">
          <span style="color:${icolor};font-size:0.8rem;width:14px;text-align:center;flex-shrink:0;">${icon}</span>
          <span style="flex:1 1 auto;min-width:0;font-size:0.83rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(item.payer_name)}${acct}</span>
          <span style="display:inline-flex;align-items:center;gap:0.25rem;flex-shrink:0;">${badge}${sentinelBtn}${uploadBtn}</span>
          <button class="adv-item-del" onclick="deleteAdvItem(${item.id},'${esc(org.tax_year)}')" title="Remove item" style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:0.8rem;padding:0.1rem 0.25rem;border-radius:3px;flex-shrink:0;" onmouseenter="this.style.color='var(--red)'" onmouseleave="this.style.color='var(--muted)'">🗑</button>
        </div>`;
      }).join('');
      return `<div style="margin-bottom:1rem;">
        <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:rgba(201,168,76,0.7);margin-bottom:0.35rem;padding-bottom:0.3rem;border-bottom:1px solid rgba(255,255,255,0.06);">${FULL_SECTION_LABELS[sec]||sec}</div>
        ${rows}
      </div>`;
    }

    const answers = org.question_answers || {};
    const displayQuestions = (org.question_config || window.organizerQuestions || []).map(q => ({ key: q.id, label: `${q.id.toUpperCase()}. ${q.text}`, custom: false, isV2: true }));
    const hasAnswers = Object.values(answers || {}).some(v => (v && typeof v === 'object' && (typeof v.answer === 'boolean' || v.details)) || typeof v === 'boolean');

    const answersHtml = `<div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.06);">
      <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:0.75rem;">
        Client Questionnaire ${hasAnswers ? '' : '<span style="color:rgba(255,255,255,0.2);font-weight:400;letter-spacing:0;">— Not yet answered</span>'}
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem;">
        ${displayQuestions.map(q => {
          const val = answers[q.key] || {};
          const isTextOnly = q.key === 'q17';
          const answered = isTextOnly ? !!val.details : typeof val.answer === 'boolean';
          const isYes = val.answer === true;
          const yesStyle = answered && isYes
            ? 'background:rgba(62,207,142,0.15);border-color:var(--green);color:var(--green);'
            : 'background:rgba(255,255,255,0.04);border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.2);';
          const noStyle = answered && val.answer === false
            ? 'background:rgba(143,163,184,0.12);border-color:var(--muted);color:var(--text);'
            : 'background:rgba(255,255,255,0.04);border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.2);';
          const detail = val.details ? `<div style="font-size:0.75rem;color:var(--muted);margin-top:0.2rem;">“${esc(val.details)}”</div>` : '';
          return `<div style="display:flex;align-items:flex-start;gap:0.75rem;padding:0.35rem 0;">
            <div style="display:flex;gap:0.3rem;flex-shrink:0;">
              ${isTextOnly ? '<span style="font-size:0.72rem;font-weight:700;padding:0.15rem 0.55rem;border-radius:4px;border:1px solid rgba(255,255,255,0.1);color:var(--muted);">Text</span>' : `<span style="font-size:0.72rem;font-weight:700;padding:0.15rem 0.55rem;border-radius:4px;border:1px solid;${yesStyle}">Yes</span><span style="font-size:0.72rem;font-weight:700;padding:0.15rem 0.55rem;border-radius:4px;border:1px solid;${noStyle}">No</span>`}
            </div>
            <div style="font-size:0.82rem;color:${answered ? 'var(--text)' : 'rgba(255,255,255,0.35)'};">${esc(q.label)}${detail}</div>
          </div>`;
        }).join('')}
      </div>
    </div>`;

    return `<div style="background:var(--card);border:1px solid ${isSubmitted?'rgba(62,207,142,0.25)':'var(--border)'};border-radius:12px;padding:1.5rem;margin-bottom:1rem;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
        <div>
          <div style="font-weight:700;font-size:0.95rem;margin-bottom:0.2rem;">📋 ${esc(org.tax_year)} Tax Organizer</div>
          <div style="font-size:0.78rem;color:${color};font-weight:600;">${label}${org.submitted_at ? ` · ${new Date(org.submitted_at).toLocaleDateString('en-US',{month:'short',day:'numeric'})}` : ''}</div>
        </div>
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <div style="display:flex;gap:1.25rem;font-size:0.78rem;text-align:center;">
            <div><div style="font-size:1rem;font-weight:700;color:var(--green);">${uploaded}</div><div style="color:var(--muted);">Uploaded</div></div>
            <div><div style="font-size:1rem;font-weight:700;color:var(--muted);">${nty}</div><div style="color:var(--muted);">Not This Year</div></div>
            <div><div style="font-size:1rem;font-weight:700;color:${pending?'var(--orange)':'var(--muted)'};">${pending}</div><div style="color:var(--muted);">Pending</div></div>
            ${sentinel ? `<div><div style="font-size:1rem;font-weight:700;color:var(--gold);">${sentinel}</div><div style="color:var(--muted);">Firm</div></div>` : ''}
          </div>
          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">${actionBtns}</div>
        </div>
      </div>
      ${org.reopen_note ? `<div style="background:rgba(245,166,35,0.08);border:1px solid rgba(245,166,35,0.3);border-radius:8px;padding:0.5rem 0.75rem;font-size:0.8rem;color:var(--text);margin-bottom:1rem;">⚠️ Reopen note: "${esc(org.reopen_note)}"</div>` : ''}
      <div style="height:5px;background:rgba(255,255,255,0.07);border-radius:3px;overflow:hidden;margin-bottom:1.5rem;">
        <div style="height:100%;width:${pct}%;background:var(--green);border-radius:3px;"></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(430px,100%),1fr));gap:0 1.25rem;align-items:start;">
        <div style="min-width:0;">${leftSecs.map(buildSectionHtml).join('')}</div>
        <div style="min-width:0;">${rightSecs.map(buildSectionHtml).join('')}</div>
      </div>
      ${answersHtml}
      ${isSubmitted && org.workpaper_document_id ? `
        <div style="margin-top:1rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;gap:0.75rem;">
          <span style="font-size:0.78rem;color:var(--muted);">Workpaper:</span>
          <a href="/api/documents/${org.workpaper_document_id}/url" target="_blank" class="btn btn-outline btn-sm" style="font-size:0.75rem;">⬇ Download Workpaper PDF</a>
        </div>` : ''}
      <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.06);">
        <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:0.75rem;">Add Document Request</div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:flex-end;">
          <div style="flex:2;min-width:180px;"><input type="text" id="adv-add-payer" placeholder="Payer / document name" class="form-control" style="font-size:0.83rem;"></div>
          <div style="flex:1;min-width:130px;"><select id="adv-add-section" class="form-control" style="font-size:0.83rem;">
            <option value="w2">W-2</option><option value="1099-r">1099-R</option><option value="1099-div">1099-DIV</option>
            <option value="1099-int">1099-INT</option><option value="1099-nec">1099-NEC</option><option value="1099-misc">1099-MISC</option>
            <option value="k1" selected>K-1</option><option value="schedule-c">Schedule C</option>
            <option value="1098">1098</option><option value="childcare">Childcare</option><option value="questionnaire">Questionnaire</option><option value="other">Other</option>
          </select></div>
          <div style="flex:1;min-width:110px;"><select id="adv-add-owner" class="form-control" style="font-size:0.83rem;">
            <option value="taxpayer">Taxpayer</option><option value="spouse">Spouse</option><option value="joint">Joint</option>
          </select></div>
          <button class="btn btn-gold btn-sm" onclick="addAdvItem(${org.id},'${esc(org.tax_year)}')" style="font-size:0.82rem;white-space:nowrap;">+ Add</button>
        </div>
      </div>
      <div style="margin-top:0.75rem;">
        <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:0.75rem;">Add Custom Question</div>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <input type="text" id="adv-add-question" placeholder="e.g. Did you receive an inheritance this year?" class="form-control" style="font-size:0.83rem;flex:1;">
          <button class="btn btn-gold btn-sm" onclick="addAdvQuestion(${org.id},'${esc(org.tax_year)}')" style="font-size:0.82rem;white-space:nowrap;">+ Add</button>
        </div>
        <div id="adv-custom-questions-list" style="margin-top:0.5rem;">
          ${(org.custom_questions || []).map((q, i) => `
            <div style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0.5rem;background:rgba(255,255,255,0.03);border-radius:5px;margin-top:0.25rem;font-size:0.82rem;">
              <span style="flex:1;color:var(--text);">❓ ${esc(q.label)}</span>
              <button onclick="removeAdvQuestion(${org.id},'${esc(org.tax_year)}',${i})" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.75rem;padding:0.1rem 0.3rem;" title="Remove">✕</button>
            </div>
          `).join('')}
        </div>
      </div>
    </div>`;
  }

  async function reopenOrganizer(year) {
    const note = prompt(`Optional: add a note for the client about what's needed (${year} organizer):`);
    if (note === null) return; // cancelled
    try {
      const res = await apiFetch(`/api/organizers/${personId}/${year}/reopen`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ note: note || '' }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      loadOrganizersTab();
    } catch(err) { alert('Error: ' + err.message); }
  }

  async function closeOrganizer(year) {
    if (!confirm(`Close the ${year} tax season for this client? They won't see the organizer as active anymore.`)) return;
    try {
      const res = await apiFetch(`/api/organizers/${personId}/${year}/close`, { method: 'POST' });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      loadOrganizersTab();
    } catch(err) { alert('Error: ' + err.message); }
  }

  async function uploadOrganizerFile(input, pid, year) {
    if (!input.files.length) return;
    const wrap = document.getElementById('adv-organizer-wrap');
    wrap.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;padding:0.75rem 0;">⏳ Parsing organizer…</div>';
    const fd = new FormData();
    fd.append('file', input.files[0]);
    fd.append('year', year);
    try {
      const res = await fetch(`/api/organizers/upload/${pid}`, {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + ((window.DLAuth ? window.DLAuth.token() : localStorage.getItem('dl_token')) || '') },
        body: fd,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      // Reload
      loadAdvisorOrganizer();
    } catch(e) {
      wrap.innerHTML = `<div style="color:var(--red);font-size:0.85rem;padding:0.75rem 0;">❌ ${esc(e.message)}</div>`;
    }
  }


  async function deleteAdvItem(itemId, year) {
    const el = document.getElementById('adv-item-' + itemId);
    if (!el) return;
    // Double-tap confirm pattern
    if (el.dataset.confirmDelete) {
      el.style.opacity = '0.4';
      try {
        const res = await apiFetch(`/api/organizers/${personId}/${year}/items/${itemId}`, { method: 'DELETE' });
        if (!res.ok) { const d = await res.json(); throw new Error(d.error); }
        el.remove();
      } catch(e) { el.style.opacity = '1'; alert('Error: ' + e.message); }
    } else {
      el.dataset.confirmDelete = '1';
      const btn = el.querySelector('.adv-item-del');
      if (btn) { btn.style.opacity = '1'; btn.textContent = '✕ confirm'; btn.style.color = 'var(--red)'; }
      setTimeout(() => {
        delete el.dataset.confirmDelete;
        if (btn) { btn.textContent = '🗑'; btn.style.color = 'var(--muted)'; btn.style.opacity = '0'; }
      }, 3000);
    }
  }

