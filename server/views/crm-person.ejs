<%- include('partials/shell-globals') %>

<script src="/js/client-doc-picker.js"></script>
<script>
  const personId = location.pathname.split('/').pop();
  const token = (window.DLAuth ? window.DLAuth.token() : localStorage.getItem('dl_token'));
  if (!token) window.location.href = '/login';

  let personData = null;
  let relationshipMoveOptions = null;

  function authHeaders() { return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token }; }
  async function apiFetch(url, opts = {}) {
    const isFormData = opts.body instanceof FormData;
    const headers = isFormData
      ? { 'Authorization': 'Bearer ' + token, ...(opts.headers||{}) }
      : { ...authHeaders(), ...(opts.headers||{}) };
    const res = await fetch(url, { ...opts, headers });
    if (res.status === 401) window.location.href = '/login';
    return res;
  }
  function esc(s) { if (s == null) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  // Format phone as 239.297.2988 and wrap in tel: link
  function fmtPhone(raw) {
    if (!raw) return '—';
    const digits = raw.replace(/\D/g, '');
    let formatted = raw; // fallback to raw if can't parse
    if (digits.length === 10) {
      formatted = `${digits.slice(0,3)}.${digits.slice(3,6)}.${digits.slice(6)}`;
    } else if (digits.length === 11 && digits[0] === '1') {
      formatted = `${digits.slice(1,4)}.${digits.slice(4,7)}.${digits.slice(7)}`;
    }
    return `<a href="tel:${formatted}" style="color:var(--gold);text-decoration:none;">${esc(formatted)}</a>`;
  }

  // Format date_of_birth as mm/dd/yyyy
  function fmtDOB(raw) {
    if (!raw) return '—';
    // raw may be ISO date string like "1955-04-12" or "1955-04-12T00:00:00.000Z"
    const d = new Date(raw);
    if (isNaN(d)) return esc(raw);
    // Use UTC parts to avoid timezone shift
    const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
    const dd = String(d.getUTCDate()).padStart(2, '0');
    const yyyy = d.getUTCFullYear();
    return `${mm}/${dd}/${yyyy}`;
  }
  function toast(msg, type) {
    if (typeof window._shellToast === 'function') {
      window._shellToast(msg, type === 'error' ? 'error' : undefined);
    }
  }

  async function loadRelationshipMoveOptions() {
    if (relationshipMoveOptions) return relationshipMoveOptions;
    const res = await apiFetch('/api/relationships');
    if (!res.ok) throw new Error('Could not load relationships');
    relationshipMoveOptions = await res.json();
    return relationshipMoveOptions;
  }

  async function openMoveRelationshipModal() {
    if (!personData) return;
    const modal = document.getElementById('move-relationship-modal');
    const select = document.getElementById('move-relationship-select');
    const error = document.getElementById('move-relationship-error');
    const btn = document.getElementById('move-relationship-submit');
    error.style.display = 'none';
    btn.disabled = false;
    btn.textContent = 'Move';
    select.innerHTML = '<option value="">Loading...</option>';
    document.getElementById('move-sync-access').checked = true;
    modal.classList.remove('hidden');
    try {
      const relationships = await loadRelationshipMoveOptions();
      const currentId = String(personData.relationship_id || '');
      const options = relationships.filter(r => String(r.id) !== currentId);
      select.innerHTML = options.length
        ? '<option value="">Choose relationship...</option>' + options.map(r => `<option value="${r.id}">${esc(r.name || ('Relationship #' + r.id))}</option>`).join('')
        : '<option value="">No other relationships available</option>';
    } catch(e) {
      select.innerHTML = '<option value="">Could not load relationships</option>';
      error.textContent = e.message || 'Could not load relationships';
      error.style.display = '';
    }
  }

  function closeMoveRelationshipModal() {
    document.getElementById('move-relationship-modal').classList.add('hidden');
  }

  async function submitMoveRelationship() {
    if (!personData) return;
    const select = document.getElementById('move-relationship-select');
    const relationshipId = parseInt(select.value, 10);
    const error = document.getElementById('move-relationship-error');
    const btn = document.getElementById('move-relationship-submit');
    error.style.display = 'none';
    if (!relationshipId) {
      error.textContent = 'Choose a relationship.';
      error.style.display = '';
      return;
    }
    const targetName = select.options[select.selectedIndex]?.textContent || 'the selected relationship';
    const message = `Move ${formatPersonDisplayName(personData) || 'this person'} to ${targetName}?`;
    if (window.dlConfirm && !await window.dlConfirm(message, { title: 'Move Person', confirmLabel: 'Move' })) return;
    btn.disabled = true;
    btn.textContent = 'Moving...';
    try {
      const res = await apiFetch(`/api/people/${personId}/move-relationship`, {
        method: 'POST',
        body: JSON.stringify({
          relationship_id: relationshipId,
          sync_company_access: document.getElementById('move-sync-access').checked,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to move person');
      if (data.person) {
        personData = data.person;
        renderHeader(personData);
        renderOverview(personData);
      } else {
        await loadPerson();
      }
      closeMoveRelationshipModal();
      toast(data.moved === false ? 'Person already in that relationship' : 'Person moved');
    } catch(e) {
      error.textContent = e.message || 'Failed to move person';
      error.style.display = '';
      btn.disabled = false;
      btn.textContent = 'Move';
    }
  }

  function switchTab(name, el) {
    try {
    document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => { t.classList.remove('active'); t.style.display = ''; });
    if (!el) {
      el = Array.from(document.querySelectorAll('.tab-item')).find(t =>
        (t.getAttribute('onclick') || '').includes(`'${name}'`) ||
        (t.getAttribute('onclick') || '').includes(`"${name}"`)
      ) || null;
    }
    if (el) el.classList.add('active');
    const tc = document.getElementById('tab-' + name);
    if (tc) tc.classList.add('active');
    // Hide main scrollbar on comm tab, restore on others
    const mainEl = document.querySelector('.main');
    if (mainEl) mainEl.style.overflowY = (name === 'communication') ? 'hidden' : 'auto';
    if (name === 'docs') loadDocs();
    if (name === 'tax') loadTax(true);
    if (name === 'communication') initComm(personData?.id || personId);
    if (name === 'organizers') {
      const urlInput = document.getElementById('stanford-url-input');
      if (urlInput && personData) urlInput.value = personData.stanford_tax_url || '';
      const orgLinkEl = document.getElementById('org-stanford-link');
      if (orgLinkEl) {
        if (personData && personData.stanford_tax_url) {
          orgLinkEl.innerHTML = `<a href="${esc(personData.stanford_tax_url)}" target="_blank" rel="noopener" class="btn btn-gold btn-sm">🔗 Open Stanford Tax Organizer →</a>`;
        } else {
          orgLinkEl.innerHTML = '';
        }
      }
      loadOrganizersTab();
    }
    if (name === 'notes') {
      const notesEl = document.getElementById('notes-ta-full');
      if (notesEl) notesEl.value = (personData && personData.notes) || '';
    }
    if (name === 'workflow') loadWorkflow();
    if (name === 'investments') loadInvestmentsTab();
    } catch(e) { console.error('switchTab error:', e); }
  }
  window.switchTab = switchTab;

  async function loadWorkflow() {
    const loading = document.getElementById('workflow-loading');
    const list = document.getElementById('workflow-list');
    loading.style.display = ''; list.style.display = 'none';
    try {
      const res = await apiFetch(`/api/pipelines/entity-jobs?entity_type=person&entity_id=${personId}`);
      const jobs = await res.json();
      loading.style.display = 'none'; list.style.display = '';
      if (!jobs.length) {
        list.innerHTML = `<div style="text-align:center;padding:2.5rem 1rem;color:var(--muted);">
          <div style="font-size:2rem;margin-bottom:0.75rem;">📋</div>
          <div style="font-weight:600;font-size:0.95rem;margin-bottom:0.4rem;color:var(--text);">No active pipelines</div>
          <div style="font-size:0.84rem;">Workflows will appear here once this client is added to a pipeline.</div>
        </div>`;
        return;
      }
      list.innerHTML = jobs.map(j => renderJobCard(j)).join('');
    } catch(e) { loading.textContent = 'Failed to load pipelines: ' + e.message; }

    // Load pipeline history
    loadPipelineHistory();
  }

  async function loadPipelineHistory() {
    const loading = document.getElementById('pipeline-history-loading');
    const list = document.getElementById('pipeline-history-list');
    if (!loading || !list) return;
    loading.style.display = ''; list.style.display = 'none';
    try {
      const res = await apiFetch(`/api/pipelines/completions?entity_type=person&entity_id=${personId}`);
      if (!res.ok) throw new Error('API error');
      const data = await res.json();
      const completions = data.completions || [];
      const activeJobs = data.active_jobs || [];
      loading.style.display = 'none'; list.style.display = '';
      if (!completions.length && !activeJobs.length) {
        list.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;">No pipeline history yet.</div>';
        return;
      }
      const rows = [];
      completions.forEach(c => {
        const yr = c.tax_year ? ` ${c.tax_year}` : '';
        const date = new Date(c.completed_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
        rows.push(`<div style="display:flex;align-items:center;gap:0.75rem;padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
          <span style="font-size:1rem;">✅</span>
          <span style="flex:1;font-size:0.88rem;font-weight:600;">${esc(c.pipeline_name)}${yr}</span>
          <span style="font-size:0.78rem;color:var(--muted);">completed ${date}</span>
        </div>`);
      });
      activeJobs.forEach(j => {
        const yr = j.tax_year ? ` ${j.tax_year}` : '';
        const stage = j.current_stage_name ? ` → ${j.current_stage_name}` : '';
        rows.push(`<div style="display:flex;align-items:center;gap:0.75rem;padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
          <span style="font-size:1rem;">🔄</span>
          <span style="flex:1;font-size:0.88rem;font-weight:600;">${esc(j.pipeline_name)}${yr}</span>
          <span style="font-size:0.78rem;color:var(--muted);">in progress${esc(stage)}</span>
        </div>`);
      });
      list.innerHTML = rows.join('') || '<div style="color:var(--muted);font-size:0.85rem;">No pipeline history yet.</div>';
    } catch(e) {
      loading.style.display = 'none'; list.style.display = '';
      list.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;">No pipeline history yet.</div>';
    }
  }

  // ── Job Card Renderer (with prev/next stage nav) ─────
  function renderJobCard(j) {
    const stageColor = j.stage_color || 'var(--gold)';
    const yearBadge = j.tax_year ? `<span style="font-size:0.72rem;background:rgba(255,255,255,0.06);border-radius:4px;padding:0.1rem 0.45rem;margin-left:0.5rem;color:var(--muted);">${j.tax_year}</span>` : '';
    const statusColor = j.job_status === 'blocked' ? 'var(--red)' : (j.job_status === 'waiting_client' || j.job_status === 'missing_info') ? 'var(--orange)' : 'var(--green)';
    const statusLabel = {active:'Active',waiting_client:'Waiting on Client',missing_info:'Missing Info',blocked:'Blocked',under_extension:'Under Extension',on_hold:'On Hold'}[j.job_status] || 'Active';
    const updateText = j.last_update ? (j.last_update.length > 80 ? j.last_update.substring(0,80)+'…' : j.last_update) : null;
    const updateDate = j.last_update_at ? new Date(j.last_update_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '';
    const lastUpdate = updateText ? `<div style="font-size:0.78rem;color:var(--muted);margin-top:0.25rem;">${esc(updateText)}<span style="font-size:0.72rem;color:rgba(143,163,184,0.5);margin-left:0.4rem;">${esc(j.last_update_author||'')}${updateDate ? ' · '+updateDate : ''}</span></div>` : '';

    // Prev / current / next stage nav
    const stages = j.stages || [];
    const curIdx = stages.findIndex(s => s.id === j.current_stage_id);
    const prevStage = curIdx > 0 ? stages[curIdx - 1] : null;
    const nextStage = curIdx < stages.length - 1 ? stages[curIdx + 1] : null;

    const prevBtn = prevStage
      ? `<button onclick="event.stopPropagation();moveJobStage(${j.id},'${esc(j.pipeline_name)}${j.tax_year?' '+j.tax_year:''}',${prevStage.id},'${esc(prevStage.name)}')" title="Move back to: ${esc(prevStage.name)}" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:0.3rem 0.6rem;cursor:pointer;color:var(--muted);font-size:0.75rem;display:flex;align-items:center;gap:0.3rem;white-space:nowrap;">← ${esc(prevStage.name)}</button>`
      : `<span style="width:0"></span>`;
    const nextBtn = nextStage
      ? `<button onclick="event.stopPropagation();moveJobStage(${j.id},'${esc(j.pipeline_name)}${j.tax_year?' '+j.tax_year:''}',${nextStage.id},'${esc(nextStage.name)}')" title="Move forward to: ${esc(nextStage.name)}" style="background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.25);border-radius:6px;padding:0.3rem 0.6rem;cursor:pointer;color:var(--gold);font-size:0.75rem;display:flex;align-items:center;gap:0.3rem;white-space:nowrap;">${esc(nextStage.name)} →</button>`
      : `<span style="font-size:0.72rem;color:rgba(255,255,255,0.2);">Final stage</span>`;

    return `<div class="workflow-job-card" style="flex-direction:column;align-items:stretch;gap:0.75rem;padding:1rem 1.25rem;cursor:default;" onclick="">
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:180px;">
          <div style="font-weight:700;font-size:0.95rem;">${esc(j.pipeline_name)}${yearBadge}</div>
          ${lastUpdate}
        </div>
        <div style="text-align:center;min-width:130px;">
          <div style="font-size:0.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.2rem;">Current Stage</div>
          <div style="font-weight:700;color:${stageColor};font-size:0.88rem;">${esc(j.stage_name)}</div>
        </div>
        <div style="text-align:center;min-width:90px;">
          <div style="font-size:0.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.2rem;">Status</div>
          <div style="font-weight:600;font-size:0.8rem;color:${statusColor};">${statusLabel}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.05);">
        <div>${prevBtn}</div>
        <div style="font-size:0.72rem;color:rgba(255,255,255,0.2);">${curIdx + 1} / ${stages.length}</div>
        <div>${nextBtn}</div>
      </div>
    </div>`;
  }

  async function moveJobStage(jobId, pipelineName, stageId, stageName) {
    try {
      const res = await apiFetch(`/api/pipelines/jobs/${jobId}/move`, {
        method: 'POST',
        body: JSON.stringify({ stage_id: stageId, note: `Moved to "${stageName}" from person workflow tab` }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Move failed'); }
      if (typeof window._shellToast === 'function') window._shellToast(`Moved to "${stageName}"`);
      const wList = document.getElementById('workflow-list');
      const wLoad = document.getElementById('workflow-loading');
      if (wList) { wList.innerHTML = ''; wList.style.display = 'none'; }
      if (wLoad) wLoad.style.display = '';
      await loadWorkflow();
    } catch(e) {
      if (typeof window._shellToast === 'function') window._shellToast('Error: ' + e.message);
      else alert('Error: ' + e.message);
    }
  }

  // ── Create Card Modal ─────────────────────────────────
  let _allInstances = [];

  async function openCreateCardModal() {
    const modal = document.getElementById('create-card-modal');
    if (!modal) return;
    modal.classList.remove('hidden');

    const pipelineSel = document.getElementById('cc-pipeline-sel');
    const stageSel = document.getElementById('cc-stage-sel');
    pipelineSel.innerHTML = '<option value="">Loading pipelines…</option>';
    stageSel.innerHTML = '<option value="">Select pipeline first</option>';

    try {
      const res = await apiFetch('/api/pipelines/instances');
      _allInstances = await res.json();
      // Filter to person-type pipelines only
      const personInstances = _allInstances.filter(i => i.entity_type === 'person');
      if (!personInstances.length) {
        pipelineSel.innerHTML = '<option value="">No person pipelines found</option>';
        return;
      }
      pipelineSel.innerHTML = '<option value="">— Select pipeline —</option>' +
        personInstances.map(i => `<option value="${i.id}">${esc(i.template_name)}${i.tax_year ? ' '+i.tax_year : ''}</option>`).join('');
      pipelineSel.onchange = async () => {
        const instId = pipelineSel.value;
        stageSel.innerHTML = '<option value="">Loading stages…</option>';
        if (!instId) { stageSel.innerHTML = '<option value="">Select pipeline first</option>'; return; }
        const inst = _allInstances.find(i => String(i.id) === String(instId));
        if (!inst) return;
        const r = await apiFetch(`/api/pipelines/instances/${instId}`);
        const data = await r.json();
        stageSel.innerHTML = '<option value="">— Select starting stage —</option>' +
          (data.stages || []).map(s => `<option value="${s.id}">${esc(s.name)}</option>`).join('');
      };
    } catch(e) {
      pipelineSel.innerHTML = `<option value="">Error: ${esc(e.message)}</option>`;
    }
  }

  async function submitCreateCard() {
    const instId = document.getElementById('cc-pipeline-sel').value;
    const stageId = document.getElementById('cc-stage-sel').value;
    const errEl = document.getElementById('cc-error');
    if (!instId || !stageId) { errEl.textContent = 'Select a pipeline and stage.'; errEl.style.display='block'; return; }
    errEl.style.display = 'none';
    try {
      const res = await apiFetch(`/api/pipelines/instances/${instId}/jobs`, {
        method: 'POST',
        body: JSON.stringify({ entity_type: 'person', entity_id: personId }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      const newJob = await res.json();
      // Move to selected stage if it's not already the default
      if (newJob.current_stage_id !== parseInt(stageId)) {
        await apiFetch(`/api/pipelines/jobs/${newJob.id}/move`, {
          method: 'POST',
          body: JSON.stringify({ stage_id: parseInt(stageId), note: 'Placed at stage on card creation' }),
        });
      }
      document.getElementById('create-card-modal').classList.add('hidden');
      toast('Pipeline card created');
      // Force full reload of workflow tab
      const wList = document.getElementById('workflow-list');
      const wLoad = document.getElementById('workflow-loading');
      if (wList) { wList.innerHTML = ''; wList.style.display = 'none'; }
      if (wLoad) wLoad.style.display = '';
      loadWorkflow();
    } catch(e) { errEl.textContent = 'Error: ' + e.message; errEl.style.display = 'block'; }
  }

  // ── Fire Trigger Modal ────────────────────────────────
  let availableTriggers = [];

  async function openFireTriggerModal() {
    const modal = document.getElementById('fire-trigger-modal');
    const select = document.getElementById('ft-trigger-select');
    const result = document.getElementById('ft-result');
    result.style.display = 'none';
    modal.classList.remove('hidden');

    if (!availableTriggers.length) {
      try {
        const res = await apiFetch('/api/pipeline-triggers');
        availableTriggers = await res.json();
        // Group by category
        const byCategory = {};
        availableTriggers.forEach(t => {
          if (!byCategory[t.category]) byCategory[t.category] = [];
          byCategory[t.category].push(t);
        });
        let html = '<option value="">— Select a trigger —</option>';
        Object.keys(byCategory).sort().forEach(cat => {
          html += `<optgroup label="${esc(cat)}">`;
          byCategory[cat].forEach(t => {
            html += `<option value="${esc(t.key)}">${esc(t.label)}</option>`;
          });
          html += '</optgroup>';
        });
        select.innerHTML = html;
      } catch(e) {
        select.innerHTML = '<option value="">Failed to load triggers</option>';
      }
    }
  }

  function closeFireTriggerModal() {
    document.getElementById('fire-trigger-modal').classList.add('hidden');
    document.getElementById('ft-result').style.display = 'none';
    document.getElementById('ft-trigger-select').value = '';
  }

  async function submitFireTrigger() {
    const key = document.getElementById('ft-trigger-select').value;
    const result = document.getElementById('ft-result');
    const btn = document.getElementById('ft-submit');
    if (!key) { toast('Select a trigger first', 'error'); return; }

    btn.disabled = true;
    btn.textContent = 'Firing…';
    result.style.display = 'none';

    try {
      const res = await apiFetch('/api/pipeline-triggers/fire', {
        method: 'POST',
        body: JSON.stringify({ trigger_key: key, person_id: parseInt(personId) }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');

      if (data.moved && data.moved.length) {
        const lines = data.moved.map(m =>
          `<div style="margin-bottom:0.3rem;">📌 <strong>${esc(m.pipeline)}</strong>: ${m.from_stage ? esc(m.from_stage) + ' → ' : ''}${esc(m.to_stage)}</div>`
        ).join('');
        result.style.background = 'rgba(34,197,94,0.1)';
        result.style.border = '1px solid rgba(34,197,94,0.3)';
        result.style.color = 'var(--text)';
        result.innerHTML = `<div style="font-weight:700;margin-bottom:0.5rem;">✅ Moved ${data.moved.length} card${data.moved.length !== 1 ? 's' : ''}:</div>${lines}`;
        result.style.display = 'block';
        // Refresh workflow list
        loadWorkflow();
      } else {
        result.style.background = 'rgba(255,255,255,0.05)';
        result.style.border = '1px solid var(--border)';
        result.style.color = 'var(--muted)';
        result.innerHTML = 'ℹ️ No cards moved — this person has no active pipeline jobs with a smart stage configured for this trigger.';
        result.style.display = 'block';
      }
    } catch(e) {
      result.style.background = 'rgba(239,68,68,0.1)';
      result.style.border = '1px solid rgba(239,68,68,0.3)';
      result.style.color = 'var(--red)';
      result.innerHTML = '❌ ' + esc(e.message);
      result.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Fire ⚡';
    }
  }
  // ── End Fire Trigger Modal ────────────────────────

  async function loadPerson() {
    try {
      const res = await apiFetch(`/api/people/${personId}`);
      if (res.status === 404 || res.status === 403) { window.location.href = '/404'; return; }
      if (!res.ok) { document.getElementById('entity-name').textContent = 'Error loading'; return; }
      personData = await res.json();
      renderHeader(personData);
      renderOverview(personData);
    } catch(e) {
      document.getElementById('entity-name').textContent = 'Error loading';
    }
  }

  function renderHeader(p) {
    const name = formatPersonDisplayName(p) || 'Unnamed';
    document.title = `${name} — DarkLion`;
    document.getElementById('entity-name').textContent = name;
    let html = `<span class="badge badge-muted">Person</span>`;
    if (p.filing_status) {
      const fsColors = { MFJ:'rgba(74,144,217,0.18)', Single:'rgba(143,163,184,0.2)', HOH:'rgba(237,137,54,0.18)', MFS:'rgba(138,99,241,0.18)' };
      const fsTextColors = { MFJ:'#4a90d9', Single:'#8fa3b8', HOH:'#ed8936', MFS:'#a78bfa' };
      const fsKey = p.filing_status.toUpperCase() === 'MFJ' ? 'MFJ' : p.filing_status === 'single' ? 'Single' : p.filing_status === 'hoh' ? 'HOH' : p.filing_status === 'mfs' ? 'MFS' : null;
      const fsLabel = { mfj:'MFJ', single:'Single', hoh:'HOH', mfs:'MFS' }[(p.filing_status||'').toLowerCase()] || p.filing_status.replace(/_/g,' ');
      const bg = fsColors[fsKey] || 'rgba(143,163,184,0.2)';
      const tc = fsTextColors[fsKey] || '#8fa3b8';
      html += ` <span class="badge" style="background:${bg};color:${tc};">${esc(fsLabel)}</span>`;
    }
    if (p.portal_enabled) html += ` <span class="badge badge-green">Portal Active</span>`;
    else if (p.portal_invite_token) html += ` <span class="badge badge-orange">Portal Invited</span>`;
    document.getElementById('entity-badges').innerHTML = html;
    const meta = [];
    if (p.email) meta.push(esc(p.email));
    if (p.phone) meta.push(fmtPhone(p.phone));
    const cityState = [p.city, p.state].filter(x => x && x.trim()).map(esc).join(', ');
    if (cityState) meta.push(`📍 ${cityState}`);
    if (p.relationship_id && p.relationship_name) {
      meta.push(`👥 <a href="/crm/relationship/${p.relationship_id}" style="color:var(--gold);text-decoration:none;">${esc(p.relationship_name)}</a>`);
      // Relationship button in header
      const relBtn = document.getElementById('entity-rel-btn');
      if (relBtn) { relBtn.textContent = `👥 ${p.relationship_name}`; relBtn.style.display = ''; relBtn.onclick = () => window.location.href = `/crm/relationship/${p.relationship_id}`; }
    }
    document.getElementById('entity-meta').innerHTML = meta.join('  ·  ');
    // Track recent visit
    if (window.addRecentClient) window.addRecentClient({ _type:'person', id: p.id, _label: name, _sub: p.relationship_name || 'Person' });
  }

  // ── Overview v2 helpers (people Overview only) ──
  function ov2CurrentTaxYear() {
    const now = new Date();
    // Through September, default to prior calendar year (tax season); then flip to current.
    return now.getMonth() >= 9 ? now.getFullYear() : now.getFullYear() - 1;
  }

  function ov2GoTab(name, nth) {
    const el = document.querySelector(`.tab-item:nth-child(${nth})`);
    switchTab(name, el || null);
  }

  function ov2ComputeNextStep(p, deliveries, activeJobs) {
    const taxYear = ov2CurrentTaxYear();
    const delivs = Array.isArray(deliveries) ? deliveries : [];
    const jobs = Array.isArray(activeJobs) ? activeJobs : [];

    if (p.personal_tax_engaged === false) {
      return {
        title: 'Not engaged for personal tax',
        sub: 'Mark engaged in Edit if this is a tax client',
        primary: { label: 'Edit client', onclick: 'openEditModal()' },
        secondary: null,
      };
    }

    const portalLive = !!(p.portal_enabled && p.portal_has_password);
    if (!portalLive) {
      if (p.portal_invite_token) {
        return {
          title: 'Portal invite pending',
          sub: 'Client has not activated their portal yet',
          primary: { label: 'Resend invite', onclick: 'sendPortalInvite(this)' },
          secondary: { label: 'Preview portal', onclick: "viewPortalAsClient(this, false)" },
        };
      }
      if (p.email) {
        return {
          title: 'Set up client portal',
          sub: 'Invite them to upload docs and message securely',
          primary: { label: 'Send invite', onclick: 'sendPortalInvite(this)' },
          secondary: { label: 'Open organizers', onclick: "ov2GoTab('organizers',5)" },
        };
      }
    }

    const openOrder = ['needs_changes', 'draft', 'sent', 'signed'];
    const openDel = delivs
      .filter(d => openOrder.includes(d.status))
      .sort((a, b) => openOrder.indexOf(a.status) - openOrder.indexOf(b.status))[0];

    if (openDel) {
      if (openDel.status === 'needs_changes') {
        return {
          title: `Client requested changes · ${openDel.tax_year || taxYear}`,
          sub: esc(openDel.title || 'Tax return'),
          primary: { label: 'Open tax', onclick: "ov2GoTab('tax',3)" },
          secondary: { label: 'Messages', onclick: "ov2GoTab('communication',4)" },
        };
      }
      if (openDel.status === 'draft') {
        return {
          title: `Finish ${openDel.tax_year || taxYear} delivery draft`,
          sub: 'Review docs and send to client',
          primary: { label: 'Open tax', onclick: "ov2GoTab('tax',3)" },
          secondary: { label: 'Organizer', onclick: "ov2GoTab('organizers',5)" },
        };
      }
      if (openDel.status === 'sent') {
        return {
          title: `Waiting on client signature · ${openDel.tax_year || taxYear}`,
          sub: esc(openDel.title || 'Tax return sent'),
          primary: { label: 'Open tax', onclick: "ov2GoTab('tax',3)" },
          secondary: { label: 'Preview portal', onclick: "viewPortalAsClient(this, false)" },
        };
      }
      if (openDel.status === 'signed') {
        return {
          title: `Review signed return · ${openDel.tax_year || taxYear}`,
          sub: 'Approve or complete the delivery',
          primary: { label: 'Open tax', onclick: "ov2GoTab('tax',3)" },
          secondary: null,
        };
      }
    }

    if (jobs.length) {
      const j = jobs[0];
      const stage = j.current_stage_name ? esc(j.current_stage_name) : 'In progress';
      const yr = j.tax_year ? ` · ${j.tax_year}` : '';
      return {
        title: stage + yr,
        sub: esc(j.pipeline_name || 'Active pipeline'),
        primary: { label: 'Open workflow', onclick: "ov2GoTab('workflow',6)" },
        secondary: { label: 'Create delivery', onclick: "ov2GoTab('tax',3);setTimeout(()=>openPersonDeliveryModal(),120)" },
      };
    }

    const hasYearDelivery = delivs.some(d => String(d.tax_year) === String(taxYear));
    if (!hasYearDelivery) {
      return {
        title: `Start ${taxYear} tax return delivery`,
        sub: 'Or open organizer when docs are ready',
        primary: { label: 'Create delivery', onclick: "ov2GoTab('tax',3);setTimeout(()=>openPersonDeliveryModal(),120)" },
        secondary: { label: 'Open organizer', onclick: "ov2GoTab('organizers',5)" },
      };
    }

    return {
      title: `${taxYear} work looks current`,
      sub: 'No open tax actions right now',
      primary: { label: 'View tax', onclick: "ov2GoTab('tax',3)" },
      secondary: { label: 'Messages', onclick: "ov2GoTab('communication',4)" },
    };
  }

  function renderOverviewStatusStrip(p, deliveries, activeJobs) {
    const el = document.getElementById('overview-status-strip');
    if (!el) return;
    const taxYear = ov2CurrentTaxYear();
    const engaged = p.personal_tax_engaged !== false;
    const personBmLabel = p.billing_method === 'monthly_billing' ? 'Monthly billing'
      : p.billing_method === 'client_invoice' ? 'Client invoice'
      : (p.billing_method || 'Billing unset');
    const fsShort = { mfj: 'MFJ', single: 'Single', hoh: 'HOH', mfs: 'MFS' }[(p.filing_status || '').toLowerCase()] || '';
    const portalLive = !!(p.portal_enabled && p.portal_has_password);
    const portalPending = !portalLive && !!p.portal_invite_token;
    let portalVal, portalSub;
    if (portalLive) {
      portalVal = `<span class="ov2-pulse"></span> Active`;
      portalSub = `${esc(p.first_name || 'Client')} · taxpayer`;
    } else if (portalPending) {
      portalVal = `<span style="color:var(--orange);">Invite sent</span>`;
      portalSub = 'Waiting for client activation';
    } else {
      portalVal = `<span style="color:var(--muted);">Not set up</span>`;
      portalSub = p.email ? 'No portal access yet' : 'Add email to enable portal';
    }

    const delivs = Array.isArray(deliveries) ? deliveries : [];
    const yearDelivs = delivs.filter(d => String(d.tax_year) === String(taxYear));
    let yearSub = 'No delivery yet';
    if (yearDelivs.length) {
      const STATUS_LABEL = { draft: 'Draft', sent: 'Sent', signed: 'Signed', complete: 'Complete', needs_changes: 'Needs changes', approved: 'Approved' };
      const top = yearDelivs[0];
      yearSub = STATUS_LABEL[top.status] || top.status || 'On file';
    }

    const next = ov2ComputeNextStep(p, delivs, activeJobs);
    const primaryBtn = next.primary
      ? `<button class="btn btn-gold btn-sm" onclick="${next.primary.onclick}">${esc(next.primary.label)}</button>`
      : '';
    const secondaryBtn = next.secondary
      ? `<button class="btn btn-outline btn-sm" onclick="${next.secondary.onclick}">${esc(next.secondary.label)}</button>`
      : '';

    el.innerHTML = `
      <div class="ov2-status-cell">
        <div class="ov2-status-label">Engagement</div>
        <div class="ov2-status-value">
          ${engaged
            ? '<span class="badge" style="background:rgba(201,168,76,0.14);color:var(--gold);border:1px solid rgba(201,168,76,0.3);">Engaged</span>'
            : '<span class="badge" style="background:rgba(229,62,62,0.12);color:var(--red);border:1px solid rgba(229,62,62,0.28);">Not engaged</span>'}
          <span style="font-weight:600;font-size:0.82rem;color:var(--muted);">Personal tax</span>
        </div>
        <div class="ov2-status-sub">${esc(personBmLabel)}${fsShort ? ' · ' + esc(fsShort) : ''}</div>
      </div>
      <div class="ov2-status-cell">
        <div class="ov2-status-label">Tax year</div>
        <div class="ov2-status-value">${taxYear}</div>
        <div class="ov2-status-sub">${esc(yearSub)}</div>
      </div>
      <div class="ov2-status-cell">
        <div class="ov2-status-label">Portal</div>
        <div class="ov2-status-value">${portalVal}</div>
        <div class="ov2-status-sub">${portalSub}</div>
      </div>
      <div class="ov2-status-cell">
        <div class="ov2-status-label">Suggested next step</div>
        <div class="ov2-status-next">${next.title}</div>
        <div class="ov2-status-sub">${next.sub || ''}</div>
      </div>
      <div class="ov2-status-actions">${primaryBtn}${secondaryBtn}</div>`;
  }

  function renderOverview(p) {
    window._ov2Ctx = window._ov2Ctx || { deliveries: null, activeJobs: null };
    window._ov2Ctx.person = p;

    const notesTa = document.getElementById('notes-ta');
    if (notesTa) notesTa.value = p.notes || '';
    const notesFullEl = document.getElementById('notes-ta-full');
    if (notesFullEl) notesFullEl.value = p.notes || '';

    const initials = ((p.first_name || '').charAt(0) + (p.last_name || '').charAt(0)).toUpperCase() || '?';
    const fsLabel = { mfj: 'MFJ', single: 'Single', hoh: 'Head of Household', mfs: 'MFS' }[(p.filing_status || '').toLowerCase()] || (p.filing_status || '').replace(/_/g, ' ');
    const fsColors = { MFJ: 'rgba(74,144,217,0.15)', Single: 'rgba(143,163,184,0.15)', HOH: 'rgba(237,137,54,0.15)', MFS: 'rgba(138,99,241,0.15)' };
    const fsTextColors = { MFJ: '#4a90d9', Single: '#8fa3b8', HOH: '#ed8936', MFS: '#a78bfa' };
    const fsKey = (p.filing_status || '').toLowerCase() === 'mfj' ? 'MFJ'
      : p.filing_status === 'single' ? 'Single'
      : p.filing_status === 'hoh' ? 'HOH'
      : p.filing_status === 'mfs' ? 'MFS' : null;
    const fsBg = fsColors[fsKey] || 'rgba(143,163,184,0.15)';
    const fsTc = fsTextColors[fsKey] || '#8fa3b8';
    const personBmLabel = p.billing_method === 'monthly_billing' ? 'Monthly'
      : p.billing_method === 'client_invoice' ? 'Client Invoice'
      : (p.billing_method || '—');
    const addrLine1 = [p.address_line1, p.address_line2].filter(x => x && x.trim()).map(esc).join(', ');
    const addrLine2 = [p.city, p.state, p.zip].filter(x => x && x.trim()).map(esc).join(', ');
    const isJoint = ['mfj', 'mfs'].includes((p.filing_status || '').toLowerCase());
    const spouseInitials = (p.spouse_name || '')
      .split(/\s+/).filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase() || 'S';

    // Status strip (refined as deliveries / pipeline load)
    renderOverviewStatusStrip(p, window._ov2Ctx.deliveries, window._ov2Ctx.activeJobs);

    // ── Household snapshot ──
    const contactEl = document.getElementById('overview-contact-panel');
    const relVal = (p.relationship_id && p.relationship_name)
      ? `<a href="/crm/relationship/${p.relationship_id}" style="color:var(--gold);">${esc(p.relationship_name)}</a>`
      : (p.relationship_name ? esc(p.relationship_name) : '—');
    const metaItems = [
      { label: 'Email', val: p.email ? `<a href="mailto:${esc(p.email)}" style="color:var(--gold);">${esc(p.email)}</a>` : '—' },
      { label: 'Phone', val: fmtPhone(p.phone) || '—' },
      { label: 'Date of birth', val: fmtDOB(p.date_of_birth) || '—' },
      { label: 'Filing status', val: p.filing_status ? `<span style="background:${fsBg};color:${fsTc};border-radius:4px;padding:0.1rem 0.45rem;font-size:0.72rem;font-weight:700;">${esc(fsLabel)}</span>` : '—' },
      { label: 'Billing', val: esc(personBmLabel) },
      { label: 'Relationship', val: relVal },
    ];
    contactEl.innerHTML = `
      <div class="ov2-card-head">
        <div class="ov2-card-title">Household snapshot</div>
        <span style="display:flex;gap:0.45rem;align-items:center;">
          <button class="btn btn-outline btn-xs" onclick="openMoveRelationshipModal()">Move</button>
          <button class="btn btn-outline btn-xs" onclick="openEditModal()">Edit details</button>
        </span>
      </div>
      <div class="ov2-household">
        <div class="ov2-av-pair">
          <div class="ov2-av ov2-av-a">${initials}</div>
          ${isJoint && (p.spouse_name || p.spouse_email) ? `<div class="ov2-av ov2-av-b">${spouseInitials}</div>` : ''}
        </div>
        <div style="min-width:0;">
          <div class="ov2-hh-name">${esc(formatPersonDisplayName(p)) || 'Unnamed'}</div>
          ${(addrLine1 || addrLine2)
            ? `<div class="ov2-hh-addr">${[addrLine1, addrLine2].filter(Boolean).join('<br>')}</div>`
            : `<div class="ov2-hh-addr" style="font-style:italic;">No address on file</div>`}
        </div>
      </div>
      <div class="ov2-meta-grid">
        ${metaItems.map(r => `<div class="ov2-meta-item"><label>${r.label}</label><div>${r.val}</div></div>`).join('')}
      </div>`;

    // ── Portal Access (rail) ──
    const portalEl = document.getElementById('overview-portal-panel');

    function portalStatusBadge(enabled, hasPassword, token) {
      if (enabled && hasPassword) return `<span style="font-size:0.68rem;background:rgba(62,207,142,0.12);color:var(--green);border-radius:999px;padding:0.12rem 0.45rem;font-weight:700;border:1px solid rgba(62,207,142,0.28);">Active</span>`;
      if (token) return `<span style="font-size:0.68rem;background:rgba(237,137,54,0.12);color:var(--orange);border-radius:999px;padding:0.12rem 0.45rem;font-weight:700;border:1px solid rgba(237,137,54,0.28);">Invite sent</span>`;
      return `<span style="font-size:0.68rem;background:rgba(143,163,184,0.1);color:var(--muted);border-radius:999px;padding:0.12rem 0.45rem;font-weight:700;border:1px solid rgba(143,163,184,0.2);">Not set up</span>`;
    }

    function portalActionBtns(fullyActive, token, isSpouse) {
      const inviteFn = isSpouse ? 'sendSpousePortalInvite(this)' : 'sendPortalInvite(this)';
      const resetFn = isSpouse ? 'resetSpousePortalPassword()' : 'resetPortalPassword()';
      const disableFn = isSpouse ? 'disableSpousePortal()' : 'disablePortal()';
      const inviteLabel = token ? 'Resend invite' : 'Send invite';
      if (fullyActive) {
        return `<div class="ov2-portal-actions">
          <button class="btn btn-gold btn-sm" style="width:100%;" onclick="viewPortalAsClient(this, ${isSpouse ? 'true' : 'false'})" title="Open portal as this client (advisor preview)">Preview portal</button>
          <div class="btn-row">
            <button class="btn btn-outline btn-xs" onclick="${resetFn}">Reset password</button>
            <button class="btn btn-xs" style="border:1px solid rgba(229,62,62,0.4);color:var(--red);background:transparent;" onclick="${disableFn}">Disable</button>
          </div>
        </div>`;
      }
      return `<div class="ov2-portal-actions">
        <button class="btn btn-gold btn-sm" style="width:100%;" onclick="${inviteFn}">${inviteLabel}</button>
        <button class="btn btn-outline btn-xs" style="width:100%;" onclick="viewPortalAsClient(this, ${isSpouse ? 'true' : 'false'})">Preview portal</button>
      </div>`;
    }

    window.viewPortalAsClient = async function(btn, isSpouse) {
      const orig = btn.textContent;
      btn.textContent = '…'; btn.disabled = true;
      try {
        const res = await apiFetch(`/api/people/${personId}/portal-preview`, {
          method: 'POST',
          body: JSON.stringify({ spouse: !!isSpouse })
        });
        const data = await res.json();
        if (data.url) window.open(data.url, '_blank');
        else window._shellToast(data.error || 'Could not generate preview link', 'error');
      } catch (e) {
        window._shellToast('Failed to open portal preview', 'error');
      } finally {
        btn.textContent = orig; btn.disabled = false;
      }
    };

    function portalPersonBlock(avInitials, avatarBg, avatarColor, name, role, email, enabled, hasPassword, token, hasEmail, isSpouse) {
      return `
        <div class="ov2-portal-block">
          <div class="ov2-portal-person">
            <div style="width:34px;height:34px;border-radius:50%;background:${avatarBg};color:${avatarColor};font-weight:700;font-size:0.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${avInitials}</div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:650;font-size:0.84rem;line-height:1.2;">${name}</div>
              <div style="font-size:0.72rem;color:var(--muted);">${role} · ${email}</div>
            </div>
            ${portalStatusBadge(enabled, hasPassword, token)}
          </div>
          ${hasEmail ? portalActionBtns(enabled && hasPassword, token, isSpouse) : '<div style="font-size:0.74rem;color:var(--muted);font-style:italic;">Add email to enable portal</div>'}
        </div>`;
    }

    const taxpayerBlock = portalPersonBlock(
      (p.first_name || '?').charAt(0).toUpperCase(),
      'rgba(201,168,76,0.18)', 'var(--gold)',
      `${esc(p.first_name)} ${esc(p.last_name)}`, 'Taxpayer',
      esc(p.email || '—'),
      p.portal_enabled, p.portal_has_password, p.portal_invite_token, !!p.email, false
    );

    let spouseBlock = '';
    if (isJoint) {
      if (p.spouse_name || p.spouse_email) {
        spouseBlock = portalPersonBlock(
          (p.spouse_name || 'S').charAt(0).toUpperCase(),
          'rgba(110,168,254,0.16)', '#6ea8fe',
          esc(p.spouse_name || '—'), 'Spouse',
          esc(p.spouse_email || '—'),
          p.spouse_portal_enabled, p.spouse_portal_has_password, p.spouse_portal_invite_token, !!p.spouse_email, true
        );
      } else {
        spouseBlock = `<div class="ov2-portal-block" style="font-size:0.8rem;color:var(--muted);font-style:italic;">Spouse not set — add name &amp; email via Edit</div>`;
      }
    }

    portalEl.innerHTML = `
      <div class="ov2-card-head">
        <div class="ov2-card-title">Portal access</div>
      </div>
      ${taxpayerBlock}
      ${spouseBlock}`;

    const spouseEl = document.getElementById('overview-spouse-panel');
    if (spouseEl) spouseEl.style.display = 'none';

    loadStaffAccessPanel(p.id);

    // ── Tax work ──
    const taxEl = document.getElementById('overview-tax-panel');
    taxEl.innerHTML = `
      <div class="ov2-card-head">
        <div class="ov2-card-title">Tax work</div>
        <a href="#" class="ov2-card-link" onclick="ov2GoTab('tax',3);return false;">View all →</a>
      </div>
      <div id="ov-tax-inner" style="color:var(--muted);font-size:0.82rem;">Loading…</div>`;

    const renderPersonTaxSnippet = (deliveries) => {
      const list = Array.isArray(deliveries) ? deliveries : (deliveries?.deliveries || []);
      window._ov2Ctx.deliveries = list;
      renderOverviewStatusStrip(p, list, window._ov2Ctx.activeJobs);

      const el = document.getElementById('ov-tax-inner');
      if (!el) return;
      if (!list.length) {
        el.innerHTML = `<div class="ov2-empty">
          <span>No tax deliveries for ${ov2CurrentTaxYear()} yet.</span>
          <button type="button" class="ov2-empty-cta" onclick="ov2GoTab('tax',3);setTimeout(()=>openPersonDeliveryModal(),120)">+ Create delivery</button>
        </div>`;
        return;
      }
      const STATUS_DOT = { draft: '#8fa3b8', sent: '#4a90d9', signed: '#3ecf8e', complete: '#3ecf8e', needs_changes: '#ed8936', approved: '#c9a84c' };
      const STATUS_LABEL = { draft: 'Draft', sent: 'Sent', signed: 'Signed', complete: 'Complete', needs_changes: 'Needs Changes', approved: 'Approved' };
      el.innerHTML = list.slice(0, 4).map(d => {
        const dot = STATUS_DOT[d.status] || '#8fa3b8';
        const label = STATUS_LABEL[d.status] || d.status || '';
        return `<div class="ov2-work-row" style="cursor:pointer;" onclick="ov2GoTab('tax',3)">
          <span style="background:rgba(201,168,76,0.12);color:var(--gold);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.72rem;font-weight:700;flex-shrink:0;">${esc(String(d.tax_year || ''))}</span>
          <span style="flex:1;min-width:0;font-size:0.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(d.title || 'Return')}</span>
          <span style="display:flex;align-items:center;gap:0.3rem;font-size:0.75rem;flex-shrink:0;color:var(--muted);"><span style="width:7px;height:7px;border-radius:50%;background:${dot};display:inline-block;"></span>${esc(label)}</span>
        </div>`;
      }).join('');
    };

    if (p.tax_deliveries && p.tax_deliveries.length) {
      renderPersonTaxSnippet(p.tax_deliveries);
    } else {
      apiFetch(`/api/tax-deliveries?person_id=${personId}`).then(r => r.json()).then(renderPersonTaxSnippet).catch(() => {
        const el = document.getElementById('ov-tax-inner');
        if (el) el.innerHTML = '<span>—</span>';
      });
    }

    // ── Companies (rail) ──
    const companiesEl = document.getElementById('overview-companies-panel');
    const companies = p.company_access || p.companies || [];
    let compHtml = `<div class="ov2-card-head"><div class="ov2-card-title">Companies</div></div>`;
    if (!companies.length) {
      compHtml += `<div class="ov2-empty"><span>No companies linked.</span></div>`;
    } else {
      compHtml += `<div class="overview-company-grid">`;
      companies.forEach(c => {
        compHtml += `<div class="overview-company-card" onclick="window.location.href='/crm/company/${c.company_id}'">
          <div style="width:28px;height:28px;border-radius:6px;background:rgba(74,144,217,0.15);color:#4a90d9;font-weight:700;font-size:0.8rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">🏢</div>
          <div style="min-width:0;flex:1;">
            <div style="font-size:0.82rem;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(c.company_name || 'Company')}</div>
            ${c.access_level ? `<div style="font-size:0.7rem;color:var(--muted);">${esc(c.access_level)}</div>` : ''}
          </div>
        </div>`;
      });
      compHtml += `</div>`;
    }
    companiesEl.innerHTML = compHtml;

    // ── Recent messages ──
    const msgsEl = document.getElementById('overview-messages-panel');
    msgsEl.innerHTML = `
      <div class="ov2-card-head">
        <div class="ov2-card-title">Recent messages</div>
        <a href="#" class="ov2-card-link" onclick="ov2GoTab('communication',4);return false;">View all →</a>
      </div>
      <div id="ov-person-msgs-inner"></div>`;
    apiFetch(`/api/messages/person/${personId}?scope=mine`).then(r => r.json()).then(threads => {
      const el = document.getElementById('ov-person-msgs-inner');
      if (!el) return;
      const arr = Array.isArray(threads) ? threads : (threads.threads || threads.data || []);
      if (!arr.length) {
        el.innerHTML = `<div class="ov2-empty">
          <span>No message threads yet.</span>
          <button type="button" class="ov2-empty-cta" onclick="ov2GoTab('communication',4)">+ New message</button>
        </div>`;
        return;
      }
      function timeAgo(ts) {
        if (!ts) return '';
        const d = new Date(ts);
        const diff = Date.now() - d;
        if (diff < 60000) return 'just now';
        if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
        if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
        return d.toLocaleDateString();
      }
      el.innerHTML = arr.slice(0, 5).map(t => {
        const subject = t.subject || '(no subject)';
        const preview = t.lastPreview || t.last_body || '';
        const unread = (t.unreadCount || t.unread_count || 0) > 0;
        const unreadCount = t.unreadCount || t.unread_count || 0;
        const personName = formatPersonDisplayName({
          first_name: t.firstName || t.first_name,
          last_name: t.lastName || t.last_name,
          spouse_name: t.spouseName || t.spouse_name,
        }) || 'Client';
        const ini = personName.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
        const when = timeAgo(t.lastMessageAt || t.last_message_at || t.createdAt || t.created_at);
        return `<a href="#" class="thread-row${unread ? ' has-unread' : ''}" onclick="ov2GoTab('communication',4);setTimeout(()=>loadThread(${t.id}),200);return false;">
          <div class="thread-row-avatar">${ini}</div>
          <div class="thread-row-body">
            <div class="thread-row-top">
              <span class="thread-row-name">${esc(personName)}${unread ? `<span class="thread-unread-badge">${unreadCount}</span>` : ''}</span>
              <span class="thread-row-time">${when}</span>
            </div>
            <div class="thread-row-subject">${esc(subject)}</div>
            <div class="thread-row-preview">${esc(preview)}</div>
          </div>
        </a>`;
      }).join('');
    }).catch(() => {
      const el = document.getElementById('ov-person-msgs-inner');
      if (el) el.innerHTML = '<span style="color:var(--muted);">—</span>';
    });

    loadOverviewPipelineHistory();
  }

  async function loadStaffAccessPanel(personId) {
    const el = document.getElementById('overview-staff-access-panel');
    if (!el || !personId) return;
    try {
      const res = await apiFetch(`/api/people/${personId}/staff-access`);
      if (!res.ok) { el.style.display = 'none'; return; }
      renderStaffAccessPanel(personId, await res.json());
    } catch (e) { el.style.display = 'none'; }
  }

  function renderStaffAccessPanel(personId, data) {
    const el = document.getElementById('overview-staff-access-panel');
    const staff = (data && data.staff) || [];
    if (!staff.length) { el.style.display = 'none'; return; }
    const canEdit = !!data.canEdit;
    const hiddenCount = staff.filter(s => !s.canMessage).length;
    const rows = staff.map(s => `
      <label style="display:flex;align-items:center;gap:0.55rem;padding:0.3rem 0;font-size:0.84rem;cursor:${canEdit ? 'pointer' : 'default'};">
        <input type="checkbox" data-staff-id="${s.id}" ${s.canMessage ? 'checked' : ''} ${canEdit ? '' : 'disabled'} onchange="saveStaffAccess(${personId})">
        <span style="color:${s.canMessage ? 'var(--text)' : 'var(--muted)'};">${esc(s.name)}</span>
      </label>`).join('');
    el.innerHTML = `
      <div class="ov2-card-head">
        <div class="ov2-card-title">Who can message</div>
        <span id="staff-access-status" style="font-size:0.72rem;color:var(--muted);">${hiddenCount ? hiddenCount + ' hidden' : 'Whole team'}</span>
      </div>
      <div style="font-size:0.76rem;color:var(--muted);margin-bottom:0.4rem;">${canEdit ? 'Uncheck anyone this client should not be able to message.' : 'Only the firm owner can change this.'}</div>
      <div id="staff-access-list">${rows}</div>`;
    el.style.display = '';
  }

  async function saveStaffAccess(personId) {
    const boxes = [...document.querySelectorAll('#staff-access-list input[data-staff-id]')];
    const hidden = boxes.filter(b => !b.checked).map(b => parseInt(b.dataset.staffId));
    const status = document.getElementById('staff-access-status');
    if (status) status.textContent = 'Saving…';
    boxes.forEach(b => { b.disabled = true; });
    try {
      const res = await apiFetch(`/api/people/${personId}/staff-access`, { method: 'PUT', body: JSON.stringify({ hidden }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not save');
      renderStaffAccessPanel(personId, data);
    } catch (e) {
      if (status) status.textContent = e.message || 'Could not save';
      loadStaffAccessPanel(personId);
    }
  }

