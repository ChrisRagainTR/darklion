  // ── Docs: helpers ──
  function fileTypeBadge(mimeType, displayName) {
    const mime = (mimeType || '').toLowerCase();
    const name = (displayName || '').toLowerCase();
    const ext = name.includes('.') ? name.split('.').pop() : '';
    if (mime === 'application/pdf' || ext === 'pdf') return { label: 'PDF', color: '#e53e3e' };
    if (mime.includes('spreadsheet') || mime.includes('excel') || ext === 'xlsx' || ext === 'xls' || ext === 'csv')
      return { label: ext === 'csv' ? 'CSV' : 'Excel', color: '#38a169' };
    if (mime.includes('word') || ext === 'docx' || ext === 'doc')
      return { label: 'Word', color: '#3182ce' };
    if (mime.includes('presentation') || mime.includes('powerpoint') || ext === 'pptx' || ext === 'ppt')
      return { label: 'PPT', color: '#dd6b20' };
    if (mime.startsWith('image/') || ['jpg','jpeg','png','gif','webp','heic'].includes(ext))
      return { label: 'Image', color: '#805ad5' };
    if (mime.includes('zip') || ext === 'zip') return { label: 'ZIP', color: '#718096' };
    if (mime.startsWith('text/') || ext === 'txt') return { label: 'TXT', color: '#718096' };
    return { label: ext ? ext.toUpperCase().slice(0, 4) : 'FILE', color: '#718096' };
  }

  function fmtBytes(b) {
    if (!b) return '';
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(1) + ' MB';
  }

  function isEngagementLetterDoc(doc) {
    const cat = (doc.folder_category || '').toLowerCase();
    const typ = (doc.doc_type || '').toLowerCase();
    return cat === 'engagement_letter' || typ === 'engagement_letter';
  }

  let docsData = [];
  let documentFolders = [];
  let docsTrashData = [];
  let docsShowingTrash = false;
  const DOCS_YEARS = (() => { const a = []; for (let y = new Date().getFullYear(); y >= 2018; y--) a.push(String(y)); return a; })();

  function personIsInvestmentClient() {
    return !!(personData && (personData.financial_planning_enabled || personData.blueleaf_household_id));
  }

  function personDocCats() {
    const cats = [{ key: 'tax', label: 'Tax', icon: '🧾' }];
    if (personIsInvestmentClient()) cats.push({ key: 'ias', label: 'IAS', icon: '📈' });
    cats.push({ key: 'other', label: 'Other', icon: '📎' });
    return cats;
  }

  function normalizePersonDocCategory(category) {
    const key = (category || '').toLowerCase();
    return personDocCats().some(cat => cat.key === key) ? key : 'other';
  }

  function personDocCategoryOptions(selected) {
    const selectedKey = normalizePersonDocCategory(selected);
    return personDocCats().map(cat => `<option value="${cat.key}"${selectedKey === cat.key ? ' selected' : ''}>${cat.label}</option>`).join('');
  }

  function syncUploadDocTypeOptions() {
    const sel = document.getElementById('upload-doc-type');
    if (!sel) return;
    sel.innerHTML = personDocCategoryOptions(sel.value || 'tax');
  }

  function personFolderDefinitions(section, category) {
    return documentFolders.filter(folder => folder.folder_section === section && folder.folder_category === category);
  }

  function personFolderOptions(section, category, selectedId) {
    const categoryLabels = Object.fromEntries(personDocCats().map(cat => [cat.key, cat.label]));
    const options = documentFolders
      .filter(folder => categoryLabels[folder.folder_category])
      .map(folder => {
        const sectionLabel = folder.folder_section === 'client_uploaded' ? 'Client Uploaded' : 'Delivered by Advisor';
        const path = `${sectionLabel} / ${categoryLabels[folder.folder_category]} / ${folder.name}`;
        return `<option value="${folder.id}"${Number(selectedId) === Number(folder.id) ? ' selected' : ''}>${esc(path)}</option>`;
      }).join('');
    return `<option value="">No custom folder</option>${options}`;
  }

  function syncPersonFolderPlacement(folderSelect, sectionSelect, categorySelect) {
    const folder = documentFolders.find(item => Number(item.id) === Number(folderSelect?.value));
    if (!folder) return;
    sectionSelect.value = folder.folder_section;
    categorySelect.value = folder.folder_category;
  }

  function syncPersonMovePlacementFromFolder(id) {
    syncPersonFolderPlacement(
      document.getElementById(`mv-folder-${id}`),
      document.getElementById(`mv-sec-${id}`),
      document.getElementById(`mv-cat-${id}`)
    );
  }

  function refreshPersonMoveFolderOptions(id) {
    const section = document.getElementById(`mv-sec-${id}`)?.value || 'firm_uploaded';
    const category = document.getElementById(`mv-cat-${id}`)?.value || 'other';
    const select = document.getElementById(`mv-folder-${id}`);
    if (select) select.innerHTML = personFolderOptions(section, category, '');
  }

  function renderPersonDocRow(doc, sectionKey) {
    const badge = fileTypeBadge(doc.mime_type, doc.display_name);
    const status = sectionKey === 'firm_uploaded' ? '<span class="doc-badge doc-badge-viewed">✓ Delivered</span>' : '<span class="doc-badge doc-badge-client">✓ Uploaded</span>';
    const years = DOCS_YEARS;
    return `<div class="doc-row" data-docid="${doc.id}">
      <span style="flex-shrink:0;padding:0.15rem 0.4rem;border-radius:4px;font-size:0.65rem;font-weight:700;color:#fff;background:${badge.color};letter-spacing:0.03em;">${badge.label}</span>
      <div class="doc-info"><div class="doc-name doc-name-link" data-docid="${doc.id}" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">${esc((doc.display_name || 'Document').replace(/_/g, ' ').replace(/\s+/g, ' ').trim())}</div><div class="doc-badges">${status}${doc.size_bytes ? `<span class="doc-badge doc-badge-type">${fmtBytes(doc.size_bytes)}</span>` : ''}</div>
        <div class="doc-move-panel" id="move-panel-${doc.id}" style="display:none;margin-top:0.4rem;padding:0.4rem;background:rgba(201,168,76,0.06);border-radius:5px;">
          <span style="font-size:0.72rem;color:var(--muted);margin-right:0.3rem;">Move to:</span>
          <select id="mv-year-${doc.id}" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">${years.map(year => `<option value="${year}"${String(doc.year || '') === String(year) ? ' selected' : ''}>${year}</option>`).join('')}</select>
          <select id="mv-sec-${doc.id}" onchange="refreshPersonMoveFolderOptions(${doc.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;"><option value="firm_uploaded"${(doc.folder_section || 'firm_uploaded') === 'firm_uploaded' ? ' selected' : ''}>Advisor</option><option value="client_uploaded"${doc.folder_section === 'client_uploaded' ? ' selected' : ''}>Client</option></select>
          <select id="mv-cat-${doc.id}" onchange="refreshPersonMoveFolderOptions(${doc.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">${personDocCategoryOptions(doc.folder_category || 'other')}</select>
          <select id="mv-folder-${doc.id}" onchange="syncPersonMovePlacementFromFolder(${doc.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">${personFolderOptions(doc.folder_section || 'firm_uploaded', doc.folder_category || 'other', doc.document_folder_id)}</select>
          <button onclick="saveDocMove(${doc.id})" style="background:var(--gold);color:var(--navy);border:none;border-radius:4px;padding:0.2rem 0.55rem;font-size:0.75rem;font-weight:700;cursor:pointer;">Save</button><button onclick="document.getElementById('move-panel-${doc.id}').style.display='none'" style="background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:4px;padding:0.2rem 0.45rem;font-size:0.75rem;cursor:pointer;margin-left:0.2rem;">✕</button>
        </div>
      </div>
      <div style="display:flex;gap:0.4rem;flex-shrink:0;align-items:center;"><button class="btn-dl" data-docid="${doc.id}">⬇</button><button class="btn btn-ghost btn-xs" onclick="quickMoveDocSide(${doc.id},event)">${sectionKey === 'firm_uploaded' ? '→ Client' : '→ Advisor'}</button><button class="btn btn-ghost btn-xs" onclick="document.getElementById('move-panel-${doc.id}').style.display=document.getElementById('move-panel-${doc.id}').style.display==='none'?'block':'none'">↕</button><button class="btn btn-ghost btn-xs" style="color:var(--red)" onclick="deleteDoc(${doc.id},event)">🗑</button></div>
    </div>`;
  }

  function renderPersonCategoryFiles(files, sectionKey, category, year) {
    const names = new Set(files.map(doc => doc.folder_subcategory).filter(Boolean));
    if (String(year) === String(new Date().getFullYear())) personFolderDefinitions(sectionKey, category).forEach(folder => names.add(folder.name));
    let html = files.filter(doc => !doc.folder_subcategory).map(doc => renderPersonDocRow(doc, sectionKey)).join('');
    Array.from(names).sort((a, b) => a.localeCompare(b)).forEach(name => {
      const folderDocs = files.filter(doc => doc.folder_subcategory === name);
      html += `<div class="year-folder open" style="margin-bottom:0.35rem;"><div class="year-header" style="padding:0.3rem 0.5rem;font-size:0.8rem;"><span class="yr-label">📁 ${esc(name)} <span class="yr-count">${folderDocs.length}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:1rem;">${folderDocs.length ? folderDocs.map(doc => renderPersonDocRow(doc, sectionKey)).join('') : '<div style="color:var(--muted);font-size:0.78rem;font-style:italic;">Empty</div>'}</div></div>`;
    });
    return html || '<div style="color:var(--muted);font-size:0.78rem;font-style:italic;padding:0.2rem 0;">Empty</div>';
  }

  function buildDocsSection(docs, sectionKey, sectionTitle, sectionIcon) {
    const rawDocs = docs.filter(doc => (doc.folder_section || 'firm_uploaded') === sectionKey);
    const engagementLetters = sectionKey === 'firm_uploaded' ? rawDocs.filter(isEngagementLetterDoc) : [];
    const sectionDocs = rawDocs.filter(doc => !isEngagementLetterDoc(doc)).map(doc => ({ ...doc, folder_category: normalizePersonDocCategory(doc.folder_category || doc.doc_type) }));
    const categories = personDocCats();
    const renderYear = year => {
      const yearDocs = sectionDocs.filter(doc => (doc.year || '') === year);
      return `<div class="year-folder" style="margin-bottom:0.4rem;"><div class="year-header"><span class="yr-label">📅 ${year} <span class="yr-count">${yearDocs.length}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:1rem;">${categories.map(category => { const files = yearDocs.filter(doc => doc.folder_category === category.key); return `<div class="cat-folder"><div class="cat-folder-header" onclick="this.closest('.cat-folder').classList.toggle('open')"><span class="cat-folder-label">${category.icon} ${category.label}</span><span style="display:flex;align-items:center;gap:0.5rem;"><span class="cat-folder-meta">${files.length} file${files.length !== 1 ? 's' : ''}</span><span class="cat-chevron">▼</span></span></div><div class="cat-folder-body">${renderPersonCategoryFiles(files, sectionKey, category.key, year)}</div></div>`; }).join('')}</div></div>`;
    };
    let html = `<div class="docs-col-title">${sectionIcon} ${sectionTitle} <span style="font-size:0.75rem;font-weight:400;color:var(--muted);">(${sectionDocs.length + engagementLetters.length})</span></div>`;
    if (engagementLetters.length) html += `<div class="year-folder" style="margin-bottom:0.65rem;"><div class="year-header"><span class="yr-label">📄 Engagement Letters <span class="yr-count">${engagementLetters.length}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:1rem;">${engagementLetters.map(doc => renderPersonDocRow(doc, sectionKey)).join('')}</div></div>`;
    DOCS_YEARS.slice(0, 2).forEach(year => { html += renderYear(year); });
    const priorYears = DOCS_YEARS.slice(2);
    const priorCount = priorYears.reduce((count, year) => count + sectionDocs.filter(doc => (doc.year || '') === year).length, 0);
    html += `<div class="year-folder" style="margin-bottom:0.4rem;"><div class="year-header"><span class="yr-label">📂 Prior Years <span class="yr-count">${priorCount}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:0.5rem;">${priorYears.map(renderYear).join('')}</div></div>`;
    return html;
  }

  async function loadDocs() {
    const el = document.getElementById('docs-content');
    if (el.dataset.loaded) return;
    el.dataset.loaded = '1';
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading documents…</div></div>';
    try {
      const [docsRes, foldersRes] = await Promise.all([
        apiFetch(`/api/documents?owner_type=person&owner_id=${personId}`),
        apiFetch(`/api/documents/folders?owner_type=person&owner_id=${personId}`),
      ]);
      docsData = await docsRes.json();
      documentFolders = foldersRes.ok ? await foldersRes.json() : [];
      renderDocs();
    } catch(e) { el.innerHTML = '<div class="empty-state">Failed to load documents.</div>'; }
  }

  async function loadTrashDocs() {
    const el = document.getElementById('docs-content');
    docsShowingTrash = true;
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading Trash…</div></div>';
    try {
      const res = await apiFetch(`/api/documents?owner_type=person&owner_id=${personId}&include_deleted=only`);
      docsTrashData = await res.json();
      renderDocs();
    } catch(e) { el.innerHTML = '<div class="empty-state">Failed to load Trash.</div>'; }
  }

  function renderDocsToolbar() {
    const trashCount = docsTrashData.length ? ` (${docsTrashData.length})` : '';
    return `
      <button class="btn btn-outline btn-sm" onclick="openAddFolderModal()">+ Add Folder</button>
      <button class="btn btn-gold btn-sm" onclick="openUploadModal()">↑ Upload Document</button>
      ${docsShowingTrash
        ? `<button class="btn btn-outline btn-sm" onclick="docsShowingTrash=false;renderDocs();">← Active Documents</button>`
        : `<button class="btn btn-outline btn-sm" onclick="loadTrashDocs();">🗑 Trash${trashCount}</button>`}`;
  }

  function renderDocsActions() {
    const toolbar = document.getElementById('docs-toolbar');
    if (toolbar) toolbar.innerHTML = renderDocsToolbar();
  }

  function refreshPersonUploadFolderOptions() {
    const section = document.getElementById('upload-section')?.value || 'firm_uploaded';
    const category = document.getElementById('upload-doc-type')?.value || 'other';
    const select = document.getElementById('upload-folder');
    if (select) select.innerHTML = personFolderOptions(section, category, '');
  }

  function openAddFolderModal() {
    syncUploadDocTypeOptions();
    document.getElementById('add-folder-category').innerHTML = personDocCategoryOptions('tax');
    document.getElementById('add-folder-name').value = '';
    document.getElementById('add-folder-error').style.display = 'none';
    document.getElementById('add-folder-modal').classList.remove('hidden');
    setTimeout(() => document.getElementById('add-folder-name').focus(), 0);
  }

  function closeAddFolderModal() {
    document.getElementById('add-folder-modal').classList.add('hidden');
  }

  async function submitAddFolder() {
    const button = document.getElementById('add-folder-submit');
    const error = document.getElementById('add-folder-error');
    const applyTo = document.getElementById('add-folder-scope').value;
    button.disabled = true;
    button.textContent = 'Adding…';
    error.style.display = 'none';
    try {
      const response = await apiFetch('/api/documents/folders', {
        method: 'POST',
        body: JSON.stringify({
          name: document.getElementById('add-folder-name').value,
          folder_section: document.getElementById('add-folder-section').value,
          folder_category: document.getElementById('add-folder-category').value,
          scope: applyTo === 'client' ? 'client' : 'firm',
          applies_to: applyTo === 'client' ? 'person' : applyTo,
          owner_type: 'person',
          owner_id: personId,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to create folder');
      documentFolders.push(data);
      closeAddFolderModal();
      refreshPersonUploadFolderOptions();
      renderDocs();
      toast('Folder added');
    } catch (err) {
      error.textContent = err.message;
      error.style.display = 'block';
    } finally {
      button.disabled = false;
      button.textContent = 'Add Folder';
    }
  }

  function renderTrashDocs() {
    const rows = docsTrashData.map(doc => {
      const ftb = fileTypeBadge(doc.mime_type, doc.display_name);
      const name = (doc.display_name || 'Document').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
      const deletedAt = doc.deleted_at ? new Date(doc.deleted_at).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/New_York',timeZoneName:'short'}) : 'Unknown';
      return `<div class="doc-row" data-docid="${doc.id}">
        <span style="flex-shrink:0;padding:0.15rem 0.4rem;border-radius:4px;font-size:0.65rem;font-weight:700;color:#fff;background:${ftb.color};letter-spacing:0.03em;">${ftb.label}</span>
        <div class="doc-info"><div class="doc-name">${esc(name)}</div><div class="doc-badges"><span class="doc-badge doc-badge-type">${esc(doc.year || 'No year')}</span><span style="font-size:0.67rem;color:var(--muted);opacity:0.7;">Deleted ${deletedAt}</span></div></div>
        <div style="display:flex;gap:0.4rem;flex-shrink:0;align-items:center;">
          <button class="btn btn-outline btn-xs" onclick="restoreDoc(${doc.id},event)">Restore</button>
          <button class="btn btn-ghost btn-xs" style="color:var(--red)" onclick="permanentDeleteDoc(${doc.id},event)">Delete Forever</button>
        </div>
      </div>`;
    }).join('');
    return `<div style="background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:10px;padding:1rem;">
      <div class="docs-col-title">🗑 Trash <span style="font-size:0.75rem;font-weight:400;color:var(--muted);">(${docsTrashData.length})</span></div>
      ${rows || '<div class="empty-state">Trash is empty.</div>'}
      <div style="margin-top:0.75rem;font-size:0.75rem;color:var(--muted);">Trash does not auto-empty. Use Delete Forever only when you intentionally want to remove the S3 object.</div>
    </div>`;
  }

  function buildOrganizerDocsSection(docs) {
    const orgDocs = docs.filter(d => d.folder_category === 'organizer');
    if (!orgDocs.length) return '';
    const byYear = {};
    orgDocs.forEach(d => { const y = d.year || 'Unknown'; if (!byYear[y]) byYear[y] = []; byYear[y].push(d); });
    const uid = 'org-docs-' + Date.now();
    let innerHtml = '';
    Object.keys(byYear).sort((a,b) => b.localeCompare(a)).forEach(yr => {
      innerHtml += `<div style="margin-bottom:0.5rem;"><div style="font-size:0.73rem;font-weight:600;color:var(--muted);margin-bottom:0.3rem;padding-bottom:0.2rem;border-bottom:1px solid rgba(255,255,255,0.05);">📅 ${yr} <span style="font-weight:400;">(${byYear[yr].length} file${byYear[yr].length!==1?'s':''})</span></div>`;
      byYear[yr].forEach(doc => {
        const ftb = fileTypeBadge(doc.mime_type, doc.display_name);
        const name = (doc.display_name || 'Document').replace(/_/g,' ').trim();
        innerHtml += `<div style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0.4rem;border-radius:5px;" onmouseenter="this.style.background='rgba(255,255,255,0.03)'" onmouseleave="this.style.background=''">
          <span style="flex-shrink:0;padding:0.1rem 0.35rem;border-radius:3px;font-size:0.62rem;font-weight:700;color:#fff;background:${ftb.color};">${ftb.label}</span>
          <span style="flex:1;font-size:0.8rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${esc(name)}">${esc(name)}</span>
          <button onclick="downloadDoc(${doc.id},this)" style="background:none;border:1px solid var(--border);border-radius:4px;padding:0.1rem 0.45rem;font-size:0.7rem;color:var(--muted);cursor:pointer;">⬇</button>
        </div>`;
      });
      innerHtml += `</div>`;
    });
    return `<div style="background:rgba(201,168,76,0.04);border:1px solid rgba(201,168,76,0.2);border-radius:10px;margin-bottom:1.25rem;overflow:hidden;">
