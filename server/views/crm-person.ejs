            <span style="flex:1;min-width:0;font-size:0.82rem;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(j.pipeline_name)}${yr}</span>
            <span style="font-size:0.74rem;color:var(--muted);flex-shrink:0;">${stage}</span>
