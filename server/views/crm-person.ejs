  // Unified send — creates thread if needed, replies if thread exists
  async function commSendMessage() {
    if (commCurrentThreadArchived) {
      window._shellToast('Restore this conversation before replying.', 'info');
      return;
    }
    const body = document.getElementById('comm-reply-body').value.trim();
    if (!body && commAttachFiles.length === 0 && commAttachClientDocs.length === 0) return;
    const isSms = document.getElementById('comm-sms-check')?.checked;

    if (isSms) {
      if (!body) {
        toast('Write a text message first', 'error');
        return;
      }
      if (commAttachFiles.length || commAttachClientDocs.length) {
        toast('Attachments and client documents must be sent through the secure portal, not by text.', 'error');
        return;
      }
      try {
        const res = await apiFetch('/api/messages/sms', {
          method: 'POST',
          body: JSON.stringify({
            person_id: commPersonId,
            body,
            ...(commActiveThreadId ? { thread_id: commActiveThreadId } : {}),
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to send SMS');
        document.getElementById('comm-reply-body').value = '';
        const useThreadId = data.thread_id || commActiveThreadId;
        commActiveThreadId = useThreadId;
        await loadConversation();
        toast('Text message sent ✓');
      } catch(e) {
        await loadConversation();
        toast(e.message, 'error');
      }
      return;
    }

    if (!commActiveThreadId) {
      // No thread yet — create one
      try {
        const res = await apiFetch('/api/messages', { method: 'POST', body: JSON.stringify({ person_id: commPersonId, subject: '', body, is_internal: false, document_ids: commAttachClientDocs.map(d => d.id) }) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        commActiveThreadId = data.threadId;
        if (commAttachFiles.length > 0 && commActiveThreadId) {
          const fd = new FormData();
          fd.append('body', '');
          commAttachFiles.forEach(f => fd.append('files', f));
          await apiFetch(`/api/messages/${commActiveThreadId}/reply`, { method: 'POST', body: fd });
        }
        document.getElementById('comm-reply-body').value = '';
        commAttachFiles = [];
        commAttachClientDocs = [];
        renderCommAttachChips();
        await loadConversation();
        toast('Message sent');
      } catch(e) { toast('Failed to send message', 'error'); }
      return;
    }

    // Existing thread — optimistic reply
    const filesToSend = commAttachFiles.slice();
    const docsToSend = commAttachClientDocs.slice();
    const tempId = 'local-comm-' + Date.now();
    commAppendBubble({ id:tempId, senderType:'staff', senderName:'You', body, isInternal:false, pending:true, createdAt:new Date().toISOString(), attachments:filesToSend.map(f => ({ displayName:f.name, sizeBytes:f.size })).concat(docsToSend.map(d => ({ displayName:d.displayName, sizeBytes:d.sizeBytes, documentId:d.id }))) });
    try {
      const fd = new FormData();
      fd.append('body', body);
      fd.append('is_internal', 'false');
      filesToSend.forEach(f => fd.append('files', f));
      docsToSend.forEach(d => fd.append('document_ids', String(d.id)));
      document.getElementById('comm-reply-body').value = '';
      commAttachFiles = [];
      commAttachClientDocs = [];
      renderCommAttachChips();
      const replyRes = await apiFetch(`/api/messages/${commActiveThreadId}/reply`, { method: 'POST', body: fd });
      const data = await replyRes.json().catch(() => ({}));
      if (!replyRes.ok) throw new Error(data.error || `Server error ${replyRes.status}`);
      if (data.threadId) commActiveThreadId = data.threadId;
      commSettlePending(tempId, data.message || { id:data.messageId, senderType:'staff', senderName:'You', body, isInternal:false, createdAt:new Date().toISOString(), attachments:docsToSend.map(d => ({ displayName:d.displayName, sizeBytes:d.sizeBytes, documentId:d.id })) });
      await loadThread(commActiveThreadId, false);
    } catch(e) { console.error('[comm] sendMessage error:', e); commFailPending(tempId); toast('Failed to send: ' + e.message, 'error'); }
  }

