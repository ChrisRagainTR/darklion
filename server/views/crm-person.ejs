  // ── Communication JS ──
  let commPersonId = null;
  let commActiveThreadId = null;
  let commView = 'active';
  let commArchivedThreads = [];
  let commCurrentThreadArchived = false;
  let commPreferredReplyChannel = 'portal';
  let commAttachFiles = [];
  let commAttachClientDocs = [];
  let commNewAttachFiles = [];

  // ── @mention picker for comm reply box ──────────────────────────────────────
  (function() {
    let _commFirmUsers = [];
    let _commMentionStart = -1;
    const getTA = () => document.getElementById('comm-reply-body');
    const getPicker = () => document.getElementById('comm-mention-picker');

    // Use a body-level picker to avoid overflow/z-index clipping
    let _commPicker = null;
    function getOrCreatePicker() {
      if (!_commPicker) {
        _commPicker = document.createElement('div');
        _commPicker.id = 'comm-mention-picker-float';
        _commPicker.style.cssText = 'display:none;position:fixed;z-index:9999;background:var(--charcoal,#1c2b3a);border:1px solid var(--gold,#c9a84c);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.5);min-width:200px;max-height:220px;overflow-y:auto;';
        document.body.appendChild(_commPicker);
      }
      return _commPicker;
    }
    function hidePicker() { const p = getOrCreatePicker(); p.style.display = 'none'; _commMentionStart = -1; }
    function positionPicker(ta) {
      const picker = getOrCreatePicker();
      const rect = ta.getBoundingClientRect();
      picker.style.left = rect.left + 'px';
      picker.style.width = rect.width + 'px';
      // Always above — use rAF so picker height is known after render
      requestAnimationFrame(() => {
        const ph = picker.offsetHeight;
        picker.style.top = Math.max(8, rect.top - ph - 6) + 'px';
      });
    }
    function insertMention(name) {
      const ta = getTA(); if (!ta) return;
      const val = ta.value, pos = ta.selectionStart;
      ta.value = val.slice(0, _commMentionStart) + '@' + name + ' ' + val.slice(pos);
      const np = _commMentionStart + name.length + 2;
      ta.setSelectionRange(np, np); ta.focus(); hidePicker();
    }

    document.addEventListener('keyup', function(e) {
      const ta = getTA();
      if (!ta || e.target !== ta) return;
      const val = ta.value, pos = ta.selectionStart;
      const textBefore = val.slice(0, pos);
      const atIdx = textBefore.lastIndexOf('@');
      if (atIdx === -1 || (atIdx > 0 && /\S/.test(val[atIdx - 1]))) { hidePicker(); return; }
      const query = textBefore.slice(atIdx + 1).toLowerCase();
      if (query.includes(' ') && query.split(' ').length > 2) { hidePicker(); return; }
      _commMentionStart = atIdx;
      if (!_commFirmUsers.length) {
        apiFetch('/firms/team').then(r => r.json()).then(u => { _commFirmUsers = u || []; }).catch(() => {});
        return;
      }
      const matches = _commFirmUsers.filter(u => (u.name || u.email || '').toLowerCase().includes(query)).slice(0, 8);
      if (!matches.length) { hidePicker(); return; }
      const picker = getOrCreatePicker();
      picker.innerHTML = matches.map(u => {
        const name = u.name || u.email;
        const ini = name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
        return `<div class="comm-mention-item" data-name="${name.replace(/"/g,'')}" style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;color:var(--text,#e8edf2);">
          <div style="width:26px;height:26px;border-radius:50%;background:rgba(201,168,76,0.15);color:var(--gold,#c9a84c);display:flex;align-items:center;justify-content:center;font-size:0.68rem;font-weight:700;">${ini}</div>
          <span>${name}</span></div>`;
      }).join('');
      picker.style.display = 'block';
      positionPicker(ta);
      picker.querySelectorAll('.comm-mention-item').forEach(item => {
        item.addEventListener('mouseenter', () => item.style.background = 'rgba(201,168,76,0.1)');
        item.addEventListener('mouseleave', () => item.style.background = '');
        item.addEventListener('mousedown', ev => { ev.preventDefault(); insertMention(item.dataset.name); });
      });
    });
    document.addEventListener('keydown', e => { if (getOrCreatePicker().style.display !== 'none' && e.key === 'Escape') hidePicker(); });

    // Pre-load users so picker is instant
    apiFetch('/firms/team').then(r => r.json()).then(u => { _commFirmUsers = u || []; }).catch(() => {});
  })();

  function initComm(pid) {
    if (!pid) { console.error('[comm] initComm called with no personId'); return; }
    if (commPersonId === pid) return; // already initialized for this person
    commPersonId = pid;
    commActiveThreadId = null;
    commView = 'active';
    commCurrentThreadArchived = false;
    _commSummaryLoaded = false;
    updateCommViewControls();
    commShowEmpty();
    loadConversation();
    loadCommArchivedThreads(false);
    // Auto-generate summary on first open
    loadCommSummary(false);
    // Enter to send, Shift+Enter for newline
    const ta = document.getElementById('comm-reply-body');
    if (ta && !ta._shiftEnterBound) {
      ta.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey && !e.altKey && !e.ctrlKey && !e.metaKey && !e.isComposing) {
          e.preventDefault();
          commSendMessage();
        }
      });
      ta._shiftEnterBound = true;
    }
  }

  // ── AI Summary ──────────────────────────────────────────────────────────────
  let _commSummaryLoaded = false;
  async function loadCommSummary(force = false) {
    if (!commPersonId) return;
    if (commView === 'archived') return;
    const body = document.getElementById('comm-summary-body');
    const btn = document.getElementById('comm-summary-refresh-btn');
    if (!body) return;
    body.innerHTML = '<div style="display:flex;align-items:center;gap:0.5rem;color:var(--muted);"><div class="loading-spinner" style="width:16px;height:16px;border-width:2px;"></div> Generating summary…</div>';
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/messages/person/${commPersonId}/summary`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      _commSummaryLoaded = true;
      if (!data.summary) {
        body.innerHTML = `<div style="color:var(--muted);font-style:italic;">${data.message || 'No messages in the last 30 days.'}</div>`;
      } else {
        // Format markdown-style bold headers
        const html = data.summary
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\n/g, '<br>');
        body.innerHTML = `<div>${html}</div>
          <div style="margin-top:1rem;font-size:0.72rem;color:var(--muted);border-top:1px solid var(--border);padding-top:0.5rem;">
            Based on ${data.messageCount} message${data.messageCount !== 1 ? 's' : ''} · ${new Date(data.generatedAt).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}
          </div>`;
      }
    } catch(e) {
      body.innerHTML = `<div style="color:var(--red);font-size:0.8rem;">Failed: ${e.message}</div>`;
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '↺ Refresh'; }
    }
  }

  function updateCommViewControls() {
    const archived = commView === 'archived';
    document.getElementById('comm-view-active')?.classList.toggle('active', !archived);
    document.getElementById('comm-view-archived')?.classList.toggle('active', archived);
    const threadSelect = document.getElementById('comm-archive-thread-select');
    if (threadSelect) threadSelect.style.display = archived && commArchivedThreads.length ? 'block' : 'none';
    const archiveBanner = document.getElementById('comm-archive-banner');
    if (archiveBanner) archiveBanner.style.display = archived && commCurrentThreadArchived ? 'flex' : 'none';
    const replyBox = document.getElementById('comm-reply-box');
    if (replyBox) replyBox.style.display = archived ? 'none' : '';
    const sidePanel = document.querySelector('#tab-communication .comm-summary-panel');
    sidePanel?.classList.toggle('archive-date-mode', archived);
    const sideTitle = document.getElementById('comm-side-panel-title');
    if (sideTitle) sideTitle.textContent = archived ? 'Conversation Dates' : '🤖 30-Day Summary';
    const refreshButton = document.getElementById('comm-summary-refresh-btn');
    if (refreshButton) refreshButton.style.display = archived ? 'none' : '';
  }

  async function setCommView(view) {
    if (!['active', 'archived'].includes(view)) return;
    commView = view;
    commActiveThreadId = null;
    commCurrentThreadArchived = false;
    updateCommViewControls();
    if (view === 'archived') {
      await loadCommArchivedThreads(true);
    } else {
      await loadConversation();
      await loadCommSummary(true);
    }
  }

  async function loadCommArchivedThreads(openFirst = false) {
    if (!commPersonId) return;
    try {
      const archivedResponse = await apiFetch(`/api/messages/person/${commPersonId}?scope=mine&view=archived`);
      if (!archivedResponse.ok) throw new Error('Failed to load archived conversations');
      commArchivedThreads = await archivedResponse.json();
      const archiveCount = document.getElementById('comm-archive-count');
      if (archiveCount) archiveCount.textContent = commArchivedThreads.length;
      const threadSelect = document.getElementById('comm-archive-thread-select');
      if (threadSelect) {
        threadSelect.innerHTML = commArchivedThreads.map(thread => {
          const label = thread.subject || new Date(thread.lastMessageAt || thread.createdAt).toLocaleDateString();
          return `<option value="${thread.id}">${esc(label)} · ${new Date(thread.lastMessageAt || thread.createdAt).toLocaleDateString()}</option>`;
        }).join('');
      }
      updateCommViewControls();
      if (commView !== 'archived' || !openFirst) return;
      if (!commArchivedThreads.length) {
        commShowEmpty('No archived conversations for this client.');
        renderCommDateNavigation([]);
        return;
      }
      await loadThread(commArchivedThreads[0].id, false);
    } catch (error) {
      console.error('[comm] archived conversation load failed:', error);
      if (commView === 'archived') commShowEmpty('Archived conversations could not be loaded.');
    }
  }

  function commSelectArchivedThread(threadId) {
    const parsedThreadId = parseInt(threadId, 10);
    if (parsedThreadId) loadThread(parsedThreadId, false);
  }

  async function commRestoreArchivedThread() {
    if (!commActiveThreadId || !commCurrentThreadArchived) return;
    const restoredThreadId = commActiveThreadId;
    try {
      const restoreResponse = await apiFetch(`/api/messages/${restoredThreadId}/restore`, { method: 'PUT' });
      const restoreResult = await restoreResponse.json().catch(() => ({}));
      if (!restoreResponse.ok) throw new Error(restoreResult.error || 'Failed to restore conversation');
      await loadCommArchivedThreads(false);
      commView = 'active';
      commCurrentThreadArchived = false;
      updateCommViewControls();
      await loadConversation(restoredThreadId);
      await loadCommSummary(true);
      window._shellToast('Conversation restored to Messages', 'success');
    } catch (error) {
      window._shellToast(error.message || 'Failed to restore conversation', 'error');
    }
  }

  function commMessageDateKey(timestamp) {
    const date = new Date(timestamp);
    if (Number.isNaN(date.getTime())) return '';
    const pad = value => String(value).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  }

  function commMessageDateLabel(timestamp, options) {
    const date = new Date(timestamp);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-US', options);
  }

  function commBuildTimeline(messages, buildBubble) {
    let previousDate = '';
    return messages.map(message => {
      const dateKey = commMessageDateKey(message.createdAt);
      let divider = '';
      if (dateKey && dateKey !== previousDate) {
        const label = commMessageDateLabel(message.createdAt, { weekday:'short', month:'short', day:'numeric', year:'numeric' });
        divider = `<div class="comm-date-divider" id="comm-date-${dateKey}" data-comm-date="${dateKey}"><span>${esc(label)}</span></div>`;
      }
      previousDate = dateKey || previousDate;
      return divider + buildBubble(message);
    }).join('');
  }

  function renderCommDateNavigation(messages) {
    if (commView !== 'archived') return;
    const groups = [];
    const groupsByDate = new Map();
    for (const message of messages) {
      const dateKey = commMessageDateKey(message.createdAt);
      if (!dateKey) continue;
      if (!groupsByDate.has(dateKey)) {
        const group = {
          key: dateKey,
          count: 0,
          dateLabel: commMessageDateLabel(message.createdAt, { month:'short', day:'numeric' }),
          fullLabel: commMessageDateLabel(message.createdAt, { month:'long', day:'numeric', year:'numeric' }),
          monthLabel: commMessageDateLabel(message.createdAt, { month:'long', year:'numeric' }),
        };
        groupsByDate.set(dateKey, group);
        groups.push(group);
      }
      groupsByDate.get(dateKey).count += 1;
    }

    const sideBody = document.getElementById('comm-summary-body');
    const compactSelect = document.getElementById('comm-date-jump-compact');
    if (compactSelect) {
      compactSelect.innerHTML = groups.length
        ? '<option value="">Jump to date…</option>' + groups.map(group => `<option value="${group.key}">${esc(group.fullLabel)} (${group.count})</option>`).join('')
        : '<option value="">No dated messages</option>';
    }
    if (!sideBody) return;
    if (!groups.length) {
      sideBody.innerHTML = '<div style="color:var(--muted);font-style:italic;">No dated messages in this conversation.</div>';
      return;
    }
    let currentMonth = '';
    let navigationHtml = '';
    for (const group of groups) {
      if (group.monthLabel !== currentMonth) {
        if (currentMonth) navigationHtml += '</div>';
        currentMonth = group.monthLabel;
        navigationHtml += `<div class="comm-date-month"><div class="comm-date-month-label">${esc(currentMonth)}</div>`;
      }
      navigationHtml += `<button class="comm-date-link" data-comm-date-link="${group.key}" onclick="commJumpToDate('${group.key}')"><span>${esc(group.dateLabel)}</span><span class="comm-date-count">${group.count}</span></button>`;
    }
    if (currentMonth) navigationHtml += '</div>';
    sideBody.innerHTML = navigationHtml;
    updateCommActiveDate();
  }

  function commJumpToDate(dateKey) {
    if (!dateKey) return;
    document.getElementById(`comm-date-${dateKey}`)?.scrollIntoView({ behavior:'smooth', block:'start' });
    setCommActiveDate(dateKey);
  }

  function setCommActiveDate(dateKey) {
    document.querySelectorAll('[data-comm-date-link]').forEach(link => link.classList.toggle('active', link.dataset.commDateLink === dateKey));
    const compactSelect = document.getElementById('comm-date-jump-compact');
    if (compactSelect && dateKey) compactSelect.value = dateKey;
  }

  function updateCommActiveDate() {
    if (commView !== 'archived') return;
    const messageContainer = document.getElementById('comm-detail-messages');
    if (!messageContainer) return;
    const dividers = [...messageContainer.querySelectorAll('[data-comm-date]')];
    if (!dividers.length) return;
    const threshold = messageContainer.getBoundingClientRect().top + 80;
    let activeDate = dividers[0].dataset.commDate;
    for (const divider of dividers) {
      if (divider.getBoundingClientRect().top <= threshold) activeDate = divider.dataset.commDate;
      else break;
    }
    setCommActiveDate(activeDate);
  }

  document.getElementById('comm-detail-messages')?.addEventListener('scroll', () => {
    window.requestAnimationFrame(updateCommActiveDate);
  }, { passive:true });

  function commShowEmpty(message = 'No messages yet — send the first one below') {
    document.getElementById('comm-no-thread').style.display = 'flex';
    document.getElementById('comm-detail-messages').innerHTML = '';
    const emptyMessage = document.querySelector('#comm-no-thread > div:last-child');
    if (emptyMessage) emptyMessage.textContent = message;
  }
  function commShowDetail() {
    document.getElementById('comm-no-thread').style.display = 'none';
    // Show SMS toggle if person has a phone number on file
    apiFetch(`/api/people/${personId}`).then(r=>r.json()).then(p => {
      const wrap = document.getElementById('comm-sms-toggle-wrap');
      if (wrap) wrap.style.display = p.phone ? '' : 'none';
    }).catch(()=>{});
  }
  function commOpenNew() { /* no-op — compose is now the reply box */ }
  function commCloseNew() { /* no-op */ }

  function commCopyDraft(msgId) {
    const el = document.getElementById('emma-draft-body-' + msgId);
    if (!el) return;
    const ta = document.getElementById('comm-reply-body');
    if (ta) { ta.value = el.textContent; ta.focus(); }
    toast('Draft copied to reply box');
  }

  async function commSendDraft(msgId) {
    if (commCurrentThreadArchived) return;
    const el = document.getElementById('emma-draft-body-' + msgId);
    if (!el) return;
    const body = el.textContent.trim();
    if (!body) return;
    const btn = document.querySelector(`[onclick="commSendDraft(${msgId})"]`);
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    try {
      if (!commActiveThreadId) return;
      const fd = new FormData();
      fd.append('body', body);
      fd.append('is_internal', 'false');
      const res = await apiFetch(`/api/messages/${commActiveThreadId}/reply`, { method: 'POST', body: fd });
      if (!res.ok) throw new Error((await res.json()).error || 'Failed');
      toast('Message sent ✓');
      await loadConversation();
    } catch(e) { toast(e.message || 'Failed to send', 'error'); if (btn) { btn.disabled = false; btn.textContent = 'Send As-Is'; } }
  }

  // ── Template picker ──
  let _commTemplates = null;
  async function commOpenTemplatePicker() {
    const overlay = document.getElementById('comm-tmpl-overlay');
    overlay.style.display = 'flex';
    document.getElementById('comm-tmpl-search').value = '';
    document.getElementById('comm-tmpl-list').innerHTML = '<div style="padding:1rem;text-align:center;color:var(--muted);">Loading…</div>';
    if (!_commTemplates) {
      try {
        const res = await apiFetch('/api/templates');
        _commTemplates = await res.json();
      } catch(e) { _commTemplates = []; }
    }
    commRenderTemplates(_commTemplates);
  }
  function commCloseTemplatePicker() {
    document.getElementById('comm-tmpl-overlay').style.display = 'none';
  }
  function commFilterTemplates(q) {
    if (!_commTemplates) return;
    const filtered = q ? _commTemplates.filter(t => t.name.toLowerCase().includes(q.toLowerCase()) || t.body.toLowerCase().includes(q.toLowerCase())) : _commTemplates;
    commRenderTemplates(filtered);
  }
  function commRenderTemplates(list) {
    const el = document.getElementById('comm-tmpl-list');
    if (!list.length) {
      el.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--muted);font-style:italic;">No templates found</div>';
      return;
    }
    el.innerHTML = list.map(t => `
      <div style="padding:0.75rem 1.25rem;border-bottom:1px solid var(--border);cursor:pointer;transition:background 0.1s;"
        onmouseover="this.style.background='rgba(201,168,76,0.07)'" onmouseout="this.style.background=''"
        onclick="commLoadTemplate(${t.id})">
        <div style="font-weight:600;font-size:0.88rem;margin-bottom:0.25rem;">${esc(t.name)}</div>
        <div style="font-size:0.78rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(t.body.slice(0,100))}${t.body.length>100?'…':''}</div>
      </div>`).join('');
  }
  function resolveTemplateVars(body) {
    const p = personData || {};
    const firmName = (() => { try { return JSON.parse(atob((window.DLAuth ? window.DLAuth.token() : localStorage.getItem('dl_token')).split('.')[1])).firmName || ''; } catch(e) { return ''; } })();
    const companies = p.company_access || [];
    let companyResolved;
    if (companies.length === 1) {
      companyResolved = companies[0].company_name || '{Company Name}';
    } else if (companies.length > 1) {
      // List all company names separated by " / " — staff deletes the ones they don't want
      companyResolved = companies.map(c => c.company_name).filter(Boolean).join(' / ');
    } else {
      companyResolved = '{Company Name}';
    }
    return body
      .replace(/\{First Name\}/g, p.first_name || '')
      .replace(/\{Last Name\}/g, p.last_name || '')
      .replace(/\{Full Name\}/g, [p.first_name, p.last_name].filter(Boolean).join(' ') || '')
      .replace(/\{Company Name\}/g, companyResolved)
      .replace(/\{Firm Name\}/g, firmName);
  }

  function commLoadTemplate(id) {
    const t = _commTemplates && _commTemplates.find(x => x.id === id);
    if (!t) return;
    document.getElementById('comm-reply-body').value = resolveTemplateVars(t.body);
    commCloseTemplatePicker();
    document.getElementById('comm-reply-body').focus();
  }

  function commInitials(name) {
    return (name||'?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2) || '?';
  }

  // Single-convo loader: fetches thread list, picks most recent, loads messages
  async function loadConversation(preferredThreadId = null) {
    if (!commPersonId) return;
    try {
      const res = await apiFetch(`/api/messages/person/${commPersonId}?scope=mine`);
      if (!res.ok) return;
      const threads = await res.json();
      if (!threads.length) { commShowEmpty(); return; }
      // Use most recent thread
      const thread = threads.find(candidate => candidate.id === preferredThreadId) || threads[0];
      commActiveThreadId = thread.id;
      await loadThread(thread.id, false);
    } catch(e) {
      console.error('[comm] loadConversation error:', e);
    }
  }
  // Keep loadThreads as alias for any remaining callers
  async function loadThreads() { return loadConversation(); }

  async function loadThread(threadId, silent = false) {
    commActiveThreadId = threadId;
    // Mark active
    document.querySelectorAll('#comm-threads .thread-card').forEach(el => el.classList.remove('active'));
    const item = document.getElementById('comm-item-' + threadId);
    if (item) item.classList.add('active');
    if (!silent) {
      document.getElementById('comm-detail-messages').innerHTML = '<div style="display:flex;justify-content:center;padding:2rem;"><div class="spinner"></div></div>';
    }
    commShowDetail();
    try {
      const res = await apiFetch(`/api/messages/${threadId}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to load thread');
      commCurrentThreadArchived = data.isArchived === true;
      updateCommViewControls();
      const archivedThreadSelect = document.getElementById('comm-archive-thread-select');
      if (archivedThreadSelect && commCurrentThreadArchived) archivedThreadSelect.value = String(threadId);
      commPreferredReplyChannel = data.preferredReplyChannel === 'sms' ? 'sms' : 'portal';
      const smsCheck = document.getElementById('comm-sms-check');
      const smsToggle = document.getElementById('comm-sms-toggle');
      if (smsCheck) smsCheck.checked = commPreferredReplyChannel === 'sms';
      if (smsToggle) smsToggle.checked = commPreferredReplyChannel === 'sms';
      const sendButton = document.getElementById('comm-send-reply-btn');
      if (sendButton) sendButton.textContent = commPreferredReplyChannel === 'sms' ? '📱 Send Text' : 'Send Message';

      // Keep header as simple static "Messages" title (already rendered in HTML)

      // Messages — same render as team inbox
      const msgEl = document.getElementById('comm-detail-messages');
      const msgs = data.messages || [];

      function buildCommBubble(m) {
        // Emma draft card
        if (m.isEmmaDraft) {
          return `<div class="msg-bubble-wrap internal" data-msg-id="${m.id}">
            <div class="emma-draft-card">
              <div class="emma-draft-label">🤖 Emma Draft · <span style="font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0;">${relTime(m.createdAt)}</span></div>
              <div class="emma-draft-body" id="emma-draft-body-${m.id}">${esc(m.body||'')}</div>
              <div class="emma-draft-actions" style="${commCurrentThreadArchived ? 'display:none;' : ''}">
                <button class="btn btn-outline btn-sm" onclick="commCopyDraft(${m.id})" style="font-size:0.78rem;">Copy to Reply</button>
                <button class="btn btn-gold btn-sm" onclick="commSendDraft(${m.id})" style="font-size:0.78rem;">Send As-Is</button>
              </div>
            </div>
          </div>`;
        }
        const isInternal = m.isInternal;
        const isStaff = m.senderType === 'staff';
        const side = isInternal ? 'internal' : isStaff ? 'staff' : 'client';
        const bubbleClass = isInternal ? 'internal' : side;
        const attachmentsHtml = (m.attachments||[]).length > 0
          ? `<div class="msg-attachments">${m.attachments.map(a => {
              const size = a.sizeBytes ? ` <span style="font-size:0.7rem;opacity:0.7;">(${commFormatBytes(a.sizeBytes)})</span>` : '';
              return `<a href="#" class="attachment-chip" onclick="commDownloadAttachment(${a.documentId});return false;">📎 ${esc(a.displayName)}${size}</a>`;
            }).join('')}</div>` : '';
        return `<div class="msg-bubble-wrap ${side}" data-msg-id="${m.id}">
          ${isInternal ? '<div class="msg-internal-label">🔒 Internal note</div>' : ''}
          <div class="msg-bubble ${bubbleClass}">${esc(m.body||'').replace(/\n/g,'<br>')}${attachmentsHtml}</div>
          <div class="msg-meta">${esc(m.senderName||'')} · ${relTime(m.createdAt)}</div>
        </div>`;
      }

      if (!msgs.length) {
        if (!silent) msgEl.innerHTML = '<div style="color:var(--muted);text-align:center;padding:2rem;">No messages yet.</div>';
      } else if (silent) {
        // Append-only — only add new messages
        const existingIds = new Set([...msgEl.querySelectorAll('[data-msg-id]')].map(el => parseInt(el.dataset.msgId)));
        let appended = false;
        for (const m of msgs) {
          if (!existingIds.has(m.id)) {
            const dateKey = commMessageDateKey(m.createdAt);
            if (dateKey && !msgEl.querySelector(`[data-comm-date="${dateKey}"]`)) {
              msgEl.insertAdjacentHTML('beforeend', commBuildTimeline([m], () => ''));
            }
            msgEl.insertAdjacentHTML('beforeend', buildCommBubble(m));
            appended = true;
          }
        }
        if (appended) msgEl.scrollTop = msgEl.scrollHeight;
      } else {
        msgEl.innerHTML = commBuildTimeline(msgs, buildCommBubble);
        msgEl.scrollTop = msgEl.scrollHeight;
      }
      renderCommDateNavigation(msgs);
      updateCommActiveDate();
    } catch(e) {
      document.getElementById('comm-detail-messages').innerHTML = '<div style="color:var(--muted);padding:1rem;">Failed to load thread.</div>';
    }
  }

  function commFormatBytes(b) {
    if (!b) return '0 B';
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b/1024).toFixed(1) + ' KB';
    return (b/1048576).toFixed(1) + ' MB';
  }


  function commBuildBubble(m) {
    const isInternal = !!m.isInternal;
    const isStaff = m.senderType === 'staff';
    const side = isInternal ? 'internal' : isStaff ? 'staff' : 'client';
    const bubbleClass = isInternal ? 'internal' : side;
    const attachmentsHtml = (m.attachments||[]).length > 0
      ? `<div class="msg-attachments">${m.attachments.map(a => {
          const size = a.sizeBytes ? ` <span style="font-size:0.7rem;opacity:0.7;">(${commFormatBytes(a.sizeBytes)})</span>` : '';
          return a.documentId ? `<a href="#" class="attachment-chip" onclick="commDownloadAttachment(${a.documentId});return false;">📎 ${esc(a.displayName)}${size}</a>` : `<span class="attachment-chip">📎 ${esc(a.displayName || 'Attachment')}${size}</span>`;
        }).join('')}</div>` : '';
    const failedActions = m.failed ? `<div class="msg-failed-actions"><button class="btn btn-outline btn-sm" onclick="commRestoreFailed('${esc(m.id)}')">Retry</button><button class="btn btn-outline btn-sm" onclick="this.closest('.msg-bubble-wrap')?.remove()">Remove</button></div>` : '';
    const smsStatus = isStaff && m.providerStatus ? ` · ${esc(m.providerStatus)}` : '';
    const channelLabel = !isInternal && m.channel === 'sms'
      ? `<div class="msg-task-label">📱 Text message${smsStatus}</div>`
      : '';
    return `<div class="msg-bubble-wrap ${side}${m.pending ? ' pending' : ''}${m.failed ? ' failed' : ''}" data-msg-id="${esc(m.id)}" data-body="${esc(m.body || '')}">
      ${isInternal ? '<div class="msg-internal-label">🔒 Internal note</div>' : channelLabel}
      <div class="msg-bubble ${bubbleClass}">${esc(m.body||'').replace(/\n/g,'<br>')}${attachmentsHtml}</div>
      <div class="msg-meta">${esc(m.senderName||'You')} · ${m.pending ? 'Sending…' : (m.failed ? 'Failed to send' : relTime(m.createdAt))}</div>
      ${failedActions}
    </div>`;
  }
  function commAppendBubble(m) {
    const msgEl = document.getElementById('comm-detail-messages');
    if (!msgEl) return;
    const near = window.DLStability?.nearBottom(msgEl) !== false;
    msgEl.insertAdjacentHTML('beforeend', commBuildBubble(m));
    if (near || m.senderType === 'staff') msgEl.scrollTop = msgEl.scrollHeight;
  }
  function commSettlePending(tempId, message) {
    const node = document.querySelector(`#comm-detail-messages [data-msg-id="${tempId}"]`);
    if (node && message) node.outerHTML = commBuildBubble(message);
  }
  function commFailPending(tempId) {
    const node = document.querySelector(`#comm-detail-messages [data-msg-id="${tempId}"]`);
    if (!node) return;
    node.classList.remove('pending'); node.classList.add('failed');
    const meta = node.querySelector('.msg-meta'); if (meta) meta.textContent = 'You · Failed to send';
    if (!node.querySelector('.msg-failed-actions')) node.insertAdjacentHTML('beforeend', `<div class="msg-failed-actions"><button class="btn btn-outline btn-sm" onclick="commRestoreFailed('${tempId}')">Retry</button><button class="btn btn-outline btn-sm" onclick="this.closest('.msg-bubble-wrap')?.remove()">Remove</button></div>`);
  }
  function commRestoreFailed(tempId) {
    const node = document.querySelector(`#comm-detail-messages [data-msg-id="${tempId}"]`);
    const ta = document.getElementById('comm-reply-body');
    if (ta) { ta.value = node?.dataset.body || ''; ta.focus(); }
    node?.remove();
  }

