  async function addAdvQuestion(organizerId, year) {
    const label = document.getElementById('adv-add-question').value.trim();
    if (!label) { alert('Enter a question'); return; }

    // Get current questions, add new one
    let questions = [];
    try {
      const res = await apiFetch(`/api/organizers/${personId}/${year}`);
      const data = await res.json();
      questions = data.organizer.custom_questions || [];
    } catch(e) {}

    const key = 'custom_' + Date.now();
    questions.push({ key, label, required: false });

    try {
      const res = await apiFetch(`/api/organizers/${personId}/${year}/questions`, {
        method: 'PUT',
        body: JSON.stringify({ questions }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error); }
      document.getElementById('adv-add-question').value = '';
      loadAdvisorOrganizer();
    } catch(e) { alert('Error: ' + e.message); }
  }

  async function removeAdvQuestion(organizerId, year, index) {
    try {
      const res = await apiFetch(`/api/organizers/${personId}/${year}`);
      const data = await res.json();
      const questions = (data.organizer.custom_questions || []).filter((_,i) => i !== index);
      await apiFetch(`/api/organizers/${personId}/${year}/questions`, {
        method: 'PUT',
        body: JSON.stringify({ questions }),
      });
      loadAdvisorOrganizer();
    } catch(e) { alert('Error: ' + e.message); }
  }

