<!-- ══ RIGHT: DarkLion AI Chat ══ -->
      <div class="dash-right-col">
        <div class="dash-ai-header">
          <div class="dash-ai-avatar">
            <img src="/lion-logo.png" alt="DarkLion AI">
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:0.88rem;" id="dash-ai-title">DarkLion AI</div>
            <div style="font-size:0.72rem;color:var(--muted);" id="emma-status">Connecting…</div>
          </div>
        </div>

        <div class="dash-ai-messages" id="dash-ai-messages">
          <div style="display:flex;align-items:center;gap:0.6rem;padding:1rem;color:var(--muted);font-size:0.82rem;">
            <div style="width:18px;height:18px;border:2px solid var(--gold);border-top-color:transparent;border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0;"></div>
            Loading DarkLion AI…
          </div>
        </div>

        <div class="dash-ai-input-row">
          <textarea class="dash-ai-input" id="dash-ai-input" placeholder="Ask anything…" rows="2" disabled></textarea>
          <button class="dash-ai-send" id="dash-ai-send-btn" disabled title="Send">↑</button>
        </div>
      </div>
