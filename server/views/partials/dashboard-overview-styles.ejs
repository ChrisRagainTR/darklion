        grid-template-columns: 1fr 440px;
        gap: 0;
        height: calc(100vh - var(--header-h) - 58px);
        overflow: hidden;
      }
      @media (max-width: 960px) {
        .dash-overview-wrap { grid-template-columns: 1fr; height: auto; overflow: visible; }
        .dash-right-col { border-left: none !important; border-top: 1px solid var(--border); max-height: 700px; }
      }

      /* Left column */
      .dash-left-col { overflow-y: auto; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 1rem; container-type: inline-size; }

      /* Stat bar */
      .dash-stat-bar { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.65rem; }
      .dash-stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem 1rem; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
