        .dash-chart-inner { height: 190px; }
        .dash-intel-header { padding: 0.8rem 1rem; }
        .dash-intel-title { font-size: 0.78rem; }
        .dash-intel-row { padding: 0.7rem 1rem; font-size: 0.9rem; }
        .dash-intel-empty { padding: 1.2rem 1rem; font-size: 0.9rem; }
      }

      @media (max-width: 420px) {
        .dash-left-col { padding: 0.75rem; }
        .dash-stat-bar { gap: 0.6rem; }
        .dash-stat-card { padding: 0.85rem; min-height: 78px; }
        .dash-stat-val { font-size: 1.5rem; }
        .dash-stat-label { font-size: 0.66rem; letter-spacing: 0.045em; }
        .dash-chart-inner { height: 165px; }
      }

      /* iPad Safari can keep a desktop-width viewport while the chat column
         squeezes the actual dashboard column. Respond to the column itself. */
      @container (max-width: 720px) {
        .dash-stat-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
        .dash-stat-card { padding: 1rem; min-height: 86px; }
        .dash-stat-val { font-size: 1.75rem; }
        .dash-stat-label { font-size: 0.74rem; }
        .dash-charts-grid,
        .dash-intel-grid { grid-template-columns: 1fr !important; gap: 0.85rem !important; }
        .dash-chart-inner { height: 190px; }
      }
    </style>

