      .dash-ai-bubble.user { background: var(--gold, #c9a84c); color: var(--navy, #0f1923); align-self: flex-end; margin-left: 2rem; border-bottom-right-radius: 4px; }
      .dash-ai-input-row { padding: 0.85rem 1.25rem; border-top: 1px solid var(--border); display: flex; gap: 0.5rem; align-items: flex-end; }
      .dash-ai-input { flex: 1; background: var(--input-bg, rgba(255,255,255,0.04)); border: 1px solid var(--border); border-radius: 8px; padding: 0.6rem 0.75rem; color: var(--text); font-size: 0.85rem; font-family: inherit; resize: none; min-height: 64px; max-height: 220px; }
      .dash-ai-input::placeholder { color: var(--muted); }
