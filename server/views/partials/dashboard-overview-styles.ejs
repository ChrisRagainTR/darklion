      .dash-ai-send { background: var(--gold); color: var(--navy); border: none; border-radius: 8px; width: 36px; height: 36px; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; opacity: 0.5; }
      .dash-ai-soon { font-size: 0.68rem; font-weight: 700; background: rgba(201,168,76,0.12); color: var(--gold); border-radius: 8px; padding: 0.15rem 0.5rem; letter-spacing: 0.05em; }
      @keyframes pulse { 0%,100% { opacity:0.4 } 50% { opacity:1 } }

      /* Tablet/mobile dashboard: don't squeeze desktop grids into the viewport */
      @media (max-width: 960px) {
        .dash-left-col { padding: 1rem; gap: 0.85rem; }
        .dash-stat-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
        .dash-stat-card { padding: 1rem; min-height: 86px; }
        .dash-stat-val { font-size: 1.75rem; }
        .dash-stat-label { font-size: 0.74rem; }
        .dash-charts-grid,
