        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .dash-ai-avatar img { width: 26px; height: 26px; object-fit: contain; border-radius: 0; }
      .dash-ai-messages { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.85rem; }
