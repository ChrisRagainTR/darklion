      .dash-stat-val { font-size: 1.55rem; font-weight: 800; color: var(--gold); line-height: 1; margin-bottom: 0.2rem; }
      .dash-stat-label { font-size: 0.68rem; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }

      /* Intel cards */
      .dash-intel-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
      .dash-intel-header { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); }
      .dash-intel-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
      .dash-intel-badge { font-size: 0.68rem; font-weight: 800; background: rgba(201,168,76,0.15); color: var(--gold); border-radius: 10px; padding: 0.1rem 0.5rem; }
      .dash-intel-badge.red { background: rgba(245,101,101,0.12); color: var(--red); }
      .dash-intel-badge.green { background: rgba(62,207,142,0.12); color: var(--green); }
      .dash-intel-row { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.04); cursor: pointer; transition: background 0.1s; font-size: 0.83rem; }
      .dash-intel-row:last-child { border-bottom: none; }
      .dash-intel-row:hover { background: rgba(201,168,76,0.04); }
      .dash-intel-name { font-weight: 600; color: var(--text); }
      .dash-intel-sub { font-size: 0.73rem; color: var(--muted); margin-top: 0.1rem; }
      .dash-intel-tag { font-size: 0.68rem; font-weight: 700; border-radius: 6px; padding: 0.15rem 0.45rem; white-space: nowrap; flex-shrink: 0; }
      .dash-intel-empty { padding: 1rem; text-align: center; color: var(--muted); font-size: 0.82rem; font-style: italic; }

      /* Charts */
      .dash-chart-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; }
      .dash-chart-inner { position: relative; height: 130px; width: 100%; }
      .dash-chart-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.85rem; }

      /* Right col — AI chat placeholder */
      .dash-right-col {
        border-left: 1px solid var(--border);
        display: flex; flex-direction: column;
        overflow: hidden;
      }
      .dash-ai-header {
        padding: 1rem 1.25rem 0.85rem;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; gap: 0.65rem;
      }
      .dash-ai-avatar {
        width: 36px; height: 36px; border-radius: 50%;
