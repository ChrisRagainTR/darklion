  // ── EDIT STAGES ───────────────────────────────────
  window.openEditStagesModal = function() {
    if (!currentTemplateId) return;
    // Load smart stages config alongside stages
    if (currentInstanceId) {
      api('GET', '/templates/' + currentTemplateId).then(function(tmpl) {
        loadSmartStages(tmpl.stages || []);
      }).catch(function() {});
    }
    renderStagesList();
    openModal('edit-stages-modal');
  };

  window.openEditStagesForTemplate = function(templateId) {
    currentTemplateId = templateId;
    smartStageConfigs = {};
    renderStagesList();
    openModal('edit-stages-modal');
  };

  // Smart stages state
  var availableTriggers = [];
  var smartStageConfigs = {}; // stageId -> [{ configId, triggerKey }]
  var currentSmartStages = []; // cached stages for re-render after add/remove

  function renderStagesList() {
    api('GET', '/templates/' + currentTemplateId).then(function(tmpl) {
      var stages = tmpl.stages || [];
      var html = stages.length ? stages.map(function(s, i) {
        var hasTrigger = !!(smartStageConfigs[s.id] && smartStageConfigs[s.id].length);
        var triggerBadge = hasTrigger ? '<span title="Smart stage configured" style="font-size:0.85rem;margin-left:0.25rem;">⚡</span>' : '';
        var terminalChecked = s.is_terminal ? ' checked' : '';
        return '<div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">' +
          '<input type="text" value="' + esc(s.name) + '" style="flex:1;background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.4rem 0.6rem;border-radius:6px;font-size:0.85rem;outline:none;" onblur="renameStage(' + s.id + ',this.value)" />' +
          '<label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--muted);white-space:nowrap;cursor:pointer;" title="Archive card when it reaches this stage">' +
            '<input type="checkbox"' + terminalChecked + ' onchange="toggleTerminalStage(' + s.id + ',this.checked)" style="cursor:pointer;" />' +
            '🏁' +
          '</label>' +
          triggerBadge +
          '<button style="background:none;border:none;color:var(--red);cursor:pointer;font-size:1rem;padding:0 0.3rem;" onclick="deleteStage(' + s.id + ')" title="Delete stage">✕</button>' +
        '</div>';
      }).join('') : '<p style="color:var(--muted);font-size:0.85rem;margin-bottom:0.75rem;">No stages yet.</p>';
      document.getElementById('stages-list').innerHTML = html;
      // If board is showing, update it after stage changes
      if (currentInstanceId) {
        document.getElementById('stages-list').dataset.needsReload = '1';
        renderSmartStages(stages);
      } else {
        document.getElementById('smart-stages-list').innerHTML = '<div style="color:var(--muted);font-size:0.82rem;">Open a pipeline to configure smart stages.</div>';
      }
    }).catch(function(e) { window.toast('Failed to load stages: ' + e.message, 'error'); });
  }

  function loadSmartStages(stages) {
    if (!currentInstanceId) return;
    if (stages) currentSmartStages = stages; // cache for re-renders
    // Load available triggers + existing configs in parallel
    Promise.all([
      fetch('/api/pipeline-triggers', { headers: { 'Authorization': 'Bearer ' + token } }).then(function(r) { return r.ok ? r.json() : []; }),
      fetch('/api/pipeline-triggers/stage-config/' + currentInstanceId, { headers: { 'Authorization': 'Bearer ' + token } }).then(function(r) { return r.ok ? r.json() : []; })
    ]).then(function(results) {
      availableTriggers = results[0];
      var configs = results[1];
      smartStageConfigs = {};
      configs.forEach(function(c) { if (!smartStageConfigs[c.stage_id]) smartStageConfigs[c.stage_id] = []; smartStageConfigs[c.stage_id].push({ configId: c.id, triggerKey: c.trigger_key }); });
      renderSmartStages(currentSmartStages);
    }).catch(function(e) { console.error('loadSmartStages error:', e); });
  }

  function renderSmartStages(stages) {
    if (!currentInstanceId || !stages || !stages.length) {
      document.getElementById('smart-stages-list').innerHTML = stages && stages.length
        ? '<div style="color:var(--muted);font-size:0.82rem;">Open a pipeline to configure smart stages.</div>'
        : '<div style="color:var(--muted);font-size:0.82rem;">Add stages first.</div>';
      return;
    }
    // Group triggers by category for the add dropdown
    var byCategory = {};
    availableTriggers.forEach(function(t) {
      if (!byCategory[t.category]) byCategory[t.category] = [];
      byCategory[t.category].push(t);
    });

    var html = '';
    stages.forEach(function(s) {
      var cfgs = smartStageConfigs[s.id] || [];
      // Chips for existing triggers
      var chips = cfgs.map(function(c) {
        var label = (availableTriggers.find(function(t) { return t.key === c.triggerKey; }) || {}).label || c.triggerKey;
        return '<span style="display:inline-flex;align-items:center;gap:0.3rem;background:rgba(201,168,76,0.12);border:1px solid rgba(201,168,76,0.3);border-radius:12px;padding:0.15rem 0.5rem;font-size:0.75rem;color:var(--gold);">' +
          '⚡ ' + esc(label) +
          '<button onclick="removeSmartStage(' + c.configId + ',' + s.id + ')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.8rem;padding:0;line-height:1;" title="Remove">×</button>' +
          '</span>';
      }).join(' ');

      // Add trigger dropdown (only show triggers not already configured)
      var usedKeys = cfgs.map(function(c) { return c.triggerKey; });
      var addOpts = '<option value="">+ Add trigger…</option>';
      Object.keys(byCategory).sort().forEach(function(cat) {
        var catOpts = byCategory[cat].filter(function(t) { return usedKeys.indexOf(t.key) === -1; });
        if (!catOpts.length) return;
        addOpts += '<optgroup label="' + esc(cat) + '">';
        catOpts.forEach(function(t) { addOpts += '<option value="' + esc(t.key) + '">' + esc(t.label) + '</option>'; });
        addOpts += '</optgroup>';
      });
      var addSelect = cfgs.length >= 2
        ? '<span style="font-size:0.72rem;color:var(--muted);font-style:italic;">Max 2 triggers per stage</span>'
        : '<select onchange="addSmartStage(' + s.id + ', this)" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.25rem 0.4rem;border-radius:6px;font-size:0.75rem;outline:none;">' + addOpts + '</select>';

      html += '<div style="padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">' +
        '<div style="font-weight:600;font-size:0.82rem;margin-bottom:0.35rem;">' + esc(s.name) + '</div>' +
        '<div style="display:flex;align-items:center;flex-wrap:wrap;gap:0.35rem;">' +
        chips + addSelect +
        '</div></div>';
    });
    document.getElementById('smart-stages-list').innerHTML = html || '<div style="color:var(--muted);font-size:0.82rem;">No stages found.</div>';
  }

  window.addSmartStage = function(stageId, selectEl) {
    var triggerKey = selectEl.value;
    if (!triggerKey || !currentInstanceId) { selectEl.value = ''; return; }
    fetch('/api/pipeline-triggers/stage-config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ pipeline_instance_id: currentInstanceId, stage_id: stageId, trigger_key: triggerKey })
    }).then(function(r) { return r.ok ? r.json() : r.json().then(function(e) { throw new Error(e.error || 'Failed'); }); })
    .then(function(cfg) {
      if (!smartStageConfigs[stageId]) smartStageConfigs[stageId] = [];
      smartStageConfigs[stageId].push({ configId: cfg.id, triggerKey: cfg.trigger_key });
      window.toast('⚡ Trigger added');
      loadSmartStages(); // re-render
    }).catch(function(e) { window.toast('Failed: ' + e.message, 'error'); selectEl.value = ''; });
  };

  window.removeSmartStage = function(configId, stageId) {
    fetch('/api/pipeline-triggers/stage-config/' + configId, {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + token }
    }).then(function() {
      if (smartStageConfigs[stageId]) {
        smartStageConfigs[stageId] = smartStageConfigs[stageId].filter(function(c) { return c.configId !== configId; });
        if (!smartStageConfigs[stageId].length) delete smartStageConfigs[stageId];
      }
      window.toast('Trigger removed');
      loadSmartStages();
    }).catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };



  window.renameStage = function(stageId, name) {
    if (!name.trim()) return;
    api('PUT', '/templates/' + currentTemplateId + '/stages/' + stageId, { name: name.trim() })
      .then(function() { if (currentInstanceId) loadBoard(); })
      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  window.toggleTerminalStage = function(stageId, isTerminal) {
    fetch('/api/pipelines/stages/' + stageId + '/terminal', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ is_terminal: isTerminal })
    }).then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.error || 'Failed'); });
      window.toast(isTerminal ? '🏁 Stage marked as terminal' : 'Terminal removed');
      if (currentInstanceId) loadBoard();
    }).catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  window.deleteStage = async function(stageId) {
    if (!await window.dlConfirm('Delete this stage? Jobs in this stage will be moved to the first stage.', {title:'Delete Stage', confirmLabel:'Delete', danger:true, icon:'⚠️'})) return;
    api('DELETE', '/templates/' + currentTemplateId + '/stages/' + stageId)
      .then(function() { renderStagesList(); if (currentInstanceId) return loadBoard(); })
      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  window.addStage = function() {
    var input = document.getElementById('new-stage-name');
    var name = input.value.trim();
    if (!name) return;
    api('POST', '/templates/' + currentTemplateId + '/stages', { name: name, position: 999 })
      .then(function() { input.value = ''; renderStagesList(); if (currentInstanceId) return loadBoard(); })
      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  // ── NEW PIPELINE ──────────────────────────────────
  window.openNewPipelineModal = function() {
    document.getElementById('np-name').value = '';
    openModal('new-pipeline-modal');
  };

  window.submitNewPipeline = function() {
