  window.deleteJob = async function(jobId) {
    if (!await window.dlConfirm('Delete this job? This cannot be undone.', {title:'Delete Job', confirmLabel:'Delete', danger:true, icon:'🗑️'})) return;
    api('DELETE', '/jobs/' + jobId)
      .then(function() { closePanel(); return loadBoard(); })
      .catch(function(err) { window.toast('Failed: ' + err.message, 'error'); });
