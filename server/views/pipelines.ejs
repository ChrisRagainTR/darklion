      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  // ── ARCHIVE / UNARCHIVE ───────────────────────────
  var showingArchived = false;

  window.archivePipeline = function(id, name) {
    api('POST', '/templates/' + id + '/archive')
      .then(function() { window.toast('"' + name + '" archived'); loadList(); })
      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  window.unarchivePipeline = function(id, name) {
    api('POST', '/templates/' + id + '/unarchive')
      .then(function() { window.toast('"' + name + '" restored'); loadList(); })
      .catch(function(e) { window.toast('Failed: ' + e.message, 'error'); });
  };

  window.toggleArchived = function() {
    showingArchived = !showingArchived;
    var btn = document.getElementById('archived-toggle');
    var title = document.getElementById('list-title');
    var newBtn = document.getElementById('new-pipe-btn');
    btn.textContent = showingArchived ? '← Active Pipelines' : '📦 View Archived';
    title.textContent = showingArchived ? 'Archived Pipelines' : 'Pipelines';
    if (newBtn) newBtn.style.display = showingArchived ? 'none' : '';
    loadList();
  };

  // ── LOAD TEAM ─────────────────────────────────────
  function loadTeam() {
    fetch('/firms/team', { headers: { 'Authorization': 'Bearer ' + token } })
      .then(function(r) { return r.ok ? r.json() : []; })
      .then(function(members) { teamMembers = members; })
      .catch(function() {});
  }

  window.loadList = loadList; // expose for retry link

  // ── INIT ──────────────────────────────────────────
  loadTeam();
  loadList();

  // Auto-navigate to instance if ?instance=X is in the URL
  var _urlParams = new URLSearchParams(window.location.search);
  var _instanceParam = _urlParams.get('instance');
  if (_instanceParam) {
    // Hide list immediately to prevent flash
    showBoard();
    document.getElementById('kanban-wrap').innerHTML = '<div class="board-empty"><p style="color:var(--muted)">Loading…</p></div>';
    api('GET', '/instances/' + _instanceParam).then(function(inst) {
      if (!inst || !inst.template_id) { showList(); return; }
      currentYear = parseInt(inst.tax_year) || currentYear;
      openPipeline(inst.template_id);
    }).catch(function() { showList(); });
  }

})();
</script>

