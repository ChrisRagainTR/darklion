  window.migrateCardToNextYear = function(jobId) {
    var msgEl = document.getElementById('migrate-msg-' + jobId);
    if (msgEl) { msgEl.style.color = 'var(--muted)'; msgEl.textContent = 'Moving…'; }
    api('POST', '/jobs/' + jobId + '/migrate-to-next-year', {})
      .then(function(result) {
        if (msgEl) { msgEl.style.color = 'var(--green)'; msgEl.textContent = '✓ Moved to ' + (result.new_tax_year || 'next year'); }
