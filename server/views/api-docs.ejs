        <tr><td>include_summaries</td><td>boolean <span class="badge badge-optional">optional</span></td><td>Default true. Set false to return events only.</td></tr>
        <tr><td>limit</td><td>number <span class="badge badge-optional">optional</span></td><td>Default 100, max 500. Message summaries do not count against this limit.</td></tr>
      </tbody>
    </table>
