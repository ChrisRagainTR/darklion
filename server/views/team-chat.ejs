<%- include('partials/shell-top', { title: title, activeNav: activeNav }) %>

<style>
  .tc-wrap { padding: 0.85rem 1.25rem; height: calc(100vh - 58px); max-height: calc(100vh - 58px); min-height: 0; display: flex; flex-direction: column; gap: 0; overflow:hidden; }
  .tc-hero { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; }
  .tc-eyebrow { color:var(--gold); font-size:0.72rem; text-transform:uppercase; letter-spacing:0.12em; font-weight:800; margin-bottom:0.35rem; }
  .tc-hero h1 { margin:0; font-size:1.45rem; letter-spacing:-0.03em; }
  .tc-hero p { margin:0.35rem 0 0; color:var(--muted); max-width:760px; font-size:0.92rem; line-height:1.45; }
  .tc-status-row { display:flex; gap:0.5rem; flex-wrap:wrap; justify-content:flex-end; }
  .tc-pill { display:inline-flex; align-items:center; gap:0.4rem; border:1px solid var(--border); background:rgba(255,255,255,0.035); color:var(--muted); border-radius:999px; padding:0.38rem 0.7rem; font-size:0.78rem; font-weight:700; white-space:nowrap; }
  .tc-pill.gold { color:var(--gold); background:rgba(201,168,76,0.12); border-color:rgba(201,168,76,0.28); }
  .tc-pill.green { color:var(--green); background:rgba(62,207,142,0.1); border-color:rgba(62,207,142,0.25); }

  .tc-setup { border:1px solid rgba(201,168,76,0.22); border-radius:18px; margin-bottom:0.8rem; padding:0.75rem 0.9rem; background:linear-gradient(135deg, rgba(201,168,76,0.12), rgba(20,29,38,0.72)); box-shadow:0 16px 42px rgba(0,0,0,0.18); display:block; }
  .tc-setup.kickoff { border-color:rgba(201,168,76,0.36); }
  .tc-setup.connected { border-color:rgba(62,207,142,0.26); background:linear-gradient(135deg, rgba(62,207,142,0.09), rgba(20,29,38,0.74)); }
  .tc-setup.error { border-color:rgba(229,62,62,0.32); background:linear-gradient(135deg, rgba(229,62,62,0.09), rgba(20,29,38,0.74)); }
  .tc-setup.compact { display:none; }
  .tc-setup-copy { display:flex; flex-direction:column; justify-content:center; min-width:0; }
  .tc-setup-kicker { color:var(--gold); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; font-weight:900; margin-bottom:0.25rem; }
  .tc-setup-title { margin:0; font-size:1.05rem; letter-spacing:-0.02em; font-weight:950; }
  .tc-setup-desc { color:var(--muted); font-size:0.82rem; line-height:1.42; margin-top:0.35rem; }
  .tc-setup-actions { display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.75rem; }
  .tc-setup-action { border:1px solid var(--border); background:rgba(255,255,255,0.045); color:var(--text); border-radius:10px; padding:0.52rem 0.7rem; font-size:0.76rem; font-weight:900; cursor:pointer; }
  .tc-setup-action.primary { background:var(--gold); border-color:var(--gold); color:var(--navy); }
  .tc-setup-action.warn { border-color:rgba(229,62,62,0.35); color:var(--red); }
  .tc-setup-action:disabled { opacity:0.55; cursor:not-allowed; }
  .tc-steps { display:none; }
  .tc-step { border:1px solid var(--border); background:rgba(15,25,35,0.62); border-radius:14px; padding:0.72rem; min-width:0; position:relative; overflow:hidden; }
  .tc-step:before { content:""; position:absolute; left:0; top:0; height:3px; width:100%; background:rgba(143,163,184,0.2); }
  .tc-step.done:before { background:var(--green); }
  .tc-step.active:before { background:var(--gold); }
  .tc-step.error:before { background:var(--red); }
  .tc-step-icon { width:1.65rem; height:1.65rem; border-radius:10px; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.05); margin-bottom:0.48rem; }
  .tc-step-title { color:var(--text); font-size:0.78rem; font-weight:900; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tc-step-sub { color:var(--muted); font-size:0.68rem; line-height:1.35; margin-top:0.22rem; }
  .tc-progress { height:7px; background:rgba(255,255,255,0.07); border-radius:999px; overflow:hidden; margin-top:0.75rem; }
  .tc-progress span { display:block; height:100%; width:0%; background:linear-gradient(90deg, var(--gold), var(--green)); transition:width 0.25s ease; }
  .tc-setup-detail { color:var(--muted); font-size:0.72rem; margin-top:0.45rem; line-height:1.35; }

  .tc-shell { --tc-left-w:320px; --tc-ai-w:440px; flex:1 1 auto; min-height:0; height:100%; display:grid; grid-template-columns: var(--tc-left-w) 7px minmax(420px, 1fr) var(--tc-ai-w); border:1px solid var(--border); border-radius:18px; overflow:hidden; background:var(--card); box-shadow:0 18px 55px rgba(0,0,0,0.22); position:relative; }
  .tc-shell.ai-collapsed { --tc-ai-w:0px; }
  .tc-shell.ai-collapsed .tc-assistant { display:none; }
  .tc-left-resizer { min-width:7px; cursor:col-resize; background:rgba(201,168,76,0.06); border-right:1px solid var(--border); position:relative; }
  .tc-left-resizer:before { content:""; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:3px; height:42px; border-radius:999px; background:rgba(201,168,76,0.32); }
  .tc-left-resizer:hover, body.tc-resizing-left .tc-left-resizer { background:rgba(201,168,76,0.14); }
  body.tc-resizing-left { cursor:col-resize; user-select:none; }
  .tc-mobile-bar { display:none; border-bottom:1px solid var(--border); background:rgba(15,25,35,0.98); padding:0.75rem; gap:0.55rem; align-items:center; flex-wrap:wrap; }
  .tc-mobile-select-wrap { flex:1; min-width:0; position:relative; }
  .tc-mobile-select { width:100%; min-height:44px; appearance:none; background:var(--navy); border:1px solid rgba(201,168,76,0.32); color:var(--text); border-radius:12px; padding:0.65rem 2.2rem 0.65rem 0.78rem; font:inherit; font-size:0.92rem; font-weight:850; outline:none; }
  .tc-mobile-select-wrap:after { content:"⌄"; position:absolute; right:0.8rem; top:50%; transform:translateY(-54%); color:var(--gold); pointer-events:none; font-weight:900; }
  .tc-mobile-search { flex:1; min-width:0; min-height:42px; background:var(--navy); border:1px solid var(--border); color:var(--text); border-radius:12px; padding:0.62rem 0.75rem; font:inherit; font-size:0.9rem; outline:none; }
  .tc-mobile-search:focus { border-color:var(--gold); }
  .tc-mobile-action { width:42px; min-width:42px; height:42px; border:1px solid rgba(201,168,76,0.24); background:rgba(201,168,76,0.08); color:var(--gold); border-radius:12px; padding:0; font-size:1.15rem; line-height:1; font-weight:900; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; }
  .tc-mobile-action:hover { border-color:rgba(201,168,76,0.46); background:rgba(201,168,76,0.14); color:#f4d987; }
  .tc-shell * { scrollbar-width:thin; scrollbar-color:#334155 #0b121a; }
  .tc-shell *::-webkit-scrollbar { width:10px; height:10px; }
  .tc-shell *::-webkit-scrollbar-track { background:#0b121a; }
  .tc-shell *::-webkit-scrollbar-thumb { background:#334155; border-radius:999px; border:2px solid #0b121a; }
  .tc-shell *::-webkit-scrollbar-thumb:hover { background:#475569; }
  .tc-left { background:rgba(15,25,35,0.74); min-width:0; min-height:0; border-right:1px solid var(--border); display:flex; flex-direction:column; }
  .tc-search { padding:0.9rem; border-bottom:1px solid var(--border); }
  .tc-search-row { display:flex; align-items:center; gap:0.45rem; }
  .tc-search input { flex:1; min-width:0; width:100%; background:var(--navy); border:1px solid var(--border); color:var(--text); border-radius:10px; padding:0.65rem 0.8rem; font-size:0.86rem; outline:none; }
  .tc-search input:focus { border-color:var(--gold); }
  .tc-compose-btn { width:36px; height:36px; flex:0 0 36px; border:1px solid rgba(201,168,76,0.24); background:rgba(201,168,76,0.08); color:var(--gold); border-radius:11px; display:inline-flex; align-items:center; justify-content:center; font-size:1rem; line-height:1; font-weight:900; cursor:pointer; transition:0.12s ease; }
  .tc-compose-btn:hover { border-color:rgba(201,168,76,0.46); background:rgba(201,168,76,0.14); color:#f4d987; }
  .tc-compose-btn:focus-visible { outline:2px solid rgba(201,168,76,0.55); outline-offset:2px; }
  .tc-compose-btn:disabled { opacity:0.62; cursor:not-allowed; }
  .tc-section-label { padding:0.75rem 0.9rem 0.4rem; color:var(--muted); font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; display:flex; align-items:center; justify-content:space-between; gap:0.5rem; }
  .tc-chat-list { overflow:auto; padding-bottom:0.6rem; }
  .tc-chat { display:flex; gap:0.7rem; align-items:center; padding:0.72rem 0.9rem; cursor:pointer; border-left:3px solid transparent; transition:0.12s ease; }
  .tc-chat:hover { background:rgba(255,255,255,0.035); }
  .tc-chat.active { background:rgba(201,168,76,0.1); border-left-color:var(--gold); }
  .tc-chat.unread .tc-chat-name { color:#fff; }
  .tc-chat.unread .tc-chat-preview { color:var(--text); font-weight:700; }
  .tc-chat.unread { background:rgba(201,168,76,0.06); }
  .tc-chat.unread.active { background:rgba(201,168,76,0.16); }
  .tc-avatar { width:40px; height:40px; border-radius:14px; display:flex; align-items:center; justify-content:center; flex:0 0 auto; font-weight:900; color:var(--navy); background:linear-gradient(135deg, var(--gold), #f4d987); box-shadow:0 8px 22px rgba(201,168,76,0.18); }
  .tc-avatar.blue { color:#dbeafe; background:linear-gradient(135deg, #2563eb, #38bdf8); }
  .tc-avatar.green { color:#052e1a; background:linear-gradient(135deg, #3ecf8e, #a7f3d0); }
  .tc-avatar.has-photo { color:var(--text); background:rgba(15,25,35,0.72); border:1px solid rgba(201,168,76,0.34); box-shadow:0 8px 22px rgba(0,0,0,0.2); }
  .tc-avatar.dark { color:#d7c68a; background:linear-gradient(135deg, #111827, #334155); border:1px solid rgba(201,168,76,0.24); }
  .tc-avatar img, .tc-msg-avatar img { width:100%; height:100%; object-fit:cover; border-radius:inherit; display:block; }
  .tc-member-avatars { min-width:40px; max-width:76px; display:flex; align-items:center; flex:0 0 auto; padding-left:1px; }
  .tc-member-avatar { width:26px; height:26px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex:0 0 auto; margin-left:-7px; border:2px solid #15202b; background:linear-gradient(135deg, #334155, #64748b); color:#f8fafc; font-size:0.62rem; font-weight:950; box-shadow:0 5px 14px rgba(0,0,0,0.24); overflow:hidden; }
  .tc-member-avatar:first-child { margin-left:0; }
  .tc-member-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
  .tc-chat.active .tc-member-avatar { border-color:#242925; }
  .tc-chat-body { min-width:0; flex:1; }
  .tc-chat-top { display:flex; justify-content:space-between; gap:0.5rem; align-items:center; }
  .tc-chat-more { opacity:0; border:1px solid transparent; background:transparent; color:var(--muted); border-radius:8px; padding:0.22rem 0.42rem; font-size:1rem; line-height:1; cursor:pointer; flex:0 0 auto; }
  .tc-chat:hover .tc-chat-more, .tc-chat-more:focus { opacity:1; }
  .tc-chat-more:hover { color:var(--gold); border-color:rgba(201,168,76,0.24); background:rgba(201,168,76,0.08); }
  .tc-chat-name { color:var(--text); font-weight:800; font-size:0.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tc-chat-time { color:var(--muted); font-size:0.68rem; white-space:nowrap; }
  .tc-chat-preview { margin-top:0.18rem; color:var(--muted); font-size:0.78rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tc-badge { background:var(--gold); color:var(--navy); border-radius:999px; min-width:1.15rem; padding:0.05rem 0.35rem; text-align:center; font-size:0.68rem; font-weight:900; }
  .tc-unread-label { display:inline-flex; align-items:center; gap:0.28rem; color:var(--gold); font-size:0.68rem; font-weight:900; text-transform:uppercase; letter-spacing:0.04em; margin-top:0.22rem; }
  .tc-read-dot { width:0.48rem; height:0.48rem; border-radius:999px; background:rgba(143,163,184,0.36); flex:0 0 auto; }
  .tc-chat.unread .tc-read-dot { background:var(--gold); box-shadow:0 0 0 3px rgba(201,168,76,0.12); }
  .tc-left-tools { padding:0.75rem 0.9rem; border-bottom:1px solid var(--border); display:none; gap:0.5rem; }
  .tc-left-tools.open { display:grid; }
  .tc-group-panel { padding:0.75rem 0.9rem; border-bottom:1px solid var(--border); display:none; gap:0.5rem; }
  .tc-group-panel.open { display:grid; }
  .tc-tool-row { display:flex; gap:0.45rem; }
  .tc-tool-row input { flex:1; min-width:0; background:var(--navy); border:1px solid var(--border); color:var(--text); border-radius:9px; padding:0.5rem 0.6rem; font-size:0.78rem; outline:none; }
  .tc-tool-row input:focus { border-color:var(--gold); }
  .tc-left-btn { border:1px solid var(--border); background:rgba(255,255,255,0.04); color:var(--text); border-radius:9px; padding:0.5rem 0.6rem; font-size:0.74rem; font-weight:900; cursor:pointer; white-space:nowrap; }
  .tc-left-btn.gold { color:var(--navy); background:var(--gold); border-color:var(--gold); }
  .tc-left-btn.danger { color:var(--red); border-color:rgba(245,101,101,0.35); }
  .tc-left-btn.danger:hover { color:#fff; background:rgba(245,101,101,0.14); border-color:rgba(245,101,101,0.5); }
  .tc-sidebar-note { color:var(--muted); font-size:0.72rem; line-height:1.35; padding:0 0.9rem 0.7rem; }
  .tc-list-state { margin:0.65rem 0.9rem; border:1px dashed var(--border); border-radius:12px; padding:0.7rem; color:var(--muted); font-size:0.78rem; line-height:1.4; background:rgba(255,255,255,0.025); display:none; }
  .tc-list-state.show { display:block; }
  .tc-list-state.error { color:var(--red); border-color:rgba(229,62,62,0.35); background:rgba(229,62,62,0.06); }
  .tc-list-state.empty { color:var(--muted); }

  .tc-main { display:flex; flex-direction:column; min-width:0; min-height:0; height:100%; overflow:hidden; background:linear-gradient(180deg, rgba(20,29,38,0.96), rgba(15,25,35,0.98)); }
  .tc-convo-head { display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1rem; border-bottom:1px solid var(--border); gap:0.75rem; }
  .tc-convo-person { display:flex; align-items:center; gap:0.75rem; min-width:0; }
  .tc-convo-title { font-weight:900; font-size:0.98rem; }
  .tc-convo-sub { color:var(--muted); font-size:0.74rem; margin-top:0.16rem; display:flex; gap:0.34rem; align-items:center; flex-wrap:wrap; line-height:1.35; }
  .tc-convo-sub-label { color:rgba(143,163,184,0.72); font-size:0.66rem; font-weight:900; letter-spacing:0.08em; text-transform:uppercase; }
  .tc-convo-sub-names { color:var(--muted); }
  .tc-refresh-btn.is-busy { opacity:0.72; pointer-events:none; }
  .tc-refresh-btn.is-busy .tc-refresh-icon { display:inline-block; animation:tcSpin 0.8s linear infinite; }

  .tc-messages { flex:1 1 auto; min-height:0; overflow-y:auto; overflow-x:hidden; padding:1rem 1.15rem; display:flex; flex-direction:column; gap:0.75rem; overscroll-behavior:contain; }
  .tc-day { align-self:center; color:var(--muted); font-size:0.7rem; background:rgba(255,255,255,0.045); border:1px solid var(--border); border-radius:999px; padding:0.25rem 0.6rem; margin:0.1rem 0 0.35rem; }
  .tc-msg { display:flex; gap:0.55rem; max-width:78%; min-width:0; align-items:flex-end; }
  .tc-msg.mine { align-self:flex-end; flex-direction:row-reverse; }
  .tc-msg-avatar { width:26px; height:26px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:900; background:rgba(143,163,184,0.15); color:var(--muted); flex:0 0 auto; }
  .tc-msg-bubble { border:1px solid var(--border); background:rgba(255,255,255,0.045); border-radius:16px 16px 16px 5px; padding:0.65rem 0.75rem; line-height:1.42; font-size:0.88rem; color:var(--text); min-width:0; max-width:100%; overflow-wrap:anywhere; word-break:break-word; white-space:pre-wrap; }
  .tc-msg-bubble a { color:#93c5fd; text-decoration:underline; text-underline-offset:2px; font-weight:800; }
  .tc-msg.mine .tc-msg-bubble { background:var(--gold); color:var(--navy); border-color:var(--gold); border-radius:16px 16px 5px 16px; font-weight:600; }
  .tc-msg.mine .tc-msg-bubble a { color:inherit; }
  .tc-msg.emoji-only .tc-msg-bubble { border:none; background:transparent; padding:0.08rem 0.12rem; font-size:2.35rem; line-height:1.08; box-shadow:none; filter:drop-shadow(0 5px 12px rgba(0,0,0,0.28)); }
  .tc-msg.mine.emoji-only .tc-msg-bubble { background:transparent; color:inherit; border:none; font-weight:400; }
  .tc-msg.meta { max-width:88%; align-self:center; }
  .tc-msg.meta .tc-msg-bubble { border-style:dashed; color:var(--muted); background:rgba(201,168,76,0.055); }
  .tc-unread-divider { align-self:stretch; display:flex; align-items:center; gap:0.75rem; color:var(--gold); font-size:0.72rem; font-weight:950; letter-spacing:0.08em; text-transform:uppercase; margin:0.35rem 0; cursor:pointer; }
  .tc-unread-divider::before, .tc-unread-divider::after { content:""; height:1px; flex:1; background:linear-gradient(90deg, transparent, rgba(201,168,76,0.62)); }
  .tc-unread-divider::after { background:linear-gradient(90deg, rgba(201,168,76,0.62), transparent); }
  .tc-unread-divider-label { border:1px solid rgba(201,168,76,0.34); border-radius:999px; padding:0.26rem 0.72rem; background:rgba(201,168,76,0.08); box-shadow:0 8px 22px rgba(201,168,76,0.08); }
  .tc-unread-divider:hover .tc-unread-divider-label { background:rgba(201,168,76,0.15); }
  .tc-new-pill { position:sticky; bottom:0.65rem; align-self:center; z-index:4; border:1px solid rgba(201,168,76,0.42); background:rgba(201,168,76,0.96); color:var(--navy); border-radius:999px; padding:0.42rem 0.85rem; font-size:0.76rem; font-weight:950; box-shadow:0 12px 30px rgba(0,0,0,0.28); cursor:pointer; display:none; }
  .tc-new-pill.show { display:inline-flex; align-items:center; gap:0.35rem; }
  .tc-new-pill:hover { filter:brightness(1.04); }
  .tc-switch-state { margin:auto; align-self:center; display:flex; flex-direction:column; align-items:center; gap:0.7rem; color:var(--muted); font-size:0.86rem; }
  .tc-switch-spinner { width:32px; height:32px; border-radius:999px; border:3px solid rgba(143,163,184,0.22); border-top-color:var(--gold); animation:tcSpin 0.8s linear infinite; }
  @keyframes tcSpin { to { transform:rotate(360deg); } }
  .tc-msg-time { color:var(--muted); font-size:0.66rem; margin-top:0.25rem; }
  .tc-msg-meta-row { display:flex; align-items:center; gap:0.4rem; margin-top:0.25rem; }
  .tc-msg.mine .tc-msg-meta-row { justify-content:flex-end; }
  .tc-msg-action { border:1px solid rgba(143,163,184,0.22); background:rgba(255,255,255,0.055); color:var(--muted); border-radius:999px; font-size:0.66rem; font-weight:900; cursor:pointer; padding:0.14rem 0.42rem; line-height:1.25; }
  .tc-msg-action:hover { color:var(--red); border-color:rgba(229,62,62,0.35); background:rgba(229,62,62,0.08); }
  .tc-msg.mine .tc-msg-action { color:rgba(15,25,35,0.78); border-color:rgba(15,25,35,0.2); background:rgba(15,25,35,0.08); }
  .tc-msg.mine .tc-msg-action:hover { color:#7f1d1d; border-color:rgba(127,29,29,0.38); background:rgba(127,29,29,0.08); }
  .tc-msg-action.edit:hover { color:var(--gold); border-color:rgba(201,168,76,0.38); background:rgba(201,168,76,0.12); }
  .tc-msg-edit { display:grid; gap:0.45rem; min-width:min(420px, 62vw); }
  .tc-msg-edit textarea { width:100%; min-height:86px; resize:vertical; border:1px solid rgba(143,163,184,0.24); border-radius:10px; padding:0.55rem 0.65rem; background:rgba(15,25,35,0.9); color:var(--text); font:inherit; line-height:1.4; box-sizing:border-box; }
  .tc-msg.mine .tc-msg-edit textarea { background:rgba(255,255,255,0.82); color:var(--navy); border-color:rgba(15,25,35,0.22); }
  .tc-msg-edit-actions { display:flex; justify-content:flex-end; gap:0.4rem; }
  .tc-msg.pending .tc-msg-bubble { opacity:0.82; }
  .tc-msg.typing .tc-msg-bubble { min-width:56px; color:var(--muted); }
  .tc-typing-dots { display:inline-flex; align-items:center; gap:0.22rem; height:1rem; }
  .tc-typing-dots span { width:0.34rem; height:0.34rem; border-radius:999px; background:currentColor; opacity:0.38; animation:tcTyping 1s infinite ease-in-out; }
  .tc-typing-dots span:nth-child(2) { animation-delay:0.16s; }
  .tc-typing-dots span:nth-child(3) { animation-delay:0.32s; }
