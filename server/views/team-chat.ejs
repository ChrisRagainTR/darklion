  async function initEmma() {
    var title = $('dash-ai-title');
    if (title) title.textContent = 'DarkLion AI';
    setEmmaStatus('Loading…', false);
    try {
      var data = await apiJson('/api/emma-chat/session');
      emmaMessages = Array.isArray(data.messages) ? data.messages : [];
      setEmmaStatus('Ready', true);
      renderEmmaMessages(emmaMessages.length ? emmaMessages : [{ role:'assistant', content:'Hi, I’m DarkLion AI. I can help while you work in Team Chat.' }]);
      setEmmaEnabled(true);
    } catch (err) {
      setEmmaStatus('Unavailable', false);
      var box = $('dash-ai-messages');
      if (box) box.innerHTML = '<div class="dash-ai-bubble agent" style="color:var(--muted);">DarkLion AI is unavailable right now. Please try again.</div>';
      setEmmaEnabled(false);
    }
  }
  function setEmmaStatus(text, online) {
    var el = $('emma-status');
    if (el) {
      el.textContent = text;
      el.style.color = online ? 'var(--green,#3ecf8e)' : 'var(--muted)';
    }
