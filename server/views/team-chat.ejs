  function setEmmaEnabled(enabled) {
    var input = $('dash-ai-input');
    var send = $('dash-ai-send-btn');
    if (input) { input.disabled = !enabled || assistantSendInFlight; input.placeholder = enabled ? 'Ask DarkLion AI…' : 'DarkLion AI unavailable'; }
    if (send) { send.disabled = !enabled || assistantSendInFlight; send.style.opacity = (!enabled || assistantSendInFlight) ? '0.5' : '1'; }
  }
  function renderEmmaMessages(messages) {
    var box = $('dash-ai-messages');
    if (!box) return;
    box.innerHTML = (messages || []).map(function(m) {
      var isUser = m.role === 'user';
      var rendered = esc(m.content || '').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
      return '<div class="dash-ai-bubble ' + (isUser ? 'user' : 'agent') + '">' + rendered + '</div>';
    }).join('');
    box.scrollTop = box.scrollHeight;
  }
  function appendEmmaMessage(role, content) {
    var box = $('dash-ai-messages');
    if (!box) return;
    var div = document.createElement('div');
    div.className = 'dash-ai-bubble ' + (role === 'user' ? 'user' : 'agent');
    div.innerHTML = esc(content || '').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }
  async function sendEmmaMessage(text) {
    if (assistantSendInFlight) return;
    var input = $('dash-ai-input');
    var message = String(text || '').replace(/^\n+|\n+$/g, '');
    if (!message) return;
    assistantSendInFlight = true;
    appendEmmaMessage('user', message);
    if (input && input.value.trim() === message) { input.value = ''; autoSizeTextarea(input); }
    var thinkingId = 'team-emma-thinking-' + Date.now();
    var box = $('dash-ai-messages');
    if (box) {
      var thinking = document.createElement('div');
      thinking.className = 'dash-ai-bubble agent';
      thinking.id = thinkingId;
      thinking.style.cssText = 'opacity:0.7;font-size:0.8rem;color:var(--muted);';
      thinking.textContent = 'DarkLion AI is thinking…';
      box.appendChild(thinking);
      box.scrollTop = box.scrollHeight;
    }
    setEmmaEnabled(true);
    try {
      var data = await apiJson('/api/emma-chat/message', { method:'POST', body: JSON.stringify({ message:message }) });
      var t = $(thinkingId); if (t) t.remove();
      if (data.reply) appendEmmaMessage('assistant', data.reply);
      else if (Array.isArray(data.messages)) renderEmmaMessages(data.messages);
      else appendEmmaMessage('assistant', 'Got it.');
    } catch (err) {
      var t2 = $(thinkingId); if (t2) t2.remove();
      appendEmmaMessage('assistant', 'Could not reach DarkLion AI: ' + err.message);
    } finally {
      assistantSendInFlight = false;
      setEmmaEnabled(true);
      if (input && !input.disabled) input.focus();
    }
  }
  function submitEmmaComposer() {
