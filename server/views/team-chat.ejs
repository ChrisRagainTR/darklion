    try { localStorage.setItem(storageKeyAiCollapsed, collapsed ? '1' : '0'); } catch (_) {}
  }
  function initTeamChatLayoutControls() {
    var shell = teamChatShell();
    if (!shell) return;
    var savedWidth = Number(localStorage.getItem(storageKeyLeftWidth) || 0);
    if (savedWidth) setTeamChatLeftWidth(savedWidth);
    setAiDrawerCollapsed(localStorage.getItem(storageKeyAiCollapsed) === '1');
    $('tc-ai-collapse-btn')?.addEventListener('click', function(e) { e.preventDefault(); setAiDrawerCollapsed(true); });
    $('tc-ai-restore-btn')?.addEventListener('click', function(e) { e.preventDefault(); setAiDrawerCollapsed(false); });
    var handle = $('tc-left-resizer');
    if (!handle) return;
    var dragging = false;
    function onMove(e) {
      if (!dragging) return;
      var rect = shell.getBoundingClientRect();
      setTeamChatLeftWidth(e.clientX - rect.left);
    }
    function onUp() {
      if (!dragging) return;
