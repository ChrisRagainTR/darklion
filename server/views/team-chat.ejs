  async function ensureConcreteConversationForSend() {
    if (!activeChat?.synthetic_dm) return activeChat;
    var staffUserId = activeChat.staff_user_id || String(activeChat.id || '').replace(/^staff-/, '');
    if (!staffUserId) return activeChat;
    setLiveState('working', 'Starting DM');
    setStatus('Starting direct message…');
    var data = await apiJson('/api/team-chat/conversations/dm', { method:'POST', body: JSON.stringify({ staff_user_id: staffUserId }) });
    await loadImportedChats();
    if (data.conversation) setActiveChat(data.conversation, { refresh:false });
    return data.conversation || activeChat;
  }
  async function sendComposer(statusPrefix) {
    if (composerSendInFlight) return;
    var input = $('tc-message-input');
    var rawMessage = input?.value || '';
    var message = rawMessage.replace(/^\n+|\n+$/g, '');
    var files = selectedMainFiles();
    if (!activeChat?.id) return setStatus('Select a Team Chat conversation before sending.', 'err');
    if (!message && !files.length) return setStatus('Type a message or attach up to 3 files first.', 'err');
    composerSendInFlight = true;
    setComposerState(true);
    var sendStartedForChat = activeChat;
    try {
      await ensureConcreteConversationForSend();
      if (files.length) await sendComposerAttachments(files, message);
      else await sendMessage(message, statusPrefix || 'Sent message');
      acknowledgeActiveChatRead('reply');
      if (input && input.value === rawMessage) input.value = '';
      autoSizeTextarea(input);
      if (input) input.focus();
    } catch (err) {
      setLiveState('idle', 'Live');
      setStatus('Send failed: ' + err.message, 'err');
      if (input && sendStartedForChat === activeChat) input.focus();
    } finally {
      composerSendInFlight = false;
      setComposerState(!!activeChat?.id);
    }
  }
  async function sendComposerAttachments(files, caption) {
    files = Array.from(files || []).slice(0, 3);
    var nonce = makeClientNonce('tc-file');
    var tempId = 'local-file-' + nonce;
    optimisticMessages.push({ out:true, text:caption || '', attachments:files.map(function(file, idx){ return { id:'local-' + idx, file_name:file.name, content_type:file.type || 'application/octet-stream', byte_size:file.size }; }), has_media:true, attachment_kind:'document', date:new Date().toISOString(), message_id:tempId, pending:true, created_ms:Date.now(), client_nonce:nonce });
    renderMessages(lastServerMessages, { forceBottom:true, smooth:true });
    var fd = new FormData();
    fd.append('conversation_id', activeChat.id);
    fd.append('message', caption || '');
    fd.append('client_nonce', nonce);
    files.forEach(function(file){ fd.append('attachments', file); });
    setLiveState('working', 'Sending file');
    setStatus('Sending ' + files.length + ' file' + (files.length === 1 ? '' : 's') + '…');
    try {
      var data = await apiJson('/api/team-chat/messages/send', { method:'POST', body: fd });
      optimisticMessages = optimisticMessages.map(function(m){ return m.message_id === tempId ? Object.assign({}, m, data.message || {}, { pending:false, message_id:(data.message && (data.message.message_id || data.message.id)) || tempId }) : m; });
      renderMessages(lastServerMessages, { forceBottom:true });
      clearMainFile();
      setStatus('File attachment' + (files.length === 1 ? '' : 's') + ' sent.', 'ok');
      scheduleMessageRefresh(activeChat, { syncLatest:true, forceBottom:true }, 450);
    } catch (err) {
      optimisticMessages = optimisticMessages.filter(function(m){ return m.message_id !== tempId; });
      renderMessages(lastServerMessages);
      throw err;
    }
  }

  async function sendMessage(message, statusPrefix) {
    var nonce = makeClientNonce('tc-msg');
    var tempId = 'local-' + nonce;
    optimisticMessages.push({ out: true, text: message, date: new Date().toISOString(), message_id: tempId, pending:true, created_ms:Date.now(), client_nonce:nonce });
    renderMessages(lastServerMessages, { forceBottom:true, smooth:true });
    try {
      var data = await apiJson('/api/team-chat/messages/send', {
        method: 'POST',
        body: JSON.stringify({ conversation_id: activeChat.id, message: message, client_nonce: nonce })
      });
      optimisticMessages = optimisticMessages.map(function(m){ return m.message_id === tempId ? Object.assign({}, m, data.message || {}, { pending:false, message_id:(data.message && (data.message.message_id || data.message.id)) || tempId }) : m; });
      renderMessages(lastServerMessages, { forceBottom:true });
      setStatus((statusPrefix || 'Sent') + '.', 'ok');
      scheduleMessageRefresh(activeChat, { syncLatest:true, forceBottom:true }, 450);
    } catch (err) {
      optimisticMessages = optimisticMessages.filter(function(m){ return m.message_id !== tempId; });
      renderMessages(lastServerMessages);
      throw err;
    }
  }


