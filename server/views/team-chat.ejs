      saveEditBtn.textContent = 'Saving…';
      try {
        var data = await apiJson('/api/team-chat/messages/' + encodeURIComponent(editMessageId), { method:'PATCH', body: JSON.stringify({ body:nextBody }) });
        replaceMessageInState(data.message);
        editingMessageId = null;
        renderMessages(lastServerMessages);
        setStatus('Message edited.', 'ok');
        scheduleMessageRefresh(activeChat, { syncLatest:true }, 450);
      } catch (err) {
        saveEditBtn.disabled = false;
        saveEditBtn.textContent = originalEditText;
        setStatus('Edit failed: ' + err.message, 'err');
      }
      return;
    }
    var deleteBtn = e.target.closest('[data-delete-message-id]');
    if (deleteBtn) {
      e.preventDefault();
      var messageId = deleteBtn.dataset.deleteMessageId;
      if (!messageId || !confirm('Remove this Team Chat message?')) return;
      deleteBtn.disabled = true;
      var originalDeleteText = deleteBtn.textContent;
      deleteBtn.textContent = 'Deleting…';
      try {
        await apiJson('/api/team-chat/messages/' + encodeURIComponent(messageId), { method:'DELETE' });
        lastServerMessages = lastServerMessages.filter(function(m){ return String(m.id || m.message_id) !== String(messageId); });
        optimisticMessages = optimisticMessages.filter(function(m){ return String(m.id || m.message_id) !== String(messageId); });
        renderMessages(lastServerMessages);
        setStatus('Message removed.', 'ok');
        scheduleMessageRefresh(activeChat, { syncLatest:true }, 450);
      } catch (err) {
        deleteBtn.disabled = false;
        deleteBtn.textContent = originalDeleteText;
        setStatus('Delete failed: ' + err.message, 'err');
      }
      return;
    }
    acknowledgeActiveChatRead('click');
    var imageButton = e.target.closest('[data-image-preview-id]');
    if (imageButton) {
      e.preventDefault();
      openImageLightbox(imageButton);
      return;
    }
    var downloadButton = e.target.closest('[data-download-attachment-id]');
    if (downloadButton) {
      e.preventDefault();
      await downloadTeamChatAttachment(downloadButton.dataset.downloadAttachmentId, downloadButton);
      return;
    }
    var link = e.target.closest('[data-attachment-id]');
    if (!link) return;
    e.preventDefault();
    var caption = link.querySelector('.tc-attachment-caption');
    var target = caption || link;
    var original = target.textContent;
    target.textContent = 'Downloading...';
    await downloadTeamChatAttachment(link.dataset.attachmentId);
    target.textContent = original;
  });

