      return;
    }
    var cancelEditBtn = e.target.closest('[data-cancel-edit-message-id]');
    if (cancelEditBtn) {
      e.preventDefault();
      editingMessageId = null;
      renderMessages(lastServerMessages);
      return;
    }
    var saveEditBtn = e.target.closest('[data-save-edit-message-id]');
    if (saveEditBtn) {
      e.preventDefault();
      var editMessageId = saveEditBtn.dataset.saveEditMessageId;
      var textarea = document.querySelector('[data-edit-body="' + CSS.escape(String(editMessageId || '')) + '"]');
      var nextBody = (textarea?.value || '').replace(/^\n+|\n+$/g, '');
      saveEditBtn.disabled = true;
