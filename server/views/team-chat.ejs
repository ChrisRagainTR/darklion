    var next = clampNumber(width, 240, max);
    shell.style.setProperty('--tc-left-w', next + 'px');
    try { localStorage.setItem(storageKeyLeftWidth, String(Math.round(next))); } catch (_) {}
  }
  function setAiDrawerCollapsed(collapsed) {
