    <div class="settings-section">
      <div class="archive-overview">
        <div class="archive-overview-main">
          <div>
            <h2>Communications archive</h2>
            <p>Generate a retained, checksum-verified export of client and internal communications for any date range.</p>
          </div>
          <a class="btn btn-gold archive-open-btn" href="/communication-exports">Open communications archive <span aria-hidden="true">→</span></a>
        </div>
        <div class="archive-overview-status">
          <div class="archive-health-label">Archive status</div>
          <div class="archive-health-value" id="archive-health-value">Checking…</div>
          <div class="archive-health-note" id="archive-health-note">Loading retained record count</div>
