  </div><!-- end tab-archives -->

  <!-- ============ INTEGRATIONS ============ -->
  <div class="settings-tab-panel" id="tab-integrations">
    <div class="settings-section" style="max-width:560px;">
      <h2>🔗 Integrations</h2>
      <p style="color:var(--muted);font-size:0.88rem;margin-bottom:1.5rem;">Connect third-party services to this firm.</p>

      <div style="margin-bottom:1.5rem;">
        <label class="form-label" style="display:block;margin-bottom:0.5rem;font-size:0.82rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">Blueleaf API Token</label>
        <p style="color:var(--muted);font-size:0.82rem;margin-bottom:0.75rem;">Used for financial planning data sync. Leave blank to disable Blueleaf integration.</p>
        <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
