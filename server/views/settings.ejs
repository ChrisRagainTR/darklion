      <div style="border-top:1px solid var(--border);padding-top:1.25rem;margin-top:1.25rem;">
        <label class="form-label" style="display:block;margin-bottom:0.5rem;font-size:0.82rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">LedgerHQ</label>
        <p style="color:var(--muted);font-size:0.82rem;margin-bottom:0.75rem;">Connect LedgerHQ once for the firm, then map any DarkLion company to any LedgerHQ company from the Company → Bookkeeping tab.</p>
        <div id="ledgerhq-status" style="font-size:0.84rem;color:var(--muted);margin-bottom:0.75rem;">Checking LedgerHQ…</div>
        <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
          <button class="btn btn-gold btn-sm" onclick="connectLedgerHq()" id="ledgerhq-connect-btn">Connect LedgerHQ</button>
          <button class="btn btn-outline btn-sm" onclick="refreshLedgerHqCompanies()" id="ledgerhq-refresh-btn">Refresh Companies</button>
