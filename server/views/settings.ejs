          <button class="btn btn-gold btn-sm" onclick="saveBlueleafToken()">Save</button>
          <button class="btn btn-sm" style="background:var(--charcoal);border:1px solid var(--border);color:var(--muted);" onclick="clearBlueleafToken()">Clear</button>
        </div>
        <div id="blueleaf-token-current" style="margin-top:0.5rem;font-size:0.8rem;color:var(--muted);"></div>
        <span id="blueleaf-token-save-msg" style="font-size:0.82rem;color:var(--green);display:none;">✓ Saved</span>
