<%- include('partials/shell-top', { title: 'Settings', activeNav: 'settings' }) %>
<%- include('partials/shell-globals') %>

<style>
  .settings-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
  .settings-section { margin-bottom: 2.5rem; }
  .settings-section h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--text); }
  .settings-section p { font-size: 0.82rem; color: var(--muted); margin-bottom: 1rem; }
  .domain-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem; background: var(--charcoal); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.5rem; }
  .domain-row .domain-name { font-size: 0.88rem; font-weight: 600; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .domain-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .dns-info { background: rgba(201,168,76,0.06); border: 1px solid rgba(201,168,76,0.2); border-radius: 6px; padding: 0.6rem 0.85rem; font-size: 0.78rem; color: var(--muted); margin-top: 0.35rem; margin-bottom: 0.25rem; font-family: monospace; word-break: break-all; }
  .add-domain-row { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .add-domain-row .form-control { flex: 1; }
  .instructions { background: var(--charcoal); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; font-size: 0.82rem; color: var(--muted); line-height: 1.6; }
  .instructions ol { padding-left: 1.25rem; }
  .instructions li { margin-bottom: 0.35rem; }
  .instructions code { background: rgba(255,255,255,0.07); padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.85em; color: var(--text); }
  /* Settings tabs */
  .settings-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .settings-tab-btn { background: none; border: none; border-bottom: 2px solid transparent; padding: 0.6rem 1rem; font-size: 0.88rem; font-weight: 600; color: var(--muted); cursor: pointer; margin-bottom: -1px; transition: color 0.15s, border-color 0.15s; white-space: nowrap; }
  .settings-tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }
  .settings-tab-btn:hover:not(.active) { color: var(--text); }
  .settings-tab-panel { display: none; }
  .settings-tab-panel.active { display: block; }
  .archive-overview { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(240px,0.65fr); gap:1px; border:1px solid var(--border); background:var(--border); border-radius:8px; overflow:hidden; margin-bottom:2rem; }
  .archive-overview-main, .archive-overview-status { background:var(--charcoal); padding:1.25rem; }
  .archive-overview-main { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; }
  .archive-overview-main h2 { margin:0 0 0.35rem; font-size:1rem; }
  .archive-overview-main p { margin:0; max-width:620px; line-height:1.55; }
  .archive-open-btn { flex-shrink:0; display:inline-flex; align-items:center; gap:0.45rem; text-decoration:none; }
  .archive-health-label { color:var(--muted); font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; }
  .archive-health-value { color:var(--text); font-size:1.35rem; font-weight:800; margin-top:0.3rem; }
  .archive-health-note { color:var(--muted); font-size:0.75rem; margin-top:0.2rem; }
  .archive-company-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border); }
  @media (max-width: 760px) {
    .archive-overview { grid-template-columns:1fr; }
    .archive-overview-main { align-items:flex-start; flex-direction:column; }
  }
  /* API token table */
  .token-table { width: 100%; border-collapse: collapse; font-size: 0.83rem; margin-top: 1rem; }
  .token-table th { text-align: left; padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .token-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: var(--text); vertical-align: middle; }
  .token-table td:first-child { font-weight: 600; }
  .token-copy-box { background: var(--charcoal); border: 1px solid var(--border); border-radius: 6px; padding: 0.6rem 0.85rem; font-family: monospace; font-size: 0.78rem; color: var(--gold); word-break: break-all; margin: 0.75rem 0; }
  .mcp-endpoint-card { background: rgba(201,168,76,0.06); border: 1px solid rgba(201,168,76,0.2); border-radius: 8px; padding: 1rem; margin-bottom: 1.25rem; }
  .mcp-endpoint-row { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.65rem; }
  .mcp-endpoint-url { flex: 1; min-width: 0; background: var(--charcoal); border: 1px solid var(--border); border-radius: 6px; padding: 0.65rem 0.85rem; font-family: monospace; font-size: 0.82rem; color: var(--gold); word-break: break-all; }
  @media (max-width: 560px) { .mcp-endpoint-row { align-items: stretch; flex-direction: column; } }
  .token-warning { background: rgba(245,101,101,0.08); border: 1px solid rgba(245,101,101,0.25); border-radius: 6px; padding: 0.5rem 0.85rem; font-size: 0.8rem; color: #f56565; margin-bottom: 0.75rem; }
  .agent-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; max-width: 760px; }
  .agent-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .agent-form-grid .full { grid-column: 1 / -1; }
  .agent-status-pill { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.78rem; font-weight: 700; color: var(--muted); background: rgba(255,255,255,0.03); }
  .agent-status-pill.connected { border-color: rgba(72,187,120,0.35); color: var(--green); background: rgba(72,187,120,0.08); }
  .agent-status-pill.paused { border-color: rgba(201,168,76,0.35); color: var(--gold); background: rgba(201,168,76,0.08); }
  .agent-status-pill.error, .agent-status-pill.disabled { border-color: rgba(245,101,101,0.35); color: var(--red); background: rgba(245,101,101,0.08); }
  .agent-callback-token { background: rgba(201,168,76,0.06); border: 1px solid rgba(201,168,76,0.2); border-radius: 8px; padding: 0.75rem; font-family: monospace; font-size: 0.78rem; color: var(--gold); word-break: break-all; margin-top: 0.75rem; }
  @media (max-width: 720px) { .agent-form-grid { grid-template-columns: 1fr; } }
</style>

<div class="settings-wrap">
  <h1 style="font-size:1.35rem;font-weight:800;margin-bottom:1.5rem;">⚙️ Settings</h1>

  <div class="settings-tabs">
    <button class="settings-tab-btn active" onclick="switchTab('branding')">🎨 Firm Branding</button>
    <button class="settings-tab-btn" onclick="switchTab('domains')">🌐 Custom Domains</button>
    <button class="settings-tab-btn" onclick="switchTab('api-keys')">🔑 API Keys</button>
    <button class="settings-tab-btn" onclick="switchTab('downloads')">⬇️ Downloads</button>
    <button class="settings-tab-btn" onclick="switchTab('tax-season')">🗓 Tax Season</button>
    <button class="settings-tab-btn" onclick="switchTab('document-notifications')">📄 Upload Routing</button>
    <button class="settings-tab-btn" onclick="switchTab('integrations')">🔗 Integrations</button>
    <button class="settings-tab-btn" onclick="switchTab('archives')">🗄️ Archives</button>
  </div>

  <!-- ============ FIRM BRANDING ============ -->
  <div class="settings-tab-panel active" id="tab-branding">
    <div class="settings-section">
      <h2>🎨 Firm Branding</h2>
      <p>Customize how your firm appears in the client portal, proposals, and emails.</p>

      <div class="form-group">
        <label for="client-login-url">Your branded client login link</label>
        <input id="client-login-url" type="url" readonly style="width:100%" onclick="this.select()" />
        <p>Share this link with clients. They sign in with their email and password.</p>
      </div>

      <!-- Logo -->
      <div style="margin-bottom:2rem;">
        <div style="font-size:0.82rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.75rem;">Firm Logo</div>
        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
          <div id="logo-preview" style="width:120px;height:60px;background:var(--charcoal);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;">
            <span style="color:var(--muted);font-size:0.75rem;">No logo</span>
          </div>
          <div>
            <label class="btn btn-outline" style="cursor:pointer;display:inline-block;">
              📁 Choose Logo
              <input type="file" id="logo-input" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="uploadLogo(this)">
            </label>
            <div style="font-size:0.75rem;color:var(--muted);margin-top:0.4rem;">PNG, JPG or WebP. Recommended: 400×200px or wider, transparent background.</div>
          </div>
        </div>
      </div>

      <div style="margin-bottom:2rem;">
        <label class="form-label" for="portal-icon-input">Portal Icon / Large Favicon</label>
        <p>Upload a square brand mark for the login page and browser icon. Recommended: 512×512px, with a transparent background.</p>
        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
          <div id="portal-icon-preview" style="width:104px;height:104px;display:flex;align-items:center;justify-content:center;background:var(--charcoal);border:1px solid var(--border);border-radius:8px;overflow:hidden;">
            <span style="color:var(--muted);font-size:0.75rem;">No icon</span>
          </div>
          <label class="btn btn-outline" style="cursor:pointer;">
            Choose Portal Icon
            <input type="file" id="portal-icon-input" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="uploadLogo(this, 'icon')">
          </label>
        </div>
        <label class="form-label" for="b-portal-logo-style" style="display:block;margin-top:1rem;">Login Page Image</label>
        <select id="b-portal-logo-style" class="form-control">
          <option value="icon">Large portal icon above firm name</option>
          <option value="logo">Wide firm logo above firm name</option>
        </select>
        <p>Keep the full firm logo for proposals and emails. The portal icon also appears in the client portal's browser tab.</p>
      </div>

      <!-- Firm info form -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
        <div>
          <label class="form-label">Display Name</label>
          <input type="text" class="form-control" id="b-display-name" placeholder="Smith & Co. CPAs">
          <div style="font-size:0.72rem;color:var(--muted);margin-top:0.25rem;">Shown in portal and proposals instead of your account name.</div>
        </div>
        <div>
          <label class="form-label">Tagline</label>
          <input type="text" class="form-control" id="b-tagline" placeholder="Retirement planning for life's next chapter">
        </div>
        <div>
          <label class="form-label">Contact Email</label>
          <input type="email" class="form-control" id="b-contact-email" placeholder="hello@yourfirm.com">
        </div>
        <div>
          <label class="form-label">Phone</label>
          <input type="tel" class="form-control" id="b-phone" placeholder="(239) 555-0100">
        </div>
        <div>
          <label class="form-label">Website</label>
          <input type="url" class="form-control" id="b-website" placeholder="https://yourfirm.com">
        </div>
        <div>
          <label class="form-label">Brand Color</label>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <input type="color" id="b-color-picker" value="#C9A84C" style="width:42px;height:38px;padding:2px;background:var(--charcoal);border:1px solid var(--border);border-radius:6px;cursor:pointer;">
            <input type="text" class="form-control" id="b-primary-color" placeholder="#C9A84C" maxlength="7" style="flex:1;" oninput="syncColorPicker(this.value)">
          </div>
          <div style="font-size:0.72rem;color:var(--muted);margin-top:0.25rem;">Used for portal buttons and accents.</div>
        </div>
      </div>

      <div style="margin-bottom:1.5rem;">
        <label class="form-label">Address</label>
        <textarea class="form-control" id="b-address" rows="5" style="resize:vertical;min-height:100px;" placeholder="123 Main Street, Suite 200&#10;Springfield, IL 62701"></textarea>
        <div style="font-size:0.72rem;color:var(--muted);margin-top:0.25rem;">Shown on proposals and tax letters.</div>
      </div>

      <button class="btn btn-gold" onclick="saveBranding()">Save Branding</button>
    </div>
  </div><!-- end tab-branding -->

  <!-- ============ CUSTOM DOMAINS ============ -->
  <div class="settings-tab-panel" id="tab-domains">
    <div class="settings-section">
    <h2>🌐 Custom Domains</h2>
    <p>Let clients access proposals and the portal via your own domain (e.g. <code>my.yourfirm.com</code>) instead of the main app address.</p>

    <div id="domains-list">
      <div class="loading-state"><div class="loading-spinner"></div></div>
    </div>

    <div class="add-domain-row">
      <input type="text" class="form-control" id="new-domain-input" placeholder="e.g. my.yourfirm.com" autocomplete="off">
      <button class="btn btn-gold" onclick="addDomain()">+ Add Domain</button>
    </div>

    <div style="margin-top:1.5rem;">
      <div class="card-title" style="margin-bottom:0.5rem;">📋 Setup Instructions</div>
      <div class="instructions">
        <ol>
          <li><strong>Enter your domain below</strong> (e.g. <code>my.yourdomain.com</code>) — you'll get a TXT verification token and CNAME target.</li>
          <li><strong>Log in to your DNS provider</strong> (GoDaddy, Cloudflare, Namecheap, etc.) and add both records shown — the TXT record to verify ownership, and the CNAME record to point traffic to DarkLion.</li>
          <li><strong>In your Railway dashboard</strong>, go to your DarkLion service → Settings → Networking → Add Custom Domain → enter your domain. Railway will handle the SSL certificate automatically.</li>
          <li><strong>Click "Check Verification"</strong> once your DNS records have propagated. Usually under 30 minutes.</li>
          <li>Once verified, all proposal links for your firm will automatically use your custom domain. ✅</li>
        </ol>
      </div>
    </div>
  </div>
  </div><!-- end tab-domains -->

  <!-- ============ API KEYS ============ -->
  <div class="settings-tab-panel" id="tab-api-keys">
    <div class="settings-section">
      <h2>🔑 API Keys</h2>
      <p>API keys allow external agents and services to access DarkLion APIs. For Agent Work features like Inbox drafts and Team Chat replies, assign the key to the staff/agent identity it should act as. Store keys securely — they are shown only once.</p>

      <div class="mcp-endpoint-card">
        <div style="font-size:0.82rem;font-weight:700;color:var(--text);">DarkLion MCP URL</div>
        <div style="font-size:0.78rem;color:var(--muted);margin-top:0.25rem;line-height:1.45;">Use this URL when connecting DarkLion to an MCP client. The client will guide you through secure OAuth authorization.</div>
        <div class="mcp-endpoint-row">
          <code class="mcp-endpoint-url" id="mcp-endpoint-url"></code>
          <script>document.getElementById('mcp-endpoint-url').textContent = location.origin + '/mcp';</script>
          <button type="button" class="btn btn-outline" onclick="copyMcpEndpoint(this)">📋 Copy URL</button>
        </div>
      </div>

      <button class="btn btn-gold" onclick="openNewTokenModal()" style="margin-bottom:1rem;">+ Generate New Key</button>

      <div id="api-tokens-list">
        <div class="loading-state"><div class="loading-spinner"></div></div>
      </div>
    </div>
  </div><!-- end tab-api-keys -->

  <!-- ============ DOWNLOADS ============ -->
  <div class="settings-tab-panel" id="tab-downloads">
    <div class="settings-section">
      <h2>Desktop Apps</h2>
      <p>Install desktop tools for your firm's staff.</p>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.5rem;display:flex;align-items:center;gap:1.5rem;">
        <div style="font-size:2.5rem;line-height:1;">🦁</div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:1rem;margin-bottom:0.25rem;">DarkLion Drive</div>
          <div style="color:var(--muted);font-size:0.85rem;margin-bottom:0.5rem;">Mount your DarkLion documents as a folder on your Windows desktop. Drag and drop files directly into client folders.</div>
          <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.75rem;">Windows 10/11 only &nbsp;·&nbsp; WinFsp installed automatically.</div>
          <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.75rem;background:rgba(255,255,255,0.04);border-radius:6px;padding:0.5rem 0.75rem;line-height:1.6;">
            <strong style="color:var(--text);">Setup notes:</strong><br>
            1. Install WinFsp <strong>before</strong> running the installer. If you see a WinFsp error, download it first: <a href="https://winfsp.dev/rel" target="_blank" style="color:var(--gold);">winfsp.dev/rel</a><br>
            2. After connecting, look for the <strong>DarkLion Drive</strong> shortcut on your Desktop. On OneDrive-synced PCs it may appear in your user folder (<code style="color:var(--muted);">C:\Users\you\DarkLion Drive</code>) — drag it to your Desktop.
          </div>
          <a href="/downloads/darklion-drive/windows"
             class="btn btn-gold"
             style="display:inline-block;text-decoration:none;font-size:0.85rem;padding:0.5rem 1.25rem;">
            ⬇️ Download DarkLion Drive v1.0.2
          </a>
        </div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.5rem;display:flex;align-items:center;gap:1.5rem;margin-top:1rem;">
        <div style="font-size:2.5rem;line-height:1;">💻</div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:1rem;margin-bottom:0.25rem;">DarkLion Desktop</div>
          <div style="color:var(--muted);font-size:0.85rem;margin-bottom:0.5rem;">Run DarkLion as a full desktop workstation app with native notifications, taskbar unread badges, Team Chat alerts, deep links, and faster access to daily advisor workflows.</div>
          <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.75rem;">Windows 10/11 &nbsp;·&nbsp; Native notifications &nbsp;·&nbsp; Taskbar unread badge &nbsp;·&nbsp; Team Chat + Messages alerts</div>
          <a href="/downloads/darklion-desktop/windows"
             class="btn btn-gold"
             style="display:inline-block;text-decoration:none;font-size:0.85rem;padding:0.5rem 1.25rem;">
            ⬇️ Download DarkLion Desktop v1.0.3
          </a>
        </div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.5rem;display:flex;align-items:center;gap:1.5rem;margin-top:1rem;">
        <div style="font-size:2.5rem;line-height:1;">🖨️</div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:1rem;margin-bottom:0.25rem;">DarkLion Print Agent</div>
          <div style="color:var(--muted);font-size:0.85rem;margin-bottom:0.5rem;">Print and upload tax documents directly from Drake Software to DarkLion. Batch print jobs with automatic client matching.</div>
          <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.75rem;">Windows only &nbsp;·&nbsp; Requires Drake Tax Software</div>
          <a href="https://github.com/ChrisRagainTR/darklion/releases/download/printv1.0.1/DarkLionPrintAgent_Setup_1.0.1.exe"
             class="btn btn-gold"
             style="display:inline-block;text-decoration:none;font-size:0.85rem;padding:0.5rem 1.25rem;">
            ⬇️ Download Print Agent v1.0.1
          </a>
        </div>
      </div>
    </div>
  </div><!-- end tab-downloads -->

  <!-- ============ TAX SEASON ============ -->
  <div class="settings-tab-panel" id="tab-tax-season">
    <div class="settings-section" style="max-width:560px;">
      <h2>🗓 Tax Season</h2>
      <p style="color:var(--muted);font-size:0.88rem;margin-bottom:1.5rem;">Set the active tax year for client organizers. When you flip this, the client portal immediately shows the new year's organizer. No deploy needed.</p>

      <label class="form-label" style="display:block;margin-bottom:0.5rem;font-size:0.82rem;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">Active Tax Year</label>
      <div style="display:flex;gap:0.75rem;align-items:center;">
        <select id="active-tax-year-select" class="form-control" style="width:120px;">
          <option value="2024">2024</option>
          <option value="2025" selected>2025</option>
          <option value="2026">2026</option>
          <option value="2027">2027</option>
        </select>
        <button class="btn btn-gold btn-sm" onclick="saveTaxYear()">Save</button>
        <span id="tax-year-save-msg" style="font-size:0.82rem;color:var(--green);display:none;">✓ Saved</span>
        <span id="tax-year-err-msg" style="font-size:0.82rem;color:var(--red);display:none;"></span>
      </div>

      <div style="margin-top:1.25rem;padding:1rem 1.25rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;font-size:0.82rem;color:var(--muted);line-height:1.8;">
        <div style="font-weight:600;color:var(--text);margin-bottom:0.4rem;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.04em;">What this controls</div>
        <div>→ Client portal Organizers tab shows the active year</div>
        <div>→ New Drake organizer uploads default to this year</div>
        <div>→ Prior years move to the "Prior Years" section on the client portal</div>
      </div>

      <div style="margin-top:1.5rem;">
        <a href="/tax-season" class="btn btn-gold" style="display:inline-flex;align-items:center;gap:0.5rem;">📋 Manage Client Organizer Visibility</a>
      </div>
    </div>
  </div><!-- end tab-tax-season -->

  <!-- ============ DOCUMENT UPLOAD NOTIFICATIONS ============ -->
  <div class="settings-tab-panel" id="tab-document-notifications">
    <div class="settings-section" style="max-width:760px;">
      <h2>📄 Client Document Upload Routing</h2>
      <p>Choose which staff members receive Inbox alerts for each client-uploaded folder. Organizer uploads follow Tax routing. Secure-message attachments remain regular Messages.</p>
      <div style="display:grid;gap:1rem;margin:1.25rem 0;">
        <div data-route-category="tax" style="padding:1rem;border:1px solid var(--border);border-radius:8px;"><strong>Tax</strong><span data-route-warning role="status" style="display:block;color:#f59e0b;font-size:0.76rem;margin-top:0.35rem;">⚠ No recipients configured — Tax uploads will not create alerts.</span><div class="route-staff-options" style="display:grid;gap:0.45rem;margin-top:0.65rem;"></div></div>
        <div data-route-category="bookkeeping" style="padding:1rem;border:1px solid var(--border);border-radius:8px;"><strong>Bookkeeping</strong><span data-route-warning role="status" style="display:block;color:#f59e0b;font-size:0.76rem;margin-top:0.35rem;">⚠ No recipients configured — Bookkeeping uploads will not create alerts.</span><div class="route-staff-options" style="display:grid;gap:0.45rem;margin-top:0.65rem;"></div></div>
        <div data-route-category="other" style="padding:1rem;border:1px solid var(--border);border-radius:8px;"><strong>Other</strong><span data-route-warning role="status" style="display:block;color:#f59e0b;font-size:0.76rem;margin-top:0.35rem;">⚠ No recipients configured — Other uploads will not create alerts.</span><div class="route-staff-options" style="display:grid;gap:0.45rem;margin-top:0.65rem;"></div></div>
