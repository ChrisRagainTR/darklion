  async function disconnectCompanyQbo(companyIdToDisconnect, companyName) {
    const label = companyName || 'this company';
    if (!confirm(`Disconnect QBO for ${label}? This will clear the stored QuickBooks connection for this company, but keep the company record and history in DarkLion.`)) return;
    try {
      const res = await apiFetch(`/api/companies/${companyIdToDisconnect}/disconnect-qbo`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to disconnect QBO');
      _shellToast(`Disconnected QBO for ${label}`);
      await loadCompany();
    } catch (e) {
      _shellToast(`Disconnect failed: ${e.message}`);
    }
  }

  async function openLedgerHqClosePackageFromOverview() {
    await bk_setClosePackageProvider('ledgerhq');
    if (bk_cpProvider === 'ledgerhq') ov2GoTab('bk-reports');
  }

  async function saveBookkeepingSettings() {
    const bookkeeper_id = document.getElementById('ov-bk-bookkeeper')?.value || null;
    const bookkeeping_service = document.getElementById('ov-bk-service')?.value || 'none';
    const msgEl = document.getElementById('ov-bk-save-msg');
    try {
      const res = await apiFetch(`/api/companies/${companyId}`, { method: 'PUT', body: JSON.stringify({ bookkeeper_id: bookkeeper_id || null, bookkeeping_service }) });
      if (!res.ok) throw new Error('Failed');
      if (msgEl) { msgEl.textContent = '✓ Saved'; setTimeout(()=>{ msgEl.textContent=''; }, 2000); }
      if (companyData) { companyData.bookkeeper_id = bookkeeper_id; companyData.bookkeeping_service = bookkeeping_service; }
      renderHeader(companyData);
    } catch(e) { if (msgEl) { msgEl.style.color='var(--red)'; msgEl.textContent='Failed to save'; setTimeout(()=>{ msgEl.textContent=''; msgEl.style.color='var(--green)'; }, 2000); } }
  }

  function docTypeBadge(mimeType, displayName) {
    const mime = (mimeType || '').toLowerCase();
    const name = (displayName || '').toLowerCase();
    const ext = name.includes('.') ? name.split('.').pop() : '';
    let label, color;
    if (mime === 'application/pdf' || ext === 'pdf') { label = 'PDF'; color = '#e53e3e'; }
    else if (mime.includes('spreadsheet') || mime.includes('excel') || ext === 'xlsx' || ext === 'xls' || ext === 'csv') { label = ext === 'csv' ? 'CSV' : 'Excel'; color = '#38a169'; }
    else if (mime.includes('word') || ext === 'docx' || ext === 'doc') { label = 'Word'; color = '#3182ce'; }
    else if (mime.includes('presentation') || mime.includes('powerpoint') || ext === 'pptx' || ext === 'ppt') { label = 'PPT'; color = '#dd6b20'; }
    else if (mime.startsWith('image/') || ['jpg','jpeg','png','gif','webp','heic'].includes(ext)) { label = 'Image'; color = '#805ad5'; }
    else if (mime.includes('zip') || ext === 'zip') { label = 'ZIP'; color = '#718096'; }
    else if (mime.startsWith('text/') || ext === 'txt') { label = 'TXT'; color = '#718096'; }
    else { label = ext ? ext.toUpperCase().slice(0,4) : 'FILE'; color = '#718096'; }
    return `<span style="flex-shrink:0;padding:0.15rem 0.4rem;border-radius:4px;font-size:0.65rem;font-weight:700;color:#fff;background:${color};letter-spacing:0.03em;">${label}</span>`;
  }

  function formatBytes(b) {
    if (!b) return '';
    if (b < 1024) return b + ' B';
    if (b < 1024*1024) return (b/1024).toFixed(1) + ' KB';
    return (b/(1024*1024)).toFixed(1) + ' MB';
  }

  function isEngagementLetterDoc(doc) {
    const cat = (doc.folder_category || '').toLowerCase();
    const typ = (doc.doc_type || '').toLowerCase();
    return cat === 'engagement_letter' || typ === 'engagement_letter';
  }

  const DOC_CATS_FIRM   = [
    { key: 'tax',         label: 'Tax',         icon: '🧾' },
    { key: 'bookkeeping', label: 'Bookkeeping',  icon: '📒' },
    { key: 'private',     label: 'Private',      icon: '🔒' },
    { key: 'other',       label: 'Other',        icon: '📎' },
  ];
  const DOC_CATS_CLIENT = [
    { key: 'tax',         label: 'Tax',         icon: '🧾' },
    { key: 'bookkeeping', label: 'Bookkeeping',  icon: '📒' },
    { key: 'other',       label: 'Other',        icon: '📎' },
  ];

  let documentFolders = [];

  function companyFolderDefinitions(section, category) {
    return documentFolders.filter(folder => folder.folder_section === section && folder.folder_category === category);
  }

  function companyFolderOptions(section, category, selectedId) {
    const categoryLabels = { tax: 'Tax', bookkeeping: 'Bookkeeping', other: 'Other' };
    const options = documentFolders
      .filter(folder => categoryLabels[folder.folder_category])
      .map(folder => {
        const sectionLabel = folder.folder_section === 'client_uploaded' ? 'Client Uploaded' : 'Delivered by Advisor';
        const path = `${sectionLabel} / ${categoryLabels[folder.folder_category]} / ${folder.name}`;
        return `<option value="${folder.id}"${Number(selectedId) === Number(folder.id) ? ' selected' : ''}>${esc(path)}</option>`;
      })
      .join('');
    return `<option value="">No custom folder</option>${options}`;
  }

  function syncCompanyFolderPlacement(folderSelect, sectionSelect, categorySelect) {
    const folder = documentFolders.find(item => Number(item.id) === Number(folderSelect?.value));
    if (!folder) return;
    sectionSelect.value = folder.folder_section;
    categorySelect.value = folder.folder_category;
  }

  function syncCompanyMovePlacementFromFolder(id) {
    syncCompanyFolderPlacement(
      document.getElementById(`mv-folder-${id}`),
      document.getElementById(`mv-sec-${id}`),
      document.getElementById(`mv-cat-${id}`)
    );
  }

  function refreshCompanyMoveFolderOptions(id) {
    const section = document.getElementById(`mv-sec-${id}`)?.value || 'firm_uploaded';
    const category = document.getElementById(`mv-cat-${id}`)?.value || 'other';
    const select = document.getElementById(`mv-folder-${id}`);
    if (select) select.innerHTML = companyFolderOptions(section, category, '');
  }

  function renderCompanyDocRow(file, statusBadge, isClientSection) {
    const years = [];
    for (let year = new Date().getFullYear(); year >= 2018; year--) years.push(year);
    return `<div class="doc-row" data-docid="${file.id}">
      ${docTypeBadge(file.mime_type, file.display_name)}
      <div class="doc-info">
        <div class="doc-name doc-name-link" data-docid="${file.id}" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">${esc((file.display_name || 'Untitled').replace(/_/g, ' ').trim())}</div>
        <div class="doc-badges">${statusBadge}${file.size_bytes ? `<span class="doc-badge doc-badge-type">${formatBytes(file.size_bytes)}</span>` : ''}${file.created_at ? `<span style="font-size:0.67rem;color:var(--muted);opacity:0.7;">${new Date(file.created_at).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/New_York',timeZoneName:'short'})}</span>` : ''}</div>
        <div id="move-panel-${file.id}" style="display:none;margin-top:0.4rem;padding:0.4rem;background:rgba(201,168,76,0.06);border-radius:5px;">
          <span style="font-size:0.72rem;color:var(--muted);margin-right:0.3rem;">Move to:</span>
          <select id="mv-year-${file.id}" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">${years.map(year => `<option value="${year}"${String(file.year || '') === String(year) ? ' selected' : ''}>${year}</option>`).join('')}</select>
          <select id="mv-sec-${file.id}" onchange="refreshCompanyMoveFolderOptions(${file.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">
            <option value="firm_uploaded"${(file.folder_section || 'firm_uploaded') === 'firm_uploaded' ? ' selected' : ''}>Advisor</option>
            <option value="client_uploaded"${file.folder_section === 'client_uploaded' ? ' selected' : ''}>Client</option>
          </select>
          <select id="mv-cat-${file.id}" onchange="refreshCompanyMoveFolderOptions(${file.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">
            <option value="tax"${file.folder_category === 'tax' ? ' selected' : ''}>Tax</option>
            <option value="bookkeeping"${file.folder_category === 'bookkeeping' ? ' selected' : ''}>Bookkeeping</option>
            <option value="other"${(file.folder_category || 'other') === 'other' ? ' selected' : ''}>Other</option>
          </select>
          <select id="mv-folder-${file.id}" onchange="syncCompanyMovePlacementFromFolder(${file.id})" style="background:var(--charcoal);border:1px solid var(--border);color:var(--text);padding:0.2rem 0.4rem;border-radius:4px;font-size:0.75rem;margin-right:0.3rem;">${companyFolderOptions(file.folder_section || 'firm_uploaded', file.folder_category || 'other', file.document_folder_id)}</select>
          <button data-action="save-move" style="background:var(--gold);color:var(--navy);border:none;border-radius:4px;padding:0.2rem 0.55rem;font-size:0.75rem;font-weight:700;cursor:pointer;">Save</button>
          <button data-action="close-move" style="background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:4px;padding:0.2rem 0.45rem;font-size:0.75rem;cursor:pointer;margin-left:0.2rem;">✕</button>
        </div>
      </div>
      <div style="display:flex;gap:0.4rem;flex-shrink:0;align-items:center;">
        <button class="btn-dl" data-docid="${file.id}">⬇</button>
        <button class="btn btn-ghost btn-xs" data-action="quick-move" title="Move to ${isClientSection ? 'Delivered by Advisor' : 'Uploaded by Client'}">${isClientSection ? '→ Advisor' : '→ Client'}</button>
        <button class="btn btn-ghost btn-xs" data-action="toggle-move" title="Move">↕</button>
        <button class="btn btn-ghost btn-xs" style="color:var(--red)" data-action="delete" title="Delete">🗑</button>
      </div>
    </div>`;
  }

  function renderCompanyCategoryFiles(files, section, category, year, statusBadge, isClientSection) {
    const unfiled = files.filter(file => !file.folder_subcategory);
    const names = new Set(files.map(file => file.folder_subcategory).filter(Boolean));
    if (String(year) === String(new Date().getFullYear())) {
      companyFolderDefinitions(section, category).forEach(folder => names.add(folder.name));
    }
    let html = unfiled.map(file => renderCompanyDocRow(file, statusBadge, isClientSection)).join('');
    Array.from(names).sort((a, b) => a.localeCompare(b)).forEach(name => {
      const folderFiles = files.filter(file => file.folder_subcategory === name);
      html += `<div class="year-folder open" style="margin-bottom:0.35rem;">
        <div class="year-header" style="padding:0.3rem 0.5rem;font-size:0.8rem;"><span class="yr-label">📁 ${esc(name)} <span class="yr-count">${folderFiles.length}</span></span><span class="yr-chevron">▼</span></div>
        <div class="year-body" style="padding-left:1rem;">${folderFiles.length ? folderFiles.map(file => renderCompanyDocRow(file, statusBadge, isClientSection)).join('') : '<div style="color:var(--muted);font-size:0.78rem;font-style:italic;">Empty</div>'}</div>
      </div>`;
    });
    return html || '<div style="color:var(--muted);font-size:0.78rem;font-style:italic;padding:0.2rem 0;">Empty</div>';
  }

  function buildDocsColumn(sectionDocs, title, icon, cats) {
    cats = cats || DOC_CATS_FIRM;
    const isClientSection = title.toLowerCase().includes('client');
    const section = isClientSection ? 'client_uploaded' : 'firm_uploaded';
    const engagementLetters = !isClientSection ? sectionDocs.filter(isEngagementLetterDoc) : [];
    sectionDocs = sectionDocs.filter(file => !isEngagementLetterDoc(file));
    const currentYear = new Date().getFullYear();
    const years = [];
    for (let year = currentYear; year >= 2018; year--) years.push(String(year));

    function renderYear(year) {
      const yearDocs = sectionDocs.filter(file => (file.year || String(currentYear)) === year);
      return `<div class="year-folder" style="margin-bottom:0.4rem;">
        <div class="year-header"><span class="yr-label">📅 ${year} <span class="yr-count">${yearDocs.length}</span></span><span class="yr-chevron">▼</span></div>
        <div class="year-body" style="padding-left:1rem;">${cats.map(category => {
          const files = yearDocs.filter(file => (file.folder_category || file.doc_type || 'other') === category.key);
          const statusBadge = isClientSection ? '<span class="doc-badge doc-badge-client">✓ Uploaded</span>' : '<span class="doc-badge doc-badge-viewed">✓ Delivered</span>';
          return `<div class="cat-folder"><div class="cat-folder-header" onclick="this.closest('.cat-folder').classList.toggle('open')"><span class="cat-folder-label">${category.icon} ${category.label}</span><span style="display:flex;align-items:center;gap:0.5rem;"><span class="cat-folder-meta">${files.length} file${files.length !== 1 ? 's' : ''}</span><span class="cat-chevron">▼</span></span></div><div class="cat-folder-body">${renderCompanyCategoryFiles(files, section, category.key, year, statusBadge, isClientSection)}</div></div>`;
        }).join('')}</div>
      </div>`;
    }

    let html = `<div class="docs-col-title">${icon} ${title} <span style="font-size:0.75rem;font-weight:400;color:var(--muted);">(${sectionDocs.length + engagementLetters.length})</span></div>`;
    if (engagementLetters.length) {
      html += `<div class="year-folder" style="margin-bottom:0.65rem;border-color:rgba(201,168,76,0.35);"><div class="year-header"><span class="yr-label">📄 Engagement Letters <span class="yr-count">${engagementLetters.length}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:1rem;">${engagementLetters.map(file => renderCompanyDocRow(file, '<span class="doc-badge doc-badge-viewed">✓ Delivered</span>', false)).join('')}</div></div>`;
    }
    years.slice(0, 2).forEach(year => { html += renderYear(year); });
    const priorYears = years.slice(2);
    const priorCount = priorYears.reduce((count, year) => count + sectionDocs.filter(file => (file.year || String(currentYear)) === year).length, 0);
    html += `<div class="year-folder" style="margin-bottom:0.4rem;"><div class="year-header"><span class="yr-label">📂 Prior Years <span class="yr-count">${priorCount}</span></span><span class="yr-chevron">▼</span></div><div class="year-body" style="padding-left:0.5rem;">${priorYears.map(renderYear).join('')}</div></div>`;
    return html;
  }

  let docsData = [];
  let docsTrashData = [];
  let docsShowingTrash = false;

  async function loadDocs() {
    const el = document.getElementById('docs-content');
    if (el.dataset.loaded) return;
    el.dataset.loaded = '1';
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading…</div></div>';
    try {
      const [docsRes, foldersRes] = await Promise.all([
        apiFetch(`/api/documents?owner_type=company&owner_id=${companyId}`),
        apiFetch(`/api/documents/folders?owner_type=company&owner_id=${companyId}`),
      ]);
      docsData = await docsRes.json();
      documentFolders = foldersRes.ok ? await foldersRes.json() : [];
      renderDocs();
    } catch(e) { el.innerHTML = '<div class="empty-state">Failed to load documents.</div>'; }
  }

  async function loadTrashDocs() {
    const el = document.getElementById('docs-content');
    docsShowingTrash = true;
    el.innerHTML = '<div class="loading-state"><div class="loading-spinner"></div><div>Loading Trash…</div></div>';
    try {
      const res = await apiFetch(`/api/documents?owner_type=company&owner_id=${companyId}&include_deleted=only`);
      docsTrashData = await res.json();
      renderDocs();
