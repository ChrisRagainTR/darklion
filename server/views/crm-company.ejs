  // Auto Bookkeeper JS (company-scoped)
  // ═══════════════════════════════════════════════════════════

  let abCompanyData = null;
  let abRealmId = null;
  let abAllTransactions = [];
  let abDirFilter = 'all';

  async function ab_initAutoBookkeeper() {
    console.log('[ab_init] Starting, companyId:', companyId);
    if (!companyId) return;
    // Use existing companyData if available, otherwise fetch it
    if (companyData && companyData.realm_id) {
      abCompanyData = companyData;
      abRealmId = companyData.realm_id;
      console.log('[ab_init] Using existing companyData, realmId:', abRealmId);
    } else {
      try {
        console.log('[ab_init] Fetching company data for', companyId);
        const res = await apiFetch(`/api/companies/${companyId}`);
        if (!res.ok) {
          console.error('[ab_init] API failed:', res.status);
          return;
        }
        abCompanyData = await res.json();
        abRealmId = abCompanyData.realm_id;
        console.log('[ab_init] Fetched company data, realmId:', abRealmId);
      } catch (e) {
        console.error('ab_initAutoBookkeeper error:', e);
        return;
      }
    }

    // Load the active subtab
    const activeSubtab = document.querySelector('#subtab-auto-bookkeeper .subtab-item.active');
    console.log('[ab_init] Active subtab found:', !!activeSubtab);
    if (activeSubtab) {
      const name = activeSubtab.getAttribute('onclick').match(/'([^']+)'/)[1];
      console.log('[ab_init] Loading subtab:', name);
      ab_loadActiveSubtab(name);
    }
  }

  function ab_showConnectCard(needsReconnect) {
    const guard = document.getElementById('ab-uncat-qbo-guard');
    if (!guard) return;
    guard.innerHTML = `
      <div class="connect-qbo-prompt">
        <div style="font-size:2.5rem;margin-bottom:1rem;">🔐</div>
        <h3>QuickBooks Not Connected</h3>
        <p>${needsReconnect ? 'QBO tokens expired. Please reconnect.' : 'Connect QuickBooks to enable Auto Bookkeeper.'}</p>
        <a href="/connect?realm_id=${abRealmId || ''}&return_to=${encodeURIComponent(window.location.pathname)}" class="btn btn-gold">Connect QuickBooks</a>
      </div>`;
  }

  function ab_loadActiveSubtab(name) {
    console.log('[ab_loadActiveSubtab] Called with name:', name);
    if (name === 'ab-uncategorized') {
      console.log('[ab_loadActiveSubtab] Calling ab_loadUncategorized');
      ab_loadUncategorized();
    } else if (name === 'ab-history') {
      console.log('[ab_loadActiveSubtab] Calling ab_loadHistory');
      ab_loadHistory();
    } else if (name === 'ab-mappings') {
      console.log('[ab_loadActiveSubtab] Calling ab_loadMappings');
      ab_loadMappings();
    } else if (name === 'ab-sent-to-client') {
      console.log('[ab_loadActiveSubtab] Calling ab_loadSentToClient');
      ab_loadSentToClient();
    } else {
      console.log('[ab_loadActiveSubtab] Unknown subtab:', name);
    }
  }

  async function ab_loadUncategorized() {
    console.log('[ab_uncat] Loading, abRealmId:', abRealmId, 'companyId:', companyId);
    const main = document.getElementById('ab-uncat-main');
    const guard = document.getElementById('ab-uncat-qbo-guard');
    if (!main || !guard) {
      console.log('[ab_uncat] Missing DOM elements');
      return;
    }

    // If realm not set yet, try to init first
    if (!abRealmId && companyId) {
      console.log('[ab_uncat] Realm not set, calling init');
      await ab_initAutoBookkeeper();
    }

    if (!abRealmId) {
      console.log('[ab_uncat] Still no realmId, showing connect card');
      guard.style.display = '';
      main.style.display = 'none';
      return;
    }
    console.log('[ab_uncat] Showing main content, main element:', main ? 'found' : 'NOT FOUND');
    guard.style.display = 'none';
    main.style.display = '';
    console.log('[ab_uncat] Main div display set to:', main.style.display);

    const scanBtn = document.getElementById('ab-uncat-scan-btn');
    const runBtn = document.getElementById('ab-uncat-run-btn');
    if (scanBtn) scanBtn.disabled = true;
    if (runBtn) runBtn.disabled = true;

    try {
      console.log('[ab_uncat] Fetching from /api/bookkeeper/company/', companyId, '/uncoded');
      const res = await apiFetch(`/api/bookkeeper/company/${companyId}/uncoded?showSnoozed=${abSnoozedMode ? 'only' : 'false'}`);
      console.log('[ab_uncat] API response status:', res.status);
      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        console.error('[ab_uncat] API error:', errData);
        throw new Error(errData.error || `API status ${res.status}`);
      }
      const data = await res.json();
      console.log('[ab_uncat] API response data:', data);
      console.log('[ab_uncat] Transactions count:', data.transactions?.length || 0);
      ab_renderUncategorized(data);
    } catch (e) {
      console.error('[ab_uncat] Error:', e);
      document.getElementById('ab-uncat-results').innerHTML = `<div style="color:var(--red);padding:1rem;">Error: ${esc(e.message)}</div>`;
    } finally {
      if (scanBtn) scanBtn.disabled = false;
      if (runBtn) runBtn.disabled = false;
    }
  }

