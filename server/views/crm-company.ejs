  // ── Auto-Bookkeeper History ──
  let _bkHistLoaded = false;
  let _bkHistData = null;
  let _bkHistSortByName = false;
  let _bkHistDirFilter = 'all';
  async function bk_initHistory() {
    if (_bkHistLoaded) return;
    _bkHistLoaded = true;
    const wrap = document.getElementById('bk-hist-wrap');
    if (!wrap || !bookkeepingRealm) {
      if (wrap) wrap.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;">QBO not connected.</div>';
      return;
    }
    try {
      const r = await apiFetch(`/api/bookkeeper/history?realmId=${encodeURIComponent(bookkeepingRealm)}&days=30`);
      _bkHistData = await r.json();
      bk_renderBookkeeperHistory();
    } catch(e) {
      wrap.innerHTML = `<div style="color:var(--red);padding:1rem;">Error loading history: ${esc(e.message)}</div>`;
    }
  }

  function bk_toggleHistSort() {
    _bkHistSortByName = document.getElementById('bk-hist-sort-name').checked;
    bk_renderBookkeeperHistory();
  }

  function bk_histDirection(txn) {
    const type = String(txn?.txn_type || '').toLowerCase();
    const acct = String(txn?.original_account || '').toLowerCase();
    const expenseTypes = ['expense', 'check', 'billpaymentcheck', 'bill payment', 'bill payment check', 'purchase', 'cashexpense', 'creditcardcharge', 'credit card charge'];
    const incomeTypes = ['deposit', 'salesreceipt', 'sales receipt', 'invoice', 'payment', 'receivepayment', 'receive payment', 'creditcardcredit', 'credit card credit'];

    if (expenseTypes.includes(type)) return 'out';
    if (incomeTypes.includes(type)) return 'in';
    if (acct.includes('credit card')) return Number(txn?.amount || 0) < 0 ? 'in' : 'out';
    return Number(txn?.amount || 0) >= 0 ? 'in' : 'out';
  }

  function bk_histAmountHtml(txn) {
    const amt = Math.abs(Number(txn?.amount || 0));
    const dir = bk_histDirection(txn);
    const color = dir === 'in' ? 'var(--green)' : 'var(--red)';
    const label = dir === 'in' ? 'Money In' : 'Money Out';
    return `<span style="color:${color};font-weight:700;">$${amt.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}</span><span style="font-size:0.7rem;color:var(--muted);margin-left:0.45rem;">${label}</span>`;
  }

  function bk_setHistDirFilter(dir, btn) {
    _bkHistDirFilter = dir;
    document.querySelectorAll('.bk-hist-dir-btn').forEach(b => b.className = 'btn btn-outline btn-sm bk-hist-dir-btn');
    if (btn) btn.className = 'btn btn-gold btn-sm bk-hist-dir-btn';
    bk_renderBookkeeperHistory();
  }

  function bk_renderBookkeeperHistory() {
    const wrap = document.getElementById('bk-hist-wrap');
    if (!wrap || !_bkHistData) return;
    const data = _bkHistData;
    if (!data.totalCount) {
      wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--muted);"><div style="font-size:1.5rem;margin-bottom:0.5rem;">📊</div>No auto-coded transactions in the last 30 days.<br><a href="/bookkeeper" style="color:var(--gold);">Open Bookkeeper →</a></div>';
      return;
    }

    let byDate = data.byDate || {};
    let allTxns = [];
    for (const [date, txns] of Object.entries(byDate)) allTxns.push(...txns.map(t => ({...t, _date: date})));

    if (_bkHistDirFilter !== 'all') {
      allTxns = allTxns.filter(t => bk_histDirection(t) === _bkHistDirFilter);
    }

    if (!allTxns.length) {
      wrap.innerHTML = `<div style="text-align:center;padding:2rem;color:var(--muted);"><div style="font-size:1.5rem;margin-bottom:0.5rem;">📊</div>No ${_bkHistDirFilter === 'in' ? 'money in' : _bkHistDirFilter === 'out' ? 'money out' : ''} transactions found in the last 30 days.</div>`;
      return;
    }

    if (_bkHistSortByName) {
      allTxns.sort((a,b) => (a.vendor_name||'').localeCompare(b.vendor_name||''));
    } else {
      allTxns.sort((a,b) => (b._date || '').localeCompare(a._date || '') || new Date(b.coded_at || b.date || 0) - new Date(a.coded_at || a.date || 0));
    }

    byDate = {};
    for (const t of allTxns) { if (!byDate[t._date]) byDate[t._date] = []; byDate[t._date].push(t); }
      let sortedDates = Object.keys(byDate).sort((a,b) => b.localeCompare(a));
    if (_bkHistSortByName) sortedDates = Object.keys(byDate);

    wrap.innerHTML = `<div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.75rem;">
      <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
        <button class="btn ${_bkHistDirFilter === 'all' ? 'btn-gold' : 'btn-outline'} btn-sm bk-hist-dir-btn" onclick="bk_setHistDirFilter('all', this)">All</button>
        <button class="btn ${_bkHistDirFilter === 'in' ? 'btn-gold' : 'btn-outline'} btn-sm bk-hist-dir-btn" onclick="bk_setHistDirFilter('in', this)">📈 Money In</button>
        <button class="btn ${_bkHistDirFilter === 'out' ? 'btn-gold' : 'btn-outline'} btn-sm bk-hist-dir-btn" onclick="bk_setHistDirFilter('out', this)">📉 Money Out</button>
      </div>
      <div style="font-size:0.78rem;color:var(--muted);">${allTxns.length} transaction${allTxns.length !== 1 ? 's' : ''}</div>
    </div>` + sortedDates.map(dateKey => {
    const txns = byDate[dateKey];
    const dateLabel = new Date(dateKey + 'T12:00:00').toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
    const autoCount = txns.filter(t => t.coded_by === 'auto').length;
    const aiCount = txns.filter(t => t.coded_by === 'ai-research').length;
    const manualCount = txns.filter(t => t.coded_by === 'manual').length;
    const moneyIn = txns.filter(t => bk_histDirection(t) === 'in').reduce((s,t) => s + Math.abs(Number(t.amount)||0), 0);
    const moneyOut = txns.filter(t => bk_histDirection(t) === 'out').reduce((s,t) => s + Math.abs(Number(t.amount)||0), 0);

    const rows = txns.map(t => {
      const sourceClass = t.coded_by === 'manual' ? 'bkh-source-manual' : t.coded_by === 'ai-research' ? 'bkh-source-ai' : 'bkh-source-auto';
      const sourceLabel = t.coded_by === 'manual' ? '👤 Manual' : t.coded_by === 'ai-research' ? '🤖 AI ' + (t.ai_confidence||'') + '%' : '📊 Auto';
      return `<div class="bkh-row">
        <span class="bkh-vendor">${esc(t.vendor_name || t.description || 'Unknown')}</span>
        <span class="bkh-amount">${bk_histAmountHtml(t)}</span>
        <span class="bkh-account">→ ${esc(t.coded_account)}</span>
        <span class="bkh-source ${sourceClass}">${sourceLabel}</span>
        <span style="font-size:0.75rem;color:var(--muted);">${esc(t.date||'')}</span>
      </div>`;
    }).join('');

    return `<div class="bkh-day">
      <div class="bkh-day-header" onclick="this.nextElementSibling.classList.toggle('open');this.querySelector('.bkh-chev').textContent=this.nextElementSibling.classList.contains('open')?'▾':'▸';">
        <span class="bkh-day-date"><span class="bkh-chev">▸</span> ${dateLabel}</span>
        <div class="bkh-day-stats">
          <span>${txns.length} txn${txns.length!==1?'s':''}</span>
          <span style="color:var(--green);">In $${moneyIn.toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0})}</span>
          <span style="color:var(--red);">Out $${moneyOut.toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0})}</span>
          ${autoCount ? '<span style="color:var(--green);">'+autoCount+' auto</span>' : ''}
          ${aiCount ? '<span style="color:var(--gold);">'+aiCount+' AI</span>' : ''}
          ${manualCount ? '<span style="color:#63b3ed;">'+manualCount+' manual</span>' : ''}
        </div>
      </div>
      <div class="bkh-day-body">${rows}</div>
    </div>`;
  }).join('');
  }

  // ── Helpers ──
  function bk_fmtCur(n) { return '$'+Math.abs(n).toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0}); }
  function bk_fmtCurSigned(n) { return (n>=0?'+':'-')+'$'+Math.abs(n).toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0}); }
  function bk_fmtPay(n) { return '$'+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function bk_parseScanData(scan) {
    if (!scan || !scan.result_data) return null;
    try { return typeof scan.result_data === 'string' ? JSON.parse(scan.result_data) : scan.result_data; }
    catch(e) { return null; }
  }
  function bk_lastDay(year, month) {
    const d = new Date(year, month, 0);
    return year+'-'+String(month).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  }
  function bk_formatCurrency(n) {
    if (n === 0) return '$0.00';
    const abs = Math.abs(n);
    const formatted = '$' + abs.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
    return n < 0 ? `<span style="color:var(--red);">(${formatted})</span>` : formatted;
  }

