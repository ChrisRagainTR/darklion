  async function submitAddFolder() {
    const button = document.getElementById('add-folder-submit');
    const error = document.getElementById('add-folder-error');
    const applyTo = document.getElementById('add-folder-scope').value;
    button.disabled = true;
    button.textContent = 'Adding…';
    error.style.display = 'none';
    try {
      const response = await apiFetch('/api/documents/folders', {
        method: 'POST',
