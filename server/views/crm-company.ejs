  function renderTrashDocs() {
    const rows = docsTrashData.map(f => {
      const deletedAt = f.deleted_at ? new Date(f.deleted_at).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/New_York',timeZoneName:'short'}) : 'Unknown';
      return `<div class="doc-row" data-docid="${f.id}">
        ${docTypeBadge(f.mime_type, f.display_name)}
        <div class="doc-info"><div class="doc-name">${esc((f.display_name||'Untitled').replace(/_/g,' ').trim())}</div><div class="doc-badges"><span class="doc-badge doc-badge-type">${esc(f.year || 'No year')}</span><span style="font-size:0.67rem;color:var(--muted);opacity:0.7;">Deleted ${deletedAt}</span></div></div>
        <div style="display:flex;gap:0.4rem;flex-shrink:0;align-items:center;">
          <button class="btn btn-outline btn-xs" data-action="restore">Restore</button>
          <button class="btn btn-ghost btn-xs" style="color:var(--red)" data-action="permanent-delete">Delete Forever</button>
        </div>
      </div>`;
    }).join('');
    return `<div style="background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:10px;padding:1rem;">
      <div class="docs-col-title">🗑 Trash <span style="font-size:0.75rem;font-weight:400;color:var(--muted);">(${docsTrashData.length})</span></div>
      ${rows || '<div class="empty-state">Trash is empty.</div>'}
      <div style="margin-top:0.75rem;font-size:0.75rem;color:var(--muted);">Trash does not auto-empty. Use Delete Forever only when you intentionally want to remove the S3 object.</div>
    </div>`;
  }

  function wireDocListeners(el) {
    if (el.dataset.docListenersWired) return;
    el.addEventListener('click', e => {
      const hdr = e.target.closest('.year-header');
      if (hdr && el.contains(hdr)) {
        e.stopPropagation();
        hdr.closest('.year-folder').classList.toggle('open');
        return;
      }

      const row = e.target.closest('.doc-row');
      const btn = e.target.closest('button[data-action]');
      if (!row || !btn) return;
      const id = parseInt(row.dataset.docid);
      if (!id) return;

      e.stopPropagation();
      const action = btn.dataset.action;
      if (action === 'delete') {
        deleteDoc(id, e);
      } else if (action === 'quick-move') {
        quickMoveDocSide(id, e);
      } else if (action === 'toggle-move') {
        const panel = document.getElementById('move-panel-' + id);
        if (panel) panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
      } else if (action === 'save-move') {
        saveDocMove(id);
      } else if (action === 'close-move') {
        const panel = document.getElementById('move-panel-' + id);
        if (panel) panel.style.display = 'none';
      } else if (action === 'restore') {
        restoreDoc(id, e);
      } else if (action === 'permanent-delete') {
        permanentDeleteDoc(id, e);
      }
    });
    el.dataset.docListenersWired = '1';
  }

  function renderDocs() {
    const el = document.getElementById('docs-content');
    renderDocsActions();
    wireDocListeners(el);
    if (docsShowingTrash) {
      el.innerHTML = renderTrashDocs();
      return;
    }
    const firmDocs = docsData.filter(d => (d.folder_section || 'firm_uploaded') === 'firm_uploaded');
    const clientDocs = docsData.filter(d => d.folder_section === 'client_uploaded');
    el.innerHTML = `<div class="docs-layout">
      <div>${buildDocsColumn(firmDocs, 'Delivered by Advisor', '📁', DOC_CATS_FIRM)}</div>
      <div>${buildDocsColumn(clientDocs, 'Uploaded by Client', '📤', DOC_CATS_CLIENT)}</div>
    </div>`;
    // Wire doc name click to open (re-attach to new elements each render)
    el.querySelectorAll('.doc-name-link').forEach(nameEl => {
      nameEl.addEventListener('click', e => {
        e.stopPropagation();
        downloadDoc(parseInt(nameEl.dataset.docid));
      });
    });
    // Wire download buttons (re-attach each render)
    el.querySelectorAll('.btn-dl').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        downloadDoc(parseInt(btn.dataset.docid), btn);
      });
    });
  }


  // ── Tax Financials (Send to Tax Prep) ──
  (function() {
    var tfModal = document.getElementById('tax-financials-modal');
    var tfYear  = document.getElementById('tf-year');
    var tfBtn   = document.getElementById('tf-submit-btn');
    var tfErr   = document.getElementById('tf-error');
    var tfOk    = document.getElementById('tf-success');
    if (!tfModal || !tfYear) return;

    // Populate year dropdown
    var CY = new Date().getFullYear();
    for (var y = CY - 1; y >= 2020; y--) {
      var o = document.createElement('option');
      o.value = String(y); o.textContent = String(y);
      if (y === CY - 1) o.selected = true;
      tfYear.appendChild(o);
    }

    window.openTaxFinancialsModal = function() {
      tfErr.style.display = 'none'; tfOk.style.display = 'none';
      tfBtn.disabled = false; tfBtn.textContent = 'Generate & Save';
      tfModal.classList.add('open');
    };
    window.closeTaxFinancialsModal = function() { tfModal.classList.remove('open'); };

    window.submitTaxFinancials = async function() {
      tfErr.style.display = 'none'; tfOk.style.display = 'none';
      tfBtn.disabled = true; tfBtn.textContent = 'Generating…';
      try {
        // Need realmId — get from bookkeepingRealm or company data
        var realm = bookkeepingRealm || companyData.realm_id;
        if (!realm) { tfErr.textContent = 'No QuickBooks connection found for this company.'; tfErr.style.display = ''; tfBtn.disabled = false; tfBtn.textContent = 'Generate & Save'; return; }
        var res = await apiFetch('/api/companies/' + realm + '/tax-financials', {
          method: 'POST',
          body: JSON.stringify({ year: parseInt(tfYear.value) })
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to generate');
        tfOk.textContent = '✓ Saved to Docs → Tax folder';
        tfOk.style.display = '';
        tfBtn.textContent = 'Done';
        // Close modal, switch to docs tab, force-refresh list
        setTimeout(function() {
          closeTaxFinancialsModal();
          // Clear the loaded cache so loadDocs re-fetches
