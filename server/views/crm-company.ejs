  async function coCommRestoreArchivedThread() {
    if (!commCoActiveThreadId || !commCoCurrentThreadArchived) return;
    const restoredThreadId = commCoActiveThreadId;
    try {
      const restoreResponse = await apiFetch(`/api/messages/${restoredThreadId}/restore`, { method:'PUT' });
      const restoreResult = await restoreResponse.json().catch(() => ({}));
      if (!restoreResponse.ok) throw new Error(restoreResult.error || 'Failed to restore conversation');
      await loadCoCommArchivedThreads(false);
      commCoView = 'active';
      commCoCurrentThreadArchived = false;
      updateCoCommViewControls();
      await loadCoConversation(restoredThreadId);
      await loadCoCommSummary(true);
      window._shellToast('Conversation restored to Messages', 'success');
    } catch (error) {
      window._shellToast(error.message || 'Failed to restore conversation', 'error');
    }
  }

  function coCommMessageDateKey(timestamp) {
    const date = new Date(timestamp);
    if (Number.isNaN(date.getTime())) return '';
    const pad = value => String(value).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  }

  function coCommMessageDateLabel(timestamp, options) {
    const date = new Date(timestamp);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-US', options);
  }

  function coCommBuildTimeline(messages, buildBubble) {
    let previousDate = '';
    return messages.map(message => {
      const dateKey = coCommMessageDateKey(message.createdAt);
      let divider = '';
      if (dateKey && dateKey !== previousDate) {
        const label = coCommMessageDateLabel(message.createdAt, { weekday:'short', month:'short', day:'numeric', year:'numeric' });
        divider = `<div class="comm-date-divider" id="comm-co-date-${dateKey}" data-comm-co-date="${dateKey}"><span>${esc(label)}</span></div>`;
      }
      previousDate = dateKey || previousDate;
      return divider + buildBubble(message);
    }).join('');
  }

  function renderCoCommDateNavigation(messages) {
    if (commCoView !== 'archived') return;
    const groups = [];
    const groupsByDate = new Map();
    for (const message of messages) {
      const dateKey = coCommMessageDateKey(message.createdAt);
      if (!dateKey) continue;
      if (!groupsByDate.has(dateKey)) {
        const group = {
          key: dateKey,
          count: 0,
          dateLabel: coCommMessageDateLabel(message.createdAt, { month:'short', day:'numeric' }),
          fullLabel: coCommMessageDateLabel(message.createdAt, { month:'long', day:'numeric', year:'numeric' }),
          monthLabel: coCommMessageDateLabel(message.createdAt, { month:'long', year:'numeric' }),
        };
        groupsByDate.set(dateKey, group);
        groups.push(group);
      }
      groupsByDate.get(dateKey).count += 1;
    }

    const sideBody = document.getElementById('comm-co-summary-body');
    const compactSelect = document.getElementById('comm-co-date-jump-compact');
    if (compactSelect) {
      compactSelect.innerHTML = groups.length
        ? '<option value="">Jump to date…</option>' + groups.map(group => `<option value="${group.key}">${esc(group.fullLabel)} (${group.count})</option>`).join('')
        : '<option value="">No dated messages</option>';
    }
    if (!sideBody) return;
    if (!groups.length) {
      sideBody.innerHTML = '<div style="color:var(--muted);font-style:italic;">No dated messages in this conversation.</div>';
      return;
    }
    let currentMonth = '';
    let navigationHtml = '';
    for (const group of groups) {
      if (group.monthLabel !== currentMonth) {
        if (currentMonth) navigationHtml += '</div>';
        currentMonth = group.monthLabel;
        navigationHtml += `<div class="comm-date-month"><div class="comm-date-month-label">${esc(currentMonth)}</div>`;
      }
      navigationHtml += `<button class="comm-date-link" data-comm-co-date-link="${group.key}" onclick="coCommJumpToDate('${group.key}')"><span>${esc(group.dateLabel)}</span><span class="comm-date-count">${group.count}</span></button>`;
    }
    if (currentMonth) navigationHtml += '</div>';
    sideBody.innerHTML = navigationHtml;
    updateCoCommActiveDate();
  }

  function coCommJumpToDate(dateKey) {
    if (!dateKey) return;
    document.getElementById(`comm-co-date-${dateKey}`)?.scrollIntoView({ behavior:'smooth', block:'start' });
    setCoCommActiveDate(dateKey);
  }

  function setCoCommActiveDate(dateKey) {
    document.querySelectorAll('[data-comm-co-date-link]').forEach(link => link.classList.toggle('active', link.dataset.commCoDateLink === dateKey));
    const compactSelect = document.getElementById('comm-co-date-jump-compact');
    if (compactSelect && dateKey) compactSelect.value = dateKey;
  }

  function updateCoCommActiveDate() {
    if (commCoView !== 'archived') return;
    const messageContainer = document.getElementById('comm-co-detail-messages');
    if (!messageContainer) return;
    const dividers = [...messageContainer.querySelectorAll('[data-comm-co-date]')];
    if (!dividers.length) return;
    const threshold = messageContainer.getBoundingClientRect().top + 80;
    let activeDate = dividers[0].dataset.commCoDate;
    for (const divider of dividers) {
      if (divider.getBoundingClientRect().top <= threshold) activeDate = divider.dataset.commCoDate;
      else break;
    }
    setCoCommActiveDate(activeDate);
  }

  document.getElementById('comm-co-detail-messages')?.addEventListener('scroll', () => {
    window.requestAnimationFrame(updateCoCommActiveDate);
  }, { passive:true });

  function coRelTime(ts) {
    if (!ts) return ''; const d=new Date(ts); const diff=Date.now()-d;
    if (diff<60000) return 'just now'; if (diff<3600000) return Math.floor(diff/60000)+'m ago';
    if (diff<86400000) return Math.floor(diff/3600000)+'h ago'; return d.toLocaleDateString();
  }

  function coCommFormatBytes(b) {
    if (!b) return '0 B'; if (b<1024) return b+' B'; if (b<1048576) return (b/1024).toFixed(1)+' KB'; return (b/1048576).toFixed(1)+' MB';
  }

  async function loadCoConversation(preferredThreadId = null) {
    if (!commCoId) return;
    try {
      const res = await apiFetch(`/api/messages/company/${commCoId}?scope=mine`);
      if (!res.ok) return;
      const threads = await res.json();
      if (!threads.length) { coCommShowEmpty(); return; }
      const thread = threads.find(candidate => candidate.id === preferredThreadId) || threads[0];
      commCoActiveThreadId = thread.id;
      await loadCoThread(thread.id, false);
    } catch(e) { console.error('[co-comm] loadCoConversation error:', e); }
  }
  async function loadCoThreads() { return loadCoConversation(); }

  async function loadCoThread(threadId, silent = false) {
    commCoActiveThreadId = threadId;
    document.querySelectorAll('#comm-co-threads .thread-card').forEach(el => el.classList.remove('active'));
    const item = document.getElementById('comm-co-item-' + threadId);
    if (item) item.classList.add('active');
    if (!silent) {
      document.getElementById('comm-co-detail-messages').innerHTML = '<div style="display:flex;justify-content:center;padding:2rem;"><div class="spinner"></div></div>';
    }
    coCommShowDetail();
    try {
      const res = await apiFetch(`/api/messages/${threadId}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to load thread');
      commCoCurrentThreadArchived = data.isArchived === true;
      updateCoCommViewControls();
      const archivedThreadSelect = document.getElementById('comm-co-archive-thread-select');
      if (archivedThreadSelect && commCoCurrentThreadArchived) archivedThreadSelect.value = String(threadId);
      // Header is static "Messages" title rendered in HTML — no update needed
      const msgEl = document.getElementById('comm-co-detail-messages');
      const msgs = data.messages || [];
      function buildCoBubble(m) {
        if (m.isEmmaDraft) {
          return `<div class="msg-bubble-wrap internal" data-msg-id="${m.id}">
            <div class="emma-draft-card">
              <div class="emma-draft-label">🤖 Emma Draft · <span style="font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0;">${coRelTime(m.createdAt)}</span></div>
              <div class="emma-draft-body" id="co-emma-draft-body-${m.id}">${esc(m.body||'')}</div>
              <div class="emma-draft-actions" style="${commCoCurrentThreadArchived ? 'display:none;' : ''}">
                <button class="btn btn-outline btn-sm" onclick="coCommCopyDraft(${m.id})" style="font-size:0.78rem;">Copy to Reply</button>
                <button class="btn btn-gold btn-sm" onclick="coCommSendDraft(${m.id})" style="font-size:0.78rem;">Send As-Is</button>
              </div>
            </div>
          </div>`;
        }
        const isInternal = m.isInternal, isStaff = m.senderType === 'staff';
        const side = isInternal ? 'internal' : isStaff ? 'staff' : 'client';
        const bubbleClass = isInternal ? 'internal' : side;
        const attachHtml = (m.attachments||[]).length > 0
          ? `<div class="msg-attachments">${m.attachments.map(a => `<a href="#" class="attachment-chip" onclick="coCommDownloadAttachment(${a.documentId});return false;">📎 ${esc(a.displayName)}</a>`).join('')}</div>` : '';
        return `<div class="msg-bubble-wrap ${side}" data-msg-id="${m.id}">
          ${isInternal ? '<div class="msg-internal-label">🔒 Internal note</div>' : ''}
          <div class="msg-bubble ${bubbleClass}">${esc(m.body||'').replace(/\n/g,'<br>')}${attachHtml}</div>
          <div class="msg-meta">${esc(m.senderName||'')} · ${coRelTime(m.createdAt)}</div>
        </div>`;
      }
      if (!msgs.length) {
        if (!silent) msgEl.innerHTML = '<div style="color:var(--muted);text-align:center;padding:2rem;">No messages yet.</div>';
      } else if (silent) {
        const existingIds = new Set([...msgEl.querySelectorAll('[data-msg-id]')].map(el => parseInt(el.dataset.msgId)));
        let appended = false;
        for (const m of msgs) {
          if (!existingIds.has(m.id)) {
            const dateKey = coCommMessageDateKey(m.createdAt);
            if (dateKey && !msgEl.querySelector(`[data-comm-co-date="${dateKey}"]`)) {
              msgEl.insertAdjacentHTML('beforeend', coCommBuildTimeline([m], () => ''));
            }
            msgEl.insertAdjacentHTML('beforeend', buildCoBubble(m));
            appended = true;
          }
        }
        if (appended) msgEl.scrollTop = msgEl.scrollHeight;
      } else {
        msgEl.innerHTML = coCommBuildTimeline(msgs, buildCoBubble);
        msgEl.scrollTop = msgEl.scrollHeight;
      }
      renderCoCommDateNavigation(msgs);
      updateCoCommActiveDate();
    } catch(e) {
      if (!silent) document.getElementById('comm-co-detail-messages').innerHTML = '<div style="color:var(--muted);padding:1rem;">Failed to load.</div>';
    }
  }

  async function coCommSendAsSms() {
    const toggle = document.getElementById('comm-co-sms-toggle');
    if (toggle) toggle.checked = true;
    await coCommSendReply();
    if (toggle) toggle.checked = false;
  }


  function coCommBuildBubble(m) {
    const isInternal = !!m.isInternal;
    const isStaff = m.senderType === 'staff';
    const side = isInternal ? 'internal' : isStaff ? 'staff' : 'client';
    const bubbleClass = isInternal ? 'internal' : side;
    const attachHtml = (m.attachments||[]).length > 0
      ? `<div class="msg-attachments">${m.attachments.map(a => {
          const size = a.sizeBytes ? ` <span style="font-size:0.7rem;opacity:0.7;">(${formatBytes(a.sizeBytes)})</span>` : '';
          return a.documentId ? `<a href="#" class="attachment-chip" onclick="coCommDownloadAttachment(${a.documentId});return false;">📎 ${esc(a.displayName)}${size}</a>` : `<span class="attachment-chip">📎 ${esc(a.displayName || 'Attachment')}${size}</span>`;
        }).join('')}</div>` : '';
    const failedActions = m.failed ? `<div class="msg-failed-actions"><button class="btn btn-outline btn-sm" onclick="coCommRestoreFailed('${esc(m.id)}')">Retry</button><button class="btn btn-outline btn-sm" onclick="this.closest('.msg-bubble-wrap')?.remove()">Remove</button></div>` : '';
    return `<div class="msg-bubble-wrap ${side}${m.pending ? ' pending' : ''}${m.failed ? ' failed' : ''}" data-msg-id="${esc(m.id)}" data-body="${esc(m.body || '')}">
      ${isInternal ? '<div class="msg-internal-label">🔒 Internal note</div>' : ''}
      <div class="msg-bubble ${bubbleClass}">${esc(m.body||'').replace(/\n/g,'<br>')}${attachHtml}</div>
      <div class="msg-meta">${esc(m.senderName||'You')} · ${m.pending ? 'Sending…' : (m.failed ? 'Failed to send' : coRelTime(m.createdAt))}</div>
      ${failedActions}
    </div>`;
  }
  function coCommAppendBubble(m) {
    const msgEl = document.getElementById('comm-co-detail-messages');
    if (!msgEl) return;
    const near = window.DLStability?.nearBottom(msgEl) !== false;
    msgEl.insertAdjacentHTML('beforeend', coCommBuildBubble(m));
    if (near || m.senderType === 'staff') msgEl.scrollTop = msgEl.scrollHeight;
  }
  function coCommSettlePending(tempId, message) {
    const node = document.querySelector(`#comm-co-detail-messages [data-msg-id="${tempId}"]`);
    if (node && message) node.outerHTML = coCommBuildBubble(message);
  }
  function coCommFailPending(tempId) {
    const node = document.querySelector(`#comm-co-detail-messages [data-msg-id="${tempId}"]`);
    if (!node) return;
    node.classList.remove('pending'); node.classList.add('failed');
    const meta = node.querySelector('.msg-meta'); if (meta) meta.textContent = 'You · Failed to send';
    if (!node.querySelector('.msg-failed-actions')) node.insertAdjacentHTML('beforeend', `<div class="msg-failed-actions"><button class="btn btn-outline btn-sm" onclick="coCommRestoreFailed('${tempId}')">Retry</button><button class="btn btn-outline btn-sm" onclick="this.closest('.msg-bubble-wrap')?.remove()">Remove</button></div>`);
  }
  function coCommRestoreFailed(tempId) {
    const node = document.querySelector(`#comm-co-detail-messages [data-msg-id="${tempId}"]`);
    const ta = document.getElementById('comm-co-reply-body');
    if (ta) { ta.value = node?.dataset.body || ''; ta.focus(); }
    node?.remove();
  }

  // Unified send — creates thread if needed, replies if thread exists
  async function coCommSendMessage() {
    if (commCoCurrentThreadArchived) {
      window._shellToast('Restore this conversation before replying.', 'info');
      return;
    }
    const body = document.getElementById('comm-co-reply-body').value.trim();
    if (!body && coCommAttachFiles.length === 0 && coCommAttachClientDocs.length === 0) return;

    if (!commCoActiveThreadId) {
      // No thread yet — send to all portal-enabled people on this company
      try {
        const coRes = await apiFetch(`/api/companies/${commCoId}`);
        const co = await coRes.json();
        const people = (co.people || []).filter(p => p.portal_enabled);
        if (!people.length) { toast('No portal users on this company — invite someone to the portal first', 'error'); return; }
        let lastThreadId = null;
        for (const p of people) {
          const res = await apiFetch('/api/messages', { method:'POST', body: JSON.stringify({ person_id: p.person_id || p.id, subject: '', body, is_internal: false, document_ids: coCommAttachClientDocs.map(d => d.id) }) });
          const data = await res.json();
          if (data.threadId) lastThreadId = data.threadId;
        }
        document.getElementById('comm-co-reply-body').value = '';
        coCommAttachFiles = [];
        coCommAttachClientDocs = [];
        renderCoCommAttachChips();
        await loadCoConversation();
        toast(`Message sent to ${people.length} ${people.length===1?'person':'people'}`);
      } catch(e) { toast('Failed to send: ' + e.message, 'error'); }
      return;
    }

    // Existing thread — optimistic reply
    const filesToSend = coCommAttachFiles.slice();
    const docsToSend = coCommAttachClientDocs.slice();
    const tempId = 'local-comm-co-' + Date.now();
    coCommAppendBubble({ id:tempId, senderType:'staff', senderName:'You', body, isInternal:false, pending:true, createdAt:new Date().toISOString(), attachments:filesToSend.map(f => ({ displayName:f.name, sizeBytes:f.size })).concat(docsToSend.map(d => ({ displayName:d.displayName, sizeBytes:d.sizeBytes, documentId:d.id }))) });
    try {
      const fd = new FormData();
      fd.append('body', body);
      fd.append('is_internal', 'false');
      filesToSend.forEach(f => fd.append('files', f));
      docsToSend.forEach(d => fd.append('document_ids', String(d.id)));
      document.getElementById('comm-co-reply-body').value = '';
      coCommAttachFiles = [];
      coCommAttachClientDocs = [];
      renderCoCommAttachChips();
      const replyRes = await apiFetch(`/api/messages/${commCoActiveThreadId}/reply`, { method: 'POST', body: fd });
      const data = await replyRes.json().catch(()=>({}));
      if (!replyRes.ok) throw new Error(data.error || `Server error ${replyRes.status}`);
      if (data.threadId) commCoActiveThreadId = data.threadId;
      coCommSettlePending(tempId, data.message || { id:data.messageId, senderType:'staff', senderName:'You', body, isInternal:false, createdAt:new Date().toISOString(), attachments:docsToSend.map(d => ({ displayName:d.displayName, sizeBytes:d.sizeBytes, documentId:d.id })) });
      await loadCoThread(commCoActiveThreadId, false);
    } catch(e) { coCommFailPending(tempId); toast('Failed to send: ' + e.message, 'error'); }
  }

  async function coCommArchive() {
    if (!commCoActiveThreadId) return;
    const archiveResponse = await apiFetch(`/api/messages/${commCoActiveThreadId}/archive`, { method: 'PUT' });
    if (!archiveResponse.ok) return window._shellToast('Failed to archive conversation', 'error');
    commCoActiveThreadId = null;
    await loadCoCommArchivedThreads(false);
    await loadCoConversation();
  }

  function handleCoCommAttach(fileList) {
    for (const f of Array.from(fileList)) { if (coCommAttachFiles.length >= 8) break; coCommAttachFiles.push(f); }
    document.getElementById('comm-co-attach-input').value = '';
    renderCoCommAttachChips();
  }
  window.handleCoCommAttach = handleCoCommAttach;

  function openCoCommClientDocPicker() {
    ClientDocPicker.open({
      apiFetch,
      scope: commCoActiveThreadId ? { threadId: commCoActiveThreadId } : { companyId: commCoId },
      selected: coCommAttachClientDocs,
      onApply: docs => { coCommAttachClientDocs = docs; renderCoCommAttachChips(); },
    });
  }
  window.openCoCommClientDocPicker = openCoCommClientDocPicker;

  function renderCoCommAttachChips() {
    const el = document.getElementById('comm-co-attach-chips');
    if (!el) return;
    const fileChips = coCommAttachFiles.map((f,i) => `<span class="attach-chip-input">📎 ${esc(f.name)} <button onclick="removeCoCommAttach(${i})">×</button></span>`);
    const docChips = coCommAttachClientDocs.map((d,i) => `<span class="attach-chip-input">📁 ${esc(d.displayName)} <button onclick="removeCoCommAttachDoc(${i})">×</button></span>`);
    el.innerHTML = fileChips.concat(docChips).join('');
  }
  function removeCoCommAttach(idx) { coCommAttachFiles.splice(idx,1); renderCoCommAttachChips(); }
  window.removeCoCommAttach = removeCoCommAttach;
  function removeCoCommAttachDoc(idx) { coCommAttachClientDocs.splice(idx,1); renderCoCommAttachChips(); }
  window.removeCoCommAttachDoc = removeCoCommAttachDoc;

  function handleCoNewCommAttach(fileList) {
    for (const f of Array.from(fileList)) { if (coCommNewAttachFiles.length >= 8) break; coCommNewAttachFiles.push(f); }
    document.getElementById('comm-co-new-attach-input').value = '';
    renderCoNewCommAttachChips();
  }
  window.handleCoNewCommAttach = handleCoNewCommAttach;

  function renderCoNewCommAttachChips() {
    const el = document.getElementById('comm-co-new-attach-chips');
    if (!el) return;
    el.innerHTML = coCommNewAttachFiles.map((f,i) => `<span class="attach-chip-input">📎 ${esc(f.name)} <button onclick="removeCoNewCommAttach(${i})">×</button></span>`).join('');
  }
  function removeCoNewCommAttach(idx) { coCommNewAttachFiles.splice(idx,1); renderCoNewCommAttachChips(); }
  window.removeCoNewCommAttach = removeCoNewCommAttach;

  async function coCommDownloadAttachment(documentId) {
    try {
      const res = await apiFetch(`/api/messages/attachments/${documentId}/download`);
      const data = await res.json();
      if (data.url) window.open(data.url, '_blank');
    } catch(e) { toast('Download failed', 'error'); }
  }
  window.coCommDownloadAttachment = coCommDownloadAttachment;

  // ── Attach Person Modal ──
  async function openAttachPersonModal() {
    if (!companyData) return;
    const relId = companyData.relationship_id;
    if (!relId) { toast('Company has no relationship assigned', 'error'); return; }
    try {
      const res = await apiFetch(`/api/relationships/${relId}/people`);
      const people = await res.json();
      const existing = (companyData.people || []).map(p => p.person_id);
      const available = people.filter(p => !existing.includes(p.id));
      if (!available.length) { toast('All people in this relationship are already attached', 'error'); return; }
      const opts = available.map(p => `<option value="${p.id}">${esc(formatPersonDisplayName(p))}</option>`).join('');
      const html = `<div class="modal-overlay open" id="attach-person-modal" onclick="if(event.target===this)this.remove()">
        <div class="modal" onclick="event.stopPropagation()" style="max-width:400px;">
          <h2 style="margin-bottom:1rem;">Attach Person to Company</h2>
          <div class="form-group"><label>Person</label><select id="ap-person" class="form-control">${opts}</select></div>
          <div class="form-group"><label>Access Level</label>
            <select id="ap-access" class="form-control">
              <option value="full">Full (upload + message)</option>
              <option value="view">View only</option>
              <option value="sign">Sign only</option>
            </select>
          </div>
          <div class="form-group"><label>Ownership % (optional)</label><input type="number" id="ap-ownership" class="form-control" placeholder="e.g. 50" min="0" max="100" step="0.01"></div>
          <div class="modal-actions">
            <button class="btn btn-outline" onclick="document.getElementById('attach-person-modal').remove()">Cancel</button>
            <button class="btn btn-gold" onclick="submitAttachPerson()">Attach</button>
          </div>
        </div></div>`;
      document.body.insertAdjacentHTML('beforeend', html);
    } catch(e) { toast('Failed to load people: ' + e.message, 'error'); }
  }
  window.openAttachPersonModal = openAttachPersonModal;

  async function submitAttachPerson() {
    const personId = parseInt(document.getElementById('ap-person').value);
    const accessLevel = document.getElementById('ap-access').value;
    const ownershipPct = document.getElementById('ap-ownership').value;
    try {
      const res = await apiFetch(`/api/people/${personId}/company-access`, {
        method: 'POST',
        body: JSON.stringify({ company_id: companyId, access_level: accessLevel, ownership_pct: ownershipPct || null })
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      document.getElementById('attach-person-modal').remove();
      toast('Person attached successfully');
      await loadCompany();
    } catch(e) { toast('Failed: ' + e.message, 'error'); }
  }
  window.submitAttachPerson = submitAttachPerson;

