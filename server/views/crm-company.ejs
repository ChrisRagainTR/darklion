  async function ab_setSnoozedFilter(btn) {
    abSnoozedMode = true;
    abDirFilter = 'all';
    // Reset all filter buttons, highlight Snoozed
    document.querySelectorAll('#ab-uncat-dir-filter button, #ab-dir-snoozed').forEach(b => {
      b.className = 'btn btn-outline btn-sm';
    });
    document.getElementById('ab-dir-all').className = 'btn btn-outline btn-sm';
    btn.className = 'btn btn-gold btn-sm';
    await ab_loadUncategorized();
  }

  function ab_applyDirFilter() {
    const incomeTypes = ['deposit', 'salesreceipt', 'sales receipt', 'invoice', 'payment'];
    const showChecks = document.getElementById('ab-show-checks')?.checked || false;
    let filtered = abAllTransactions;

    // Hide checks by default
    if (!showChecks) {
      filtered = filtered.filter(t => !(t.vendor_name || '').match(/^check\s*#?\s*\d+$/i) && !(t.vendor_name || '').match(/^\d{3,6}$/));
    }

    if (abDirFilter === 'in') {
      filtered = filtered.filter(t => incomeTypes.includes((t.txn_type || '').toLowerCase()) || (t.original_account || '').toLowerCase().includes('income'));
    } else if (abDirFilter === 'out') {
      filtered = filtered.filter(t => !incomeTypes.includes((t.txn_type || '').toLowerCase()) && !(t.original_account || '').toLowerCase().includes('income'));
    }
    ab_renderRows(filtered);
  }

  function ab_renderUncategorized(data) {
    console.log('[ab_render] Starting render with', data.transactions?.length || 0, 'transactions');
    abAllTransactions = data.transactions || [];
    const txns = abAllTransactions;
    const statsEl = document.getElementById('ab-uncat-stats');
    const resultsEl = document.getElementById('ab-uncat-results');
    const countEl = document.getElementById('ab-uncat-txn-count');
    const flaggedEl = document.getElementById('ab-uncat-flagged');
    const totalEl = document.getElementById('ab-uncat-total');

    console.log('[ab_render] DOM elements - statsEl:', !!statsEl, 'resultsEl:', !!resultsEl, 'countEl:', !!countEl);

    if (statsEl) {
      statsEl.style.display = '';
      console.log('[ab_render] Stats grid made visible');
    }
    if (countEl) {
      countEl.textContent = txns.length;
      console.log('[ab_render] Count set to:', txns.length);
    }

    // Count unique accounts with issues
    const flaggedAccounts = new Set(txns.map(t => t.original_account).filter(Boolean));
    if (flaggedEl) flaggedEl.textContent = flaggedAccounts.size;

    // Total amount
    const total = txns.reduce((sum, t) => sum + Math.abs(parseFloat(t.amount) || 0), 0);
    if (totalEl) totalEl.textContent = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    console.log('[ab_render] Stats populated');

    if (!txns.length) {
      console.log('[ab_render] No transactions, showing caught up');
      resultsEl.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--green);font-size:1.1rem;">✓ All caught up!</div>';
      return;
    }

    // Apply current direction filter
    ab_applyDirFilter();
  }

  function ab_renderRows(txns) {
    const resultsEl = document.getElementById('ab-uncat-results');
    if (!resultsEl) return;
    if (!txns.length) {
      resultsEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--muted);">No transactions match this filter.</div>';
      return;
    }
    resultsEl.innerHTML = `
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Vendor</th>
              <th>Description</th>
              <th class="amount">Amount</th>
              <th>Account</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${txns.map(t => `
              <tr data-uncoded-id="${t.id}" data-realm-id="${t.realm_id}" data-qb-id="${t.txn_qb_id}" data-txn-type="${t.txn_type}" data-ai-suggested="${esc(t.ai_suggested_account||'')}" data-ai-confidence="${t.ai_confidence||""}">
                <td>${(t.txn_date || t.report_date) ? new Date(t.txn_date || t.report_date).toLocaleDateString() : '—'}</td>
                <td>${esc(t.vendor_name || '—')}</td>
                <td>${esc((t.description || '').substring(0, 60))}</td>
                <td class="amount">${t.amount ? ab_uncatAmountHtml(t) : '—'}</td>
                <td>${esc(t.original_account || '—')}${t.snoozed_until ? `<div style="font-size:0.68rem;color:var(--gold);">⏰ Snoozed until ${new Date(t.snoozed_until).toLocaleDateString()}</div>` : ''}</td>
                <td style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                  <button class="btn btn-outline btn-sm ab-code-btn" onclick="ab_codeTransaction(${t.id})">Code</button>
                  <button class="btn btn-outline btn-sm" style="color:var(--muted);" onclick="ab_snoozeTxn(${t.id})">⏰ Snooze</button>
                  <button class="btn btn-outline btn-sm" style="color:var(--blue,#5b8def);" onclick="ab_sendToClient(${t.id})">📤 Client</button>
                </td>
              </tr>
            `).join('')}
