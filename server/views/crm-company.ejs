  async function ab_openMappingModal(id, vendorName, accountName, direction) {
    // Fetch CoA for dropdown
    let coaHtml = '<option value="">Loading…</option>';
    try {
      const res = await apiFetch(`/api/bookkeeper/chart-of-accounts?realmId=${abRealmId}`);
      const data = await res.json();
      coaHtml = '<option value="">Select account…</option>';
      let lastHeader = null;
      for (const a of data.accounts) {
        if (a.isHeader) {
          if (lastHeader !== null) coaHtml += '</optgroup>';
          coaHtml += `<optgroup label="${esc(a.name)}">` ;
          lastHeader = a.name;
        } else {
          const sel = a.name === accountName ? ' selected' : '';
          coaHtml += `<option value="${esc(a.name)}"${sel}>${esc(a.name)}</option>`;
        }
      }
      if (lastHeader !== null) coaHtml += '</optgroup>';
    } catch(e) { coaHtml = '<option value="">Failed to load accounts</option>'; }

    const isEdit = !!id;
    const modal = document.createElement('div');
    modal.className = 'modal-overlay open';
    modal.id = 'ab-map-modal';
    modal.onclick = e => { if (e.target === modal) modal.remove(); };
    modal.innerHTML = `
      <div class="modal" style="max-width:420px;">
        <div class="modal-header">
          <div class="modal-title">${isEdit ? 'Edit Mapping' : 'Add Mapping'}</div>
          <button class="modal-close" onclick="document.getElementById('ab-map-modal').remove()">&times;</button>
        </div>
        <div class="modal-body" style="display:flex;flex-direction:column;gap:0.75rem;">
          <div>
            <label style="font-size:0.78rem;font-weight:600;color:var(--muted);display:block;margin-bottom:0.3rem;">Vendor Name</label>
            <input type="text" id="ab-map-vendor" class="form-control" value="${esc(vendorName || '')}" placeholder="e.g. Square Inc" ${isEdit ? 'readonly style="opacity:0.6;"' : ''}>
          </div>
          <div>
            <label style="font-size:0.78rem;font-weight:600;color:var(--muted);display:block;margin-bottom:0.3rem;">Account</label>
            <select id="ab-map-account" class="form-control">${coaHtml}</select>
          </div>
          <div>
            <label style="font-size:0.78rem;font-weight:600;color:var(--muted);display:block;margin-bottom:0.3rem;">Direction</label>
            <select id="ab-map-direction" class="form-control">
              <option value="expense" ${direction !== 'income' ? 'selected' : ''}>📉 Expense (Money Out)</option>
              <option value="income" ${direction === 'income' ? 'selected' : ''}>📈 Income (Money In)</option>
            </select>
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn btn-outline" onclick="document.getElementById('ab-map-modal').remove()">Cancel</button>
          <button class="btn btn-gold" onclick="ab_saveMapping(${id || 'null'})">${isEdit ? 'Save Changes' : 'Add Mapping'}</button>
        </div>
      </div>`;
    document.body.appendChild(modal);
  }

  async function ab_saveMapping(id) {
    const vendor = document.getElementById('ab-map-vendor')?.value?.trim();
    const account = document.getElementById('ab-map-account')?.value;
    const direction = document.getElementById('ab-map-direction')?.value;
    if (!vendor || !account) { toast('Vendor and account are required', 'error'); return; }

    const saveBtn = document.querySelector('#ab-map-modal .btn-gold');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving…'; }

    try {
      if (id) {
        // Edit: delete old and re-insert (simplest approach since vendor+direction is the unique key)
        await apiFetch(`/api/bookkeeper/mappings/${id}`, { method: 'DELETE' });
      }
      const res = await apiFetch('/api/bookkeeper/mappings', {
        method: 'POST',
        body: JSON.stringify({ realmId: abRealmId, vendorName: vendor, accountName: account, direction })
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      document.getElementById('ab-map-modal')?.remove();
      toast(id ? 'Mapping updated' : 'Mapping added');
      ab_loadMappings();
    } catch(e) {
      toast('Failed: ' + e.message, 'error');
      if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = id ? 'Save Changes' : 'Add Mapping'; }
    }
  }
  window.ab_openMappingModal = ab_openMappingModal;
  window.ab_saveMapping = ab_saveMapping;

  async function ab_deleteMapping(mappingId) {
    if (!confirm('Delete this vendor mapping?')) return;
    try {
      const res = await apiFetch(`/api/bookkeeper/mappings/${mappingId}`, { method: 'DELETE' });
      if (!res.ok) throw new Error('Failed to delete mapping');
      toast('Mapping deleted');
      ab_loadMappings(); // Refresh
    } catch (e) {
      toast('Failed: ' + e.message, 'error');
    }
  }

  async function ab_rebuildMappings() {
    if (!confirm('Rebuild vendor mappings from 24 months of transaction history? This may take a minute.')) return;

    const btn = document.getElementById('ab-rebuild-mappings-btn');
    let anim = null;
    const baseLabel = '🔄 Rebuild Mappings';
    if (btn) {
      btn.disabled = true;
      let dots = 0;
      btn.textContent = '⏳ Rebuilding mappings';
      anim = setInterval(() => {
        dots = (dots + 1) % 4;
        btn.textContent = `⏳ Rebuilding mappings${'.'.repeat(dots)}`;
      }, 500);
    }

    try {
      const res = await apiFetch('/api/bookkeeper/rebuild-mapping', {
        method: 'POST',
        body: JSON.stringify({ realmId: abRealmId })
      });
      if (!res.ok) {
        const d = await res.json();
        throw new Error(d.error || 'Failed to rebuild mappings');
      }
      const data = await res.json();
      toast(`Mappings rebuilt: ${data.mappingsCreated || 0} mappings created`);
      await ab_loadMappings();
    } catch (e) {
      toast('Rebuild failed: ' + e.message, 'error');
    } finally {
      if (anim) clearInterval(anim);
      if (btn) {
        btn.disabled = false;
        btn.textContent = baseLabel;
      }
    }
  }

  async function ab_sendToClient(uncodedId) {
    const row = document.querySelector(`tr[data-uncoded-id="${uncodedId}"]`);
    const btn = row ? row.querySelector('button[onclick*="ab_sendToClient"]') : null;
    if (btn) { btn.disabled = true; btn.textContent = '...'; }
    try {
      const res = await apiFetch(`/api/bookkeeper/company/${companyId}/send-to-client`, {
        method: 'POST',
        body: JSON.stringify({ uncodedId })
      });
      if (!res.ok) {
        const d = await res.json();
        throw new Error(d.error || 'Failed');
      }
      // Remove this row from the uncoded table
      if (row) row.remove();
      toast('Sent to client for coding');
      // Update count stats
      ab_loadUncategorized();
    } catch(e) {
      if (btn) { btn.disabled = false; btn.textContent = '\uD83D\uDCE4 Client'; }
      toast('Failed: ' + e.message, 'error');
    }
  }

  async function ab_loadSentToClient() {
    const wrap = document.getElementById('ab-sent-wrap');
    if (!wrap) return;
    wrap.innerHTML = '<div style="color:var(--muted);font-size:0.85rem;padding:1rem 0;">Loading…</div>';
    try {
      const res = await apiFetch(`/api/bookkeeper/company/${companyId}/sent-to-client`);
      if (!res.ok) throw new Error('Failed to load');
      const data = await res.json();
      const txns = data.transactions || [];

      if (!txns.length) {
        wrap.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--green);font-size:1rem;">✓ No transactions currently waiting on client</div>';
        return;
      }

      const pending = txns.filter(t => !t.coded_by_client);
      const coded   = txns.filter(t =>  t.coded_by_client);

      let html = '';
      if (pending.length) {
        html += `<div style="font-size:0.78rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">Awaiting Client (${pending.length})</div>`;
        html += '<div class="table-wrap" style="margin-bottom:1.5rem;"><table class="data-table"><thead><tr><th>Date Sent</th><th>Vendor</th><th>Amount</th><th>AI Suggestion</th><th>Status</th></tr></thead><tbody>';
        for (const t of pending) {
          const sentDate = t.sent_to_client_at ? new Date(t.sent_to_client_at).toLocaleDateString() : '—';
          const aiSug = t.ai_suggested_account ? `<span style="font-size:0.78rem;color:var(--gold);">${esc(t.ai_suggested_account)}${t.ai_confidence ? ' (' + t.ai_confidence + '%)' : ''}</span>` : '<span style="color:var(--muted);font-size:0.78rem;">None</span>';
          html += `<tr><td style="font-size:0.82rem;">${sentDate}</td><td>${esc(t.vendor_name || '—')}</td><td class="amount">$${Math.abs(parseFloat(t.amount || 0)).toFixed(2)}</td><td>${aiSug}</td><td><span style="color:var(--gold);font-size:0.78rem;font-weight:600;">⏳ Pending</span></td></tr>`;
        }
        html += '</tbody></table></div>';
      }
      if (coded.length) {
        html += `<div style="font-size:0.78rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">Coded by Client (${coded.length})</div>`;
        html += '<div class="table-wrap"><table class="data-table"><thead><tr><th>Date Coded</th><th>Vendor</th><th>Amount</th><th>Coded To</th><th>Status</th></tr></thead><tbody>';
        for (const t of coded) {
          const codedDate = t.coded_by_client_at ? new Date(t.coded_by_client_at).toLocaleDateString() : '—';
          html += `<tr><td style="font-size:0.82rem;">${codedDate}</td><td>${esc(t.vendor_name || '—')}</td><td class="amount">$${Math.abs(parseFloat(t.amount || 0)).toFixed(2)}</td><td style="color:var(--green);font-size:0.82rem;">${esc(t.coded_by_client_account || '—')}</td><td><span style="color:var(--green);font-size:0.78rem;font-weight:600;">✓ Coded</span></td></tr>`;
        }
        html += '</tbody></table></div>';
      }
      wrap.innerHTML = html;
    } catch(e) {
      wrap.innerHTML = `<div style="color:var(--red,#e05c5c);padding:1rem;">❌ Failed to load: ${e.message}</div>`;
    }
  }

  // Expose functions globally
  window.ab_initAutoBookkeeper = ab_initAutoBookkeeper;
  window.ab_loadUncategorized = ab_loadUncategorized;
  window.ab_codeTransaction = ab_codeTransaction;
  window.ab_scanUncategorized = ab_scanUncategorized;
  window.ab_runBookkeeper = ab_runBookkeeper;
  window.ab_rebuildMappings = ab_rebuildMappings;
  window.ab_sendToClient = ab_sendToClient;
  window.ab_loadSentToClient = ab_loadSentToClient;

  loadCompany().then(function() {
    const requestedTab = new URLSearchParams(window.location.search).get('tab');
    if (requestedTab === 'docs') {
      const tabEl = Array.from(document.querySelectorAll('.tab-item')).find(t =>
        (t.getAttribute('onclick') || '').includes("'docs'")
      ) || null;
      switchTab('docs', tabEl);
    }
  });
</script>

<!-- Tax Summary Modal -->
<div class="tax-summary-modal hidden" id="tax-summary-modal">
  <div class="tax-summary-box" onclick="event.stopPropagation()">
    <div class="tsm-header">
      <div>
        <h2 id="tsm-title">Tax Summary</h2>
        <div id="tsm-subtitle" style="font-size:0.8rem;color:rgba(255,255,255,0.65);margin-top:0.2rem;"></div>
      </div>
      <button class="tsm-close" onclick="closeTaxSummary()">✕</button>
    </div>
    <div class="tsm-body" id="tsm-body">
      <div class="tsm-processing">
        <div class="tsm-spinner"></div>
        <div>Analyzing return with Claude…</div>
        <div style="font-size:0.75rem;opacity:0.6;">This takes about 30–60 seconds</div>
      </div>
    </div>
    <div class="tsm-footer" id="tsm-footer" style="display:none;">
      <button class="btn btn-outline btn-sm" id="tsm-reanalyze-btn" onclick="retrySummary(_tsmPendingDeliveryId)" style="margin-right:auto;">↺ Re-analyze</button>
      <button class="btn btn-outline btn-sm" onclick="closeTaxSummary()">Close</button>
      <button class="btn btn-gold" id="tsm-send-btn" onclick="confirmAndSendDelivery()" style="display:none;">Send to Client →</button>
    </div>
  </div>
</div>

<!-- Move Document Modal -->
<div class="modal-overlay" id="move-doc-modal" onclick="closeMoveDocModal()">
  <div class="modal" onclick="event.stopPropagation()" style="max-width:380px;">
    <h2>Move Document</h2>
    <div class="form-group">
      <label>Tax Year</label>
      <select id="move-doc-year" class="form-control">
        <% for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 8; y--) { %>
          <option value="<%= y %>"><%= y %></option>
        <% } %>
      </select>
    </div>
    <div class="form-group">
      <label>Section</label>
      <select id="move-doc-section" class="form-control">
        <option value="firm_uploaded">Delivered by Advisor</option>
        <option value="client_uploaded">Client Uploaded</option>
      </select>
    </div>
    <div class="form-group">
      <label>Category</label>
      <select id="move-doc-category" class="form-control">
        <option value="tax">Tax</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeMoveDocModal()">Cancel</button>
      <button class="btn-submit" onclick="submitMoveDoc()">Move</button>
    </div>
  </div>
</div>

