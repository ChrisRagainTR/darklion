  async function ab_codeTransaction(uncodedId) {
    // If there's already an expand row, remove it (toggle)
    const existing = document.getElementById(`ab-code-row-${uncodedId}`);
    if (existing) { existing.remove(); return; }

    const row = document.querySelector(`tr[data-uncoded-id="${uncodedId}"]`);
    if (!row) return;

    const realmId = row.dataset.realmId;
    const codeBtn = row.querySelector('.ab-code-btn');
    if (codeBtn) { codeBtn.disabled = true; codeBtn.textContent = '...'; }

    try {
      const res = await apiFetch(`/api/bookkeeper/chart-of-accounts?realmId=${realmId}`);
      if (!res.ok) throw new Error('Failed to fetch accounts');
      const data = await res.json();

      // Get AI suggestion from the row's data attribute
      const aiSuggested = row.dataset.aiSuggested || '';
      const aiConfidence = row.dataset.aiConfidence || '';

      // Group accounts into optgroups, pre-select AI suggestion if present
      let optHtml = aiSuggested
        ? `<option value="">Select account…</option>`
        : `<option value="">Select account…</option>`;
      let lastHeader = null;
      for (const a of data.accounts) {
        if (a.isHeader) {
          if (lastHeader !== null) optHtml += '</optgroup>';
          optHtml += `<optgroup label="${esc(a.name)}">`;
          lastHeader = a.name;
        } else {
          const selected = a.name === aiSuggested ? ' selected' : '';
          optHtml += `<option value="${esc(a.name)}"${selected}>${esc(a.name)}</option>`;
        }
      }
      if (lastHeader !== null) optHtml += '</optgroup>';

      // Insert a new row below the current one
      const expandRow = document.createElement('tr');
      expandRow.id = `ab-code-row-${uncodedId}`;
      expandRow.style.cssText = 'background:rgba(201,168,76,0.04);';
      expandRow.innerHTML = `
        <td colspan="6" style="padding:0.75rem 1rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
            ${aiSuggested ? `<div style="font-size:0.75rem;color:var(--gold);background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.2);border-radius:5px;padding:0.2rem 0.55rem;white-space:nowrap;">🤖 AI: ${esc(aiSuggested)}${aiConfidence ? ' ('+aiConfidence+'%)' : ''}</div>` : ''}
            <select id="ab-recode-select-${uncodedId}" class="bk-recode-select" style="flex:1;min-width:220px;max-width:400px;">${optHtml}</select>
            <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--muted);white-space:nowrap;">
              <input type="checkbox" id="ab-save-map-${uncodedId}" checked> Save mapping
            </label>
            <button class="btn btn-gold btn-sm" onclick="ab_saveCode(${uncodedId}, '${realmId}')">&#10003; Submit</button>
            <button class="btn btn-outline btn-sm" onclick="document.getElementById('ab-code-row-${uncodedId}').remove()">Cancel</button>
          </div>
        </td>`;
      row.parentNode.insertBefore(expandRow, row.nextSibling);

      setTimeout(() => {
        const sel = document.getElementById(`ab-recode-select-${uncodedId}`);
        if (sel) sel.focus();
      }, 50);
    } catch (e) {
      toast('Failed to load accounts: ' + e.message, 'error');
    } finally {
      if (codeBtn) { codeBtn.disabled = false; codeBtn.textContent = 'Code'; }
    }
  }

  async function ab_saveCode(uncodedId, realmId) {
    const select = document.getElementById(`ab-recode-select-${uncodedId}`);
    const saveMap = document.getElementById(`ab-save-map-${uncodedId}`);
    if (!select || !select.value) {
      toast('Please select an account', 'error');
      return;
    }

    const accountName = select.value;
    const saveBtn = document.querySelector(`#ab-code-row-${uncodedId} .btn-gold`);
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving…'; }

    try {
      const res = await apiFetch('/api/bookkeeper/code', {
        method: 'POST',
        body: JSON.stringify({ uncodedId, accountName, saveMappingForVendor: saveMap?.checked !== false })
      });
      if (!res.ok) {
        const d = await res.json();
        throw new Error(d.error || 'Failed to code transaction');
      }

      // Find other pending transactions with same vendor
      const thisTxn = abAllTransactions.find(t => t.id === uncodedId);
      const sameVendor = thisTxn ? abAllTransactions.filter(t =>
        t.id !== uncodedId &&
        t.status === 'pending' &&
        t.vendor_name === thisTxn.vendor_name
      ) : [];

      if (sameVendor.length > 0) {
        const vendorName = thisTxn.vendor_name || 'this vendor';
        if (confirm(`Code all ${sameVendor.length} other pending "${vendorName}" transaction${sameVendor.length !== 1 ? 's' : ''} to "${accountName}" too?`)) {
          const items = sameVendor.map(t => ({ uncodedId: t.id, accountName, saveMappingForVendor: true }));
          const bulkRes = await apiFetch('/api/bookkeeper/code-bulk', { method: 'POST', body: JSON.stringify({ items }) });
          const bulkData = await bulkRes.json();
          toast(`Coded ${1 + (bulkData.coded || 0)} transactions to ${accountName}`);
        } else {
          toast(`Coded to ${accountName}`);
        }
      } else {
        toast(`Coded to ${accountName}`);
      }

      ab_loadUncategorized();
    } catch (e) {
      toast('Failed: ' + e.message, 'error');
      if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = '\u2713 Submit'; }
    }
  }

  function ab_cancelCode(uncodedId) {
    ab_loadUncategorized(); // Reload to restore original row
  }

  async function ab_snoozeTxn(id) {
    try {
      const res = await apiFetch('/api/bookkeeper/snooze', { method: 'POST', body: JSON.stringify({ uncodedId: id, days: 3 }) });
      if (!res.ok) throw new Error('Failed');
      abAllTransactions = abAllTransactions.filter(t => t.id !== id);
      toast('⏰ Snoozed for 3 days');
      ab_applyDirFilter();
    } catch(e) { toast('Snooze failed: ' + e.message, 'error'); }
  }


  window.ab_snoozeTxn = ab_snoozeTxn;

  async function ab_scanUncategorized() {
    if (!abRealmId) { _shellToast('No QBO connection', true); return; }
    const btn = document.getElementById('ab-uncat-scan-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Scanning…'; }
    try {
      // Pull uncategorized txns from QBO into DB without running AI coding
      const res = await apiFetch('/api/bookkeeper/scan-only', {
        method: 'POST',
        body: JSON.stringify({ realmId: abRealmId })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Scan failed');
      _shellToast(`Scan complete — ${data.txns_found} transaction${data.txns_found !== 1 ? 's' : ''} found`);
      await ab_loadUncategorized();
    } catch (e) {
      _shellToast('Scan failed: ' + e.message, true);
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '↻ Rescan'; }
    }
  }

  async function ab_runBookkeeper() {
    const runBtn = document.getElementById('ab-uncat-run-btn');
    if (runBtn) {
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Running...';
    }

    try {
      const companyResp = await apiFetch('/api/bookkeeper/companies');
      const companyData = await companyResp.json();
      const selectedCompany = (companyData.companies || []).find(c => c.realm_id === abRealmId);
      if (selectedCompany && !selectedCompany.auto_bookkeeper_enabled) {
        throw new Error(`Auto-Bookkeeper is not enabled for ${selectedCompany.company_name || 'this company'}. Turn it on first, then rerun.`);
      }
      const res = await apiFetch('/api/bookkeeper/run-now', {
        method: 'POST',
        body: JSON.stringify({ realmId: abRealmId })
      });
      if (!res.ok) {
        const d = await res.json();
        throw new Error(d.error || 'Bookkeeper run failed');
      }
      const data = await res.json();
      toast(`Bookkeeper run complete: ${data.processed || 0} transactions processed`);
      ab_loadUncategorized(); // Refresh
    } catch (e) {
      toast('Bookkeeper run failed: ' + e.message, 'error');
    } finally {
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.textContent = '▶ Run Auto-Bookkeeper';
      }
    }
  }

  let abHistoryDirFilter = 'all';
  let abHistoryDaysFilter = 30;

  function ab_historyDirection(t) {
    const type = String(t?.txn_type || '').toLowerCase();
    const original = String(t?.original_account || '').toLowerCase();
    const coded = String(t?.coded_account || '').toLowerCase();

    if (type === 'deposit') return 'in';
    if (type === 'expense' || type === 'credit card expense' || type === 'creditcardexpense' || type === 'credit card charge' || type === 'creditcardcharge' || type === 'check' || type === 'purchase') return 'out';
    if (type === 'credit card credit' || type === 'creditcardcredit') {
      if (coded.includes('income') || coded.includes('reward') || coded.includes('rebate') || coded.includes('credit')) return 'in';
      return 'out';
    }
    if (original.includes('uncategorized income')) return 'in';
    if (original.includes('uncategorized expense')) return 'out';
    return Number(t?.amount || 0) >= 0 ? 'in' : 'out';
  }

  function ab_historyAmountHtml(t) {
    const dir = ab_historyDirection(t);
    const color = dir === 'in' ? 'var(--green)' : 'var(--red)';
    const label = dir === 'in' ? 'Money In' : 'Money Out';
    return `<span style="color:${color};font-weight:700;">$${Math.abs(parseFloat(t.amount || 0)).toFixed(2)}</span><div style="font-size:0.68rem;color:var(--muted);font-weight:400;">${label}</div>`;
  }

  function ab_uncatDirection(t) {
    const type = String(t?.txn_type || '').toLowerCase();
    const original = String(t?.original_account || '').toLowerCase();
    if (type && ['deposit', 'salesreceipt', 'sales receipt', 'invoice', 'payment'].includes(type)) return 'in';
    if (original.includes('uncategorized income')) return 'in';
    if (original.includes('uncategorized expense') || original.includes('ask my accountant')) return 'out';
    if (original.includes('credit card')) return Number(t?.amount || 0) < 0 ? 'in' : 'out';
    return Number(t?.amount || 0) >= 0 ? 'in' : 'out';
  }

  function ab_uncatAmountHtml(t) {
    const dir = ab_uncatDirection(t);
    const color = dir === 'in' ? 'var(--green)' : 'var(--red)';
    return `<span style="color:${color};font-weight:700;">$${Math.abs(parseFloat(t.amount || 0)).toFixed(2)}</span>`;
  }

  function ab_setHistoryDirFilter(dir, btn) {
    abHistoryDirFilter = dir;
    document.querySelectorAll('.ab-hist-dir-btn').forEach(b => b.className = 'btn btn-outline btn-sm ab-hist-dir-btn');
    if (btn) btn.className = 'btn btn-gold btn-sm ab-hist-dir-btn';
    ab_loadHistory();
  }

  function ab_setHistoryDaysFilter(days, btn) {
