      <button type="button" class="ov2-card-link" onclick="ov2GoTab('communication')">View all →</button>
    </div><div id="ov-msgs-inner" style="color:var(--muted);font-size:0.82rem;">Loading…</div>`;
    apiFetch(`/api/messages/company/${companyId}?scope=mine`).then(r => r.json()).then(threads => {
      const el = document.getElementById('ov-msgs-inner');
      if (!el) return;
      const list = Array.isArray(threads) ? threads : (threads.threads || threads.data || []);
      if (!list.length) {
        el.innerHTML = `<div class="ov2-empty"><span>No messages yet.</span>
          <button type="button" class="ov2-empty-cta" onclick="ov2GoTab('communication')">+ Open inbox</button></div>`;
        return;
      }
      function relTime(ts) {
        if (!ts) return '';
        const d = new Date(ts);
        const diff = Date.now() - d;
        if (diff < 60000) return 'just now';
        if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
        if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
        return d.toLocaleDateString();
      }
