  // ── @mention picker for company comm tab ──
  (function() {
    let _coFirmUsers = [];
    let _coMentionStart = -1;
    const getTA = () => document.getElementById('comm-co-reply-body');
    const getPicker = () => document.getElementById('comm-co-mention-picker');
    let _coPicker = null;
    function getOrCreateCoPicker() {
      if (!_coPicker) {
        _coPicker = document.createElement('div');
        _coPicker.style.cssText = 'display:none;position:fixed;z-index:9999;background:var(--charcoal,#1c2b3a);border:1px solid var(--gold,#c9a84c);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.5);min-width:200px;max-height:220px;overflow-y:auto;';
        document.body.appendChild(_coPicker);
      }
      return _coPicker;
    }
    function hidePicker() { getOrCreateCoPicker().style.display = 'none'; _coMentionStart = -1; }
    function insertMention(name) {
      const ta = getTA(); if (!ta) return;
      const val = ta.value, pos = ta.selectionStart;
      ta.value = val.slice(0, _coMentionStart) + '@' + name + ' ' + val.slice(pos);
      const np = _coMentionStart + name.length + 2;
      ta.setSelectionRange(np, np); ta.focus(); hidePicker();
    }
    document.addEventListener('keyup', function(e) {
      const ta = getTA();
      if (!ta || e.target !== ta) return;
      const val = ta.value, pos = ta.selectionStart, textBefore = val.slice(0, pos);
      const atIdx = textBefore.lastIndexOf('@');
      if (atIdx === -1 || (atIdx > 0 && /\S/.test(val[atIdx - 1]))) { hidePicker(); return; }
      const query = textBefore.slice(atIdx + 1).toLowerCase();
      if (query.includes(' ') && query.split(' ').length > 2) { hidePicker(); return; }
      _coMentionStart = atIdx;
      if (!_coFirmUsers.length) {
        apiFetch('/firms/team').then(r => r.json()).then(u => { _coFirmUsers = u || []; }).catch(() => {});
        return;
      }
      const matches = _coFirmUsers.filter(u => (u.name || u.email || '').toLowerCase().includes(query)).slice(0, 8);
      if (!matches.length) { hidePicker(); return; }
      const picker = getOrCreateCoPicker();
      picker.innerHTML = matches.map(u => {
        const name = u.name || u.email;
        const ini = name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
        return `<div class="co-mention-item" data-name="${name.replace(/"/g,'')}" style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;color:var(--text,#e8edf2);">
          <div style="width:26px;height:26px;border-radius:50%;background:rgba(201,168,76,0.15);color:var(--gold,#c9a84c);display:flex;align-items:center;justify-content:center;font-size:0.68rem;font-weight:700;">${ini}</div>
          <span>${name}</span></div>`;
      }).join('');
      const rect = ta.getBoundingClientRect();
      picker.style.left = rect.left + 'px';
      picker.style.width = rect.width + 'px';
      picker.style.display = 'block';
      // Always above
      requestAnimationFrame(() => {
        const ph = picker.offsetHeight;
        picker.style.top = Math.max(8, rect.top - ph - 6) + 'px';
      });
      picker.querySelectorAll('.co-mention-item').forEach(item => {
        item.addEventListener('mouseenter', () => item.style.background = 'rgba(201,168,76,0.1)');
        item.addEventListener('mouseleave', () => item.style.background = '');
        item.addEventListener('mousedown', ev => { ev.preventDefault(); insertMention(item.dataset.name); });
      });
    });
    document.addEventListener('keydown', e => { if (getOrCreateCoPicker().style.display !== 'none' && e.key === 'Escape') hidePicker(); });
    apiFetch('/firms/team').then(r => r.json()).then(u => { _coFirmUsers = u || []; }).catch(() => {});
  })();

  function initCoComm() {
    commCoId = companyId;
    commCoView = 'active';
    commCoCurrentThreadArchived = false;
    updateCoCommViewControls();
    coCommShowEmpty();
    loadCoConversation();
    loadCoCommArchivedThreads(false);
    loadCoCommSummary(false);
    // Enter to send, Shift+Enter for newline
    const ta = document.getElementById('comm-co-reply-body');
    if (ta && !ta._shiftEnterBound) {
      ta.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey && !e.altKey && !e.ctrlKey && !e.metaKey && !e.isComposing) {
          e.preventDefault();
          coCommSendMessage();
        }
      });
      ta._shiftEnterBound = true;
    }
  }

  let _coCommSummaryLoaded = false;
  async function loadCoCommSummary(force = false) {
    if (!commCoId) return;
    if (commCoView === 'archived') return;
    if (_coCommSummaryLoaded && !force) return;
    const body = document.getElementById('comm-co-summary-body');
    const btn = document.getElementById('comm-co-summary-refresh-btn');
    if (!body) return;
    body.innerHTML = '<div style="display:flex;align-items:center;gap:0.5rem;color:var(--muted);"><div class="loading-spinner" style="width:16px;height:16px;border-width:2px;"></div> Generating summary…</div>';
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/messages/company/${commCoId}/summary`, { method: 'POST' });
      const data = await res.json();
      _coCommSummaryLoaded = true;
      if (!data.summary) {
        body.innerHTML = `<div style="color:var(--muted);font-style:italic;">${data.message || 'No messages in the last 30 days.'}</div>`;
      } else {
        const html = data.summary
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\n/g, '<br>');
        body.innerHTML = `<div>${html}</div>
          <div style="margin-top:1rem;font-size:0.72rem;color:var(--muted);border-top:1px solid var(--border);padding-top:0.5rem;">
            Based on ${data.messageCount} message${data.messageCount !== 1 ? 's' : ''} · ${new Date(data.generatedAt).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}
          </div>`;
      }
    } catch(e) {
      body.innerHTML = '<div style="color:var(--muted);font-style:italic;">Failed to load summary.</div>';
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '↺ Refresh'; }
    }
  }

  function updateCoCommViewControls() {
