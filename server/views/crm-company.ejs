  // ── Upload modal wiring ──
  (function() {
    var modal     = document.getElementById('upload-modal');
    var yearSel   = document.getElementById('upload-year');
    var fileDrop  = document.getElementById('upload-file-drop');
    var fileInput = document.getElementById('upload-file-input');
    var submitBtn = document.getElementById('upload-submit-btn');
    var cancelBtn = document.getElementById('upload-cancel-btn');
    var errEl     = document.getElementById('upload-error');
    var msgEl     = document.getElementById('upload-msg');
    if (!modal) return;

    var _uploadFiles = [];
    var CY = new Date().getFullYear();
    for (var y = CY; y >= 2018; y--) {
      var o = document.createElement('option');
      o.value = String(y); o.textContent = String(y);
      if (y === CY - 1) o.selected = true;
      yearSel.appendChild(o);
    }

    function normalizeFiles(files) {
      return Array.prototype.slice.call(files || []).filter(function(f) { return f && f.name; });
    }

    function setFiles(files) {
      _uploadFiles = normalizeFiles(files);
      var nameEl = document.getElementById('upload-selected-name');
      if (!_uploadFiles.length) {
        nameEl.textContent = '';
        submitBtn.disabled = true;
        return;
      }
      if (_uploadFiles.length === 1) {
        nameEl.textContent = _uploadFiles[0].name;
      } else {
        nameEl.textContent = _uploadFiles.length + ' files selected: ' + _uploadFiles.slice(0, 3).map(function(f) { return f.name; }).join(', ') + (_uploadFiles.length > 3 ? '…' : '');
      }
      submitBtn.disabled = false;
    }

    fileDrop.addEventListener('click', function() { fileInput.click(); });
    fileDrop.addEventListener('dragover', function(e) { e.preventDefault(); fileDrop.classList.add('drag-over'); });
    fileDrop.addEventListener('dragleave', function() { fileDrop.classList.remove('drag-over'); });
    fileDrop.addEventListener('drop', function(e) { e.preventDefault(); fileDrop.classList.remove('drag-over'); setFiles(e.dataTransfer.files); });
    fileInput.addEventListener('change', function() { setFiles(fileInput.files); });
    document.getElementById('upload-section').addEventListener('change', refreshCompanyUploadFolderOptions);
    document.getElementById('upload-doc-type').addEventListener('change', refreshCompanyUploadFolderOptions);
    document.getElementById('upload-folder').addEventListener('change', function() {
      syncCompanyFolderPlacement(this, document.getElementById('upload-section'), document.getElementById('upload-doc-type'));
    });
    cancelBtn.addEventListener('click', function() { window.closeUploadModal(); });
    modal.addEventListener('click', function(e) { if (e.target === modal) window.closeUploadModal(); });

    submitBtn.addEventListener('click', async function() {
      if (!_uploadFiles.length) return;
      submitBtn.disabled = true;
      var originalLabel = submitBtn.textContent || 'Upload';
      errEl.style.display = 'none'; msgEl.style.display = 'none';
      var uploaded = 0;
      try {
        for (var i = 0; i < _uploadFiles.length; i++) {
          var file = _uploadFiles[i];
          submitBtn.textContent = _uploadFiles.length === 1 ? 'Uploading…' : 'Uploading ' + (i + 1) + ' of ' + _uploadFiles.length + '…';
          msgEl.textContent = _uploadFiles.length === 1 ? '' : 'Uploading ' + file.name;
          msgEl.style.display = _uploadFiles.length === 1 ? 'none' : 'block';

          var fd = new FormData();
          fd.append('file', file);
          fd.append('owner_type', 'company');
          fd.append('owner_id', companyId);
          fd.append('year', yearSel.value);
          fd.append('doc_type', document.getElementById('upload-doc-type').value);
          fd.append('folder_category', document.getElementById('upload-doc-type').value);
          fd.append('folder_section', document.getElementById('upload-section').value);
          fd.append('folder_id', document.getElementById('upload-folder').value);
          var res = await fetch('/api/documents/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
          var data = await res.json().catch(function() { return {}; });
          if (!res.ok) throw new Error((data.error || 'Upload failed') + ' (' + file.name + ')');
          uploaded++;
        }
        msgEl.textContent = uploaded === 1 ? 'Uploaded!' : 'Uploaded ' + uploaded + ' documents!'; msgEl.style.display = 'block';
        var docEl = document.getElementById('docs-content');
        if (docEl) delete docEl.dataset.loaded;
        docsData = [];
        await loadDocs();
        setTimeout(function() { window.closeUploadModal(); toast(uploaded === 1 ? 'Document uploaded' : uploaded + ' documents uploaded'); }, 800);
      } catch(e2) {
        errEl.textContent = e2.message; errEl.style.display = 'block';
        if (uploaded > 0) { msgEl.textContent = uploaded + ' uploaded before the error.'; msgEl.style.display = 'block'; }
        submitBtn.disabled = false; submitBtn.textContent = originalLabel;
      }
    });

    window.openUploadModal = function(preloadFiles) {
      refreshCompanyUploadFolderOptions();
      _uploadFiles = [];
      if (fileInput) fileInput.value = '';
      document.getElementById('upload-selected-name').textContent = '';
      submitBtn.disabled = true; submitBtn.textContent = 'Upload';
      errEl.style.display = 'none'; msgEl.style.display = 'none';
      modal.classList.add('open');
      if (preloadFiles) setFiles(preloadFiles instanceof File ? [preloadFiles] : preloadFiles);
    };
    window.closeUploadModal = function() { modal.classList.remove('open'); };
  })();

  function captureDocsOpenState() {
    const el = document.getElementById('docs-content');
    if (!el) return { years: [], cats: [] };
    const years = Array.from(el.querySelectorAll('.year-folder'));
    const cats = Array.from(el.querySelectorAll('.cat-folder'));
    return {
      years: years.map((node, idx) => node.classList.contains('open') ? idx : -1).filter(idx => idx >= 0),
      cats: cats.map((node, idx) => node.classList.contains('open') ? idx : -1).filter(idx => idx >= 0)
    };
  }

  function restoreDocsOpenState(state) {
    const el = document.getElementById('docs-content');
    if (!el || !state) return;
    const years = Array.from(el.querySelectorAll('.year-folder'));
    const cats = Array.from(el.querySelectorAll('.cat-folder'));
    (state.years || []).forEach(idx => { if (years[idx]) years[idx].classList.add('open'); });
    (state.cats || []).forEach(idx => { if (cats[idx]) cats[idx].classList.add('open'); });
  }

  function renderDocsPreservingState() {
    const state = captureDocsOpenState();
    renderDocs();
    restoreDocsOpenState(state);
  }

  async function downloadDoc(id, btn) {
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/documents/${id}/url`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      if (data.url) window.open(data.url, '_blank');
    } catch(e) { toast('Download failed: ' + e.message, 'error'); }
    if (btn) { btn.disabled = false; btn.textContent = '⬇'; }
  }

  function reloadDocs() {
    const el = document.getElementById('docs-content');
    if (el) delete el.dataset.loaded;
    docsShowingTrash = false;
    loadDocs();
  }

  async function deleteDoc(id, e) {
    if (e) e.stopPropagation();
    const btn = e?.currentTarget || e?.target;
    const originalLabel = btn?.textContent;
    if (!await window.dlConfirm('Move this document to Trash? You can restore it later.', {title:'Move to Trash', confirmLabel:'Move to Trash', danger:true, icon:'🗑️'})) return;
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      let res = await apiFetch(`/api/documents/${id}`, { method: 'DELETE' });
      if (res.status === 409) {
        const d = await res.json().catch(()=>({}));
        if (!d.requires_confirmation) throw new Error(d.error || 'Failed');
        const confirmed = await window.dlConfirm(
          `${d.error || 'This document is attached to a tax delivery.'}<br><br>This will delete the tax delivery and all files attached to it.`,
          {title:'Delete Tax Delivery Too?', confirmLabel:'Delete Everything', danger:true, icon:'⚠️', requiredText:'DELETE'}
        );
        if (!confirmed) {
          if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
          return;
        }
        res = await apiFetch(`/api/documents/${id}`, { method: 'DELETE', body: JSON.stringify({ confirm_delete: 'DELETE' }) });
      }
      if (!res.ok) { const d = await res.json().catch(()=>({})); throw new Error(d.error || 'Failed'); }
      toast('Document moved to Trash');
      reloadDocs();
    } catch(e2) {
      if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
      toast(e2.message, 'error');
    }
  }

  async function restoreDoc(id, e) {
    if (e) e.stopPropagation();
    const btn = e?.currentTarget || e?.target;
    const originalLabel = btn?.textContent;
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/documents/${id}/restore`, { method: 'POST' });
      if (!res.ok) { const d = await res.json().catch(()=>({})); throw new Error(d.error || 'Failed'); }
      docsTrashData = docsTrashData.filter(d => d.id !== id);
      delete document.getElementById('docs-content').dataset.loaded;
      const activeRes = await apiFetch(`/api/documents?owner_type=company&owner_id=${companyId}`);
      docsData = await activeRes.json();
      toast('Document restored');
      reloadDocs();
    } catch(e2) {
      if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
      toast('Restore failed: ' + e2.message, 'error');
    }
  }

  async function permanentDeleteDoc(id, e) {
    if (e) e.stopPropagation();
    const confirmed = await window.dlConfirm('Permanently delete this document from Trash? S3 versioning is enabled, but this removes it from DarkLion.', {title:'Delete Forever?', confirmLabel:'Delete Forever', danger:true, icon:'⚠️', requiredText:'DELETE'});
    if (!confirmed) return;
    const btn = e?.currentTarget || e?.target;
    const originalLabel = btn?.textContent;
    if (btn) { btn.disabled = true; btn.textContent = '…'; }
    try {
      const res = await apiFetch(`/api/documents/${id}/permanent`, { method: 'DELETE', body: JSON.stringify({ confirm_delete: 'DELETE' }) });
      if (!res.ok) { const d = await res.json().catch(()=>({})); throw new Error(d.error || 'Failed'); }
      toast('Document permanently deleted');
      loadTrashDocs();
    } catch(e2) {
      if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
      toast('Permanent delete failed: ' + e2.message, 'error');
    }
  }

  async function quickMoveDocSide(id, e) {
    if (e) e.stopPropagation();
    const doc = docsData.find(d => d.id === id);
    if (!doc) return;
    const currentSection = doc.folder_section || 'firm_uploaded';
    const targetSection = currentSection === 'client_uploaded' ? 'firm_uploaded' : 'client_uploaded';
    try {
      const res = await apiFetch(`/api/documents/${id}`, {
        method: 'PUT',
        body: JSON.stringify({
          year: doc.year || '',
          folder_section: targetSection,
          folder_category: doc.folder_category || doc.doc_type || 'other',
          folder_id: ''
        })
      });
      if (!res.ok) { const d = await res.json().catch(()=>({})); throw new Error(d.error || 'Failed'); }
      toast(targetSection === 'client_uploaded' ? 'Moved to Uploaded by Client' : 'Moved to Delivered by Advisor');
      reloadDocs();
    } catch(e2) { toast('Move failed: ' + e2.message, 'error'); }
  }

  let _moveDocId = null;
  function openMoveDocModal(id, currentSection, currentCategory, e, currentYear) {
    if (e) e.stopPropagation();
    _moveDocId = id;
    const modal = document.getElementById('move-doc-modal');
    if (!modal) { console.error('move-doc-modal not found in DOM'); return; }
    const yearEl    = document.getElementById('move-doc-year');
    const sectionEl = document.getElementById('move-doc-section');
    const catEl     = document.getElementById('move-doc-category');
    if (!yearEl || !sectionEl || !catEl) { console.error('move-doc-modal fields missing'); return; }
    yearEl.value    = currentYear    || String(new Date().getFullYear() - 1);
    sectionEl.value = currentSection || 'firm_uploaded';
    catEl.value     = currentCategory || 'tax';
    modal.style.display = 'flex'; // force-show regardless of class
    modal.classList.add('open');
  }
  function closeMoveDocModal() {
    const modal = document.getElementById('move-doc-modal');
    if (modal) { modal.classList.remove('open'); modal.style.display = ''; }
    _moveDocId = null;
  }
  function closeMoveDocModal() {
    const modal = document.getElementById('move-doc-modal');
    if (modal) modal.classList.remove('open');
    _moveDocId = null;
  }
  async function saveDocMove(id) {
    const year    = document.getElementById(`mv-year-${id}`).value;
    const section = document.getElementById(`mv-sec-${id}`).value;
    const category = document.getElementById(`mv-cat-${id}`).value;
    const folderId = document.getElementById(`mv-folder-${id}`)?.value || '';
    try {
      const res = await apiFetch(`/api/documents/${id}`, { method: 'PUT', body: JSON.stringify({ year, folder_section: section, folder_category: category, folder_id: folderId }) });
      if (!res.ok) { const d = await res.json().catch(()=>({})); throw new Error(d.error || 'Error ' + res.status); }
      toast('Document moved');
      reloadDocs();
    } catch(e) { toast('Move failed: ' + e.message, 'error'); }
  }

  async function submitMoveDoc() {
    if (!_moveDocId) return;
    const year = document.getElementById('move-doc-year').value;
    const section = document.getElementById('move-doc-section').value;
    const category = document.getElementById('move-doc-category').value;
    try {
      const res = await apiFetch(`/api/documents/${_moveDocId}`, { method: 'PUT', body: JSON.stringify({ year, folder_section: section, folder_category: category }) });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || 'Failed'); }
      toast('Document moved');
      closeMoveDocModal();
      reloadDocs();
    } catch(e) { toast(e.message, 'error'); }
  }

