    bk_cpProvider = companyData?.bookkeeping_provider === 'qbo' ? 'qbo' : 'ledgerhq';
  }
  let bk_ledgerHqCompanies = [];
  let bk_ledgerHqCompaniesLoaded = false;
  let bk_cpShowZeroAccounts = false;
  let bk_lastClosePackageData = null;
  let bk_lastClosePackagePkg = null;
  let bk_cpRequestId = 0;
  let bk_cpPending = false;
  let bk_cpMappingPending = false;
  let bk_cpLastAttempt = 0;

  function bk_clearClosePackage() {
    bk_cpRequestId++;
    bk_cpPending = false;
    bk_lastClosePackageData = null;
    bk_lastClosePackagePkg = null;
    document.getElementById('bk-cp-results').innerHTML = '';
  }

  function bk_refreshVisibleLedgerHq() {
    if (document.hidden || bk_cpProvider !== 'ledgerhq' || !bk_cpInitialized || bk_cpPending || bk_cpMappingPending) return;
    const panel = document.getElementById('subtab-close-package');
    if (!panel || !panel.getClientRects().length || Date.now() - bk_cpLastAttempt < 300000) return;
    bk_ledgerHqCompaniesLoaded = false;
    bk_loadLedgerHqCompanies();
    bk_generateClosePackage(true);
  }
  setInterval(bk_refreshVisibleLedgerHq, 30000);
  document.addEventListener('visibilitychange', bk_refreshVisibleLedgerHq);
  window.addEventListener('focus', bk_refreshVisibleLedgerHq);

  function bk_hasLedgerHqClosePackage() {
    return !!(companyData && companyData.ledgerhq_connected);
  }

  function bk_hasQboRealmRecord() {
    const realm = String(companyData?.realm_id || '').trim();
    return !!realm && !realm.startsWith('import-') && !realm.startsWith('unconnected-');
  }

  function bk_hasAnyClosePackageProvider() {
    return !!bookkeepingRealm || bk_hasLedgerHqClosePackage();
  }

  async function bk_loadLedgerHqCompanies() {
    if (!bk_hasLedgerHqClosePackage() || bk_ledgerHqCompaniesLoaded) return;
    const select = document.getElementById('bk-ledgerhq-company-select');
    if (select) select.innerHTML = '<option value="">Loading LedgerHQ companies…</option>';
    try {
      const res = await apiFetch('/api/ledgerhq/companies');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to load LedgerHQ companies');
      bk_ledgerHqCompanies = data.companies || [];
      bk_ledgerHqCompaniesLoaded = true;
      bk_renderLedgerHqCompanySelect();
    } catch(e) {
      if (select) select.innerHTML = '<option value="">LedgerHQ companies unavailable</option>';
      console.error('bk_loadLedgerHqCompanies error:', e);
    }
  }

  function bk_renderLedgerHqCompanySelect() {
    const select = document.getElementById('bk-ledgerhq-company-select');
    if (!select) return;
    if (!bk_hasLedgerHqClosePackage()) return;
    const currentId = companyData?.ledgerhq_link?.provider_company_id || '';
    let html = '<option value="">Choose LedgerHQ company…</option>';
    for (const co of bk_ledgerHqCompanies) {
      const id = co.id || co.companyId || '';
      const name = co.name || co.companyName || id;
      if (!id) continue;
      html += '<option value="'+esc(id)+'" data-name="'+esc(name)+'"'+(id === currentId ? ' selected' : '')+'>'+esc(name)+'</option>';
    }
    select.innerHTML = html;
  }

  async function bk_saveLedgerHqMapping() {
    const select = document.getElementById('bk-ledgerhq-company-select');
    if (!select) return;
    const providerCompanyId = select.value;
    const providerCompanyName = select.options[select.selectedIndex]?.dataset?.name || select.options[select.selectedIndex]?.textContent || '';
    if (!providerCompanyId) { bk_renderLedgerHqCompanySelect(); return; }
    bk_cpMappingPending = true;
    select.disabled = true;
    bk_clearClosePackage();
    try {
      const res = await apiFetch('/api/ledgerhq/company-links/'+companyId, {
        method: 'PUT',
        body: JSON.stringify({ providerCompanyId, providerCompanyName })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save LedgerHQ company mapping');
      companyData.ledgerhq_link = {
        provider_company_id: providerCompanyId,
        provider_company_name: providerCompanyName
      };
      toast('LedgerHQ company selected');
      bk_renderClosePackageProviderControls();
      bk_clearClosePackage();
    } catch(e) {
      bk_renderLedgerHqCompanySelect();
      toast(e.message, 'error');
    } finally {
      bk_cpMappingPending = false;
      select.disabled = false;
      if (bk_cpProvider === 'ledgerhq') bk_loadLatestClosePackage();
    }
  }

  async function bk_setClosePackageProvider(provider) {
    if (!['ledgerhq', 'qbo'].includes(provider) || bk_cpSourceSaving) return;
    if (provider === bk_cpProvider) return;
    bk_cpSourceSaving = true;
    bk_renderClosePackageProviderControls();
    try {
      const response = await apiFetch('/api/companies/'+companyId+'/bookkeeping-source', {
        method: 'PUT', body: JSON.stringify({ provider }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not save bookkeeping source');
      companyData.bookkeeping_provider = data.provider;
      bk_clearClosePackage();
      bk_restoreClosePackageProvider();
      if (bk_cpProvider === 'ledgerhq') bk_loadLedgerHqCompanies();
      if (bk_cpInitialized) bk_loadLatestClosePackage();
    } catch (error) {
      toast(error.message, 'error');
    } finally {
      bk_cpSourceSaving = false;
      bk_renderClosePackageProviderControls();
    }
  }

  function bk_showUnavailableSource() {
    if (bk_cpProvider === 'ledgerhq' && !bk_hasLedgerHqClosePackage()) {
      bk_clearClosePackage();
      document.getElementById('bk-cp-results').innerHTML = '<p style="padding:1rem;">LedgerHQ is not connected. <a href="/settings?tab=integrations">Connect LedgerHQ in Settings</a>, or choose QuickBooks above.</p>';
      return true;
    }
    if (bk_cpProvider === 'qbo' && !bookkeepingRealm) {
      bk_clearClosePackage();
      document.getElementById('bk-cp-results').innerHTML = bk_qboConnectCardHtml(bk_hasQboRealmRecord());
      return true;
    }
    return false;
  }

  function bk_renderClosePackageProviderControls() {
    const qboBtn = document.getElementById('bk-cp-provider-qbo');
    const ledgerBtn = document.getElementById('bk-cp-provider-ledgerhq');
    const note = document.getElementById('bk-cp-provider-note');
    if (!qboBtn || !ledgerBtn) return;
    qboBtn.disabled = bk_cpSourceSaving;
    ledgerBtn.disabled = bk_cpSourceSaving;
    const select = document.getElementById('bk-ledgerhq-company-select');
    const selectWrap = document.getElementById('bk-ledgerhq-company-wrap');
    if (selectWrap) selectWrap.style.display = (bk_cpProvider === 'ledgerhq' && bk_hasLedgerHqClosePackage()) ? 'flex' : 'none';
    if (select && bk_cpProvider === 'ledgerhq') bk_renderLedgerHqCompanySelect();
    qboBtn.className = 'btn ' + (bk_cpProvider === 'qbo' ? 'btn-gold' : 'btn-outline') + ' btn-sm';
    ledgerBtn.className = 'btn ' + (bk_cpProvider === 'ledgerhq' ? 'btn-gold' : 'btn-outline') + ' btn-sm';
    if (note) {
      note.textContent = bk_cpProvider === 'ledgerhq'
        ? (companyData?.ledgerhq_link ? 'LedgerHQ reports use the selected LedgerHQ company.' : 'Choose which LedgerHQ company maps to this DarkLion company.')
        : 'QuickBooks reports use the existing connected QBO company.';
    }
  }

  function bk_initClosePackage() {
    const guardEl = document.getElementById('bk-cp-qbo-guard');
    const mainEl = document.getElementById('bk-cp-main');
    if (guardEl) guardEl.innerHTML = '';
    if (mainEl) mainEl.style.display = '';
    bk_renderClosePackageProviderControls();
    bk_loadLedgerHqCompanies();
    if (bk_cpInitialized) { bk_refreshVisibleLedgerHq(); return; }
    bk_cpInitialized = true;
    bk_populatePeriodSelectors();
    bk_loadLatestClosePackage();
  }

  function bk_populatePeriodSelectors() {
    const now = new Date();
    const cutoff = new Date(now.getFullYear(), now.getMonth() - 17, 1);
    let mhtml = '';
    for (const year of [now.getFullYear(), now.getFullYear()-1]) {
      mhtml += '<div class="period-year-label">'+year+'</div><div class="month-grid">';
      for (let m = 1; m <= 12; m++) {
        const d = new Date(year, m-1, 1);
        const val = year + '-' + String(m).padStart(2,'0');
        const short = d.toLocaleString('default',{month:'short'});
        const isCurrent = year === now.getFullYear() && m-1 === now.getMonth();
        const isFuture = d > now;
        const tooOld = d < cutoff;
        const disabled = isFuture || tooOld;
        mhtml += '<button class="month-btn'+(isCurrent?' current':'')+'"'+(disabled?' disabled style="opacity:0.3;cursor:default;"':'')+' data-period="'+val+'" onclick="'+(disabled?'':'bk_selectMonth(this,\''+val+'\')')+'">'+short+'</button>';
      }
      mhtml += '</div>';
    }
    document.getElementById('bk-month-grid-container').innerHTML = mhtml;

    let qhtml = '';
    for (const year of [now.getFullYear(), now.getFullYear()-1]) {
      qhtml += '<div class="period-year-label">'+year+'</div><div class="quarter-grid">';
      for (let q = 1; q <= 4; q++) {
        const sm = (q-1)*3 + 1; const em = q*3;
        const sd = year+'-'+String(sm).padStart(2,'0')+'-01';
        const ed = bk_lastDay(year, em);
        qhtml += '<button class="quarter-btn" onclick="bk_selectQuarter(this,'+q+','+year+',\''+sd+'\',\''+ed+'\')">Q'+q+'</button>';
      }
      qhtml += '</div>';
    }
    document.getElementById('bk-quarter-grid-container').innerHTML = qhtml;

    let yhtml = '';
    const cy = now.getFullYear();
    yhtml += '<button class="year-btn" onclick="bk_selectYear(this,'+(cy-1)+')">'+(cy-1)+'</button>';
    yhtml += '<button class="year-btn" onclick="bk_selectYear(this,'+cy+')">'+cy+' YTD</button>';
    yhtml += '<button class="year-btn" onclick="bk_selectYear(this,'+(cy-2)+')">'+(cy-2)+'</button>';
    document.getElementById('bk-year-grid-container').innerHTML = yhtml;

    const lastMonth = new Date(now.getFullYear(), now.getMonth()-1, 1);
    document.getElementById('bk-cp-date-from').value = lastMonth.getFullYear()+'-'+String(lastMonth.getMonth()+1).padStart(2,'0')+'-01';
    document.getElementById('bk-cp-date-to').value = bk_lastDay(lastMonth.getFullYear(), lastMonth.getMonth()+1);

    const defaultYear = now.getFullYear() - 1;
    const defaultYearBtn = document.querySelector('#bk-year-grid-container .year-btn[onclick*="bk_selectYear(this,'+defaultYear+')"]');
    if (defaultYearBtn) bk_selectYear(defaultYearBtn, defaultYear, true);
  }

  function bk_showPeriodTab(tab, el) {
    document.querySelectorAll('#subtab-close-package .period-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('#subtab-close-package .period-panel').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('bk-pp-'+tab).classList.add('active');
  }

  function bk_clearPeriodBtns() {
    document.querySelectorAll('#bk-month-grid-container .month-btn, #bk-quarter-grid-container .quarter-btn, #bk-year-grid-container .year-btn').forEach(b => b.classList.remove('selected'));
  }

  function bk_selectMonth(btn, period, skipGenerate) {
    bk_clearPeriodBtns(); btn.classList.add('selected');
    const [y,m] = period.split('-').map(Number);
    const d = new Date(y, m-1, 1);
    bk_cpSelection = { type:'month', startDate:y+'-'+String(m).padStart(2,'0')+'-01', endDate:bk_lastDay(y,m), label:d.toLocaleString('default',{month:'long',year:'numeric'}), period };
    document.getElementById('bk-cp-selected-label').textContent = bk_cpSelection.label;
    if (!skipGenerate) bk_generateClosePackage();
  }

  function bk_selectQuarter(btn, q, year, sd, ed) {
    bk_clearPeriodBtns(); btn.classList.add('selected');
    bk_cpSelection = { type:'quarter', startDate:sd, endDate:ed, label:'Q'+q+' '+year, period:year+'-Q'+q };
    document.getElementById('bk-cp-selected-label').textContent = bk_cpSelection.label;
    bk_generateClosePackage();
  }

  function bk_selectYear(btn, year, skipGenerate) {
    bk_clearPeriodBtns(); btn.classList.add('selected');
    const now = new Date();
    const isCurrentYear = year === now.getFullYear();
    bk_cpSelection = { type:'annual', startDate:year+'-01-01', endDate:isCurrentYear?bk_lastDay(now.getFullYear(),now.getMonth()+1):year+'-12-31', label:isCurrentYear?year+' YTD':String(year), period:String(year) };
    document.getElementById('bk-cp-selected-label').textContent = bk_cpSelection.label;
    if (!skipGenerate) bk_generateClosePackage();
  }

  function bk_applyCustomRange() {
    bk_clearPeriodBtns();
    const from = document.getElementById('bk-cp-date-from').value;
    const to = document.getElementById('bk-cp-date-to').value;
    if (!from || !to) { toast('Select both dates', 'error'); return; }
    if (from > to) { toast('Start date must be before end date', 'error'); return; }
    bk_cpSelection = { type:'custom', startDate:from, endDate:to, label:from+' to '+to, period:'custom' };
    document.getElementById('bk-cp-selected-label').textContent = bk_cpSelection.label;
    bk_generateClosePackage();
  }

  async function bk_generateClosePackage(quiet = false) {
    if (bk_cpMappingPending) return;
    if (bk_showUnavailableSource()) return;
    if (!bk_cpSelection.startDate) { toast('Select a period first', 'error'); return; }
    if (bk_cpProvider === 'ledgerhq' && !companyData?.ledgerhq_link?.provider_company_id) {
      bk_clearClosePackage();
      document.getElementById('bk-cp-results').innerHTML = '<p style="color:var(--muted);">Choose a LedgerHQ company to load its reports.</p>';
      return;
    }
    const requestId = ++bk_cpRequestId;
    const provider = bk_cpProvider;
    const label = bk_cpSelection.label;
    bk_cpPending = true;
    bk_cpLastAttempt = Date.now();
    bk_lastClosePackageData = null;
    bk_lastClosePackagePkg = null;
    document.getElementById('bk-cp-results').innerHTML = '<div style="text-align:center;padding:2rem;color:var(--muted);">Generating close package for '+esc(bk_cpSelection.label)+'…</div>';
    try {
      const body = { startDate:bk_cpSelection.startDate, endDate:bk_cpSelection.endDate, period:bk_cpSelection.period, label:bk_cpSelection.label };
      const url = bk_cpProvider === 'ledgerhq'
        ? '/api/companies/id/'+companyId+'/ledgerhq/close-package'
        : '/api/companies/'+bookkeepingRealm+'/close-package';
      const response = await apiFetch(url,{method:'POST',body:JSON.stringify(body)});
      const data = await response.json();
      if (requestId !== bk_cpRequestId) return;
      if (!response.ok || data.error) throw new Error(data.error || 'Report refresh failed');
      const rd = bk_parseScanData(data) || data.report_data;
      const rdObj = typeof rd === 'string' ? JSON.parse(rd) : rd;
      bk_lastClosePackageData = rdObj;
      bk_lastClosePackagePkg = data;
      document.getElementById('bk-cp-results').innerHTML = bk_renderClosePackageShell(rdObj, data, label);
      if (!quiet) toast((provider === 'ledgerhq' ? 'LedgerHQ' : 'QBO') + ' close package generated for '+label);
    } catch(e) {
      if (requestId !== bk_cpRequestId) return;
      // If QBO token is dead, show reconnect card instead of generic error
      if (bk_cpProvider === 'qbo' && e.message && (e.message.includes('401') || e.message.includes('refresh') || e.message.includes('token'))) {
        document.getElementById('bk-cp-results').innerHTML = bk_qboConnectCardHtml(true);
        // Reload company data so header badge updates too
        loadCompany();
      } else {
        toast('Generation failed: '+e.message, 'error');
        document.getElementById('bk-cp-results').innerHTML = '<div style="text-align:center;padding:2rem;color:var(--red);">Reports could not be refreshed: '+esc(e.message)+'<br><button class="btn btn-outline btn-sm" onclick="bk_generateClosePackage()">Retry refresh</button></div>';
      }
    } finally {
      if (requestId === bk_cpRequestId) bk_cpPending = false;
    }
  }

  async function bk_loadLatestClosePackage() {
    if (bk_showUnavailableSource()) return;
    // LedgerHQ reports are fetched on opening, never restored from an old snapshot.
    if (bk_cpProvider === 'ledgerhq') return bk_generateClosePackage(true);
    const requestId = ++bk_cpRequestId;
    try {
      bk_renderClosePackageProviderControls();
      const url = bk_cpProvider === 'ledgerhq'
        ? '/api/companies/id/'+companyId+'/ledgerhq/close-packages'
        : '/api/companies/'+bookkeepingRealm+'/close-packages';
      const resp = await apiFetch(url);
      if (!resp.ok) return;
      const pkgs = await resp.json();
      if (requestId !== bk_cpRequestId) return;
      if (!Array.isArray(pkgs) || pkgs.length === 0) return;
      const latest = pkgs[0];
      const rd = bk_parseScanData(latest) || latest.report_data;
      const rdObj = typeof rd === 'string' ? JSON.parse(rd) : rd;
      if (!rdObj) return;
      const btn = document.querySelector('#bk-month-grid-container .month-btn[data-period="'+latest.period+'"]');
      if (btn) bk_selectMonth(btn, latest.period, true);
      bk_lastClosePackageData = rdObj;
      bk_lastClosePackagePkg = latest;
      document.getElementById('bk-cp-results').innerHTML = bk_renderClosePackageShell(rdObj, latest, rdObj.period || latest.period);
    } catch(e) { console.error('bk_loadLatestClosePackage error:', e); }
  }

  function bk_renderClosePackageShell(rd, pkg, title) {
    return `
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;margin-bottom:1rem;">
        <div><h3 style="font-size:0.92rem;margin:0;">${esc(title || rd?.period || '')}</h3>
        ${rd?.provider === 'ledgerhq' ? `<div style="font-size:0.78rem;color:var(--muted);">LedgerHQ · ${esc(rd.ledgerHqCompanyName)} · ${esc(rd.pnl?.Header?.ReportBasis || 'Company default')} basis<br>Updated ${esc(new Date(rd.generatedAt).toLocaleString())} · Refreshes every 5 minutes while visible</div><button class="btn btn-outline btn-sm" onclick="bk_generateClosePackage()">Refresh now</button>` : ''}</div>
        <label style="display:flex;align-items:center;gap:0.45rem;font-size:0.82rem;color:var(--muted);cursor:pointer;user-select:none;">
          <input type="checkbox" ${bk_cpShowZeroAccounts ? 'checked' : ''} onchange="bk_toggleZeroAccounts(this.checked)">
          <span>Show zero accounts</span>
        </label>
      </div>
      ${bk_renderClosePackageBody(rd, pkg)}
    `;
  }

  function bk_toggleZeroAccounts(show) {
    bk_cpShowZeroAccounts = !!show;
    if (!bk_lastClosePackageData) return;
    document.getElementById('bk-cp-results').innerHTML = bk_renderClosePackageShell(
      bk_lastClosePackageData,
      bk_lastClosePackagePkg || {},
      bk_lastClosePackageData.period || bk_cpSelection.label
    );
  }

  function bk_renderClosePackageBody(rd, pkg) {
    if (!rd) return '<div style="color:var(--muted);padding:1rem;">No report data available.</div>';
    let html = '';
    if (rd.pnl) html += '<div class="report-section"><h3>Profit & Loss</h3>'+bk_renderQBReport(rd.pnl)+'</div>';
    if (rd.balanceSheet) html += '<div class="report-section"><h3>Balance Sheet</h3>'+bk_renderQBReport(rd.balanceSheet)+'</div>';
    if (rd.trialBalance) html += '<div class="report-section"><h3>Trial Balance</h3>'+bk_renderQBReport(rd.trialBalance)+'</div>';
    if (!rd.pnl && !rd.balanceSheet && !rd.trialBalance) html += '<div style="color:var(--muted);padding:1rem;text-align:center;">No report data available.</div>';
    html += '<div style="margin-top:0.75rem;text-align:right;"><span class="badge badge-pending" style="font-size:0.75rem;padding:0.2rem 0.6rem;">'+esc(pkg.status||'draft')+'</span></div>';
    return html;
  }

  function bk_renderQBReport(report) {
    if (!report?.Rows?.Row) {
      return '<div style="text-align:center;padding:1.5rem;color:var(--muted);">No report data available.</div>';
    }
    const columns = report.Columns?.Column || [];
    const colCount = Math.max(columns.length, 2);
    const dataCols = colCount - 1;
    const MONTH_MAP = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
    function parseTitleDate(title) {
      if (!title) return { start: '', end: '' };
      const m = title.trim().match(/^([A-Za-z]{3})\s+(\d{4})$/);
      if (m) {
        const mo = MONTH_MAP[m[1].toLowerCase()];
        const yr = parseInt(m[2]);
        if (mo && yr) {
          const start = yr + '-' + String(mo).padStart(2,'0') + '-01';
          const lastD = new Date(yr, mo, 0).getDate();
          const end = yr + '-' + String(mo).padStart(2,'0') + '-' + String(lastD).padStart(2,'0');
          return { start, end };
        }
      }
      const yr = title.trim().match(/^(\d{4})$/);
      if (yr) return { start: yr[1]+'-01-01', end: yr[1]+'-12-31' };
      return { start: '', end: '' };
    }
    const colDates = columns.map(col => {
      const meta = col.MetaData || [];
      const start = meta.find(m => m.Name === 'StartDate')?.Value || '';
      const end   = meta.find(m => m.Name === 'EndDate')?.Value   || '';
      if (start && end) return { start, end };
      return parseTitleDate(col.ColTitle || '');
    });
    // Size columns for their formatted values, rather than squeezing twelve
    // months into percentages of the viewport. The wrapper owns the overflow.
    let amountChars = Math.max(14, ...columns.slice(1).map(col => String(col.ColTitle || '').length + 4));
    function measureRows(rows) {
      for (const row of rows || []) {
        for (const cells of [row.ColData, row.Summary?.ColData]) {
          for (const cell of (cells || []).slice(1)) {
            const text = bk_formatCurrency(bk_reportAmountValue(cell?.value)).replace(/<[^>]*>/g, '');
            amountChars = Math.max(amountChars, text.length + 4);
          }
        }
        measureRows(row.Rows?.Row);
      }
    }
    measureRows(report.Rows.Row);
    let html = dataCols > 3 ? '<p class="report-scroll-hint">Scroll horizontally to see all months and the total. Account names stay visible.</p>' : '';
    html += `<div class="table-wrap financial-report-scroll" tabindex="0" role="region" aria-label="${esc(report.Header?.ReportName || 'Financial report')}"><table style="table-layout:fixed;width:100%;min-width:calc(var(--report-account-width) + ${amountChars * dataCols}ch);">`;
    html += '<colgroup>';
    html += '<col style="width:var(--report-account-width)">';
    for (let i = 0; i < dataCols; i++) html += `<col style="width:${amountChars}ch">`;
    html += '</colgroup>';
    html += '<thead><tr>';
    for (let i = 0; i < colCount; i++) {
      const title = columns[i]?.ColTitle || (i === 0 ? '' : '');
      html += i === 0
        ? `<th style="text-align:left;">${esc(title)}</th>`
        : `<th class="amount" style="text-align:right;padding-right:1rem;">${esc(title)}</th>`;
    }
    html += '</tr></thead>';
    html += '<tbody>';
    const bodyHtml = bk_renderReportRows(report.Rows.Row, 0, colCount, colDates);
    html += bodyHtml || `<tr><td colspan="${colCount}" style="text-align:center;padding:1rem;color:var(--muted);">No non-zero accounts.</td></tr>`;
    html += '</tbody></table></div>';
    return html;
  }

  function bk_reportAmountValue(value) {
    if (value === null || value === undefined || value === '') return 0;
    if (typeof value === 'number') return value;
    const text = String(value).replace(/<[^>]*>/g, '').replace(/[$,]/g, '').trim();
    if (!text) return 0;
    const isParen = /^\(.*\)$/.test(text);
    const n = parseFloat(text.replace(/[()]/g, ''));
    if (isNaN(n)) return 0;
    return isParen ? -n : n;
  }

  function bk_colDataHasNonZeroAmount(colData) {
    return (colData || []).slice(1).some(col => bk_reportAmountValue(col?.value) !== 0);
  }

  function bk_renderReportRows(rows, depth, colCount, colDates) {
    let html = '';
    for (const row of rows) {
      if (row.type === 'Section' || row.group) {
        const childHtml = row.Rows?.Row ? bk_renderReportRows(row.Rows.Row, depth + 1, colCount, colDates) : '';
        const summaryHasValue = row.Summary?.ColData ? bk_colDataHasNonZeroAmount(row.Summary.ColData) : false;
        if (!bk_cpShowZeroAccounts && !childHtml && !summaryHasValue) continue;
        if (row.Header?.ColData) {
          const name = row.Header.ColData[0]?.value || '';
          const pad = (depth * 1.2) + 1;
          html += `<tr class="report-row-header"><td style="padding-left:${pad}rem;">${esc(name)}</td>`;
          for (let i = 1; i < colCount; i++) html += '<td class="amount"></td>';
          html += '</tr>';
        }
        html += childHtml;
        if (row.Summary?.ColData && (bk_cpShowZeroAccounts || summaryHasValue)) html += bk_renderDataRow(row.Summary.ColData, depth, true, colCount, colDates);
      } else if (row.ColData) {
        if (!bk_cpShowZeroAccounts && !bk_colDataHasNonZeroAmount(row.ColData)) continue;
        html += bk_renderDataRow(row.ColData, depth, false, colCount, colDates);
      }
    }
    return html;
  }

  function bk_renderDataRow(colData, depth, isTotal, colCount, colDates) {
    const cls = isTotal ? ' class="report-row-total"' : '';
    let html = `<tr${cls}>`;
    for (let i = 0; i < colCount; i++) {
      const val = colData[i]?.value ?? '';
      if (i === 0) {
        const pad = (depth * 1.2) + 1;
        html += `<td style="padding-left:${pad}rem;${isTotal ? 'font-weight:700;' : ''}">${esc(val)}</td>`;
      } else {
        const numericText = String(val).replace(/[$,()]/g, '').trim();
        const num = numericText === '' || !Number.isFinite(Number(numericText)) ? NaN : bk_reportAmountValue(val);
        const display = isNaN(num) ? esc(val) : bk_formatCurrency(num);
        const colDate = colDates?.[i] || {};
        const sDate = colDate.start || bk_cpSelection?.startDate || '';
        const eDate = colDate.end   || bk_cpSelection?.endDate   || '';
        const accountName = colData[0]?.value || '';
        const drillable = bk_cpProvider === 'qbo' && !isNaN(num) && num !== 0 && sDate && eDate && !isTotal ? ' drillable' : '';
        const drillAttr = drillable
          ? ` data-account="${esc(accountName)}" data-start="${esc(sDate)}" data-end="${esc(eDate)}" onclick="bk_openDrilldown('${esc(accountName)}','${esc(sDate)}','${esc(eDate)}','${display.replace(/['"<>]/g,'')}')"` : '';
        html += `<td class="amount${drillable}"${drillAttr} style="padding-right:1rem;${isTotal ? 'font-weight:700;' : ''}">${display}</td>`;
      }
    }
    html += '</tr>';
    return html;
  }

