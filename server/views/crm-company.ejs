      ? '<span class="badge badge-muted">Inactive</span>'
      : c.status === 'dissolved'
        ? '<span style="background:rgba(229,62,62,0.12);color:var(--red);border-radius:999px;padding:0.12rem 0.45rem;font-size:0.68rem;font-weight:700;border:1px solid rgba(229,62,62,0.28);">Dissolved</span>'
        : '<span class="badge badge-green">Active</span>';
    const qbo = ov2QboState(c);
    const svcLabel = ov2BkServiceLabel(c.bookkeeping_service || 'none');
    const syncLabel = c.last_sync_at ? new Date(c.last_sync_at).toLocaleDateString() : '—';
