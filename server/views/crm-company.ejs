  async function loadCoCommArchivedThreads(openFirst = false) {
    if (!commCoId) return;
    try {
      const archivedResponse = await apiFetch(`/api/messages/company/${commCoId}?scope=mine&view=archived`);
      if (!archivedResponse.ok) throw new Error('Failed to load archived conversations');
      commCoArchivedThreads = await archivedResponse.json();
      const archiveCount = document.getElementById('comm-co-archive-count');
      if (archiveCount) archiveCount.textContent = commCoArchivedThreads.length;
      const threadSelect = document.getElementById('comm-co-archive-thread-select');
      if (threadSelect) {
        threadSelect.innerHTML = commCoArchivedThreads.map(thread => {
          const personName = [thread.person?.firstName, thread.person?.lastName].filter(Boolean).join(' ');
          const label = thread.subject || personName || 'Conversation';
          return `<option value="${thread.id}">${esc(label)} · ${new Date(thread.lastMessageAt || thread.createdAt).toLocaleDateString()}</option>`;
        }).join('');
      }
      updateCoCommViewControls();
      if (commCoView !== 'archived' || !openFirst) return;
      if (!commCoArchivedThreads.length) {
        coCommShowEmpty('No archived conversations for this business.');
        renderCoCommDateNavigation([]);
        return;
      }
      await loadCoThread(commCoArchivedThreads[0].id, false);
    } catch (error) {
      console.error('[co-comm] archived conversation load failed:', error);
      if (commCoView === 'archived') coCommShowEmpty('Archived conversations could not be loaded.');
    }
  }

  function coCommSelectArchivedThread(threadId) {
