{
  "name": "darklion",
  "version": "1.0.0",
  "description": "DarkLion: open-source practice management for accounting and wealth-management firms. Built by LedgerHQ.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "playwright test",
    "test:local": "node --test tests/unit/*.test.js tests/reliability/*.test.cjs",
    "test:portal:local": "playwright test --config tests/reliability/playwright.config.cjs && node tests/reliability/portal-browser.cjs",
    "release:verify": "node scripts/verify-release.js",
    "test:mcp": "playwright test tests/e2e/mcp-oauth.spec.js tests/e2e/mcp-protocol.spec.js tests/e2e/mcp-parity.spec.js tests/e2e/mcp-business-domain-catalog.spec.js tests/e2e/agent-work-mcp-auth.spec.js tests/e2e/agent-revenue-forecast-contract.spec.js tests/e2e/crm-search-contract.spec.js tests/e2e/agent-documents-contract.spec.js tests/e2e/agent-communications-contract.spec.js tests/e2e/agent-business-records-contract.spec.js && node --test tests/e2e/agent-crm-records-contract.spec.js tests/e2e/agent-pipeline-work-contract.spec.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report tests/report",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:pack": "npm --prefix apps/desktop run pack",
    "desktop:dist": "npm --prefix apps/desktop run dist",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:ios:prod": "npm --prefix mobile run ios",
    "mobile:ios:prebuild": "cd mobile && npx expo prebuild --clean --platform ios",
    "mobile:ios:native": "cd mobile && npx expo run:ios",
    "mobile:config": "cd mobile && npx expo config --type public",
    "bootstrap": "node scripts/create-first-firm.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/s3-request-presigner": "^3.1013.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "ejs": "^5.0.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.1",
    "form-data": "^4.0.5",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.20.0",
    "puppeteer": "^25.9.0",
    "pusher": "^5.3.3",
    "resend": "^6.9.4",
    "sharp": "^0.35.4",
    "stripe": "^20.4.1",
    "twilio": "^5.13.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "~5.9.2"
  },
  "license": "AGPL-3.0-only"
}
