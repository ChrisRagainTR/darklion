{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::darklion-communications-archive",
        "arn:aws:s3:::darklion-communications-archive/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    },
    {
      "Sid": "DenyDeletesByApplication",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::darklion-communications-archive",
        "arn:aws:s3:::darklion-communications-archive/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/archive-role": "administrator"
        }
      }
    }
  ]
}
