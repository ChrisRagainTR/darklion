# DarkLion configuration. Copy to .env and fill in. Never commit .env.
# Lines marked REQUIRED must be set; everything else is optional.

# ---------- Core (REQUIRED) ----------
NODE_ENV=production
PORT=8080
# Postgres connection string (Neon, Render, Supabase, or your own server)
DATABASE_URL=postgresql://user:password@host:5432/darklion
# DB_SSL=false            # set false for a local Postgres without TLS
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 64 hex chars, encrypts SSNs and tokens at rest: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe backup. Losing it makes encrypted fields unreadable.
ENCRYPTION_KEY=
# Public address of this install, no trailing slash
APP_URL=https://portal.yourfirm.com
# PUBLIC_APP_URL=       # MCP OAuth origin; defaults to APP_URL
# PORTAL_URL=           # client portal links; defaults to APP_URL
# ADMIN_HOSTNAME=       # optional host that redirects / to /admin
# CORS_ORIGINS=         # extra allowed browser origins, comma separated

# ---------- Document storage (REQUIRED for uploads) ----------
# Option A: AWS S3
DOCUMENT_STORAGE_READ_PROVIDER=aws
DOCUMENT_STORAGE_WRITE_PROVIDER=aws
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option B: Cloudflare R2 (S3-compatible). Set both providers to r2 and fill these.
# Two separate buckets: documents and version history.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_DOCUMENT_BUCKET=
# R2_HISTORY_BUCKET=
# DOCUMENT_STORAGE_WRITES_PAUSED=false

# ---------- Email (Resend) ----------
RESEND_API_KEY=
RESEND_FROM="Your Firm <messages@yourfirm.com>"
# EMAIL_FROM=
# NOTIFY_EMAIL=
# MONITOR_EMAIL=
# Inbound replies: domain that receives reply+token@ addresses, and webhook secret
# EMAIL_REPLY_DOMAIN=reply.yourfirm.com
# EMAIL_INBOUND_WEBHOOK_SECRET=
# EMAIL_INBOUND_ALIASES=
# EMAIL_INBOUND_ALLOW_UNAUTHENTICATED_FALLBACK=false
# OUTBOUND_DELIVERY_MODE=live  # leave unset; other values are for isolated staging only

# ---------- AI (optional, see docs/ai-setup.md) ----------
# Leave blank to run without AI features.
ANTHROPIC_API_KEY=
# DARKLION_AI_PROVIDER=anthropic
# DARKLION_INFERENCE_URL=      # self-hosted inference service (inference/)
# DARKLION_INFERENCE_TOKEN=
# DARKLION_CODEX_MODEL=
# EMMA_DRAFT_WORKER_INTERVAL_MS=
# EMMA_DRAFT_MAX_ATTEMPTS=
# EMMA_DRAFT_JOB_TIMEOUT_MINUTES=
# AUTO_BOOKKEEPER_ENABLED=false

# ---------- Branding ----------
# DARKLION_APP_NAME=Your Firm Portal
# DARKLION_APP_STORE_URL=       # link to your own mobile app listing, if any
# DARKLION_TERMS_URL=
# DARKLION_PRIVACY_URL=
# DARKLION_TERMS_VERSION=

# ---------- Install mode ----------
# Self-hosted installs skip the hosted-subscription gates. Leave as true.
DARKLION_SELF_HOSTED=true
# Allow strangers to create firms from /join. Usually false.
DARKLION_PUBLIC_ENROLLMENT=false
# BACKGROUND_JOBS_ENABLED=true
# DASH_USER=
# DASH_PASS=

# ---------- Realtime (Pusher, optional) ----------
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=

# ---------- Integrations (all optional) ----------
# Firm IDs allowed to use the env-level integration keys below, comma separated
# ENV_INTEGRATIONS_FIRM_IDS=1
# QuickBooks
# QB_CLIENT_ID=
# QB_CLIENT_SECRET=
# QB_REDIRECT_URI=https://portal.yourfirm.com/callback.html
# Stripe (collecting client payments)
# STRIPE_SECRET_KEY=
# STRIPE_ACCOUNT_LABEL=
# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_FIRM_ID=
# TWILIO_WEBHOOK_BASE_URL=
# Google Drive import
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=
# Market data
# FINNHUB_API_KEY=
# LedgerHQ bookkeeping connection
# LEDGERHQ_API_BASE=
# LEDGERHQ_APP_BASE=
# LEDGERHQ_CLIENT_ID=
# LEDGERHQ_ENROLLMENT_SECRET=
# LEDGERHQ_SCOPES=
# Tax organizer: payer names your firm supplies itself (regex fragments, comma separated)
# ORGANIZER_FIRM_PROVIDES_PAYERS=
# Virus scanning of uploads
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ---------- Communication archive (optional, compliance) ----------
# COMMUNICATION_ARCHIVE_STORAGE_PROVIDER=r2
# COMMUNICATION_ARCHIVE_BUCKET=
# COMMUNICATION_ARCHIVE_R2_ENDPOINT=
# COMMUNICATION_ARCHIVE_ACCESS_KEY_ID=
# COMMUNICATION_ARCHIVE_SECRET_ACCESS_KEY=
# COMMUNICATION_ARCHIVE_FAIL_CLOSED=true
# COMMUNICATION_ARCHIVE_WRITES_PAUSED=false

# ---------- Hosted-only billing (not needed self-hosted) ----------
# DARKLION_STRIPE_SECRET_KEY=
# DARKLION_STRIPE_WEBHOOK_SECRET=
# DARKLION_STRIPE_BASE_PRICE_ID=
# DARKLION_STRIPE_SEAT_PRICE_ID=
